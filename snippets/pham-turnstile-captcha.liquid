{%- liquid
  unless pham_turnstile_on
    assign pham_turnstile_on = false
    assign pham_turnstile_site_key = settings.pham_waitlist_turnstile_site_key | default: '0x4AAAAAADbDNIw-HnYSFAg2' | strip
    if settings.pham_waitlist_turnstile_enabled and pham_turnstile_site_key != blank
      assign pham_turnstile_verify_url = settings.pham_waitlist_captcha_verify_url | default: '' | strip
      if pham_turnstile_verify_url contains 'https://'
        assign pham_turnstile_on = true
      endif
    endif
  endunless
-%}
{%- if pham_turnstile_on -%}
  <div class="pham-turnstile__wrap is-loading"
       data-pham-turnstile-wrap
       data-pham-turnstile-status="loading"
       aria-label="Security verification">
    <p class="pham-turnstile__label">
      <span class="pham-turnstile__shield" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" focusable="false">
          <path d="M7 1.25 2.5 3.25v3.5c0 2.8 1.92 5.42 4.5 6.05 2.58-.63 4.5-3.25 4.5-6.05v-3.5L7 1.25Z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/>
          <path d="M5.25 7.1 6.35 8.2 8.85 5.7" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="pham-turnstile__label-text">Security verification · Cloudflare Turnstile</span>
    </p>
    <div class="pham-turnstile__stage">
      <div class="pham-turnstile__skeleton" data-pham-turnstile-skeleton aria-hidden="true">
        <span class="pham-turnstile__skeleton-bar"></span>
      </div>
      <div class="pham-turnstile__widget" data-pham-turnstile aria-live="polite"></div>
    </div>
    <p class="pham-turnstile__status" data-pham-turnstile-status-text hidden role="status"></p>
    <p class="pham-turnstile__error" data-pham-turnstile-error hidden role="alert"></p>
    <p class="pham-turnstile__privacy">
      {%- if pham_turnstile_privacy_note != blank -%}
        {{ pham_turnstile_privacy_note }}
      {%- else -%}
        Security check only (HTTPS). Your personal details are not sent to this verification service.
      {%- endif -%}
    </p>
  </div>
{%- endif -%}
