{%- comment -%}
  Cloudflare Turnstile assets — preconnect + deferred scripts in load order.
  form_script_asset: theme asset filename, e.g. pham-contact-form.js
{%- endcomment -%}
{% # theme-check-disable RemoteAsset %}
<link rel="preconnect" href="https://challenges.cloudflare.com" crossorigin>
<link rel="dns-prefetch" href="https://challenges.cloudflare.com">
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" defer></script>
{% # theme-check-enable RemoteAsset %}
<script src="{{ 'pham-turnstile.js' | asset_url }}" defer></script>
{%- if form_script_asset != blank -%}
<script src="{{ form_script_asset | asset_url }}" defer></script>
{%- endif -%}
