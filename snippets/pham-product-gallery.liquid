{% comment %}
  Product-only image gallery. Custom section blocks are intentionally kept
  separate from Shopify product media so 3D models and editorial media do not
  leak into the commerce gallery.

  @param {product} product
  @param {string} section_id
  @param {array} gallery_blocks
{% endcomment %}
{%- liquid
  assign custom_media_count = 0
  for gallery_block in gallery_blocks
    if gallery_block.settings.image != blank
      assign custom_media_count = custom_media_count | plus: 1
    endif
  endfor

  assign use_custom_gallery = false
  assign media_count = product.images.size
  if custom_media_count > 0
    assign use_custom_gallery = true
    assign media_count = custom_media_count
    assign gallery_items = gallery_blocks
  else
    assign gallery_items = product.images
  endif
-%}

<div class="pham-pdp-gallery"
     data-pham-product-gallery
     data-gallery-source="{% if use_custom_gallery %}section{% else %}product-images{% endif %}"
     data-media-count="{{ media_count }}">
  {%- if media_count > 0 -%}
    <div class="pham-pdp-gallery__viewer">
      {%- if media_count > 1 -%}
        <button type="button"
                class="pham-pdp-gallery__nav pham-pdp-gallery__nav--prev"
                data-pham-gallery-prev
                aria-label="Previous image">
          <span aria-hidden="true">&lsaquo;</span>
        </button>
      {%- endif -%}

      <div class="pham-pdp-gallery__stage" data-pham-gallery-stage>
        {%- assign gallery_index = 0 -%}
        {%- for gallery_item in gallery_items -%}
          {%- liquid
            if use_custom_gallery
              assign gallery_image = gallery_item.settings.image
              assign gallery_alt = gallery_item.settings.alt | default: gallery_image.alt | default: product.title
              assign gallery_attributes = gallery_item.shopify_attributes
            else
              assign gallery_image = gallery_item
              assign gallery_alt = gallery_item.alt | default: product.title
              assign gallery_attributes = blank
            endif
            if gallery_image == blank
              continue
            endif
            assign pm_img_loading = 'lazy'
            assign pm_img_priority = 'auto'
            assign gallery_number = gallery_index | plus: 1
          -%}
          <div class="pham-pdp-gallery__slide{% if gallery_index == 0 %} is-active{% endif %}"
               data-pham-gallery-slide
               data-slide-index="{{ gallery_index }}"
               role="tabpanel"
               aria-label="Product image {{ gallery_number }} of {{ media_count }}"
               {{ gallery_attributes }}>
            <button type="button"
                    class="pham-pdp-gallery__zoom-trigger"
                    data-pham-zoom-trigger
                    data-pham-zoom-src="{{ gallery_image | image_url: width: 2400 }}"
                    data-pham-zoom-srcset="{{ gallery_image | image_url: width: 1200 }} 1200w, {{ gallery_image | image_url: width: 2000 }} 2000w, {{ gallery_image | image_url: width: 2400 }} 2400w"
                    data-pham-zoom-alt="{{ gallery_alt | escape }}"
                    aria-label="Zoom image {{ gallery_number }}">
              {{ gallery_image
                  | image_url: width: 1600
                  | image_tag:
                    loading: pm_img_loading,
                    fetchpriority: pm_img_priority,
                    widths: '480, 768, 1080, 1440, 1600',
                    sizes: '(max-width: 749px) 100vw, 50vw',
                    class: 'pham-pdp-gallery__img',
                    alt: gallery_alt,
                    width: gallery_image.width,
                    height: gallery_image.height
              }}
            </button>
          </div>
          {%- assign gallery_index = gallery_index | plus: 1 -%}
        {%- endfor -%}
      </div>

      {%- if media_count > 1 -%}
        <button type="button"
                class="pham-pdp-gallery__nav pham-pdp-gallery__nav--next"
                data-pham-gallery-next
                aria-label="Next image">
          <span aria-hidden="true">&rsaquo;</span>
        </button>
        <p class="pham-pdp-gallery__counter" data-pham-gallery-counter aria-live="polite">
          <span data-pham-gallery-current>1</span> / {{ media_count }}
        </p>
      {%- endif -%}
    </div>

    {%- if media_count > 1 -%}
      <div class="pham-pdp-gallery__thumbs-wrap">
        <button type="button"
                class="pham-pdp-gallery__thumb-nav pham-pdp-gallery__thumb-nav--prev"
                data-pham-thumb-prev
                aria-label="Scroll thumbnails left"
                hidden>
          <span aria-hidden="true">&lsaquo;</span>
        </button>
        <div class="pham-pdp-gallery__thumbs" data-pham-gallery-thumbs role="tablist" aria-label="Product thumbnails">
          {%- assign thumb_index = 0 -%}
          {%- for gallery_item in gallery_items -%}
            {%- liquid
              if use_custom_gallery
                assign thumb_image = gallery_item.settings.image
              else
                assign thumb_image = gallery_item
              endif
              if thumb_image == blank
                continue
              endif
              assign thumb_number = thumb_index | plus: 1
            -%}
            <button type="button"
                    class="pham-pdp-gallery__thumb{% if thumb_index == 0 %} is-active{% endif %}"
                    data-pham-gallery-thumb
                    data-slide-index="{{ thumb_index }}"
                    role="tab"
                    aria-selected="{% if thumb_index == 0 %}true{% else %}false{% endif %}"
                    aria-label="Show image {{ thumb_number }}">
              {{ thumb_image
                  | image_url: width: 160
                  | image_tag:
                    loading: 'lazy',
                    widths: '80, 120, 160',
                    sizes: '72px',
                    class: 'pham-pdp-gallery__thumb-img',
                    alt: ''
              }}
            </button>
            {%- assign thumb_index = thumb_index | plus: 1 -%}
          {%- endfor -%}
        </div>
        <button type="button"
                class="pham-pdp-gallery__thumb-nav pham-pdp-gallery__thumb-nav--next"
                data-pham-thumb-next
                aria-label="Scroll thumbnails right"
                hidden>
          <span aria-hidden="true">&rsaquo;</span>
        </button>
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="pham-pdp-gallery__viewer pham-pdp-gallery__viewer--empty">
      <div class="pham-pdp-gallery__img pham-skeleton" aria-hidden="true"></div>
    </div>
  {%- endif -%}
</div>
