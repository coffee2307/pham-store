{%- comment -%}
  DO NOT EDIT — managed by PHAM theme architecture.
  Header brand lockup: Logo-PHAM.svg (mark + wordmark in one asset).

  Params:
    - class: anchor class list (required)
    - url: link target (default: home)
    - logo_width: optional width in px (default: theme PHAM logo width)
    - image_loading: eager | lazy (default: eager)
{%- endcomment -%}
{%- liquid
  assign lockup_url = url | default: routes.root_url
  assign lockup_class = class | default: 'pham-brand-lockup'
  assign lockup_label = shop.name | default: 'PHAM'
  assign lockup_mark = settings.pham_logo
  if logo_width != blank
    assign lockup_logo_width = logo_width
  else
    assign lockup_logo_width = settings.pham_logo_width | default: 140
  endif
  assign lockup_logo_height = lockup_logo_width | times: 524 | divided_by: 1683 | round
  assign lockup_logo_sizes = '(max-width: 989px) 110px, ' | append: lockup_logo_width | append: 'px'
  assign lockup_image_loading = image_loading | default: 'eager'
  if lockup_image_loading == 'lazy'
    assign lockup_fetchpriority = 'auto'
  else
    assign lockup_fetchpriority = 'high'
  endif
-%}
<a
  href="{{ lockup_url }}"
  class="{{ lockup_class }} pham-brand-lockup pham-brand-lockup--logo-only"
  style="--pham-logo-width: {{ lockup_logo_width }}px;"
  aria-label="{{ lockup_label | escape }}"
>
  <span class="pham-brand-lockup__mark">
    {%- if lockup_mark != blank -%}
      {{ lockup_mark
          | image_url: width: 560
          | image_tag:
            loading: lockup_image_loading,
            fetchpriority: lockup_fetchpriority,
            widths: '140, 200, 280, 360',
            sizes: lockup_logo_sizes,
            class: 'pham-brand-lockup__mark-img',
            alt: lockup_label
      }}
    {%- else -%}
      <img
        src="{{ 'Logo-PHAM.svg' | asset_url }}"
        class="pham-brand-lockup__mark-img pham-brand-lockup__mark-img--svg"
        width="{{ lockup_logo_width }}"
        height="{{ lockup_logo_height }}"
        alt="{{ lockup_label | escape }}"
        loading="{{ lockup_image_loading }}"
        fetchpriority="{{ lockup_fetchpriority }}"
        decoding="async"
      >
    {%- endif -%}
  </span>
</a>
