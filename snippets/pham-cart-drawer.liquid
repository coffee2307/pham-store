<!-- # DO NOT EDIT — managed by PHAM theme architecture -->
{%- capture drawer_product_url -%}{%- render 'pham-featured-product-url' -%}{%- endcapture -%}
{%- assign drawer_product_url = drawer_product_url | strip -%}
{%- comment -%}
  PHAM — Cart Drawer snippet

  Renders the right-edge cart drawer overlay. Refreshed via Shopify's
  Section Rendering API by pham-cart.js (section ID: pham-cart-drawer).

  Containers:
    [data-pham-cart-drawer]          — outer dialog
    [data-pham-cart-backdrop]        — dim layer that closes on click
    [data-cart-recommendations]      — recommendation injection slot
    [data-pham-cart-close]           — close trigger
    [data-pham-qty-increase/decrease]— qty buttons
    [data-pham-qty-input]            — qty input
    [data-pham-cart-remove]          — remove trigger
{%- endcomment -%}

<aside class="pham-cart-drawer"
       data-pham-cart-drawer
       role="dialog"
       aria-modal="true"
       aria-hidden="true"
       aria-label="Shopping cart"
       tabindex="-1">

  <button type="button"
          class="pham-cart-drawer__backdrop"
          data-pham-cart-backdrop
          aria-label="Close cart"
          tabindex="-1"></button>

  <div class="pham-cart-drawer__panel" role="document">

    <header class="pham-cart-drawer__head">
      <div class="pham-cart-drawer__head-text">
        <span class="pham-eyebrow">Atelier</span>
        <h2 class="pham-cart-drawer__title">Your Edition</h2>
      </div>
      <button type="button"
              class="pham-cart-drawer__close"
              data-pham-cart-close
              aria-label="Close cart">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
          <line x1="3" y1="3" x2="15" y2="15" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          <line x1="15" y1="3" x2="3" y2="15" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
      </button>
    </header>

    {%- if cart.item_count > 0 -%}

      <div class="pham-cart-drawer__body">
        <ul class="pham-cart-drawer__items" role="list">
          {%- for item in cart.items -%}
            {%- capture pham_item_limited -%}{%- render 'pham-is-limited-edition', product: item.product -%}{%- endcapture -%}
            {%- assign pham_item_limited = pham_item_limited | strip -%}
            <li class="pham-cart-drawer__item" data-line="{{ forloop.index }}" data-key="{{ item.key }}"{% if pham_item_limited == 'true' %} data-pham-limited-qty="1"{% endif %}>
              <a href="{{ routes.cart_url }}" class="pham-cart-drawer__item-media" aria-label="View cart — {{ item.product.title | escape }}">
                {%- if item.image -%}
                  {{ item.image
                      | image_url: width: 240
                      | image_tag:
                        loading: 'lazy',
                        widths: '120, 200, 240, 360',
                        sizes: '120px',
                        alt: item.image.alt | default: item.product.title,
                        class: 'pham-cart-drawer__item-img'
                  }}
                {%- else -%}
                  <div class="pham-cart-drawer__item-img pham-skeleton" aria-hidden="true"></div>
                {%- endif -%}
              </a>

              <div class="pham-cart-drawer__item-meta">
                <div class="pham-cart-drawer__item-head">
                  <a href="{{ routes.cart_url }}" class="pham-cart-drawer__item-title">{{ item.product.title }}</a>
                  <span class="pham-cart-drawer__item-price">{{ item.final_line_price | money }}</span>
                </div>

                {%- unless item.product.has_only_default_variant -%}
                  <p class="pham-cart-drawer__item-variant">
                    {%- for opt in item.options_with_values -%}
                      <span>{{ opt.name }}: {{ opt.value }}</span>{%- unless forloop.last -%} · {%- endunless -%}
                    {%- endfor -%}
                  </p>
                {%- endunless -%}

                {%- if item.selling_plan_allocation -%}
                  <p class="pham-cart-drawer__item-plan">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                {%- endif -%}

                {%- if item.properties.size > 0 -%}
                  <ul class="pham-cart-drawer__item-props" role="list">
                    {%- for property in item.properties -%}
                      {%- assign prop_name = property.first -%}
                      {%- assign prop_value = property.last -%}
                      {%- unless prop_name contains '_' or prop_value == blank -%}
                        <li><span>{{ prop_name }}:</span> {{ prop_value }}</li>
                      {%- endunless -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

                <div class="pham-cart-drawer__item-controls">
                  <div class="pham-cart-drawer__qty" role="group" aria-label="Quantity for {{ item.product.title | escape }}">
                    <button type="button"
                            class="pham-cart-drawer__qty-btn"
                            data-pham-qty-decrease
                            data-line="{{ forloop.index }}"
                            data-quantity="{{ item.quantity }}"
                            aria-label="Decrease quantity">
                      <span aria-hidden="true">−</span>
                    </button>
                    <input type="number"
                           class="pham-cart-drawer__qty-input"
                           value="{{ item.quantity }}"
                           min="{% if pham_item_limited == 'true' %}1{% else %}0{% endif %}"
                           {% if pham_item_limited == 'true' %}max="1" readonly{% endif %}
                           inputmode="numeric"
                           pattern="[0-9]*"
                           aria-label="Quantity"
                           data-pham-qty-input
                           data-line="{{ forloop.index }}">
                    <button type="button"
                            class="pham-cart-drawer__qty-btn"
                            data-pham-qty-increase
                            data-line="{{ forloop.index }}"
                            data-quantity="{{ item.quantity }}"
                            aria-label="Increase quantity">
                      <span aria-hidden="true">+</span>
                    </button>
                  </div>

                  <button type="button"
                          class="pham-cart-drawer__remove"
                          data-pham-cart-remove
                          data-line="{{ forloop.index }}"
                          aria-label="Remove {{ item.product.title | escape }} from cart">
                    REMOVE
                  </button>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {%- if cart.cart_level_discount_applications.size > 0 -%}
          <ul class="pham-cart-drawer__discounts" role="list">
            {%- for discount in cart.cart_level_discount_applications -%}
              <li class="pham-cart-drawer__discount">
                <span class="pham-cart-drawer__discount-title">{{ discount.title }}</span>
                <span class="pham-cart-drawer__discount-amount">-{{ discount.total_allocated_amount | money }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="pham-cart-drawer__recommendations" data-cart-recommendations aria-live="polite"></div>
      </div>

      <footer class="pham-cart-drawer__foot">
        <div class="pham-cart-drawer__subtotal">
          <span class="pham-cart-drawer__subtotal-label">Subtotal</span>
          <span class="pham-cart-drawer__subtotal-value">{{ cart.total_price | money }}</span>
        </div>
        <p class="pham-cart-drawer__taxnote">Taxes and shipping calculated at checkout.</p>
        <ul class="pham-cart-trust" role="list">
          {%- if settings.pham_cart_shipping_message != blank -%}<li>{{ settings.pham_cart_shipping_message }}</li>{%- endif -%}
          {%- if settings.pham_cart_returns_message != blank -%}<li>{{ settings.pham_cart_returns_message }}</li>{%- endif -%}
          {%- if settings.pham_cart_duties_message != blank -%}<li>{{ settings.pham_cart_duties_message }}</li>{%- endif -%}
        </ul>
        <form action="{{ routes.cart_url }}" method="post" novalidate class="pham-cart-drawer__checkout-form" data-pham-no-ajax>
          <button type="submit" name="checkout" class="pham-cart-drawer__checkout">
            <span class="pham-cart-drawer__checkout-label">Proceed to Checkout</span>
            <span class="pham-cart-drawer__checkout-arrow" aria-hidden="true">&rarr;</span>
          </button>
        </form>
      </footer>

    {%- else -%}

      <div class="pham-cart-drawer__body pham-cart-drawer__body--empty">
        <div class="pham-cart-drawer__empty">
          <p class="pham-cart-drawer__empty-mark">∅</p>
          <p class="pham-cart-drawer__empty-text">Your atelier is silent.</p>
          <p class="pham-cart-drawer__empty-sub">Begin the edition.</p>
          <a href="{{ drawer_product_url }}" class="pham-cart-drawer__empty-cta">
            <span>View the Edition</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <div class="pham-cart-drawer__recommendations" data-cart-recommendations aria-live="polite"></div>
      </div>

    {%- endif -%}

    <template data-pham-cart-empty-template>
      <div class="pham-cart-drawer__body pham-cart-drawer__body--empty">
        <div class="pham-cart-drawer__empty">
          <p class="pham-cart-drawer__empty-mark">∅</p>
          <p class="pham-cart-drawer__empty-text">Your atelier is silent.</p>
          <p class="pham-cart-drawer__empty-sub">Begin the edition.</p>
          <a href="{{ drawer_product_url }}" class="pham-cart-drawer__empty-cta">
            <span>View the Edition</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <div class="pham-cart-drawer__recommendations" data-cart-recommendations aria-live="polite"></div>
      </div>
    </template>
  </div>
</aside>
