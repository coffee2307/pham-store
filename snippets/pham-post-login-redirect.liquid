{%- comment -%}
  After silent account activation, redirect logged-in customers to a safe same-origin path.
{%- endcomment -%}
{%- if customer -%}
<script>
  (function () {
    'use strict';
    var key = 'pham_return_after_login';
    var target;
    try { target = sessionStorage.getItem(key); } catch (e) { return; }
    if (!target) return;
    try { sessionStorage.removeItem(key); } catch (e) { /* ignore */ }

    function safePath(value) {
      if (window.PhamSecurity && window.PhamSecurity.isSafeSameOriginPath) {
        return window.PhamSecurity.isSafeSameOriginPath(value);
      }
      return value && value.charAt(0) === '/' && value.charAt(1) !== '/';
    }

    if (!safePath(target)) return;
    window.location.replace(target);
  })();
</script>
{%- endif -%}
