{%- liquid
  assign featured_product = section.settings.product
  if featured_product == blank
    assign featured_product = collections.all.products.first
  endif

  assign object_url = section.settings.cta_link
  if object_url == blank and featured_product != blank
    assign object_url = featured_product.url
  endif
  if object_url == blank
    assign object_url = routes.all_products_collection_url
  endif
-%}

{{ 'pham-vault.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pham-vault.js' | asset_url }}" defer></script>

<section
  class="pham-vault"
  data-pham-vault
  data-section-id="{{ section.id }}"
  data-orbit-speed="{{ section.settings.orbit_speed }}"
  data-orbit-tilt="{{ section.settings.orbit_tilt }}"
  style="--vault-orbit-scale: {{ section.settings.object_scale | times: 0.01 }}"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  <div class="pham-vault__sticky">
    <div class="pham-vault__fallback" aria-hidden="true"></div>

    <div class="pham-vault__chrome" aria-hidden="true">
      <span>PHAM / DIGITAL ARCHIVE</span>
      <span>OBJECT 001</span>
      <span>VIETNAM / 2026</span>
    </div>

    <div class="pham-vault__orbit-stage" data-pham-vault-orbit>
      <div class="pham-vault__orbit-plane" data-pham-vault-orbit-plane>
        <div class="pham-vault__orbit-ring" aria-hidden="true"></div>
        <div class="pham-vault__orbit-cards">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- assign card_image = block.settings.image -%}
              {%- assign card_alt = block.settings.alt_text | default: card_image.alt | default: 'PHAM archive image' -%}
              <figure class="pham-vault__orbit-card"
                      data-pham-vault-card
                      {% if block.settings.link == blank %}tabindex="0" role="button" aria-expanded="false" aria-label="Open {{ card_alt | escape }}"{% endif %}
                      {{ block.shopify_attributes }}>
                <div class="pham-vault__orbit-card-face">
                  {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" aria-label="{{ card_alt | escape }}">{%- endif -%}
                    {%- if card_image != blank -%}
                      {{
                        card_image
                        | image_url: width: 1200
                        | image_tag:
                          loading: 'lazy',
                          widths: '320, 480, 720, 960, 1200',
                          sizes: '(max-width: 749px) 34vw, 18vw',
                          alt: card_alt
                      }}
                    {%- else -%}
                      <span class="pham-vault__orbit-placeholder">PHAM<br>0{{ forloop.index }}</span>
                    {%- endif -%}
                  {%- if block.settings.link != blank -%}</a>{%- endif -%}
                </div>
              </figure>
            {%- endfor -%}
          {%- else -%}
            {%- for card_number in (1..8) -%}
              <figure class="pham-vault__orbit-card" data-pham-vault-card tabindex="0" role="button" aria-expanded="false" aria-label="Open PHAM archive frame {{ card_number }}">
                <div class="pham-vault__orbit-card-face">
                  <span class="pham-vault__orbit-placeholder">PHAM<br>0{{ card_number }}</span>
                </div>
              </figure>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
      <span class="pham-vault__orbit-hint" aria-hidden="true">DRAG / ROTATE</span>
    </div>

    <div class="pham-vault__chapters pham-container">
      <article class="pham-vault__chapter is-active" data-pham-vault-chapter="0">
        <p class="pham-vault__kicker">01 / THRESHOLD</p>
        <h1 class="pham-vault__display">{{ section.settings.chapter_1_title }}</h1>
        <p class="pham-vault__copy">{{ section.settings.chapter_1_body }}</p>
        <div class="pham-vault__entry-actions">
          <span class="pham-vault__cue">{{ section.settings.scroll_label }}</span>
          {%- if featured_product != blank -%}
            <a class="pham-vault__entry-link" href="{{ object_url }}">{{ section.settings.entry_cta_label }} <span aria-hidden="true">&#8599;</span></a>
          {%- endif -%}
        </div>
      </article>

      <article class="pham-vault__chapter pham-vault__chapter--right" data-pham-vault-chapter="1" aria-hidden="true">
        <p class="pham-vault__kicker">02 / OBJECT</p>
        <h2 class="pham-vault__display">{{ section.settings.chapter_2_title }}</h2>
        <p class="pham-vault__copy">{{ section.settings.chapter_2_body }}</p>
      </article>

      <article class="pham-vault__chapter" data-pham-vault-chapter="2" aria-hidden="true">
        <p class="pham-vault__kicker">03 / CONSTRUCTION</p>
        <h2 class="pham-vault__display">{{ section.settings.chapter_3_title }}</h2>
        <div class="pham-vault__specs">
          <div><span>{{ section.settings.spec_1_label }}</span><strong>{{ section.settings.spec_1_value }}</strong></div>
          <div><span>{{ section.settings.spec_2_label }}</span><strong>{{ section.settings.spec_2_value }}</strong></div>
          <div><span>{{ section.settings.spec_3_label }}</span><strong>{{ section.settings.spec_3_value }}</strong></div>
        </div>
      </article>

      <article class="pham-vault__chapter pham-vault__chapter--purchase" data-pham-vault-chapter="3" aria-hidden="true">
        <p class="pham-vault__kicker">04 / ACQUISITION</p>
        <h2 class="pham-vault__display">
          {%- if featured_product != blank -%}{{ featured_product.title }}{%- else -%}{{ section.settings.chapter_4_title }}{%- endif -%}
        </h2>
        {%- if featured_product != blank -%}
          <p class="pham-vault__price">{{ featured_product.price | money }}</p>
          <p class="pham-vault__availability">
            {%- if featured_product.available -%}{{ section.settings.available_label }}{%- else -%}{{ section.settings.sold_out_label }}{%- endif -%}
          </p>
        {%- endif -%}
        <p class="pham-vault__copy">{{ section.settings.chapter_4_body }}</p>
        <a class="pham-vault__cta" href="{{ object_url }}" data-pham-magnetic>
          <span>{{ section.settings.cta_label }}</span><span aria-hidden="true">&#8599;</span>
        </a>
      </article>
    </div>

    <nav class="pham-vault__nav" aria-label="Vault chapters">
      <button type="button" class="is-active" data-pham-vault-jump="0" aria-label="Open chapter 1"><span>01</span></button>
      <button type="button" data-pham-vault-jump="1" aria-label="Open chapter 2"><span>02</span></button>
      <button type="button" data-pham-vault-jump="2" aria-label="Open chapter 3"><span>03</span></button>
      <button type="button" data-pham-vault-jump="3" aria-label="Open chapter 4"><span>04</span></button>
    </nav>

    <div class="pham-vault__progress" aria-hidden="true"><i data-pham-vault-progress></i></div>
  </div>
</section>

{% schema %}
{
  "name": "PHAM Vault experience",
  "tag": "section",
  "class": "pham-vault-section",
  "settings": [
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "PHAM Edition 01 digital experience" },
    { "type": "product", "id": "product", "label": "Featured product" },
    { "type": "range", "id": "object_scale", "label": "Orbit scale", "min": 70, "max": 110, "step": 5, "unit": "%", "default": 90 },
    { "type": "range", "id": "orbit_speed", "label": "Automatic rotation speed", "min": 0, "max": 16, "step": 1, "unit": "°/s", "default": 6 },
    { "type": "range", "id": "orbit_tilt", "label": "Orbit tilt", "min": 2, "max": 16, "step": 1, "unit": "°", "default": 8 },
    { "type": "text", "id": "chapter_1_title", "label": "Chapter 1 title", "default": "ENTER THE VAULT" },
    { "type": "textarea", "id": "chapter_1_body", "label": "Chapter 1 text", "default": "One object. One edition. Built without compromise." },
    { "type": "text", "id": "scroll_label", "label": "Scroll prompt", "default": "SCROLL TO ENTER" },
    { "type": "text", "id": "entry_cta_label", "label": "Immediate product link", "default": "VIEW OBJECT 001" },
    { "type": "text", "id": "chapter_2_title", "label": "Chapter 2 title", "default": "FORM BEFORE NOISE" },
    { "type": "textarea", "id": "chapter_2_body", "label": "Chapter 2 text", "default": "A cropped silhouette engineered to hold tension between restraint and force." },
    { "type": "text", "id": "chapter_3_title", "label": "Chapter 3 title", "default": "BUILT IN LAYERS" },
    { "type": "text", "id": "spec_1_label", "label": "Specification 1 label", "default": "SHELL" },
    { "type": "text", "id": "spec_1_value", "label": "Specification 1 value", "default": "PREMIUM NYLON" },
    { "type": "text", "id": "spec_2_label", "label": "Specification 2 label", "default": "STRUCTURE" },
    { "type": "text", "id": "spec_2_value", "label": "Specification 2 value", "default": "QUILTED INSULATION" },
    { "type": "text", "id": "spec_3_label", "label": "Specification 3 label", "default": "EDITION" },
    { "type": "text", "id": "spec_3_value", "label": "Specification 3 value", "default": "LIMITED / 001" },
    { "type": "text", "id": "chapter_4_title", "label": "Chapter 4 title", "default": "PHAM-001" },
    { "type": "textarea", "id": "chapter_4_body", "label": "Chapter 4 text", "default": "The first PHAM object. Released in a deliberately limited edition." },
    { "type": "text", "id": "available_label", "label": "Available label", "default": "AVAILABLE / LIMITED EDITION" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "EDITION CLOSED" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "INSPECT THE OBJECT" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Falls back to the featured product." }
  ],
  "blocks": [
    {
      "type": "orbit_card",
      "name": "Orbit image",
      "limit": 12,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt_text", "label": "Alternative text" },
        { "type": "url", "id": "link", "label": "Optional link" }
      ]
    }
  ],
  "presets": [{ "name": "PHAM Vault experience", "category": "PHAM" }],
  "enabled_on": { "templates": ["index"] }
}
{% endschema %}
