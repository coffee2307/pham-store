{%- assign editorial_image = section.settings.editorial_image -%}
{%- assign editorial_mobile_image = section.settings.mobile_image -%}

<section class="pham-editorial-stage" data-pham-editorial-stage aria-label="{{ section.settings.heading | escape }}">
  <div class="pham-editorial-stage__ambient" aria-hidden="true"></div>

  {%- if editorial_image != blank -%}
    <div class="pham-editorial-stage__visual">
      <picture class="pham-editorial-stage__picture">
        {%- if editorial_mobile_image != blank -%}
          <source
            media="(max-width: 699px)"
            srcset="{{ editorial_mobile_image | image_url: width: 720 }} 720w, {{ editorial_mobile_image | image_url: width: 1100 }} 1100w, {{ editorial_mobile_image | image_url: width: 1500 }} 1500w, {{ editorial_mobile_image | image_url: width: 1800 }} 1800w"
            sizes="100vw"
          >
        {%- endif -%}
        {{ editorial_image
          | image_url: width: 2200
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            decoding: 'async',
            widths: '480, 768, 1024, 1440, 1800, 2200',
            sizes: '(max-width: 699px) 100vw, 68vw',
            class: 'pham-editorial-stage__image',
            alt: 'PHAM-001 black cropped bomber, rear editorial view'
        }}
      </picture>
    </div>
  {%- endif -%}

  <div class="pham-editorial-stage__meta pham-container">
    <p>PHAM / EDITION 01</p>
    <p>{{ section.settings.object_code }}</p>
  </div>

  <div class="pham-editorial-stage__content pham-container">
    <div class="pham-editorial-stage__copy">
      <p class="pham-editorial-stage__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="pham-editorial-stage__title{% if section.settings.heading == "THE FIRST OBJECT" %} pham-editorial-stage__title--phrase{% endif %}">{% if section.settings.heading == "THE FIRST OBJECT" %}<span class="pham-editorial-stage__phrase-unit">THE <strong>FIRST</strong> OBJECT</span>{% else %}{{ section.settings.heading | escape }}{% endif %}</h1>
      <p class="pham-editorial-stage__description pham-editorial-stage__description--desktop">{{ section.settings.body }}</p>
      <p class="pham-editorial-stage__description pham-editorial-stage__description--mobile">{{ section.settings.mobile_body | default: section.settings.body }}</p>
      <a class="pham-editorial-stage__cta" href="#MainProduct-{{ product.id }}">
        <span>EXPLORE PHAM-001</span>

</a>
    </div>
  </div>
  <div class="pham-editorial-stage__footer pham-container">
    <span>PHAM / THE FIRST OBJECT</span>
    <span>DESIGNED IN VIETNAM — EDITION 01</span>
  </div>
</section>

<style>
  .pham-editorial-stage {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: clamp(730px, 100svh, 1080px);
    background: #090b0e;
    color: #f5f3f0;
    border-bottom: 1px solid rgba(255,255,255,.1);
  }
  .pham-editorial-stage__ambient {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 68% 82% at 76% 27%, rgba(125,120,116,.12), transparent 72%),
      radial-gradient(ellipse 56% 64% at 16% 76%, rgba(32,35,39,.5), transparent 77%),
      linear-gradient(116deg, #07090c 0%, #0b0d10 54%, #151719 100%);
  }
  .pham-editorial-stage__visual {
    position: absolute;
    inset-block: 0;
    right: 0;
    width: 69%;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }
  .pham-editorial-stage__picture { display: block; width: 100%; height: 100%; }
  .pham-editorial-stage__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 54%;
  }
  /* Feather the image itself into the ambient background; never leave a clipped vertical edge. */
  @media (min-width: 700px) {
    .pham-editorial-stage__visual {
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,.12) 13%, rgba(0,0,0,.58) 32%, rgba(0,0,0,.9) 48%, #000 65%);
      mask-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,.12) 13%, rgba(0,0,0,.58) 32%, rgba(0,0,0,.9) 48%, #000 65%);
    }
  }
  .pham-editorial-stage__visual::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(9,11,14,.55) 0%, rgba(9,11,14,.2) 39%, transparent 72%),
      linear-gradient(0deg, rgba(9,11,14,.65) 0%, transparent 20%, transparent 86%, rgba(9,11,14,.14) 100%);
  }
  .pham-editorial-stage__meta,
  .pham-editorial-stage__footer {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    font: 500 10px/1.4 var(--font-mono);
    letter-spacing: .13em;
    color: rgba(244,244,241,.5);
  }
  .pham-editorial-stage__meta { top: clamp(86px, 9vw, 132px); }
  .pham-editorial-stage__footer { bottom: 28px; }
  .pham-editorial-stage__meta p { margin: 0; }
  .pham-editorial-stage__content { position: relative; width: 100%; z-index: 2; }
  .pham-editorial-stage__copy { max-width: 550px; padding: 112px 0 72px; }
  .pham-editorial-stage__eyebrow {
    margin: 0 0 22px;
    font: 500 10px/1.4 var(--font-mono);
    letter-spacing: .18em;
    color: rgba(242,242,239,.58);
  }
  .pham-editorial-stage__title {
    max-width: 570px;
    margin: 0;
    font: 400 clamp(4.1rem, 7.2vw, 8.6rem)/.92 var(--font-display);
    letter-spacing: -.045em;
    text-wrap: balance;
  }
  .pham-editorial-stage__description {
    max-width: 335px;
    margin: 30px 0 38px;
    font: 400 clamp(.88rem, 1.1vw, 1rem)/1.7 var(--font-body);
    color: rgba(242,242,239,.72);
  }
  .pham-editorial-stage__description--mobile { display: none; }
  .pham-editorial-stage__cta {
    display: inline-flex;
    gap: 25px;
    align-items: center;
    border-bottom: 1px solid rgba(242,242,239,.65);
    padding: 0 0 11px;
    color: #f6f5f1;
    text-decoration: none;
    font: 600 10px/1.2 var(--font-mono);
    letter-spacing: .13em;
    transition: opacity 180ms ease, gap 180ms ease;
  }
  .pham-editorial-stage__cta:hover { gap: 33px; opacity: .8; }
  .pham-editorial-stage__cta:focus-visible { outline: 2px solid #f6f5f1; outline-offset: 6px; }

  @media (max-width: 899px) {
    .pham-editorial-stage { min-height: 910px; }
    .pham-editorial-stage__visual { width: 80%; }
    .pham-editorial-stage__copy { max-width: 430px; }
    .pham-editorial-stage__title { font-size: clamp(3.65rem, 8.5vw, 5.6rem); }
    .pham-editorial-stage__visual::after {
      background: linear-gradient(90deg, #090b0e 0%, rgba(9,11,14,.9) 22%, rgba(9,11,14,.12) 75%),
                  linear-gradient(0deg, rgba(9,11,14,.68), transparent 22%);
    }
  }
  @media (max-width: 699px) {
    .pham-editorial-stage {
      min-height: clamp(790px, 100svh, 920px);
      height: auto;
      align-items: stretch;
      background: #090b0e;
    }
    .pham-editorial-stage__ambient { background: #090b0e; }
    .pham-editorial-stage__visual {
      inset: 0;
      width: 100%;
      height: 100%;
    }
    .pham-editorial-stage__image {
      object-position: 50% 50%;
      transform: none;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .pham-editorial-stage__visual::after {
      background: linear-gradient(180deg,
        rgba(9,11,14,.34) 0%,
        transparent 17%,
        transparent 37%,
        rgba(9,11,14,.14) 49%,
        rgba(9,11,14,.78) 69%,
        #090b0e 85%,
        #090b0e 100%);
    }
    .pham-editorial-stage__meta { display: none; }
    .pham-editorial-stage__content {
      position: absolute;
      inset: auto 0 80px;
      padding-block: 0;
      z-index: 2;
    }
    .pham-editorial-stage__copy {
      max-width: 100%;
      padding: 0;
    }
    .pham-editorial-stage__eyebrow { display: none; }
    .pham-editorial-stage__title {
      font-size: clamp(2.95rem, 10.8vw, 4.3rem);
      line-height: .97;
      letter-spacing: -.045em;
      max-width: min(320px, 88%);
    }
    .pham-editorial-stage__description--desktop { display: none; }
    .pham-editorial-stage__description--mobile { display: block; }
    .pham-editorial-stage__description {
      max-width: 310px;
      margin: 14px 0 20px;
      font-size: .78rem;
      line-height: 1.55;
      color: rgba(245,245,242,.82);
    }
    .pham-editorial-stage__cta {
      font-size: 10px;
      gap: 18px;
      padding-bottom: 10px;
    }
    .pham-editorial-stage__footer { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pham-editorial-stage__cta { transition: none; }
  }
.pham-editorial-stage__title--phrase {
  font-size:clamp(2.08rem,3.25vw,3.06rem);
  line-height:1.08;
  letter-spacing:-.035em;
  max-width:none;
}
.pham-editorial-stage__phrase-unit {display:inline-block;white-space:nowrap}
.pham-editorial-stage__phrase-unit strong {font:inherit;font-weight:640}
@media(max-width:699px) {
  .pham-editorial-stage__title--phrase {
    font-size:clamp(1.55rem,7.6vw,2.7rem);
    max-width:100%;
  }
}


/* PHAM-001 responsive hero: preserve full mobile photo width and avoid cover upscaling */
@media (max-width:699px) {
  .pham-editorial-stage {
    min-height:clamp(700px,90svh,830px);
    height:auto;
  }
  .pham-editorial-stage__visual {
    inset:0 clamp(12px,3vw,20px) auto;
    width:auto;
    height:clamp(470px,67svh,630px);
    overflow:visible;
  }
  .pham-editorial-stage__picture {
    width:100%;
    height:100%;
  }
  .pham-editorial-stage__image {
    width:100%;
    height:100%;
    object-fit:contain;
    object-position:center top;
    transform:none;
  }
  .pham-editorial-stage__visual::after {
    background:linear-gradient(180deg,
      transparent 0%, transparent 55%,
      rgba(9,11,14,.06) 68%,
      rgba(9,11,14,.56) 86%,
      #090b0e 100%);
  }
  .pham-editorial-stage__content {
    inset:auto 0 70px;
  }
}
</style>

{% schema %}
{
  "name": "PHAM Editorial stage",
  "tag": "section",
  "class": "pham-product-editorial-section",
  "settings": [
    { "type": "header", "content": "Hero image" },
    { "type": "image_picker", "id": "editorial_image", "label": "Editorial image (desktop)" },
    { "type": "image_picker", "id": "mobile_image", "label": "Editorial image (mobile, no embedded logo)" },
    { "type": "text", "id": "object_code", "label": "Object code", "default": "PHAM-001" },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "EDITION 01 / PHAM ATELIER" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "THE FIRST OBJECT" },
    { "type": "textarea", "id": "body", "label": "Description", "default": "Designed to be felt. Built to be worn. The inaugural PHAM object is defined by controlled volume, a cropped form and uncompromising detail." },
    { "type": "textarea", "id": "mobile_body", "label": "Short mobile description", "default": "A study in volume, structure and restraint." }
  ],
  "presets": [{ "name": "PHAM Editorial stage", "category": "PHAM" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
