{{ 'pham-campaign.css' | asset_url | stylesheet_tag }}
{%- capture state_raw -%}{%- render 'pham-campaign-state' -%}{%- endcapture -%}
{%- assign state = state_raw | strip -%}
{%- assign reservation_product = settings.pham_campaign_reservation_product -%}
{%- assign identity_product = settings.pham_campaign_identity_product -%}
{%- assign lookbook_product = settings.pham_campaign_lookbook_product -%}
{%- assign object_product = all_products['pham-001'] -%}
{%- assign reservation_variant = reservation_product.selected_or_first_available_variant -%}
{%- assign identity_variant = identity_product.selected_or_first_available_variant -%}
{%- assign lookbook_variant = lookbook_product.selected_or_first_available_variant -%}
{%- assign commerce_ready = settings.pham_campaign_commerce_ready | default: false -%}
{%- assign include_lookbook = settings.pham_campaign_include_digital_lookbook | default: false -%}
{%- assign lookbook_ready = settings.pham_campaign_lookbook_ready | default: false -%}
{%- assign digital_delivery_ready = true -%}
{%- if include_lookbook and lookbook_ready == false -%}{%- assign digital_delivery_ready = false -%}{%- endif -%}
{%- if include_lookbook and lookbook_variant == blank -%}{%- assign digital_delivery_ready = false -%}{%- endif -%}
{%- assign identity_limit = settings.pham_campaign_identity_limit | default: 15 -%}
{%- assign identity_claimed = settings.pham_campaign_identity_claimed | default: 0 -%}
{%- assign identity_open = true -%}
{%- assign size_options_raw = settings.pham_campaign_size_options | default: 'M,L,XL,XXL' -%}
{%- assign size_options = size_options_raw | split: ',' -%}
{%- if identity_claimed >= identity_limit or identity_product == blank or identity_variant == blank or identity_variant.available == false -%}{%- assign identity_open = false -%}{%- endif -%}
{%- assign can_checkout = false -%}
{%- if commerce_ready and digital_delivery_ready and reservation_variant != blank -%}
  {%- if settings.pham_campaign_engine_enabled or state == 'reservation_open' -%}
    {%- assign can_checkout = true -%}
  {%- endif -%}
{%- endif -%}

<section class="pham-campaign-shell pham-reservation-commerce"
  data-pham-reservation-gateway
  data-commerce-ready="{% if commerce_ready %}true{% else %}false{% endif %}"
  data-can-checkout="{% if can_checkout %}true{% else %}false{% endif %}"
  data-reservation-variant-id="{{ reservation_variant.id }}"
  data-identity-variant-id="{{ identity_variant.id }}"
  data-lookbook-variant-id="{{ lookbook_variant.id }}"
  data-include-lookbook="{% if include_lookbook %}true{% else %}false{% endif %}"
  data-lookbook-ready="{% if digital_delivery_ready %}true{% else %}false{% endif %}"
  data-reservation-price-cents="{{ reservation_variant.price | default: 2499 }}"
  data-identity-price-cents="{{ identity_variant.price | default: 500 }}"
  data-currency="{{ cart.currency.iso_code | default: localization.country.currency.iso_code | default: 'USD' }}"
  data-edition="{{ settings.pham_campaign_edition_label | default: 'EDITION 01' | escape }}"
  data-product-code="{{ settings.pham_campaign_product_code | default: 'PHAM-001' | escape }}"
  data-edition-id="{{ settings.pham_campaign_edition_id | default: 'edition-01' | escape }}"
  data-engine-enabled="{% if settings.pham_campaign_engine_enabled %}true{% else %}false{% endif %}"
  data-engine-proxy="{{ settings.pham_campaign_engine_proxy_path | default: '/apps/pham-edition' | escape }}">

  <div class="pham-campaign-inner">
    <div class="pham-reservation-commerce__layout">
      <div class="pham-reservation-commerce__media">
        <div class="pham-reservation-commerce__image-frame">
          {%- if object_product != blank and object_product.featured_image != blank -%}
            <img
              src="{{ object_product.featured_image | image_url: width: 1200 }}"
              alt="{{ object_product.featured_image.alt | default: 'PHAM-001 Edition 01' | escape }}"
              width="{{ object_product.featured_image.width }}"
              height="{{ object_product.featured_image.height }}"
              loading="eager"
              data-pham-reservation-image>
          {%- else -%}
            <div class="pham-reservation-commerce__image-placeholder">PHAM-001</div>
          {%- endif -%}
        </div>

        {%- if object_product != blank and object_product.images.size > 1 -%}
          <div class="pham-reservation-commerce__thumbs" aria-label="PHAM-001 product images">
            {%- for image in object_product.images limit: 4 -%}
              <button type="button"
                class="{% if forloop.first %}is-active{% endif %}"
                data-pham-reservation-thumb
                data-image-src="{{ image | image_url: width: 1200 }}"
                aria-label="View PHAM-001 image {{ forloop.index }}">
                <img src="{{ image | image_url: width: 180 }}" alt="" width="90" height="110" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="pham-reservation-commerce__edition-note">
          <strong>50 NUMBERED JACKETS</strong>
        </div>
      </div>

      <div class="pham-reservation-commerce__buy">
        <header class="pham-reservation-commerce__head">
          <h1>Reserve <strong class="pham-funnel-emphasis">PHAM-001.</strong></h1>
          <div class="pham-reservation-commerce__price-row">
            <strong>{{ settings.pham_campaign_reservation_price | default: '$24.99' }}</strong>
            <span>DUE TODAY</span>
          </div>
          <p class="pham-reservation-commerce__credit">Your {{ settings.pham_campaign_reservation_price | default: '$24.99' }} deposit counts toward the {{ settings.pham_campaign_final_price | default: '$199.00' }} jacket price.</p>
          <p class="pham-reservation-commerce__balance">Pay <strong>{{ settings.pham_campaign_balance_due | default: '$174.01' }}</strong> within {{ settings.pham_campaign_payment_window_hours | default: 72 }} hours of the final-payment invitation. Shipping and taxes may apply.</p>
          {%- unless can_checkout -%}
            <span class="pham-reservation-commerce__launch-note">
              {% if state == 'reservation_full' %}RESERVATION FULL{% elsif commerce_ready == false %}RESERVATIONS OPEN AT LAUNCH{% elsif digital_delivery_ready == false %}RESERVATION PREPARING{% else %}RESERVATION NOT OPEN{% endif %}
            </span>
          {%- endunless -%}
        </header>


        <div class="pham-config-field pham-reservation-size">
          <div class="pham-reservation-size__head">
            <div>
                            <h3>Choose a size.</h3>
            </div>
            <span class="pham-reservation-size__status" data-pham-size-status>NOT SELECTED</span>
          </div>

          <select id="PhamReservationSize-{{ section.id }}" class="pham-reservation-size__native" data-pham-size-preference required aria-label="PHAM-001 size preference">
            <option value="">SELECT SIZE</option>
            {%- for option in size_options -%}
              {%- assign clean_option = option | strip -%}
              {%- if clean_option != blank -%}<option value="{{ clean_option | escape }}">{{ clean_option | escape }}</option>{%- endif -%}
            {%- endfor -%}
          </select>

          <div class="pham-reservation-size__choices" data-pham-size-choices role="radiogroup" aria-label="Select PHAM-001 size">
            <button type="button" data-pham-size-choice="M" role="radio" aria-checked="false"><strong>M</strong><span>98–101 CM</span></button>
            <button type="button" data-pham-size-choice="L" role="radio" aria-checked="false"><strong>L</strong><span>102–105 CM</span></button>
            <button type="button" data-pham-size-choice="XL" role="radio" aria-checked="false"><strong>XL</strong><span>106–109 CM</span></button>
            <button type="button" data-pham-size-choice="XXL" role="radio" aria-checked="false"><strong>XXL</strong><span>110–114 CM</span></button>
          </div>

          <div class="pham-reservation-size__help">

            <a href="{{ settings.pham_campaign_size_guide_page_url | default: '/pages/pham-001-size-guide' }}">Size guide</a>
          </div>
        </div>


        <div class="pham-reservation-commerce__addon">
          <label class="pham-reservation-upgrade__choice{% unless identity_open %} is-closed{% endunless %}">
            <span>
              <input type="checkbox" data-pham-identity-upgrade {% unless identity_open %}disabled{% endunless %}>
              <span>

                <strong>OBJECT IDENTITY</strong>
                <small>Stainless-steel collector card · inscription · preferred number request · QR Birth Record</small>
              </span>
            </span>
            <strong>+ {{ settings.pham_campaign_identity_price | default: '$5.00' }}</strong>
          </label>
          <span class="pham-reservation-commerce__availability">{% if identity_open %}{{ identity_limit | minus: identity_claimed }} OF {{ identity_limit }} AVAILABLE{% else %}CURRENTLY UNAVAILABLE{% endif %}</span>
        </div>


        <div class="pham-reservation-commerce__summary">
          <div class="pham-reservation-commerce__summary-head"><span>ORDER SUMMARY</span></div>
          <div class="pham-reservation-commerce__summary-row"><span>PHAM-001 jacket deposit</span><strong>{{ settings.pham_campaign_reservation_price | default: '$24.99' }}</strong></div>
          <div class="pham-reservation-commerce__summary-row" data-pham-identity-summary hidden><span>Object Identity</span><strong>+ {{ settings.pham_campaign_identity_price | default: '$5.00' }}</strong></div>
          <div class="pham-reservation-commerce__summary-row"><span>Collector Lookbook</span><strong>INCLUDED</strong></div>
          <div class="pham-reservation-commerce__summary-total"><span>DUE TODAY</span><strong data-pham-reservation-total>{{ settings.pham_campaign_reservation_price | default: '$24.99' }}</strong></div>
          <div class="pham-reservation-commerce__later"><span>Balance payable later</span><strong>{{ settings.pham_campaign_balance_due | default: '$174.01' }}</strong></div>
        </div>

        <div class="pham-campaign-consent pham-reservation-commerce__consent">
          <label><input type="checkbox" data-pham-required-consent> <span>I agree to the <a href="{{ settings.pham_campaign_terms_page_url | default: '/pages/edition-01-terms' }}">Edition Terms</a>, including the {{ settings.pham_campaign_payment_window_hours | default: 72 }}-hour final-payment window.</span></label>
          {%- if settings.pham_campaign_include_digital_lookbook -%}
            <label><input type="checkbox" data-pham-required-consent> <span>Deliver the included Collector Lookbook after payment.</span></label>
          {%- endif -%}
        </div>

        <div class="pham-reservation-commerce__checkout">
          {%- if can_checkout -%}
            <button type="button" class="pham-campaign-btn is-disabled" data-pham-reservation-submit aria-disabled="true" disabled>PLACE $24.99 DEPOSIT</button>
          {%- else -%}
            <span class="pham-campaign-btn" aria-disabled="true">{% if state == 'reservation_full' %}RESERVATION FULL{% elsif commerce_ready == false %}RESERVATIONS OPEN AT LAUNCH{% elsif digital_delivery_ready == false %}RESERVATION PREPARING{% else %}RESERVATION NOT OPEN{% endif %}</span>
          {%- endif -%}
        </div>
        <p class="pham-campaign-error" data-pham-reservation-error hidden role="alert"></p>
        <div class="pham-reservation-commerce__microcopy">
          <span>50 numbered jackets. No restock.</span>
          <a href="{{ settings.pham_campaign_terms_page_url | default: '/pages/edition-01-terms' }}">Edition Terms</a>
        </div>
      </div>
    </div>

    <section class="pham-reservation-commerce__below">

      <div class="pham-reservation-commerce__details">
        <h2 class="pham-reservation-details-title">Reservation details</h2>
        <details>
          <summary>HOW THE DEPOSIT WORKS <span>+</span></summary>
          <p>A confirmed {{ settings.pham_campaign_reservation_price | default: '$24.99' }} reservation holds an allocation while available and counts toward the {{ settings.pham_campaign_final_price | default: '$199.00' }} jacket. This is not an additional access fee. Full-payment checkout is not yet available.</p>
        </details>
        <details>
          <summary>FINAL PAYMENT &amp; SHIPPING <span>+</span></summary>
          <p>When acquisition opens, reserved collectors receive a final payment invitation. The remaining {{ settings.pham_campaign_balance_due | default: '$174.01' }} is due within {{ settings.pham_campaign_payment_window_hours | default: 72 }} hours. Shipping, duties and taxes may apply at final checkout.</p>
        </details>
        <details>
          <summary>OBJECT IDENTITY <span>+</span></summary>
          <p>The optional {{ settings.pham_campaign_identity_price | default: '$5.00' }} Object Identity add-on includes a custom stainless-steel card, inscription, preferred object-number request and QR Birth Record. Availability is limited to {{ identity_limit }} privileges.</p>
        </details>
        <details>
          <summary>COLLECTOR LOOKBOOK <span>+</span></summary>
          <p>The Collector Lookbook is included after confirmed payment. It may appear as a separate $0 line item for digital delivery.</p>
        </details>
      </div>
    </section>
  </div>
</section>

{% schema %}
{"name":"PHAM Reservation","tag":"section","settings":[],"presets":[{"name":"PHAM Reservation"}]}
{% endschema %}
