<!-- # DO NOT EDIT — managed by PHAM theme architecture -->
{%- liquid
  assign enable_parallax = section.settings.enable_parallax
-%}

<section class="pham-lookbook-v2{% if enable_parallax %} pham-lookbook-v2--parallax{% endif %}"
         data-pham-lookbook-v2
         data-section-id="{{ section.id }}"
         role="region"
         aria-label="{{ section.settings.title | default: 'Lookbook' | escape }}">
  <div class="pham-container">

    {%- comment -%} HEADER {%- endcomment -%}
    {%- if section.settings.eyebrow != blank or section.settings.title != blank or section.settings.intro != blank -%}
      <header class="pham-lookbook-v2__head reveal-up">
        {%- if section.settings.eyebrow != blank -%}
          <p class="pham-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="pham-lookbook-v2__title">
            <span class="pham-split" data-pham-split>{{ section.settings.title }}</span>
          </h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <p class="pham-lookbook-v2__intro">{{ section.settings.intro }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- comment -%} BLOCK GRID — bento layout {%- endcomment -%}
    <div class="pham-lookbook-v2__grid stagger-children" data-pham-cols="{{ section.settings.columns | default: 12 }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign size = block.settings.size | default: 'md'
          assign aspect = block.settings.aspect | default: '4-5'
          assign caption_pos = block.settings.caption_position | default: 'below'
          assign block_speed = block.settings.parallax_speed | default: 0.15
        -%}

        {%- case block.type -%}

          {%- when 'image' -%}
            {%- liquid
              assign autoplay_sec = block.settings.autoplay_seconds | default: 5
              assign autoplay_ms = autoplay_sec | times: 1000
              assign enable_lightbox = block.settings.enable_lightbox
              if enable_lightbox == nil
                assign enable_lightbox = true
              endif
              assign enable_carousel = block.settings.enable_carousel
              if enable_carousel == nil
                assign enable_carousel = true
              endif

              assign img_count = 0
              if block.settings.image != blank
                assign img_count = img_count | plus: 1
              endif
              if block.settings.image_2 != blank
                assign img_count = img_count | plus: 1
              endif
              if block.settings.image_3 != blank
                assign img_count = img_count | plus: 1
              endif
              if block.settings.image_4 != blank
                assign img_count = img_count | plus: 1
              endif
              if block.settings.image_5 != blank
                assign img_count = img_count | plus: 1
              endif

              assign use_carousel = false
              if enable_carousel and img_count > 1
                assign use_carousel = true
              endif

              assign alt_fallback = block.settings.caption | default: block.settings.overlay_text | default: shop.name
            -%}

            <figure class="pham-lookbook-v2__cell pham-lookbook-v2__cell--{{ size }} pham-lookbook-v2__cell--aspect-{{ aspect }} pham-lookbook-v2__cell--caption-{{ caption_pos }}{% if use_carousel %} pham-lookbook-v2__cell--carousel{% endif %}"
                    {{ block.shopify_attributes }}>
              <div class="pham-lookbook-v2__frame{% if use_carousel %} pham-lookbook-v2__frame--carousel{% endif %}"
                   {% unless use_carousel %}
                     data-pham-parallax
                     data-pham-parallax-speed="{{ block_speed }}"
                   {% endunless %}>

                {%- if use_carousel -%}
                  <div class="pham-lookbook-v2__carousel"
                       data-pham-lookbook-carousel
                       data-autoplay="{{ autoplay_ms }}"
                       tabindex="0"
                       role="region"
                       aria-label="{{ block.settings.overlay_text | default: block.settings.caption | default: 'Lookbook images' | escape }}">
                    <script type="application/json" data-pham-carousel-data>
                      [
                      {%- assign json_first = true -%}
                      {%- if block.settings.image != blank -%}
                        {%- unless json_first -%},{%- endunless -%}{%- assign json_first = false -%}
                        {%- capture ss1 -%}{{ block.settings.image | image_url: width: 768 }} 768w, {{ block.settings.image | image_url: width: 1200 }} 1200w, {{ block.settings.image | image_url: width: 1800 }} 1800w, {{ block.settings.image | image_url: width: 2400 }} 2400w{%- endcapture -%}
                        {"src":{{ block.settings.image | image_url: width: 2400 | json }},"srcset":{{ ss1 | strip | json }},"alt":{{ block.settings.image.alt | default: alt_fallback | json }}}
                      {%- endif -%}
                      {%- if block.settings.image_2 != blank -%}
                        {%- unless json_first -%},{%- endunless -%}{%- assign json_first = false -%}
                        {%- capture ss2 -%}{{ block.settings.image_2 | image_url: width: 768 }} 768w, {{ block.settings.image_2 | image_url: width: 1200 }} 1200w, {{ block.settings.image_2 | image_url: width: 1800 }} 1800w, {{ block.settings.image_2 | image_url: width: 2400 }} 2400w{%- endcapture -%}
                        {"src":{{ block.settings.image_2 | image_url: width: 2400 | json }},"srcset":{{ ss2 | strip | json }},"alt":{{ block.settings.image_2.alt | default: alt_fallback | json }}}
                      {%- endif -%}
                      {%- if block.settings.image_3 != blank -%}
                        {%- unless json_first -%},{%- endunless -%}{%- assign json_first = false -%}
                        {%- capture ss3 -%}{{ block.settings.image_3 | image_url: width: 768 }} 768w, {{ block.settings.image_3 | image_url: width: 1200 }} 1200w, {{ block.settings.image_3 | image_url: width: 1800 }} 1800w, {{ block.settings.image_3 | image_url: width: 2400 }} 2400w{%- endcapture -%}
                        {"src":{{ block.settings.image_3 | image_url: width: 2400 | json }},"srcset":{{ ss3 | strip | json }},"alt":{{ block.settings.image_3.alt | default: alt_fallback | json }}}
                      {%- endif -%}
                      {%- if block.settings.image_4 != blank -%}
                        {%- unless json_first -%},{%- endunless -%}{%- assign json_first = false -%}
                        {%- capture ss4 -%}{{ block.settings.image_4 | image_url: width: 768 }} 768w, {{ block.settings.image_4 | image_url: width: 1200 }} 1200w, {{ block.settings.image_4 | image_url: width: 1800 }} 1800w, {{ block.settings.image_4 | image_url: width: 2400 }} 2400w{%- endcapture -%}
                        {"src":{{ block.settings.image_4 | image_url: width: 2400 | json }},"srcset":{{ ss4 | strip | json }},"alt":{{ block.settings.image_4.alt | default: alt_fallback | json }}}
                      {%- endif -%}
                      {%- if block.settings.image_5 != blank -%}
                        {%- unless json_first -%},{%- endunless -%}{%- assign json_first = false -%}
                        {%- capture ss5 -%}{{ block.settings.image_5 | image_url: width: 768 }} 768w, {{ block.settings.image_5 | image_url: width: 1200 }} 1200w, {{ block.settings.image_5 | image_url: width: 1800 }} 1800w, {{ block.settings.image_5 | image_url: width: 2400 }} 2400w{%- endcapture -%}
                        {"src":{{ block.settings.image_5 | image_url: width: 2400 | json }},"srcset":{{ ss5 | strip | json }},"alt":{{ block.settings.image_5.alt | default: alt_fallback | json }}}
                      {%- endif -%}
                      ]
                    </script>

                    <div class="pham-lookbook-v2__carousel-track" data-pham-carousel-track>
                      {%- assign slide_idx = 0 -%}
                      {%- if block.settings.image != blank -%}
                        {% render 'pham-lookbook-slide', image: block.settings.image, index: slide_idx, alt_fallback: alt_fallback, enable_lightbox: enable_lightbox, loading: 'lazy' %}
                        {%- assign slide_idx = slide_idx | plus: 1 -%}
                      {%- endif -%}
                      {%- if block.settings.image_2 != blank -%}
                        {% render 'pham-lookbook-slide', image: block.settings.image_2, index: slide_idx, alt_fallback: alt_fallback, enable_lightbox: enable_lightbox %}
                        {%- assign slide_idx = slide_idx | plus: 1 -%}
                      {%- endif -%}
                      {%- if block.settings.image_3 != blank -%}
                        {% render 'pham-lookbook-slide', image: block.settings.image_3, index: slide_idx, alt_fallback: alt_fallback, enable_lightbox: enable_lightbox %}
                        {%- assign slide_idx = slide_idx | plus: 1 -%}
                      {%- endif -%}
                      {%- if block.settings.image_4 != blank -%}
                        {% render 'pham-lookbook-slide', image: block.settings.image_4, index: slide_idx, alt_fallback: alt_fallback, enable_lightbox: enable_lightbox %}
                        {%- assign slide_idx = slide_idx | plus: 1 -%}
                      {%- endif -%}
                      {%- if block.settings.image_5 != blank -%}
                        {% render 'pham-lookbook-slide', image: block.settings.image_5, index: slide_idx, alt_fallback: alt_fallback, enable_lightbox: enable_lightbox %}
                      {%- endif -%}
                    </div>

                    <button type="button"
                            class="pham-lookbook-v2__carousel-nav pham-lookbook-v2__carousel-nav--prev"
                            data-pham-carousel-prev
                            aria-label="Previous image">
                      <span aria-hidden="true">&lsaquo;</span>
                    </button>
                    <button type="button"
                            class="pham-lookbook-v2__carousel-nav pham-lookbook-v2__carousel-nav--next"
                            data-pham-carousel-next
                            aria-label="Next image">
                      <span aria-hidden="true">&rsaquo;</span>
                    </button>
                    <p class="pham-lookbook-v2__carousel-counter" aria-live="polite">
                      <span data-pham-carousel-current>1</span> / {{ img_count }}
                    </p>
                  </div>

                {%- elsif block.settings.image != blank -%}
                  {%- if enable_lightbox -%}
                    {%- capture single_srcset -%}{{ block.settings.image | image_url: width: 768 }} 768w, {{ block.settings.image | image_url: width: 1200 }} 1200w, {{ block.settings.image | image_url: width: 1800 }} 1800w, {{ block.settings.image | image_url: width: 2400 }} 2400w{%- endcapture -%}
                    <button type="button"
                            class="pham-lookbook-v2__carousel-open pham-lookbook-v2__carousel-open--solo"
                            data-pham-lookbook-open
                            data-pham-index="0"
                            data-pham-src="{{ block.settings.image | image_url: width: 2400 | escape }}"
                            data-pham-srcset="{{ single_srcset | strip | escape }}"
                            data-pham-alt="{{ block.settings.image.alt | default: alt_fallback | escape }}"
                            aria-label="View image full screen">
                      {{ block.settings.image
                          | image_url: width: 1800
                          | image_tag:
                            loading: 'lazy',
                            widths: '480, 768, 1080, 1440, 1800',
                            sizes: '(max-width: 900px) 100vw, 50vw',
                            class: 'pham-lookbook-v2__img',
                            alt: block.settings.image.alt | default: alt_fallback
                      }}
                    </button>
                  {%- else -%}
                    {{ block.settings.image
                        | image_url: width: 1800
                        | image_tag:
                          loading: 'lazy',
                          widths: '480, 768, 1080, 1440, 1800',
                          sizes: '(max-width: 900px) 100vw, 50vw',
                          class: 'pham-lookbook-v2__img',
                          alt: block.settings.image.alt | default: alt_fallback
                    }}
                  {%- endif -%}
                {%- else -%}
                  <div class="pham-lookbook-v2__img pham-skeleton" aria-hidden="true"></div>
                {%- endif -%}

                {%- if block.settings.overlay_text != blank -%}
                  <div class="pham-lookbook-v2__overlay">
                    <span class="pham-eyebrow pham-lookbook-v2__overlay-tag">{{ block.settings.overlay_eyebrow | default: 'LOOK' }}</span>
                    <span class="pham-lookbook-v2__overlay-text">{{ block.settings.overlay_text }}</span>
                  </div>
                {%- endif -%}
              </div>
              {%- if block.settings.caption != blank -%}
                <figcaption class="pham-lookbook-v2__caption">
                  <span class="pham-lookbook-v2__caption-mark" aria-hidden="true">▢</span>
                  <span>{{ block.settings.caption }}</span>
                </figcaption>
              {%- endif -%}
            </figure>

          {%- when 'editorial' -%}
            <div class="pham-lookbook-v2__cell pham-lookbook-v2__cell--{{ size }} pham-lookbook-v2__cell--editorial" {{ block.shopify_attributes }}>
              <div class="pham-lookbook-v2__editorial">
                {%- if block.settings.eyebrow != blank -%}
                  <p class="pham-eyebrow">{{ block.settings.eyebrow }}</p>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="pham-lookbook-v2__editorial-heading">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <div class="pham-lookbook-v2__editorial-body rte">{{ block.settings.body }}</div>
                {%- endif -%}
                {%- if block.settings.cta_label != blank -%}
                  <a href="{{ block.settings.cta_link | default: '#' }}" class="pham-back-link pham-lookbook-v2__editorial-cta">
                    <span class="pham-back-link__label">{{ block.settings.cta_label }}</span>
                    <span class="pham-back-link__arrow" aria-hidden="true">&rarr;</span>
                  </a>
                {%- endif -%}
              </div>
            </div>

          {%- when 'quote' -%}
            <blockquote class="pham-lookbook-v2__cell pham-lookbook-v2__cell--{{ size }} pham-lookbook-v2__cell--quote" {{ block.shopify_attributes }}>
              <p class="pham-lookbook-v2__quote-mark" aria-hidden="true">"</p>
              <p class="pham-lookbook-v2__quote-body">{{ block.settings.body }}</p>
              {%- if block.settings.author != blank -%}
                <footer class="pham-lookbook-v2__quote-cite">
                  <span class="pham-eyebrow">{{ block.settings.author_role | default: 'PHAM ATELIER' }}</span>
                  <span class="pham-lookbook-v2__quote-author">{{ block.settings.author }}</span>
                </footer>
              {%- endif -%}
            </blockquote>

          {%- when 'spec' -%}
            <dl class="pham-lookbook-v2__cell pham-lookbook-v2__cell--{{ size }} pham-lookbook-v2__cell--spec" {{ block.shopify_attributes }}>
              {%- if block.settings.label_1 != blank -%}
                <div class="pham-lookbook-v2__spec-row">
                  <dt class="pham-eyebrow">{{ block.settings.label_1 }}</dt>
                  <dd>{{ block.settings.value_1 }}</dd>
                </div>
              {%- endif -%}
              {%- if block.settings.label_2 != blank -%}
                <div class="pham-lookbook-v2__spec-row">
                  <dt class="pham-eyebrow">{{ block.settings.label_2 }}</dt>
                  <dd>{{ block.settings.value_2 }}</dd>
                </div>
              {%- endif -%}
              {%- if block.settings.label_3 != blank -%}
                <div class="pham-lookbook-v2__spec-row">
                  <dt class="pham-eyebrow">{{ block.settings.label_3 }}</dt>
                  <dd>{{ block.settings.value_3 }}</dd>
                </div>
              {%- endif -%}
              {%- if block.settings.label_4 != blank -%}
                <div class="pham-lookbook-v2__spec-row">
                  <dt class="pham-eyebrow">{{ block.settings.label_4 }}</dt>
                  <dd>{{ block.settings.value_4 }}</dd>
                </div>
              {%- endif -%}
            </dl>

        {%- endcase -%}
      {%- endfor -%}
    </div>

  </div>

  {%- comment -%} Full-screen lightbox (moved to body by JS) {%- endcomment -%}
  <div class="pham-lookbook-v2__lightbox"
       data-pham-lookbook-lightbox
       role="dialog"
       aria-modal="true"
       aria-hidden="true"
       aria-label="Lookbook image viewer"
       hidden>
    <button type="button"
            class="pham-lookbook-v2__lightbox-backdrop"
            data-pham-lightbox-close
            data-pham-lightbox-backdrop
            aria-label="Close viewer"></button>

    <div class="pham-lookbook-v2__lightbox-toolbar">
      <span class="pham-lookbook-v2__lightbox-counter" data-pham-lightbox-counter hidden></span>
      <button type="button"
              class="pham-lookbook-v2__lightbox-btn pham-lookbook-v2__lightbox-close"
              data-pham-lightbox-close
              aria-label="Close viewer">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
          <line x1="3" y1="3" x2="15" y2="15" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          <line x1="15" y1="3" x2="3" y2="15" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div class="pham-lookbook-v2__lightbox-body" data-pham-lightbox-stage>
      <button type="button"
              class="pham-lookbook-v2__lightbox-nav pham-lookbook-v2__lightbox-nav--prev"
              data-pham-lightbox-prev
              aria-label="Previous image">
        <span aria-hidden="true">&lsaquo;</span>
      </button>

      <div class="pham-lookbook-v2__lightbox-viewport" data-pham-lightbox-viewport>
        <div class="pham-lookbook-v2__lightbox-canvas" data-pham-lightbox-canvas>
          <img class="pham-lookbook-v2__lightbox-img"
               data-pham-lightbox-img
               alt=""
               width="1600"
               height="2000"
               decoding="async"
               draggable="false">
        </div>
      </div>

      <button type="button"
              class="pham-lookbook-v2__lightbox-nav pham-lookbook-v2__lightbox-nav--next"
              data-pham-lightbox-next
              aria-label="Next image">
        <span aria-hidden="true">&rsaquo;</span>
      </button>
    </div>
  </div>
</section>

<script src="{{ 'pham-lookbook.js' | asset_url }}" defer></script>

<style>
  .pham-lookbook-v2 {
    background-color: var(--color-void);
    color: var(--color-bone);
    padding-block: clamp(56px, 6vw, 96px);
    overflow: hidden;
  }
  .pham-lookbook-v2__head {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(260px, .65fr);
    grid-template-rows: auto auto;
    align-items: end;
    gap: clamp(14px, 1.4vw, 20px) clamp(32px, 6vw, 88px);
    margin-bottom: clamp(34px, 4.5vw, 56px);
    padding-top: clamp(18px, 2.2vw, 30px);
    border-top: 1px solid rgba(255,255,255,.14);
    max-width: none;
  }
  .pham-lookbook-v2__head .pham-eyebrow {
    grid-column: 1 / -1;
  }
  .pham-lookbook-v2__title {
    grid-column: 1;
    grid-row: 2;
  }
  .pham-lookbook-v2__intro {
    grid-column: 2;
    grid-row: 2;
    align-self: end;
  }
  .pham-lookbook-v2__title {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-tech);
    font-size: clamp(2.1rem, 4vw, 3.75rem);
    line-height: 1.04;
    color: var(--color-bone);
    margin: 0;
    overflow: hidden;
  }
  .pham-lookbook-v2__intro {
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: 1.7;
    color: var(--color-bone-80);
    max-width: 34ch;
    margin: 0;
  }
  .pham-lookbook-v2__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-flow: dense;
    gap: clamp(10px, 1.35vw, 18px);
    align-items: stretch;
  }
  .pham-lookbook-v2__cell { position: relative; min-width: 0; margin: 0; }
  .pham-lookbook-v2__cell--xs { grid-column: span 3; }
  .pham-lookbook-v2__cell--sm { grid-column: span 4; }
  .pham-lookbook-v2__cell--md { grid-column: span 6; }
  .pham-lookbook-v2__cell--lg { grid-column: span 8; }
  .pham-lookbook-v2__cell--xl { grid-column: span 12; }

  .pham-lookbook-v2__cell--lg:not(.pham-lookbook-v2__cell--editorial) { grid-column: span 7; }
  .pham-lookbook-v2__cell--spec.pham-lookbook-v2__cell--sm,
  .pham-lookbook-v2__cell--quote.pham-lookbook-v2__cell--sm { grid-column: span 5; }
  .pham-lookbook-v2__cell--editorial.pham-lookbook-v2__cell--xl { grid-column: span 7; }


  .pham-lookbook-v2__frame {
    position: relative;
    overflow: hidden;
    background-color: var(--color-obsidian);
    border: 1px solid var(--color-ash);
    isolation: isolate;
  }
  .pham-lookbook-v2__cell--aspect-1-1   .pham-lookbook-v2__frame { aspect-ratio: 1/1; }
  .pham-lookbook-v2__cell--aspect-3-4   .pham-lookbook-v2__frame { aspect-ratio: 3/4; }
  .pham-lookbook-v2__cell--aspect-4-5   .pham-lookbook-v2__frame { aspect-ratio: 4/5; }
  .pham-lookbook-v2__cell--aspect-16-9  .pham-lookbook-v2__frame { aspect-ratio: 16/9; }
  .pham-lookbook-v2__cell--aspect-2-3   .pham-lookbook-v2__frame { aspect-ratio: 2/3; }
  .pham-lookbook-v2__cell--aspect-9-16  .pham-lookbook-v2__frame { aspect-ratio: 9/16; }
  .pham-lookbook-v2__cell--aspect-21-9  .pham-lookbook-v2__frame { aspect-ratio: 21/9; }

  @media (min-width: 901px) {
    .pham-lookbook-v2__frame {
      max-height: min(64svh, 640px);
    }
    .pham-lookbook-v2__frame--carousel,
    .pham-lookbook-v2__cell--aspect-1-1 .pham-lookbook-v2__frame,
    .pham-lookbook-v2__cell--aspect-3-4 .pham-lookbook-v2__frame,
    .pham-lookbook-v2__cell--aspect-4-5 .pham-lookbook-v2__frame,
    .pham-lookbook-v2__cell--aspect-16-9 .pham-lookbook-v2__frame,
    .pham-lookbook-v2__cell--aspect-2-3 .pham-lookbook-v2__frame,
    .pham-lookbook-v2__cell--aspect-9-16 .pham-lookbook-v2__frame,
    .pham-lookbook-v2__cell--aspect-21-9 .pham-lookbook-v2__frame {
      height: min(64svh, 640px);
      aspect-ratio: auto;
    }
  }

  .pham-lookbook-v2__img {
    position: absolute;
    inset: -8% -2%;
    width: 104%;
    height: 116%;
    object-fit: cover;
    object-position: center;
    display: block;
    will-change: transform;
    transform: translate3d(0, var(--pham-parallax-y, 0), 0);
    transition: filter var(--duration-base) var(--ease-tech);
  }
  .pham-lookbook-v2__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
    background-image:
      linear-gradient(to right,  rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-tech);
  }
  .pham-lookbook-v2__cell:hover .pham-lookbook-v2__frame::after { opacity: 1; }
  .pham-lookbook-v2__cell:hover .pham-lookbook-v2__img { filter: contrast(1.05) brightness(1.02); }

  /* Carousel frame */
  .pham-lookbook-v2__frame--carousel {
    display: block;
    overflow: hidden;
  }
  .pham-lookbook-v2__carousel {
    position: absolute;
    inset: 0;
    z-index: 1;
    outline: none;
  }
  .pham-lookbook-v2__carousel-track {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .pham-lookbook-v2__carousel-slide {
