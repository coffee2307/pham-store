<!-- # DO NOT EDIT — managed by PHAM theme architecture -->
<section class="pham-about"
         data-pham-about
         role="region"
         aria-labelledby="pham-about-heading-{{ section.id }}">
  <div class="pham-about__grid" aria-hidden="true"></div>
  <div class="pham-container pham-about__inner">
    <header class="pham-about__head reveal-up">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pham-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 id="pham-about-heading-{{ section.id }}" class="pham-about__title">
        <span class="pham-about__title-line">{{ section.settings.title_line_1 | default: 'PHAM' }}</span>
        <span class="pham-about__title-line">{{ section.settings.title_line_2 | default: 'MANIFESTO' }}</span>
      </h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="pham-about__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </header>

    <div class="pham-about__body reveal-up">
      {%- if section.settings.paragraph_1 != blank -%}
        <p class="pham-about__paragraph">{{ section.settings.paragraph_1 }}</p>
      {%- endif -%}
      {%- if section.settings.paragraph_2 != blank -%}
        <p class="pham-about__paragraph">{{ section.settings.paragraph_2 }}</p>
      {%- endif -%}
      {%- if section.settings.closing_line != blank -%}
        <p class="pham-about__closing">{{ section.settings.closing_line }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ol class="pham-about__principles" role="list">
        {%- for block in section.blocks -%}
          <li class="pham-about__principle reveal-up" {{ block.shopify_attributes }}>
            <span class="pham-about__principle-index">0{{ forloop.index }}</span>
            <h2>{{ block.settings.title }}</h2>
            <p>{{ block.settings.body }}</p>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    <section class="pham-about__record reveal-up" aria-label="PHAM founder and edition record">
      <div class="pham-about__record-block">
        <p class="pham-eyebrow">{{ section.settings.founder_eyebrow }}</p>
        <h2 class="pham-about__record-title">{{ section.settings.founder_title }}</h2>
        <p class="pham-about__record-copy">{{ section.settings.founder_body }}</p>
      </div>

      <div class="pham-about__record-block">
        <p class="pham-eyebrow">{{ section.settings.edition_eyebrow }}</p>
        <h2 class="pham-about__record-title">{{ section.settings.edition_title }}</h2>
        <p class="pham-about__record-copy">{{ section.settings.edition_body }}</p>
      </div>

      <div class="pham-about__edition-note">
        <span>{{ section.settings.edition_note_label }}</span>
        <strong>{{ section.settings.edition_note_value }}</strong>
      </div>
    </section>

    <aside class="pham-about__origin reveal-up">
      <p>{{ section.settings.origin_eyebrow }}</p>
      <div>
        <span>{{ section.settings.origin_label }}</span>
        <strong>{{ section.settings.origin_value }}</strong>
      </div>
      <div>
        <span>{{ section.settings.release_label }}</span>
        <strong>{{ section.settings.release_value }}</strong>
      </div>
    </aside>

    {%- if section.settings.show_back_link -%}
      <p class="pham-about__back reveal-up">
        <a href="{{ routes.root_url }}" class="pham-back-link pham-about__back-link">
          <span class="pham-back-link__arrow" aria-hidden="true">&larr;</span>
          <span class="pham-back-link__label">RETURN TO ATELIER</span>
        </a>
      </p>
    {%- endif -%}
  </div>
</section>

<style>
  .pham-about-section,
  .pham-about {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-x: clip;
  }
  .pham-about {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background-color: var(--color-void);
    color: var(--color-bone);
    padding-block: clamp(110px, 14vw, 190px) clamp(72px, 10vw, 140px);
  }
  .pham-about__grid { position: absolute; z-index: -1; inset: 0; background: linear-gradient(rgba(255,255,255,.027) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.027) 1px, transparent 1px); background-size: 72px 72px; mask-image: linear-gradient(to bottom, #000, transparent 86%); }
  .pham-about__inner {
    width: 100%;
    max-width: min(1240px, 100%);
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr);
    column-gap: clamp(32px, 7vw, 96px);
    overflow-x: clip;
  }
  .pham-about__inner > *,
  .pham-about__head,
  .pham-about__body,
  .pham-about__principles,
  .pham-about__principle,
  .pham-about__record,
  .pham-about__record-block,
  .pham-about__edition-note,
  .pham-about__origin,
  .pham-about__origin > * {
    min-width: 0;
    max-width: 100%;
  }
  .pham-about__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    grid-column: 1 / -1;
    max-width: 980px;
    margin-bottom: clamp(58px, 8vw, 110px);
  }
  .pham-about__title {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.08em;
    font-family: var(--font-display);
    font-size: clamp(4rem, 11vw, 10rem);
    font-weight: 300;
    letter-spacing: -.045em;
    text-transform: uppercase;
    line-height: .84;
    color: var(--color-bone);
  }
  .pham-about__title-line {
    display: block;
    max-width: 100%;
    overflow-wrap: normal;
    word-break: normal;
  }
  .pham-about__subtitle {
    margin: 30px 0 0;
    max-width: 620px;
    font-family: var(--font-mono);
    font-style: normal;
    font-size: clamp(.72rem, 1vw, .9rem);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--color-smoke);
  }
  .pham-about__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-width: 62ch;
    align-self: start;
  }
  .pham-about__paragraph {
    margin: 0;
    font-size: clamp(1rem, 1.35vw, 1.25rem);
    line-height: 1.8;
    color: var(--color-bone-80);
  }
  .pham-about__closing {
    margin: var(--space-sm) 0 0;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-ash);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.8rem);
    font-weight: 300;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.5;
    color: var(--color-white);
    max-width: 24ch;
  }
  .pham-about__principles { display: grid; align-self: start; gap: 0; margin: 0; padding: 0; border-top: 1px solid rgba(255,255,255,.22); list-style: none; }
  .pham-about__principle { display: grid; grid-template-columns: 44px 1fr; gap: 6px 18px; padding: 20px 0; border-bottom: 1px solid rgba(255,255,255,.14); }
  .pham-about__principle-index { grid-row: 1 / 3; color: rgba(242,242,239,.42); font: 400 9px/1.4 var(--font-mono); }
  .pham-about__principle h2 { margin: 0; color: var(--color-bone); font: 400 1rem/1.2 var(--font-display); letter-spacing: .04em; text-transform: uppercase; }
  .pham-about__principle p { margin: 0; color: var(--color-bone-60); font: 400 .84rem/1.6 var(--font-body); }
  .pham-about__record {
    grid-column: 1 / -1;
    margin-top: clamp(72px, 9vw, 120px);
    padding-top: clamp(36px, 5vw, 64px);
    border-top: 1px solid rgba(255,255,255,.18);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(36px, 7vw, 96px);
  }
  .pham-about__record-block {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 56ch;
  }
  .pham-about__record-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.7vw, 2.3rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: .03em;
    text-transform: uppercase;
    color: var(--color-white);
    text-wrap: balance;
  }
  .pham-about__record-copy {
    margin: 0;
    max-width: 100%;
    overflow-wrap: break-word;
    word-break: normal;
    font-family: var(--font-body);
    font-size: clamp(.96rem, 1.15vw, 1.1rem);
    line-height: 1.8;
    color: var(--color-bone-60);
  }
  .pham-about__edition-note {
    grid-column: 1 / -1;
    margin-top: clamp(8px, 2vw, 18px);
    padding-block: 18px;
    border-top: 1px solid rgba(255,255,255,.12);
    border-bottom: 1px solid rgba(255,255,255,.12);
    display: flex;
    justify-content: space-between;
    gap: 24px;
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .pham-about__edition-note span { color: rgba(242,242,239,.4); }
  .pham-about__edition-note strong { color: rgba(242,242,239,.9); font-weight: 400; text-align: right; }
  .pham-about__origin { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr repeat(2, minmax(180px, .45fr)); gap: 24px; margin-top: clamp(70px, 10vw, 130px); padding-block: 22px; border-top: 1px solid rgba(255,255,255,.2); border-bottom: 1px solid rgba(255,255,255,.12); }
  .pham-about__origin p,.pham-about__origin span,.pham-about__origin strong { margin: 0; font: 400 9px/1.45 var(--font-mono); letter-spacing: .08em; }
  .pham-about__origin p,.pham-about__origin span { color: rgba(242,242,239,.44); }
  .pham-about__origin div { display: grid; gap: 6px; }
  .pham-about__origin strong {
    min-width: 0;
    max-width: 100%;
    color: rgba(242,242,239,.9);
    overflow-wrap: anywhere;
  }
  .pham-about__back {
    grid-column: 1 / -1;
    margin: var(--space-2xl) 0 0;
  }
  @media (max-width: 899px) {
    .pham-about__inner {
      grid-template-columns: minmax(0, 1fr);
      column-gap: 0;
    }
    .pham-about__head,
    .pham-about__body,
    .pham-about__record,
    .pham-about__origin { min-width: 0; }
    .pham-about__record { grid-template-columns: minmax(0, 1fr); }
    .pham-about__edition-note { grid-column: auto; }
    .pham-about__body { margin-bottom: 60px; }
    .pham-about__origin { grid-template-columns: 1fr 1fr; }
    .pham-about__origin > p { grid-column: 1 / -1; }
  }
  @media (max-width: 599px) {
    .pham-about { padding-block: 96px 72px; }
    .pham-about__title {
      font-size: clamp(2.85rem, 15.8vw, 4.8rem);
      letter-spacing: -.055em;
    }
    .pham-about__title-line { max-width: 100%; }
    .pham-about__title-line:last-child { font-size: .82em; }
    .pham-about__head { margin-bottom: 48px; }
    .pham-about__paragraph { font-size: .96rem; }
    .pham-about__record { gap: 40px; margin-top: 64px; padding-top: 32px; }
    .pham-about__edition-note { display: grid; gap: 8px; }
    .pham-about__edition-note strong { text-align: left; }
    .pham-about__origin { grid-template-columns: 1fr; }
    .pham-about__origin > p { grid-column: auto; }
  }
</style>

{% schema %}
{
  "name": "PHAM About",
  "tag": "section",
  "class": "pham-about-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "PHAM · ATELIER"
    },
    {
      "type": "text",
      "id": "title_line_1",
      "label": "Title line 1",
      "default": "PHAM"
    },
    {
      "type": "text",
      "id": "title_line_2",
      "label": "Title line 2",
      "default": "MANIFESTO"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "THE PURE PURSUIT"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1",
      "default": "PHAM stands for Profound Human Authentic Mastery. Founded in Vietnam in 2026, PHAM is an independent fashion label operating as PHAM Atelier. The label develops edition-based garments and design objects around restraint, proportion, construction and controlled detail."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2",
      "default": "Each PHAM Atelier object is developed as a focused edition rather than a seasonal volume exercise. From silhouette and material selection to sampling and final production, decisions are kept deliberate and traceable so the finished garment remains coherent with the original intent."
    },
    {
      "type": "textarea",
      "id": "closing_line",
      "label": "Closing line",
      "default": "Not louder. More deliberate."
    },
    {
      "type": "header",
      "content": "Founder story"
    },
    {
      "type": "text",
      "id": "founder_eyebrow",
      "label": "Founder eyebrow",
      "default": "FOUNDER / COFFEE PHAM"
    },
    {
      "type": "text",
      "id": "founder_title",
      "label": "Founder title",
      "default": "BUILT FROM INTENT, NOT VOLUME"
    },
    {
      "type": "textarea",
      "id": "founder_body",
      "label": "Founder story",
      "default": "PHAM was founded in Vietnam in 2026 by Coffee Pham as an independent atelier built around a simple refusal: not to release an object before its form, proportion and details feel resolved. The studio does not work from a conventional seasonal calendar. Each release begins with one object, developed slowly enough for the construction, material and identity to remain coherent from first sketch to final production."
    },
    {
      "type": "header",
      "content": "Edition system"
    },
    {
      "type": "text",
      "id": "edition_eyebrow",
      "label": "Edition eyebrow",
      "default": "EDITION SYSTEM / NO RESTOCK"
    },
    {
      "type": "text",
      "id": "edition_title",
      "label": "Edition title",
      "default": "RELEASED ONCE. RECORDED INDIVIDUALLY."
    },
    {
      "type": "textarea",
      "id": "edition_body",
      "label": "Edition story",
      "default": "PHAM editions open within a defined release window and are not reproduced once that edition closes. Every finished piece is treated as an individual object, accompanied by its own identity card and edition identifier. PHAM-001 begins this system with a planned run of 50 cropped bomber jackets. Each jacket is paired with an exclusive appreciation necklace: 49 feature a silver-finished stainless-steel pendant, while one pendant is finished in gold. The distinction is not announced in advance; it belongs to the object and the person who receives it."
    },
    {
      "type": "text",
      "id": "edition_note_label",
      "label": "Edition note label",
      "default": "EDITION 01 / PHAM-001"
    },
    {
      "type": "text",
      "id": "edition_note_value",
      "label": "Edition note value",
      "default": "50 OBJECTS · 50 IDENTITIES · NO RESTOCK"
    },
    {
      "type": "text",
      "id": "origin_eyebrow",
      "label": "Origin eyebrow",
      "default": "PHAM ATELIER / RECORD"
    },
    {
      "type": "text",
      "id": "origin_label",
      "label": "Origin label",
      "default": "ORIGIN"
    },
    {
      "type": "text",
      "id": "origin_value",
      "label": "Origin value",
      "default": "VIETNAM / PHAM ATELIER"
    },
    {
      "type": "text",
      "id": "release_label",
      "label": "Release label",
      "default": "FIRST OBJECT"
    },
    {
      "type": "text",
      "id": "release_value",
      "label": "Release value",
      "default": "PHAM-001 / 2026"
    },
    {
      "type": "checkbox",
      "id": "show_back_link",
      "label": "Show return-to-home link",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "principle",
      "name": "Principle",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "FORM BEFORE NOISE" },
        { "type": "textarea", "id": "body", "label": "Text", "default": "Every line must carry purpose before it carries attention." }
      ]
    }
  ],
  "presets": [
    {
      "name": "PHAM About",
      "category": "PHAM",
      "blocks": [
        { "type": "principle" },
        { "type": "principle" },
        { "type": "principle" },
        { "type": "principle" }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}
