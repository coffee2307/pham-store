<!-- # DO NOT EDIT — managed by PHAM theme architecture -->
<section class="pham-about"
         data-pham-about
         role="region"
         aria-labelledby="pham-about-heading-{{ section.id }}">
  <div class="pham-about__grid" aria-hidden="true"></div>
  <div class="pham-container pham-about__inner">
    <header class="pham-about__head reveal-up">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pham-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 id="pham-about-heading-{{ section.id }}" class="pham-about__title">
        <span class="pham-about__title-line">{{ section.settings.title_line_1 | default: 'PHAM' }}</span>
        <span class="pham-about__title-line">{{ section.settings.title_line_2 | default: 'MANIFESTO' }}</span>
      </h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="pham-about__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </header>

    <div class="pham-about__body reveal-up">
      {%- if section.settings.paragraph_1 != blank -%}
        <p class="pham-about__paragraph">{{ section.settings.paragraph_1 }}</p>
      {%- endif -%}
      {%- if section.settings.paragraph_2 != blank -%}
        <p class="pham-about__paragraph">{{ section.settings.paragraph_2 }}</p>
      {%- endif -%}
      {%- if section.settings.closing_line != blank -%}
        <p class="pham-about__closing">{{ section.settings.closing_line }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ol class="pham-about__principles" role="list">
        {%- for block in section.blocks -%}
          <li class="pham-about__principle reveal-up" {{ block.shopify_attributes }}>
            <span class="pham-about__principle-index">0{{ forloop.index }}</span>
            <h2>{{ block.settings.title }}</h2>
            <p>{{ block.settings.body }}</p>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    <section class="pham-about__record reveal-up" aria-label="PHAM founder and edition record">
      <div class="pham-about__record-block pham-about__record-block--founder">
        <dl class="pham-about__founder-facts" aria-label="Founder details">
          <div><dt>FOUNDER</dt><dd>Coffee Pham</dd></div>
          <div><dt>ESTABLISHED</dt><dd>2026 · Vietnam</dd></div>
          <div><dt>AT THE BEGINNING</dt><dd>Age 16 · High school student</dd></div>
          <div><dt>MODEL</dt><dd>Independent · Edition-based</dd></div>
        </dl>
        <div class="pham-about__founder-narrative">
          <p class="pham-eyebrow">{{ section.settings.founder_eyebrow }}</p>
          <h2 class="pham-about__record-title">{{ section.settings.founder_title }}</h2>
          <p class="pham-about__record-copy">{{ section.settings.founder_body }}</p>
          {%- if section.settings.founder_body_2 != blank -%}
            <p class="pham-about__record-copy">{{ section.settings.founder_body_2 }}</p>
          {%- endif -%}
          {%- if section.settings.founder_body_3 != blank -%}
            <p class="pham-about__record-copy">{{ section.settings.founder_body_3 }}</p>
          {%- endif -%}
          <a class="pham-about__founder-story-link" href="/pages/founder-story">
            <span>READ THE FOUNDER'S STORY</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="pham-about__record-block pham-about__record-block--edition">
        <div class="pham-about__edition-heading">
          <p class="pham-eyebrow">{{ section.settings.edition_eyebrow }}</p>
          <h2 class="pham-about__record-title">{{ section.settings.edition_title }}</h2>
        </div>
        <div class="pham-about__edition-copy">
          <p class="pham-about__record-copy">{{ section.settings.edition_body }}</p>
          {%- if section.settings.edition_body_2 != blank -%}
            <p class="pham-about__record-copy">{{ section.settings.edition_body_2 }}</p>
          {%- endif -%}
          {%- if section.settings.edition_body_3 != blank -%}
            <p class="pham-about__record-copy">{{ section.settings.edition_body_3 }}</p>
          {%- endif -%}
        </div>
      </div>

      <div class="pham-about__edition-note">
        <span>{{ section.settings.edition_note_label }}</span>
        <strong>{{ section.settings.edition_note_value }}</strong>
      </div>
      <nav class="pham-about__resources" aria-label="Learn more about PHAM-001">
        <a href="/products/pham-001">
          <strong>EXPLORE PHAM-001</strong>
          <span>Design, specification and current availability</span>
          <span aria-hidden="true">→</span>
        </a>
        <a href="/pages/pham-001-size-guide">
          <strong>SIZE GUIDE</strong>
          <span>Garment measurements and fit guidance</span>
          <span aria-hidden="true">→</span>
        </a>
        <a href="/pages/edition-01">
          <strong>EDITION DETAILS</strong>
          <span>Release format and edition information</span>
          <span aria-hidden="true">→</span>
        </a>
      </nav>
    </section>

    <aside class="pham-about__origin reveal-up">
      <p>{{ section.settings.origin_eyebrow }}</p>
      <div>
        <span>{{ section.settings.origin_label }}</span>
        <strong>{{ section.settings.origin_value }}</strong>
      </div>
      <div>
        <span>{{ section.settings.release_label }}</span>
        <strong>{{ section.settings.release_value }}</strong>
      </div>
    </aside>

    {%- if section.settings.show_back_link -%}
      <p class="pham-about__back reveal-up">
        <a href="{{ routes.root_url }}" class="pham-back-link pham-about__back-link">

          <span class="pham-back-link__label">RETURN TO ATELIER</span>
</a>
      </p>
    {%- endif -%}
  </div>
</section>

<style>
  .pham-about-section,
  .pham-about {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-x: clip;
  }
  .pham-about {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background-color: var(--color-void);
    color: var(--color-bone);
    padding-block: clamp(110px, 14vw, 190px) clamp(72px, 10vw, 140px);
  }
  .pham-about__grid { position: absolute; z-index: -1; inset: 0; background: linear-gradient(rgba(255,255,255,.027) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.027) 1px, transparent 1px); background-size: 72px 72px; mask-image: linear-gradient(to bottom, #000, transparent 86%); }
  .pham-about__inner {
    width: 100%;
    max-width: min(1240px, 100%);
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr);
    column-gap: clamp(32px, 7vw, 96px);
    overflow-x: clip;
  }
  .pham-about__inner > *,
  .pham-about__head,
  .pham-about__body,
  .pham-about__principles,
  .pham-about__principle,
  .pham-about__record,
  .pham-about__record-block,
  .pham-about__edition-note,
  .pham-about__origin,
  .pham-about__origin > * {
    min-width: 0;
    max-width: 100%;
  }
  .pham-about__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    grid-column: 1 / -1;
    max-width: 980px;
    margin-bottom: clamp(58px, 8vw, 110px);
  }
  .pham-about__title {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.08em;
    font-family: var(--font-display);
    font-size: clamp(4rem, 11vw, 10rem);
    font-weight: 300;
    letter-spacing: -.045em;
    text-transform: uppercase;
    line-height: .84;
    color: var(--color-bone);
  }
  .pham-about__title-line {
    display: block;
    max-width: 100%;
    overflow-wrap: normal;
    word-break: normal;
  }
  .pham-about__subtitle {
    margin: 30px 0 0;
    max-width: 620px;
    font-family: var(--font-mono);
    font-style: normal;
    font-size: clamp(.72rem, 1vw, .9rem);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--color-smoke);
  }
  .pham-about__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-width: 62ch;
    align-self: start;
  }
  .pham-about__paragraph {
    margin: 0;
    font-size: clamp(1rem, 1.35vw, 1.25rem);
    line-height: 1.8;
    color: var(--color-bone-80);
  }
  .pham-about__closing {
    margin: var(--space-sm) 0 0;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-ash);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.8rem);
    font-weight: 300;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.5;
    color: var(--color-white);
    max-width: 24ch;
  }
  .pham-about__principles { display: grid; align-self: start; gap: 0; margin: 0; padding: 0; border-top: 1px solid rgba(255,255,255,.22); list-style: none; }
  .pham-about__principle { display: grid; grid-template-columns: 44px 1fr; gap: 6px 18px; padding: 20px 0; border-bottom: 1px solid rgba(255,255,255,.14); }
  .pham-about__principle-index { grid-row: 1 / 3; color: rgba(242,242,239,.42); font: 400 9px/1.4 var(--font-mono); }
  .pham-about__principle h2 { margin: 0; color: var(--color-bone); font: 400 1rem/1.2 var(--font-display); letter-spacing: .04em; text-transform: uppercase; }
  .pham-about__principle p { margin: 0; color: var(--color-bone-60); font: 400 .84rem/1.6 var(--font-body); }
  .pham-about__record {
    grid-column: 1 / -1;
    margin-top: clamp(72px, 9vw, 120px);
    padding-top: clamp(36px, 5vw, 64px);
    border-top: 1px solid rgba(255,255,255,.18);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(36px, 7vw, 96px);
  }
  .pham-about__record-block {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 56ch;
  }
  .pham-about__record-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.7vw, 2.3rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: .03em;
    text-transform: uppercase;
    color: var(--color-white);
    text-wrap: balance;
  }
  .pham-about__record-copy {
    margin: 0;
    max-width: 100%;
    overflow-wrap: break-word;
    word-break: normal;
    font-family: var(--font-body);
    font-size: clamp(.96rem, 1.15vw, 1.1rem);
    line-height: 1.8;
    color: var(--color-bone-60);
  }
  .pham-about__edition-note {
    grid-column: 1 / -1;
    margin-top: clamp(8px, 2vw, 18px);
    padding-block: 18px;
    border-top: 1px solid rgba(255,255,255,.12);
    border-bottom: 1px solid rgba(255,255,255,.12);
    display: flex;
    justify-content: space-between;
    gap: 24px;
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .pham-about__edition-note span { color: rgba(242,242,239,.4); }
  .pham-about__edition-note strong { color: rgba(242,242,239,.9); font-weight: 400; text-align: right; }
  .pham-about__origin { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr repeat(2, minmax(180px, .45fr)); gap: 24px; margin-top: clamp(70px, 10vw, 130px); padding-block: 22px; border-top: 1px solid rgba(255,255,255,.2); border-bottom: 1px solid rgba(255,255,255,.12); }
  .pham-about__origin p,.pham-about__origin span,.pham-about__origin strong { margin: 0; font: 400 9px/1.45 var(--font-mono); letter-spacing: .08em; }
  .pham-about__origin p,.pham-about__origin span { color: rgba(242,242,239,.44); }
  .pham-about__origin div { display: grid; gap: 6px; }
  .pham-about__origin strong {
    min-width: 0;
    max-width: 100%;
    color: rgba(242,242,239,.9);
    overflow-wrap: anywhere;
  }
  .pham-about__back {
    grid-column: 1 / -1;
    margin: var(--space-2xl) 0 0;
  }
  @media (max-width: 899px) {
    .pham-about__inner {
      grid-template-columns: minmax(0, 1fr);
      column-gap: 0;
    }
    .pham-about__head,
    .pham-about__body,
    .pham-about__record,
    .pham-about__origin { min-width: 0; }
    .pham-about__record { grid-template-columns: minmax(0, 1fr); }
    .pham-about__edition-note { grid-column: auto; }
    .pham-about__body { margin-bottom: 60px; }
    .pham-about__origin { grid-template-columns: 1fr 1fr; }
    .pham-about__origin > p { grid-column: 1 / -1; }
  }
  @media (max-width: 599px) {
    .pham-about { padding-block: 96px 72px; }
    .pham-about__title {
      font-size: clamp(2.85rem, 15.8vw, 4.8rem);
      letter-spacing: -.055em;
    }
    .pham-about__title-line { max-width: 100%; }
    .pham-about__title-line:last-child { font-size: .82em; }
    .pham-about__head { margin-bottom: 48px; }
    .pham-about__paragraph { font-size: .96rem; }
    .pham-about__record { gap: 40px; margin-top: 64px; padding-top: 32px; }
    .pham-about__edition-note { display: grid; gap: 8px; }
    .pham-about__edition-note strong { text-align: left; }
    .pham-about__origin { grid-template-columns: 1fr; }
    .pham-about__origin > p { grid-column: auto; }
  }


  /* About v3: readable editorial content, no oversized age display. */
  .pham-about {
    padding-block: clamp(104px, 10vw, 145px) clamp(68px, 8vw, 112px);
  }
  .pham-about__head {
    max-width: 100%;
    margin-bottom: clamp(40px, 5vw, 70px);
  }
  .pham-about__title {
    font-size: clamp(3.65rem, 7vw, 7.5rem);
    line-height: .94;
    letter-spacing: -.045em;
    max-width: 100%;
  }
  .pham-about__subtitle {
    max-width: 68ch;
    margin-top: 20px;
    font-size: clamp(.75rem, 1vw, .92rem);
    color: rgba(242,242,239,.74);
    line-height: 1.65;
  }
  .pham-about__paragraph {
    font-size: clamp(1rem, 1.2vw, 1.12rem);
    line-height: 1.78;
    color: rgba(242,242,239,.78);
  }
  .pham-about__closing {
    font-size: clamp(1.4rem, 2.3vw, 2.15rem);
    padding-top: 22px;
    margin-top: 10px;
  }
  .pham-about__principle-index { font-size: 11px; color: rgba(242,242,239,.62); }
  .pham-about__principle h2 { font-size: 1rem; line-height: 1.4; }
  .pham-about__principle p {
    font-size: .9rem; line-height: 1.68; color: rgba(242,242,239,.72);
  }
  .pham-about__record {
    grid-template-columns: minmax(0,1fr);
    gap: 0;
    margin-top: clamp(50px, 7vw, 92px);
  }
  .pham-about__record-block--founder {
    display: grid; grid-template-columns: minmax(210px,.38fr) minmax(0,1fr);
    align-items: start; gap: clamp(28px, 5vw, 74px);
    max-width: none; padding-bottom: clamp(48px, 6vw, 76px);
    border-bottom: 1px solid rgba(255,255,255,.18);
  }
  .pham-about__founder-facts {
    display: flex; flex-direction: column; gap: 0;
    padding: 0; margin: 0;
    border-top: 1px solid rgba(242,242,239,.22);
  }
  .pham-about__founder-facts > div {
    display: grid; gap: 6px; padding: 15px 0 18px;
    border-bottom: 1px solid rgba(242,242,239,.15);
  }
  .pham-about__founder-facts dt {
    color: rgba(242,242,239,.6); font: 600 11px/1.4 var(--font-mono);
    letter-spacing: .075em;
  }
  .pham-about__founder-facts dd {
    margin: 0; color: rgba(242,242,239,.94);
    font: 500 14px/1.5 var(--font-body);
  }
  .pham-about__founder-narrative {
    display: flex; flex-direction: column;
    gap: clamp(14px, 2vw, 21px); min-width: 0; max-width: 72ch;
  }
  .pham-about__founder-narrative .pham-about__record-title {
    font-size: clamp(1.8rem, 2.65vw, 3rem);
    max-width: 22ch; line-height: 1.18;
    letter-spacing: -.015em;
  }
  .pham-about__founder-narrative .pham-about__record-copy {
    font-size: clamp(.98rem, 1.1vw, 1.06rem);
    line-height: 1.75;
    color: rgba(242,242,239,.81);
  }
  .pham-about__record-block--edition {
    display: grid; grid-template-columns: minmax(0,.8fr) minmax(0,1.2fr);
    gap: clamp(28px, 5vw, 72px); max-width: none;
    padding-top: clamp(44px, 5vw, 68px); align-items: start;
  }
  .pham-about__edition-heading { display: flex; flex-direction: column; gap: 15px; }
  .pham-about__edition-heading .pham-about__record-title {
    font-size: clamp(1.7rem, 2.35vw, 2.6rem);
    line-height: 1.2;
  }
  .pham-about__edition-copy {
    display: flex; flex-direction: column; gap: 17px;
    min-width: 0; max-width: 72ch;
  }
  .pham-about__edition-copy .pham-about__record-copy {
    color: rgba(242,242,239,.78); font-size: clamp(.98rem, 1.1vw, 1.06rem); line-height: 1.75;
  }
  .pham-about__edition-note {
    margin-top: 34px; font-size: 11px;
  }
  .pham-about__edition-note span { color: rgba(242,242,239,.65); }
  .pham-about__resources {
    grid-column: 1 / -1;
    display: grid; grid-template-columns: repeat(3, minmax(0,1fr));
    gap: 12px; margin-top: 24px;
  }
  .pham-about__resources a {
    display: flex; flex-direction: column; align-items: flex-start;
    gap: 8px; position: relative; min-width: 0; min-height: 112px;
    padding: 20px 38px 18px 17px; text-decoration: none;
    border: 1px solid rgba(242,242,239,.37); background: #161719;
    color: #f2f1ee; border-radius: 2px;
    transition: background .15s ease, border-color .15s ease;
  }
  .pham-about__resources a:hover,.pham-about__resources a:focus-visible {
    border-color: #f2f1ee; background: #252629; outline-offset: 3px;
  }
  .pham-about__resources a strong {
    font: 600 13px/1.4 var(--font-body);
    letter-spacing: .03em;
  }
  .pham-about__resources a span:nth-child(2) {
    font: 400 12px/1.55 var(--font-body);
    color: rgba(242,242,239,.7);
  }
  .pham-about__resources a span:last-child {
    position: absolute; top: 16px; right: 16px; font-size: 20px; line-height: 1;
  }
  .pham-about__origin { margin-top: clamp(55px,7vw,85px); }
  .pham-about__origin p,.pham-about__origin span,.pham-about__origin strong { font-size: 11px; }
  .pham-about__origin p,.pham-about__origin span { color:rgba(242,242,239,.68); }
  @media(max-width: 899px) {
    .pham-about__record-block--founder { grid-template-columns: 185px minmax(0,1fr); gap: 24px; }
    .pham-about__record-block--edition { grid-template-columns: minmax(0,1fr); gap: 24px; }
    .pham-about__resources { grid-template-columns: repeat(2,minmax(0,1fr)); }
  }
  @media(max-width: 599px) {
    .pham-about { padding-block: 96px 65px; }
    .pham-about__head { margin-bottom: 38px; }
    .pham-about__title { font-size: clamp(3.4rem, 15vw, 4.7rem); }
    .pham-about__title-line:last-child { font-size: 1em; }
    .pham-about__subtitle { margin-top: 16px; font-size: 12px; }
    .pham-about__paragraph { font-size: .96rem; }
    .pham-about__body { margin-bottom: 40px; gap: 17px; }
    .pham-about__record-block--founder { grid-template-columns: minmax(0,1fr); gap: 24px; }
    .pham-about__founder-facts { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 0 18px; }
    .pham-about__founder-facts > div { padding: 12px 0; }
    .pham-about__founder-facts dd { font-size: 13px; }
    .pham-about__founder-narrative .pham-about__record-title { font-size: clamp(1.8rem, 7vw, 2.4rem); }
    .pham-about__founder-narrative .pham-about__record-copy { font-size: .97rem; }
    .pham-about__record-block--edition { padding-top: 37px; }
    .pham-about__edition-copy .pham-about__record-copy { font-size: .97rem; }
    .pham-about__edition-note { font-size: 10px; margin-top: 26px; }
    .pham-about__resources { grid-template-columns: 1fr; gap: 9px; margin-top: 18px; }
    .pham-about__resources a { min-height: 80px; padding: 15px 35px 13px 15px; gap: 6px; }
    .pham-about__resources a strong { font-size: 12px; }
    .pham-about__resources a span:nth-child(2) { font-size: 12px; }
  }
  @media(prefers-reduced-motion:reduce) {
    .pham-about__resources a { transition: none; }
  }


  .pham-about__founder-story-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    align-self: flex-start;
    gap: 28px;
    min-height: 48px;
    margin-top: 2px;
    padding: 12px 17px;
    border: 1px solid rgba(242,242,239,.65);
    background: #202125;
    color: #f1f0ee;
    text-decoration: none;
    font: 700 12px/1.35 var(--font-body);
    letter-spacing: .055em;
    transition: background .15s ease, border-color .15s ease;
  }
  .pham-about__founder-story-link:hover,
  .pham-about__founder-story-link:focus-visible {
    background: #323338;
    border-color: #fff;
  }
  .pham-about__founder-story-link span:last-child { font-size: 19px; }

</style>

{% schema %}
{
  "name": "PHAM About",
  "tag": "section",
  "class": "pham-about-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "PHAM / INDEPENDENT FASHION LABEL"
    },
    {
