<!-- # DO NOT EDIT — managed by PHAM theme architecture -->
{%- assign feat_product = blank -%}
{%- capture pham_feat_handle -%}{%- render 'pham-featured-product-handle', product_ref: section.settings.featured_product -%}{%- endcapture -%}
{%- assign pham_feat_handle = pham_feat_handle | strip -%}
{%- if pham_feat_handle != blank -%}
  {%- assign feat_product = all_products[pham_feat_handle] -%}
{%- endif -%}
{%- if feat_product == blank or feat_product == nil -%}
  {%- for pham_item in collections.all.products limit: 1 -%}
    {%- assign feat_product = pham_item -%}
  {%- endfor -%}
{%- endif -%}
{%- liquid
  assign menu_handle    = section.settings.menu | default: 'main-menu'
  assign menu           = linklists[menu_handle]
  assign show_search    = false
  assign show_account   = section.settings.show_account

  comment
    Bulletproof single-product default. PHAM is a single-product
    storefront so we treat the legacy admin menu mode as opt-OUT,
    not opt-IN. The user must EXPLICITLY set false to revert.
  endcomment
  assign single_mode = true
  if section.settings.single_product_mode == false
    assign single_mode = false
  endif

  assign product_label = section.settings.product_label | default: 'PRODUCT'
  assign home_label    = section.settings.home_label    | default: 'HOME'
  assign contact_label = section.settings.contact_label | default: 'CONTACT'
  assign contact_url   = section.settings.contact_url   | default: '/pages/contact'
  assign about_label   = section.settings.about_label   | default: 'ABOUT'
  assign about_url     = section.settings.about_url       | default: '/pages/about'
  assign show_home     = section.settings.show_home
  assign show_product  = section.settings.show_product
  assign show_about    = section.settings.show_about
  assign show_contact  = section.settings.show_contact
-%}
{%- capture product_url -%}{%- render 'pham-featured-product-url', product_ref: section.settings.featured_product -%}{%- endcapture -%}
{%- assign product_url = product_url | strip -%}

<header class="pham-header {% if section.settings.transparent_on_top %}pham-header--transparent{% endif %}"
        data-pham-header
        role="banner"
        data-section-id="{{ section.id }}"
        data-section-type="pham-header">
  <div class="pham-header__inner pham-container">

    {%- comment -%} LEFT — Mobile hamburger + desktop logo {%- endcomment -%}
    <div class="pham-header__zone pham-header__zone--left">
      <button class="pham-header__hamburger"
              type="button"
              data-pham-menu-toggle
              aria-expanded="false"
              aria-controls="pham-mobile-drawer"
              aria-label="Open menu">
        <span class="pham-header__hamburger-bar" aria-hidden="true"></span>
        <span class="pham-header__hamburger-bar" aria-hidden="true"></span>
        <span class="pham-header__hamburger-bar" aria-hidden="true"></span>
      </button>

      {% render 'pham-brand-lockup', class: 'pham-header__logo pham-header__logo--desktop', image_loading: 'eager' %}
    </div>

    {%- comment -%} CENTER — Mobile logo + desktop navigation {%- endcomment -%}
    <div class="pham-header__zone pham-header__zone--center">
      {% render 'pham-brand-lockup', class: 'pham-header__logo pham-header__logo--mobile', image_loading: 'lazy' %}

      <nav class="pham-header__nav pham-header__nav--desktop"
           role="navigation"
           aria-label="Primary navigation">
        {%- if single_mode -%}
          <ul class="pham-header__menu" role="list">
            {%- if show_home -%}
              <li class="pham-header__menu-item {% if request.page_type == 'index' %}is-active{% endif %}">
                <a href="{{ routes.root_url }}" class="pham-header__menu-link"{% if request.page_type == 'index' %} aria-current="page"{% endif %}>
                  <span class="pham-header__menu-label">{{ home_label | upcase | escape }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if show_product and feat_product != blank and feat_product != nil -%}
              <li class="pham-header__menu-item {% if request.page_type == 'product' %}is-active{% endif %}">
                <a href="{{ product_url }}" class="pham-header__menu-link"{% if request.page_type == 'product' %} aria-current="page"{% endif %}>
                  <span class="pham-header__menu-label">{{ product_label | upcase | escape }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if show_about -%}
              <li class="pham-header__menu-item {% if template.name == 'page' and page.handle == 'about' %}is-active{% endif %}">
                <a href="{{ about_url }}" class="pham-header__menu-link"{% if template.name == 'page' and page.handle == 'about' %} aria-current="page"{% endif %}>
                  <span class="pham-header__menu-label">{{ about_label | upcase | escape }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if show_contact -%}
              <li class="pham-header__menu-item {% if template.name == 'page' and page.handle == 'contact' %}is-active{% endif %}">
                <a href="{{ contact_url }}" class="pham-header__menu-link"{% if template.name == 'page' and page.handle == 'contact' %} aria-current="page"{% endif %}>
                  <span class="pham-header__menu-label">{{ contact_label | upcase | escape }}</span>
                </a>
              </li>
            {%- endif -%}
          </ul>
        {%- else -%}
          {%- if menu != blank and menu.links.size > 0 -%}
            <ul class="pham-header__menu" role="list">
              {%- for link in menu.links -%}
                {%- assign link_path = link.url | split: '?' | first | split: '#' | first -%}
                {%- assign skip_link = false -%}
                {%- if link_path contains '/collections/all' or link_path contains '/collections/' -%}
                  {%- assign skip_link = true -%}
                {%- endif -%}
                {%- unless skip_link -%}
                  <li class="pham-header__menu-item {% if link.active %}is-active{% endif %}">
                    <a href="{{ link.url }}" class="pham-header__menu-link"{% if link.active %} aria-current="page"{% endif %}>
                      <span class="pham-header__menu-label">{% render 'pham-nav-label', title: link.title, url: link.url %}</span>
                    </a>
                  </li>
                {%- endunless -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        {%- endif -%}
      </nav>
    </div>

    {%- comment -%} RIGHT — actions {%- endcomment -%}
    <div class="pham-header__zone pham-header__zone--right">
      {%- if show_search -%}
        <a href="{{ routes.search_url }}" class="pham-header__action" aria-label="Search">
          <svg class="pham-header__icon" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
            <circle cx="8" cy="8" r="5.5" stroke="currentColor" stroke-width="1.2" fill="none"/>
            <line x1="12.5" y1="12.5" x2="16.5" y2="16.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          </svg>
          <span class="pham-visually-hidden">Search</span>
        </a>
      {%- endif -%}

      {%- if show_account -%}
        {%- if shop.customer_accounts_enabled -%}
          <shopify-account
            class="pham-account-component"
            menu="{{ section.settings.customer_account_menu | default: 'customer-account-main-menu' }}"
          >
            <span slot="signed-out-avatar" class="pham-header__action pham-header__action--account pham-account-trigger" aria-label="Sign in">
              <svg class="pham-header__icon" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
                <circle cx="9" cy="6.5" r="3" stroke="currentColor" stroke-width="1.2" fill="none"/>
                <path d="M3 16c0-3.3 2.7-6 6-6s6 2.7 6 6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" fill="none"/>
              </svg>
              <span class="pham-visually-hidden">Sign in</span>
            </span>
          </shopify-account>
        {%- else -%}
          <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
             class="pham-header__action pham-header__action--account"
             aria-label="{% if customer %}Account{% else %}Sign in{% endif %}">
            <svg class="pham-header__icon" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
              <circle cx="9" cy="6.5" r="3" stroke="currentColor" stroke-width="1.2" fill="none"/>
              <path d="M3 16c0-3.3 2.7-6 6-6s6 2.7 6 6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" fill="none"/>
            </svg>
            <span class="pham-visually-hidden">{% if customer %}Account{% else %}Sign in{% endif %}</span>
          </a>
        {%- endif -%}
      {%- endif -%}

      <button type="button"
              class="pham-header__action pham-header__action--cart"
              data-pham-cart-open
              aria-label="Open cart"
              aria-haspopup="dialog">
        <svg class="pham-header__icon" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
          <path d="M3.5 5h11l-1 9.5a1.5 1.5 0 0 1-1.5 1.3H6a1.5 1.5 0 0 1-1.5-1.3L3.5 5Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" fill="none"/>
          <path d="M6.5 5V4a2.5 2.5 0 0 1 5 0v1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" fill="none"/>
        </svg>
        <span class="pham-header__cart-count"
              data-pham-cart-count
              {% if cart.item_count == 0 %}data-empty="true"{% endif %}>{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
</header>

{%- comment -%} Drawer lives outside <header> so fixed overlay is not clipped by header transforms/overflow {%- endcomment -%}
<div class="pham-header__drawer"
     id="pham-mobile-drawer"
     data-pham-mobile-drawer
     role="dialog"
     aria-modal="true"
     aria-hidden="true"
     aria-label="Site navigation">
  <div class="pham-header__drawer-backdrop" data-pham-menu-backdrop aria-hidden="true"></div>

  <div class="pham-header__drawer-panel">
    <div class="pham-header__drawer-head">
      <span class="pham-eyebrow">Menu</span>
      <button type="button"
              class="pham-header__drawer-close"
              data-pham-menu-close
              aria-label="Close menu">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
          <line x1="3" y1="3" x2="15" y2="15" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          <line x1="15" y1="3" x2="3" y2="15" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <nav class="pham-header__drawer-nav" aria-label="Mobile primary navigation">
      {%- if single_mode -%}
        <ul class="pham-header__drawer-menu" role="list">
          {%- if show_home -%}
            <li class="pham-header__drawer-item">
              <a href="{{ routes.root_url }}" class="pham-header__drawer-link"{% if request.page_type == 'index' %} aria-current="page"{% endif %}>
                <span class="pham-header__drawer-link-label">{{ home_label | upcase | escape }}</span>
                <span class="pham-header__drawer-link-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </li>
          {%- endif -%}
          {%- if show_product and feat_product != blank and feat_product != nil -%}
            <li class="pham-header__drawer-item">
              <a href="{{ product_url }}" class="pham-header__drawer-link"{% if request.page_type == 'product' %} aria-current="page"{% endif %}>
                <span class="pham-header__drawer-link-label">{{ product_label | upcase | escape }}</span>
                <span class="pham-header__drawer-link-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </li>
          {%- endif -%}
          {%- if show_about -%}
            <li class="pham-header__drawer-item">
              <a href="{{ about_url }}" class="pham-header__drawer-link"{% if template.name == 'page' and page.handle == 'about' %} aria-current="page"{% endif %}>
                <span class="pham-header__drawer-link-label">{{ about_label | upcase | escape }}</span>
                <span class="pham-header__drawer-link-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </li>
          {%- endif -%}
          {%- if show_contact -%}
            <li class="pham-header__drawer-item">
              <a href="{{ contact_url }}" class="pham-header__drawer-link"{% if template.name == 'page' and page.handle == 'contact' %} aria-current="page"{% endif %}>
                <span class="pham-header__drawer-link-label">{{ contact_label | upcase | escape }}</span>
                <span class="pham-header__drawer-link-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </li>
          {%- endif -%}
        </ul>
      {%- else -%}
        {%- if menu != blank and menu.links.size > 0 -%}
          <ul class="pham-header__drawer-menu" role="list">
            {%- for link in menu.links -%}
              {%- assign link_path = link.url | split: '?' | first | split: '#' | first -%}
              {%- assign skip_link = false -%}
              {%- if link_path contains '/collections/all' or link_path contains '/collections/' -%}
                {%- assign skip_link = true -%}
              {%- endif -%}
              {%- unless skip_link -%}
                <li class="pham-header__drawer-item">
                  <a href="{{ link.url }}" class="pham-header__drawer-link"{% if link.active %} aria-current="page"{% endif %}>
                    <span class="pham-header__drawer-link-label">{% render 'pham-nav-label', title: link.title, url: link.url %}</span>
                    <span class="pham-header__drawer-link-arrow" aria-hidden="true">&rarr;</span>
                  </a>
                  {%- if link.links.size > 0 -%}
                    <ul class="pham-header__drawer-submenu" role="list">
                      {%- for sublink in link.links -%}
                        <li>
                          <a href="{{ sublink.url }}" class="pham-header__drawer-sublink"{% if sublink.active %} aria-current="page"{% endif %}>{% render 'pham-nav-label', title: sublink.title, url: sublink.url %}</a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </li>
              {%- endunless -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      {%- endif -%}
    </nav>

    <div class="pham-header__drawer-footer">
      <div class="pham-header__drawer-utility">
        <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
           class="pham-header__drawer-util">
          {% if customer %}ACCOUNT{% else %}SIGN IN{% endif %}
        </a>
      </div>
      {%- assign pham_facebook = settings.pham_social_facebook | default: 'https://www.facebook.com/profile.php?id=61590900803027' -%}
      {%- if settings.pham_social_instagram != blank or settings.pham_social_tiktok != blank or pham_facebook != blank -%}
        <div class="pham-header__drawer-socials">
          {%- if settings.pham_social_instagram != blank -%}
            <a href="{{ settings.pham_social_instagram }}" target="_blank" rel="noopener noreferrer" class="pham-header__drawer-social">Instagram</a>
          {%- endif -%}
          {%- if settings.pham_social_tiktok != blank -%}
            <a href="{{ settings.pham_social_tiktok }}" target="_blank" rel="noopener noreferrer" class="pham-header__drawer-social">TikTok</a>
          {%- endif -%}
          {%- if pham_facebook != blank -%}
            <a href="{{ pham_facebook }}" target="_blank" rel="noopener noreferrer" class="pham-header__drawer-social">Facebook</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- comment -%} Spacer offsets the fixed header in normal flow {%- endcomment -%}
<div class="pham-header__spacer {% if section.settings.transparent_on_top %}pham-header__spacer--transparent{% endif %}" aria-hidden="true"></div>

{%- comment -%} Render the cart drawer once globally {%- endcomment -%}
{% render 'pham-cart-drawer' %}

{% schema %}
{
  "name": "PHAM Header",
  "tag": "section",
  "class": "pham-header-section",
  "settings": [
    {
      "type": "header",
      "content": "Navigation mode"
    },
    {
      "type": "checkbox",
      "id": "single_product_mode",
      "label": "Single product mode",
      "info": "When enabled, the header shows a fixed HOME / PRODUCT / CONTACT navigation and ignores the admin menu. Designed for single-product storefronts.",
      "default": true
    },
    {
      "type": "header",
      "content": "Single product mode — links"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Featured product (header)",
      "info": "Section-level override. Falls back to PHAM Brand → Featured product."
    },
    {
      "type": "checkbox",
      "id": "show_home",
      "label": "Show HOME link",
      "default": true
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "HOME label",
      "default": "HOME"
    },
    {
      "type": "checkbox",
      "id": "show_product",
      "label": "Show PRODUCT link",
      "default": true
    },
    {
      "type": "text",
      "id": "product_label",
      "label": "PRODUCT label",
      "default": "PRODUCT"
    },
    {
      "type": "checkbox",
      "id": "show_about",
      "label": "Show ABOUT link",
      "default": true
    },
    {
      "type": "text",
      "id": "about_label",
      "label": "ABOUT label",
      "default": "ABOUT"
    },
    {
      "type": "url",
      "id": "about_url",
      "label": "About page URL",
      "info": "Defaults to /pages/about"
    },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "Show CONTACT link",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "CONTACT label",
      "default": "CONTACT"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact page URL",
      "info": "Defaults to /pages/contact"
    },
    {
      "type": "header",
      "content": "Legacy menu (single mode off)"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Actions"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search icon",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account icon",
      "default": true
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "Customer account menu",
      "default": "customer-account-main-menu",
      "info": "Used by Shopify's account component for Orders, Profile, and account links."
    },
    {
      "type": "checkbox",
      "id": "transparent_on_top",
      "label": "Transparent at top of page",
      "info": "Useful when the first section below the header has a full-bleed image or video.",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "PHAM Header",
      "category": "Header"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
