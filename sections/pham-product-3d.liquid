{%- liquid
  assign model_media = blank
  for media in product.media
    if media.media_type == 'model'
      assign model_media = media
      break
    endif
  endfor
  assign fallback_image = section.settings.fallback_image | default: product.featured_image
-%}

{{ 'pham-vault.css' | asset_url | stylesheet_tag }}

<section
  class="pham-object-stage"
  data-pham-object-stage
  data-has-model="{% if model_media != blank %}true{% else %}false{% endif %}"
  aria-label="{{ section.settings.heading | escape }}"
>
  <div class="pham-object-stage__grid" aria-hidden="true"></div>
  <div class="pham-object-stage__meta pham-container">
    <p>{{ section.settings.eyebrow }}</p>
    <p>OBJECT / {{ product.id }}</p>
  </div>

  <header class="pham-object-stage__intro pham-container">
    <p class="pham-object-stage__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="pham-object-stage__title">{{ section.settings.heading }}</h2>
    <p class="pham-object-stage__body">{{ section.settings.body }}</p>
  </header>

  <div class="pham-object-stage__viewer">
    {%- if model_media != blank -%}
      {{ model_media | model_viewer_tag: class: 'pham-object-stage__model', reveal: 'auto', auto_rotate: true, camera_controls: true, interaction_prompt: 'auto' }}
      <p class="pham-object-stage__mode">3D MODEL / LIVE</p>
    {%- elsif fallback_image != blank -%}
      {{
        fallback_image
        | image_url: width: 1800
        | image_tag:
          loading: 'lazy',
          widths: '600, 900, 1200, 1500, 1800',
          sizes: '(max-width: 749px) 92vw, 62vw',
          class: 'pham-object-stage__fallback-image',
          alt: product.title
      }}
      <p class="pham-object-stage__mode">IMAGE STUDY / MODEL READY</p>
    {%- else -%}
      <div class="pham-object-stage__empty" aria-hidden="true"><span>PHAM</span><i></i><span>OBJECT</span></div>
      <p class="pham-object-stage__mode">3D MODEL / READY</p>
    {%- endif -%}
  </div>

  <div class="pham-object-stage__controls pham-container">
    <p>{% if model_media != blank %}DRAG TO ROTATE / SCROLL TO ZOOM{% else %}UPLOAD A 3D MODEL TO PRODUCT MEDIA{% endif %}</p>
    <a href="#MainProduct-{{ product.id }}">VIEW PRODUCT INFORMATION &#8595;</a>
  </div>
</section>

<style>
  .pham-object-stage { position: relative; min-height: max(720px, 100svh); overflow: hidden; isolation: isolate; display: grid; grid-template-rows: auto 1fr auto; background: #050505; color: #f2f2ef; border-bottom: 1px solid rgba(255,255,255,.12); }
  .pham-object-stage__grid { position: absolute; z-index: 0; inset: 0; background: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px), radial-gradient(circle at 50% 48%, #1a1a1a 0, #080808 55%, #050505 85%); background-size: 80px 80px, 80px 80px, auto; mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 82%, transparent); }
  .pham-object-stage__meta { position: absolute; z-index: 4; top: 88px; left: 0; right: 0; display: flex; justify-content: space-between; color: rgba(242,242,239,.42); font: 400 9px/1 var(--font-mono); pointer-events: none; }
  .pham-object-stage__meta p { margin: 0; }
  .pham-object-stage__intro { position: absolute; z-index: 4; left: 0; right: 0; top: clamp(130px, 18vh, 190px); pointer-events: none; }
  .pham-object-stage__eyebrow { margin: 0 0 16px; color: rgba(242,242,239,.5); font: 400 9px/1 var(--font-mono); }
  .pham-object-stage__title { width: min(470px, 40vw); margin: 0; font: 400 clamp(2.8rem, 6vw, 6.8rem)/.94 var(--font-display); letter-spacing: 0; }
  .pham-object-stage__body { width: min(340px, 34vw); margin: 24px 0 0; color: rgba(242,242,239,.62); font: 400 .92rem/1.65 var(--font-body); }
  .pham-object-stage__viewer { position: absolute; z-index: 2; inset: 54px 0 32px; display: grid; place-items: center; }
  .pham-object-stage__model { display: block; width: min(70vw, 960px); height: 86vh; min-height: 620px; background: transparent; --poster-color: transparent; }
  .pham-object-stage__fallback-image { width: min(62vw, 840px); height: 80vh; object-fit: contain; filter: saturate(.76) contrast(1.08) drop-shadow(0 50px 60px rgba(0,0,0,.74)); transition: transform 900ms cubic-bezier(.2,0,0,1), filter 900ms ease; }
  .pham-object-stage:hover .pham-object-stage__fallback-image { transform: scale(1.025); filter: saturate(.88) contrast(1.04) drop-shadow(0 58px 70px rgba(0,0,0,.82)); }
  .pham-object-stage__mode { position: absolute; right: var(--gutter); top: 50%; margin: 0; writing-mode: vertical-rl; color: rgba(242,242,239,.43); font: 400 9px/1 var(--font-mono); }
  .pham-object-stage__empty { width: min(48vw, 620px); aspect-ratio: 4/5; display: grid; grid-template-columns: 1fr auto 1fr; place-items: center; border: 1px solid rgba(255,255,255,.16); color: rgba(255,255,255,.38); font: 400 1rem/1 var(--font-display); }
  .pham-object-stage__empty span:first-child { justify-self: end; }.pham-object-stage__empty span:last-child { justify-self: start; }.pham-object-stage__empty i { width: 1px; height: 70%; margin: 0 24px; background: rgba(255,255,255,.16); }
  .pham-object-stage__controls { position: absolute; z-index: 5; left: 0; right: 0; bottom: 26px; display: flex; justify-content: space-between; align-items: center; font: 400 9px/1 var(--font-mono); }
  .pham-object-stage__controls p { margin: 0; color: rgba(242,242,239,.44); }.pham-object-stage__controls a { color: rgba(242,242,239,.78); text-decoration: none; }
  @media (max-width: 899px) { .pham-object-stage { min-height: 850px; }.pham-object-stage__meta { top: 76px; }.pham-object-stage__intro { top: 118px; }.pham-object-stage__title { width: min(90%, 520px); font-size: clamp(2.6rem, 12vw, 5rem); }.pham-object-stage__body { width: min(80%, 340px); margin-top: 16px; }.pham-object-stage__viewer { inset: 180px 0 76px; align-items: center; }.pham-object-stage__model { width: 100vw; height: 64vh; min-height: 480px; }.pham-object-stage__fallback-image { width: 94vw; height: 60vh; margin-top: 90px; }.pham-object-stage__mode { right: 10px; }.pham-object-stage__controls { bottom: 22px; }.pham-object-stage__controls p { display: none; } }
  @media (prefers-reduced-motion: reduce) { .pham-object-stage__fallback-image { transition: none; }.pham-object-stage:hover .pham-object-stage__fallback-image { transform: none; } }
</style>

{% schema %}
{
  "name": "PHAM Product stage",
  "tag": "section",
  "class": "pham-product-stage-section",
  "settings": [
    { "type": "image_picker", "id": "fallback_image", "label": "Fallback image", "info": "Shown until a 3D model is added to the product media." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "DIGITAL GARMENT STUDY / 001" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "INSPECT THE FORM" },
    { "type": "textarea", "id": "body", "label": "Description", "default": "Rotate the object and inspect the silhouette before entering the product archive." }
  ],
  "presets": [{ "name": "PHAM Product stage", "category": "PHAM" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
