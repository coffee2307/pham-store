{%- liquid
  assign model_media = blank
  for media in product.media
    if media.media_type == 'model'
      assign model_media = media
      break
    endif
  endfor
-%}

<section class="pham-product-3d" data-pham-product-3d data-has-model="{% if model_media != blank %}true{% else %}false{% endif %}">
  <div class="pham-product-3d__shell pham-container">
    <header class="pham-product-3d__intro">
      <p class="pham-product-3d__eyebrow">{{ section.settings.eyebrow | default: 'DIGITAL GARMENT STUDY' }}</p>
      <h2 class="pham-product-3d__title">{{ section.settings.heading | default: 'Explore the form.' }}</h2>
      <p class="pham-product-3d__body">{{ section.settings.body | default: 'A dedicated space for the PHAM-001 three-dimensional garment study.' }}</p>
      <div class="pham-product-3d__legend" aria-hidden="true">
        <span>DRAG TO ROTATE</span><span>SCROLL TO ZOOM</span>
      </div>
    </header>

    <div class="pham-product-3d__viewer-wrap">
      {%- if model_media != blank -%}
        <div class="pham-product-3d__viewer">
          {{ model_media | model_viewer_tag: class: 'pham-product-3d__model', reveal: 'interaction', auto_rotate: true, camera_controls: true }}
          <span class="pham-product-3d__axis pham-product-3d__axis--x" aria-hidden="true"></span>
          <span class="pham-product-3d__axis pham-product-3d__axis--y" aria-hidden="true"></span>
          <span class="pham-product-3d__status">MODEL / LIVE</span>
        </div>
      {%- else -%}
        <div class="pham-product-3d__placeholder">
          <div class="pham-product-3d__placeholder-frame" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <p class="pham-product-3d__status">MODEL / RESERVED</p>
          <p class="pham-product-3d__placeholder-copy">{{ section.settings.placeholder_text | default: 'The interactive garment study will appear here.' }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .pham-product-3d{padding:clamp(72px,11vw,170px) 0;background:linear-gradient(180deg,#0a0a0c,#111218);color:var(--color-bone);border-top:1px solid var(--color-ash)}
  .pham-product-3d__shell{display:grid;grid-template-columns:minmax(0,.75fr) minmax(420px,1.25fr);gap:clamp(34px,7vw,132px);align-items:center}
  .pham-product-3d__intro{max-width:420px}.pham-product-3d__eyebrow,.pham-product-3d__legend,.pham-product-3d__status{font:400 10px/1.4 var(--font-mono);letter-spacing:.16em;text-transform:uppercase}
  .pham-product-3d__eyebrow{margin:0 0 20px;color:var(--color-smoke)}.pham-product-3d__title{margin:0;font-family:var(--font-display);font-size:clamp(2.2rem,4vw,4.4rem);line-height:.95;letter-spacing:-.05em;font-weight:400}.pham-product-3d__body{max-width:340px;margin:26px 0 0;color:var(--color-bone-60);font:400 1rem/1.65 var(--font-body)}
  .pham-product-3d__legend{display:flex;flex-wrap:wrap;gap:14px;margin-top:34px;color:var(--color-placeholder)}.pham-product-3d__legend span+span:before{content:"/";margin-right:14px;color:var(--color-ash)}
  .pham-product-3d__viewer-wrap{position:relative;min-height:clamp(430px,52vw,680px);border:1px solid var(--color-ash);overflow:hidden;background:radial-gradient(circle at 50% 48%,#24262e 0%,#14151b 43%,#0c0c0f 100%)}
  .pham-product-3d__viewer{position:absolute;inset:0}.pham-product-3d__model{display:block;width:100%;height:100%;--poster-color:transparent;background:transparent}.pham-product-3d__axis{position:absolute;pointer-events:none;background:rgba(255,255,255,.12)}.pham-product-3d__axis--x{left:7%;right:7%;top:50%;height:1px}.pham-product-3d__axis--y{top:7%;bottom:7%;left:50%;width:1px}.pham-product-3d__viewer .pham-product-3d__status{position:absolute;right:18px;bottom:17px}
  .pham-product-3d__placeholder{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:radial-gradient(circle at 50% 46%,rgba(255,255,255,.07),transparent 32%)}.pham-product-3d__placeholder-frame{position:relative;width:32%;min-width:170px;aspect-ratio:3/4;border:1px solid rgba(255,255,255,.48);transform:rotateX(57deg) rotateZ(-34deg);box-shadow:0 50px 70px rgba(0,0,0,.4)}.pham-product-3d__placeholder-frame span{position:absolute;inset:16%;border:1px solid rgba(255,255,255,.18)}.pham-product-3d__placeholder-frame span:nth-child(2){transform:rotate(35deg) scale(.76)}.pham-product-3d__placeholder-frame span:nth-child(3){transform:rotate(-29deg) scale(.48)}
  .pham-product-3d__placeholder .pham-product-3d__status{position:absolute;right:18px;bottom:17px;color:var(--color-smoke)}.pham-product-3d__placeholder-copy{max-width:250px;margin:50px 20px 0;text-align:center;color:var(--color-bone-60);font:400 .85rem/1.6 var(--font-body)}
  @media (max-width:749px){.pham-product-3d__shell{grid-template-columns:1fr;gap:38px}.pham-product-3d__viewer-wrap{min-height:440px}.pham-product-3d__title{font-size:clamp(2.6rem,12vw,4rem)}}
</style>

{% schema %}
{
  "name": "PHAM Product 3D",
  "tag": "section",
  "class": "pham-product-3d-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "DIGITAL GARMENT STUDY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore the form." },
    { "type": "textarea", "id": "body", "label": "Description", "default": "A dedicated space for the PHAM-001 three-dimensional garment study." },
    { "type": "textarea", "id": "placeholder_text", "label": "Placeholder text", "default": "The interactive garment study will appear here." }
  ],
  "presets": [{ "name": "PHAM Product 3D", "category": "PHAM" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}