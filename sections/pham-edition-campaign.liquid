{{ 'pham-campaign.css' | asset_url | stylesheet_tag }}
{%- capture state_raw -%}{%- render 'pham-campaign-state' -%}{%- endcapture -%}
{%- assign state = state_raw | strip -%}
{%- assign edition_size = settings.pham_campaign_edition_size | default: 50 -%}
{%- assign claimed = settings.pham_campaign_reservations_claimed | default: 0 -%}
{%- assign identity_limit = settings.pham_campaign_identity_limit | default: 15 -%}
{%- assign identity_claimed = settings.pham_campaign_identity_claimed | default: 0 -%}
{%- assign reservation_progress = 0 -%}
{%- if edition_size > 0 -%}{%- assign reservation_progress = claimed | times: 100.0 | divided_by: edition_size -%}{%- endif -%}
{%- assign identity_progress = 0 -%}
{%- if identity_limit > 0 -%}{%- assign identity_progress = identity_claimed | times: 100.0 | divided_by: identity_limit -%}{%- endif -%}
{%- case state -%}
  {%- when 'reservation_open' -%}{%- assign state_label = 'PRIORITY RESERVATION OPEN' -%}
  {%- when 'reservation_full' -%}{%- assign state_label = 'PRIORITY RESERVATION CLOSED · STANDBY OPEN' -%}
  {%- when 'final_payment' -%}{%- assign state_label = 'ACQUISITION WINDOW OPEN' -%}
  {%- when 'sold_out' -%}{%- assign state_label = 'EDITION CLOSED' -%}
  {%- when 'archived' -%}{%- assign state_label = 'ARCHIVED' -%}
  {%- else -%}{%- assign state_label = 'PRELAUNCH · SYSTEM IN PREPARATION' -%}
{%- endcase -%}

<section class="pham-campaign-shell"
  data-pham-edition-campaign
  data-edition-id="{{ settings.pham_campaign_edition_id | default: 'edition-01' | escape }}"
  data-engine-enabled="{% if settings.pham_campaign_engine_enabled %}true{% else %}false{% endif %}"
  data-engine-proxy="{{ settings.pham_campaign_engine_proxy_path | default: '/apps/pham-edition' | escape }}">
  <div class="pham-campaign-inner">
    <p class="pham-campaign-kicker">{{ settings.pham_campaign_edition_label | default: 'EDITION 01' }} · <span data-pham-live-state>{{ state_label }}</span></p>
    <h1 class="pham-campaign-title">{{ settings.pham_campaign_product_code | default: 'PHAM-001' }}</h1>
    <p class="pham-campaign-lede">{{ section.settings.intro }}</p>

    <div class="pham-campaign-grid">
      <article class="pham-campaign-card pham-campaign-card--wide">
        <p class="pham-campaign-mono">Edition allocation</p>
        <div class="pham-campaign-stat"><strong data-pham-live-reservations>{{ claimed }} / {{ edition_size }}</strong><span>Reserved</span></div>
        <div class="pham-campaign-meter" data-pham-live-reservation-meter style="--pc-progress: {{ reservation_progress | at_most: 100 }}%"><i></i></div>
        <div class="pham-campaign-actions" data-pham-live-actions>
          {%- if state == 'reservation_open' and settings.pham_campaign_reservation_page_url != blank -%}
            <a class="pham-campaign-btn" href="{{ settings.pham_campaign_reservation_page_url }}">Reserve {{ settings.pham_campaign_product_code | default: 'PHAM-001' }}</a>
          {%- elsif state == 'reservation_full' and settings.pham_campaign_standby_page_url != blank -%}
            <a class="pham-campaign-btn" href="{{ settings.pham_campaign_standby_page_url }}">Join standby · free</a>
          {%- elsif state == 'final_payment' and settings.pham_campaign_collector_page_url != blank -%}
            <a class="pham-campaign-btn" href="{{ settings.pham_campaign_collector_page_url }}">Collector access</a>
          {%- else -%}
            <span class="pham-campaign-btn" aria-disabled="true">Not yet open</span>
          {%- endif -%}
        </div>
      </article>

      <article class="pham-campaign-card">
        <p class="pham-campaign-mono">Object Identity</p>
        <div class="pham-campaign-stat"><strong data-pham-live-identity>{{ identity_claimed }} / {{ identity_limit }}</strong><span>Privileges</span></div>
        <div class="pham-campaign-meter" data-pham-live-identity-meter style="--pc-progress: {{ identity_progress | at_most: 100 }}%"><i></i></div>
        <p style="margin-top:20px">Custom stainless-steel identity, preferred object-number request and QR provenance. Unlock by paid upgrade or one verified reservation referral while the shared pool remains available.</p>
      </article>

      <article class="pham-campaign-card">
        <h2>Reserve</h2>
        <ul class="pham-campaign-list">
          <li><span>Due at reservation</span><strong>{{ settings.pham_campaign_reservation_price | default: '$24.99' }}</strong></li>
          <li><span>Edition price</span><strong>{{ settings.pham_campaign_final_price | default: '$199.00' }}</strong></li>
          <li><span>Product balance after credit</span><strong>{{ settings.pham_campaign_balance_due | default: '$174.01' }}</strong></li>
        </ul>
      </article>

      <article class="pham-campaign-card">
        <h2>Digital Access</h2>
        <p>{% if settings.pham_campaign_include_digital_lookbook %}A confirmed reservation includes the {{ settings.pham_campaign_digital_lookbook_label | default: 'edition-exclusive digital lookbook' }}, delivered by email after payment confirmation.{% else %}Digital collector material can be attached to this edition later.{% endif %}</p>
      </article>

      <article class="pham-campaign-card">
        <h2>Founder’s Token</h2>
        <p>Edition 01 contains 50 collector tokens: 49 silver-tone and one gold-tone. The gold token is allocated once by the Edition Engine after the object set is finalized. Its result stays sealed to the collector until delivery.</p>
      </article>
      <article class="pham-campaign-card pham-campaign-card--full">
        <h2>Edition ledger</h2>
        <div class="pham-edition-ledger">
          <div><span>Object set</span><strong>{{ edition_size }} / {{ edition_size }}</strong></div>
          <div><span>Acquired</span><strong data-pham-live-acquired-count>— / {{ edition_size }}</strong></div>
          <div><span>Delivered</span><strong data-pham-live-delivered-count>0 / {{ edition_size }}</strong></div>
          <div><span>Design origin</span><strong data-pham-live-design-origin>{{ settings.pham_campaign_origin_label | default: 'VIETNAM / 2026' }}</strong></div>
          <div><span>Reproduction</span><strong>NEVER AFTER ARCHIVE</strong></div>
        </div>
        <p class="pham-edition-ledger__note" data-pham-live-archive-note>When every acquired object completes delivery, the edition can enter the permanent PHAM archive. Its object set and Birth Records remain; production does not reopen.</p>
      </article>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "PHAM Edition Campaign",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "A numbered PHAM object released through a controlled reservation, identity and provenance system. The same architecture is designed to continue across future editions."
    }
  ],
  "presets": [{"name": "PHAM Edition Campaign"}]
}
{% endschema %}
