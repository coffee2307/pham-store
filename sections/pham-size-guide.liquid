@media (max-width: 759px) {
  .pham-fit__table tbody { gap: 0; transition: gap 460ms ease; }
  .pham-fit__measurements.is-comparing .pham-fit__table tbody { gap: 10px; }
  .pham-fit__measurements .pham-fit__table tbody tr:not(.is-highlighted) {
    display: grid;
    box-sizing: border-box;
    max-height: 0;
    opacity: 0;
    visibility: hidden;
    overflow: hidden;
    padding-top: 0;
    padding-bottom: 0;
    border-width: 0;
    transform: translateY(-10px);
    pointer-events: none;
    transition:
      max-height 460ms cubic-bezier(.22,.68,.2,1),
      padding 460ms cubic-bezier(.22,.68,.2,1),
      opacity 270ms ease,
      transform 460ms cubic-bezier(.22,.68,.2,1),
      visibility 0s linear 460ms;
  }
