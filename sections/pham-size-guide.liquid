    max-height: 340px;
    opacity: 1;
    visibility: visible;
    padding: 12px 15px;
    border-width: 1px;
    transform: none;
    pointer-events: auto;
    transition:
      max-height 460ms cubic-bezier(.22,.68,.2,1),
      padding 460ms cubic-bezier(.22,.68,.2,1),
      opacity 280ms ease 70ms,
      transform 460ms cubic-bezier(.22,.68,.2,1),
      visibility 0s;
  }
  .pham-fit__compare-toggle {
    transition: background-color 240ms ease, border-color 240ms ease;
