{%- liquid
  assign recommendation_enabled = section.settings.enable_recommendation
  assign diagram_image = section.settings.diagram_image
-%}

<section class="pham-fit" data-pham-fit-guide
  data-recommendation-enabled="{% if recommendation_enabled %}true{% else %}false{% endif %}"
  data-intended-ease="{{ section.settings.intended_chest_ease | default: 30 }}"
  data-intended-shoulder-ease="{{ section.settings.intended_shoulder_ease | default: 9 }}">
  <div class="pham-fit__inner">
    <header class="pham-fit__hero">
      <div class="pham-fit__hero-copy-wrap">
        <h1>Find your <strong class="pham-editorial-emphasis">fit.</strong></h1>
        <p class="pham-fit__hero-copy">Choose a starting size, then compare it with the finished jacket measurements.</p>
      </div>
    </header>

    <section class="pham-fit__quick" id="pham-fit-choose" aria-labelledby="pham-fit-quick-heading">
      <div class="pham-fit__section-title">
        <h2 id="pham-fit-quick-heading">Your starting <strong class="pham-editorial-emphasis">size.</strong></h2>
        <span>Body chest circumference in centimeters, not flat jacket width.</span>
      </div>
      <div class="pham-fit__quick-grid" role="group" aria-label="Select a starting size">
        <button type="button" data-pham-quick-size="M" aria-pressed="false" aria-label="Size M for body chest 98 to 101 centimeters"><strong>M</strong><span>98–101 cm</span></button>
        <button type="button" data-pham-quick-size="L" aria-pressed="false" aria-label="Size L for body chest 102 to 105 centimeters"><strong>L</strong><span>102–105 cm</span></button>
        <button type="button" data-pham-quick-size="XL" aria-pressed="true" class="is-active" aria-label="Size XL for body chest 106 to 109 centimeters"><strong>XL</strong><span>106–109 cm</span></button>
        <button type="button" data-pham-quick-size="XXL" aria-pressed="false" aria-label="Size XXL for body chest 110 to 114 centimeters"><strong>XXL</strong><span>110–114 cm</span></button>
      </div>
      <div class="pham-fit__quick-preview" data-pham-fit-preview role="status" aria-live="polite" aria-atomic="true">
        <div class="pham-fit__quick-preview-inner">
          <div class="pham-fit__quick-preview-panel">
            <div class="pham-fit__quick-preview-top"><span>Garment measurements (cm)</span><strong data-pham-preview-size>XL</strong></div>
            <dl class="pham-fit__quick-preview-values">
              <div><dt>A · SHOULDER</dt><dd data-pham-preview-shoulder>—</dd></div>
              <div><dt>B · CHEST</dt><dd data-pham-preview-chest>—</dd></div>
              <div><dt>C · BODY</dt><dd data-pham-preview-length>—</dd></div>
              <div><dt>D · SLEEVE</dt><dd data-pham-preview-sleeve>—</dd></div>
            </dl>
          </div>
        </div>
      </div>
      <p class="pham-fit__help">Approximate ranges only. If between sizes, compare with a jacket you own.</p>
    </section>

    <section class="pham-fit__measurement-section" id="pham-fit-measure" aria-labelledby="pham-fit-measure-heading">
      <div class="pham-fit__section-title">
        <h2 id="pham-fit-measure-heading">Measure the <strong class="pham-editorial-emphasis">jacket.</strong></h2>
        <span>All garment dimensions in centimeters. Jacket laid flat, fully zipped.</span>
      </div>
      <div class="pham-fit__diagram-grid">
        <figure class="pham-fit__figure">
          {%- if diagram_image != blank -%}
            {{ diagram_image | image_url: width: 1600 | image_tag: class: 'pham-fit__diagram-image', loading: 'eager', decoding: 'async', widths: '360, 640, 900, 1200, 1448, 1600', sizes: '(max-width: 759px) calc(100vw - 32px), 62vw', alt: 'PHAM-001 technical drawing with measurement arrows A shoulder, B chest, C body length, D sleeve length, E hem width' }}
          {%- else -%}
            <p class="pham-fit__image-fallback">Measurement diagram is being prepared.</p>
          {%- endif -%}
          <figcaption>
            {%- if diagram_image != blank -%}<button type="button" data-pham-fit-expand>Enlarge diagram <span aria-hidden="true">+</span></button>{%- endif -%}
          </figcaption>
        </figure>
        <div class="pham-fit__legend" aria-label="Diagram measurement key">
          <div><span>A</span><div><strong>Shoulder width</strong><p>Straight across the shoulder points.</p></div></div>
          <div><span>B</span><div><strong>Chest width</strong><p>Pit to pit across a flat, zipped jacket.</p></div></div>
          <div><span>C</span><div><strong>Body length</strong><p>From the upper shoulder line to the lower hem.</p></div></div>
          <div><span>D</span><div><strong>Sleeve length</strong><p>From shoulder point to the sleeve cuff.</p></div></div>
        </div>
      </div>

      <div class="pham-fit__measurements" aria-labelledby="pham-fit-table-heading">
        <div class="pham-fit__measurements-heading">
          <div><h3 id="pham-fit-table-heading">Compare all <strong class="pham-editorial-emphasis">four sizes.</strong></h3></div>
          <span data-pham-selected-size aria-live="polite">Selected size: XL</span>
        </div>
        <div class="pham-fit__table-wrap">
          <table class="pham-fit__table">
            <caption>PHAM-001 garment measurements, laid flat, in centimeters.</caption>
            <thead><tr><th scope="col">Size</th><th scope="col">A · Shoulder</th><th scope="col">B · Chest</th><th scope="col">C · Body</th><th scope="col">D · Sleeve</th></tr></thead>
            <tbody id="pham-fit-size-rows">
              <tr data-pham-fit-size="M" data-chest="{{ section.settings.m_chest }}" data-shoulder="{{ section.settings.m_shoulder }}" data-sleeve="{{ section.settings.m_sleeve }}" data-length="{{ section.settings.m_length }}">
                <th scope="row">M</th><td data-label="A · Shoulder">{{ section.settings.m_shoulder }} cm</td><td data-label="B · Chest">{{ section.settings.m_chest }} cm</td><td data-label="C · Body">{{ section.settings.m_length }} cm</td><td data-label="D · Sleeve">{{ section.settings.m_sleeve }} cm</td>
              </tr>
              <tr data-pham-fit-size="L" data-chest="{{ section.settings.l_chest }}" data-shoulder="{{ section.settings.l_shoulder }}" data-sleeve="{{ section.settings.l_sleeve }}" data-length="{{ section.settings.l_length }}">
                <th scope="row">L</th><td data-label="A · Shoulder">{{ section.settings.l_shoulder }} cm</td><td data-label="B · Chest">{{ section.settings.l_chest }} cm</td><td data-label="C · Body">{{ section.settings.l_length }} cm</td><td data-label="D · Sleeve">{{ section.settings.l_sleeve }} cm</td>
              </tr>
              <tr class="is-highlighted" data-pham-fit-size="XL" data-chest="{{ section.settings.xl_chest }}" data-shoulder="{{ section.settings.xl_shoulder }}" data-sleeve="{{ section.settings.xl_sleeve }}" data-length="{{ section.settings.xl_length }}">
                <th scope="row">XL</th><td data-label="A · Shoulder">{{ section.settings.xl_shoulder }} cm</td><td data-label="B · Chest">{{ section.settings.xl_chest }} cm</td><td data-label="C · Body">{{ section.settings.xl_length }} cm</td><td data-label="D · Sleeve">{{ section.settings.xl_sleeve }} cm</td>
              </tr>
              <tr data-pham-fit-size="XXL" data-chest="{{ section.settings.xxl_chest }}" data-shoulder="{{ section.settings.xxl_shoulder }}" data-sleeve="{{ section.settings.xxl_sleeve }}" data-length="{{ section.settings.xxl_length }}">
                <th scope="row">XXL</th><td data-label="A · Shoulder">{{ section.settings.xxl_shoulder }} cm</td><td data-label="B · Chest">{{ section.settings.xxl_chest }} cm</td><td data-label="C · Body">{{ section.settings.xxl_length }} cm</td><td data-label="D · Sleeve">{{ section.settings.xxl_sleeve }} cm</td>
              </tr>
            </tbody>
          </table>
        </div>
        <button class="pham-fit__compare-toggle" type="button" data-pham-fit-compare aria-controls="pham-fit-size-rows" aria-expanded="false">SHOW ALL FOUR SIZES <span aria-hidden="true">+</span></button>
        <p class="pham-fit__tech-note">XL is the sample reference. Other sizes are proposed. Hem width is unverified; final dimensions may vary.</p>
      </div>
    </section>

    <section class="pham-fit__assistant" id="pham-fit-assistant" aria-labelledby="pham-fit-assistant-heading">
      <div class="pham-fit__section-title">
        <h2 id="pham-fit-assistant-heading">Need a <strong class="pham-editorial-emphasis">starting point?</strong></h2>
        <span>Enter your own body measurements for an approximate size suggestion.</span>
      </div>
      <div class="pham-fit__assistant-grid">
        <form class="pham-fit__form" data-pham-fit-form>
          <label><span>Body chest circumference <strong>Required</strong></span><div><input type="number" name="chest" min="70" max="160" inputmode="decimal" placeholder="106" aria-label="Body chest circumference in centimeters" required><em>cm</em></div></label>
          <label><span>Shoulder width <small>Optional</small></span><div><input type="number" name="shoulder" min="32" max="65" inputmode="decimal" placeholder="47" aria-label="Body shoulder width in centimeters"><em>cm</em></div></label>
          <fieldset>
            <legend>Preferred fit</legend>
            <label class="pham-fit__radio"><input type="radio" name="preference" value="close"><span>NEATER</span></label>
            <label class="pham-fit__radio"><input type="radio" name="preference" value="intended" checked><span>PHAM FIT</span></label>
            <label class="pham-fit__radio"><input type="radio" name="preference" value="relaxed"><span>RELAXED</span></label>
          </fieldset>
          <button type="submit">RECOMMEND A SIZE <span aria-hidden="true">→</span></button>
        </form>
        <div class="pham-fit__result" data-pham-fit-result aria-live="polite" aria-atomic="true">
          <div class="pham-fit__result-size" data-pham-fit-result-size>—</div>
          <h3 data-pham-fit-result-title>{% if recommendation_enabled %}Enter your measurements{% else %}Recommendation unavailable{% endif %}</h3>
          <p data-pham-fit-result-copy>{% if recommendation_enabled %}This tool suggests a starting size. Always verify it against the garment chart above.{% else %}Please use the verified garment chart while fit recommendations are disabled.{% endif %}</p>
          <div class="pham-fit__result-meta" data-pham-fit-result-meta></div>
        </div>
      </div>
    </section>

    <div class="pham-fit__footer">
      <a href="{{ section.settings.product_url | default: '/products/pham-001' }}">BACK TO PHAM-001 <span aria-hidden="true">→</span></a>
    </div>
  </div>

  {%- if diagram_image != blank -%}
    <dialog class="pham-fit__modal" data-pham-fit-modal aria-label="Full size PHAM-001 measurement diagram">
      <div class="pham-fit__modal-head"><strong>Measurement diagram</strong><button type="button" data-pham-fit-close aria-label="Close enlarged diagram">CLOSE ×</button></div>
      <div class="pham-fit__modal-scroll">
        {{ diagram_image | image_url: width: 1600 | image_tag: class: 'pham-fit__modal-img', loading: 'lazy', decoding: 'async', widths: '900, 1200, 1448, 1600', sizes: 'max(900px, 96vw)', alt: 'Enlarged PHAM-001 size guide: A shoulder, B chest, C body, D sleeve, E hem' }}
      </div>
      <p>Scroll to inspect details. A shoulder · B chest · C body · D sleeve · E hem.</p>
    </dialog>
  {%- endif -%}
</section>

<style>
.pham-fit{background:#090a0c;color:#f3f2ef;padding:clamp(92px,9vw,132px) 0 84px;min-height:100vh}
.pham-fit *{box-sizing:border-box}
.pham-fit__inner{width:min(1160px,calc(100% - 48px));margin-inline:auto}
.pham-fit__kicker,.pham-fit__section-title>p,.pham-fit__measurements-heading>div>p,.pham-fit__result-label{font:600 11px/1.45 var(--font-mono,monospace);letter-spacing:.12em;color:#aaa9a5}
.pham-fit__hero{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:clamp(24px,5vw,72px);align-items:end;border-bottom:1px solid #303135;padding-bottom:42px}
.pham-fit__hero h1{font:400 clamp(3.9rem,7.1vw,7.7rem)/.98 var(--font-display,Arial,sans-serif);letter-spacing:-.055em;margin:16px 0 20px}
.pham-fit__hero h1 em{font-style:normal;color:#b6b5b0}
.pham-fit__hero-copy{max-width:52ch;margin:0;color:#c4c3be;font:400 clamp(15px,1.2vw,17px)/1.65 var(--font-body,Arial,sans-serif)}
.pham-fit__hero-facts{display:flex;flex-wrap:wrap;gap:8px;margin-top:24px}
.pham-fit__hero-facts span{border:1px solid #34363a;border-radius:2px;padding:8px 11px;font:500 11px/1.25 var(--font-body,Arial,sans-serif);color:#c6c5c0}
.pham-fit__jump-links{display:flex;flex-direction:column;gap:0}
.pham-fit__jump-links a{display:flex;align-items:center;gap:14px;min-height:54px;border-bottom:1px solid #303135;color:#f2f1ee;text-decoration:none;font:500 13px/1.45 var(--font-body,Arial,sans-serif)}
.pham-fit__jump-links a:first-child{border-top:1px solid #303135}
.pham-fit__jump-links a span:first-child{font:600 11px/1 var(--font-mono,monospace);color:#999}
.pham-fit__jump-links a span:last-child{margin-left:auto;font-size:17px}
.pham-fit a:focus-visible,.pham-fit button:focus-visible,.pham-fit input:focus-visible{outline:2px solid #f6f5f1;outline-offset:4px}
.pham-fit__jump-links a:hover{color:#fff;background:rgba(255,255,255,.04)}
.pham-fit__quick,.pham-fit__measurement-section,.pham-fit__how,.pham-fit__assistant{padding-block:clamp(46px,6vw,76px);border-bottom:1px solid #2d2f31;scroll-margin-top:90px}
.pham-fit__section-title{max-width:760px}
.pham-fit__section-title>p{margin:0 0 12px}
.pham-fit__section-title h2{margin:0;font:400 clamp(2.05rem,3.8vw,3.75rem)/1.08 var(--font-display,Arial,sans-serif);letter-spacing:-.035em}
.pham-fit__section-title>span{display:block;margin-top:10px;color:#bcbab5;font:400 14px/1.6 var(--font-body,Arial,sans-serif)}
.pham-fit__quick-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:28px}
.pham-fit__quick-grid button{display:flex;flex-direction:column;align-items:flex-start;gap:9px;min-height:124px;text-align:left;padding:18px;border:1px solid #383a3e;border-radius:3px;background:#101114;color:#f4f3ef;cursor:pointer;transition:background .16s ease,border-color .16s ease}
.pham-fit__quick-grid button strong{font:400 32px/1 var(--font-display,Arial,sans-serif)}
.pham-fit__quick-grid button span{font:600 14px/1.2 var(--font-mono,monospace)}
.pham-fit__quick-grid button small{font:500 11px/1.2 var(--font-body,Arial,sans-serif);color:#adaba6}
.pham-fit__quick-grid button:hover{border-color:#aaa9a5}
.pham-fit__quick-grid button.is-active{background:#eae9e5;border-color:#f4f3ef;color:#0b0c0f}
.pham-fit__quick-grid button.is-active small{color:#515258}
.pham-fit__help,.pham-fit__tech-note{color:#aaa9a4;font:400 13px/1.65 var(--font-body,Arial,sans-serif);max-width:80ch;margin:15px 0 0}
.pham-fit__diagram-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(260px,.55fr);gap:20px;margin-top:30px;align-items:start}
.pham-fit__figure{margin:0;overflow:hidden;border:1px solid #333539;border-radius:3px;background:#000}
.pham-fit__diagram-image{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:contain}
.pham-fit__image-fallback{padding:60px 22px;text-align:center;color:#c0beba}
.pham-fit__figure figcaption{display:flex;gap:12px;justify-content:space-between;align-items:center;padding:9px 14px 10px;border-top:1px solid #27292d}
.pham-fit__figure figcaption span{font:600 10px/1.45 var(--font-mono,monospace);color:#aaa9a5;letter-spacing:.05em}
.pham-fit__figure figcaption button{display:flex;gap:10px;align-items:center;justify-content:center;min-height:44px;border:1px solid #56585a;padding:8px 13px;color:#f1f0ec;background:transparent;cursor:pointer;font:600 11px/1.3 var(--font-body,Arial,sans-serif)}
.pham-fit__figure figcaption button:hover{background:#ededeb;color:#08090b}
.pham-fit__legend{display:flex;flex-direction:column;border:1px solid #313337;border-radius:3px;background:#101114}
.pham-fit__legend>div{display:flex;gap:14px;align-items:flex-start;padding:17px;border-bottom:1px solid #303135}
.pham-fit__legend>div:last-child{border-bottom:0}
.pham-fit__legend>div>span{display:grid;place-items:center;flex:0 0 34px;height:34px;border:1px solid #575a5c;border-radius:2px;font:600 15px/1 var(--font-mono,monospace)}
.pham-fit__legend strong{display:block;margin-bottom:5px;font:600 14px/1.35 var(--font-body,Arial,sans-serif)}
.pham-fit__legend p{margin:0;color:#b1afaa;font:400 12px/1.55 var(--font-body,Arial,sans-serif)}
.pham-fit__measurements{margin-top:32px}
.pham-fit__measurements-heading{display:flex;justify-content:space-between;align-items:end;gap:16px;margin-bottom:18px}
.pham-fit__measurements-heading>div>p{margin:0 0 8px}
.pham-fit__measurements-heading h3{margin:0;font:400 clamp(24px,2.5vw,34px)/1.16 var(--font-display,Arial,sans-serif)}
.pham-fit__measurements-heading>span{color:#dcdad4;font:600 12px/1.45 var(--font-mono,monospace);white-space:nowrap}
.pham-fit__table-wrap{width:100%;overflow-x:auto}
.pham-fit__table{width:100%;border-collapse:collapse;min-width:740px}
.pham-fit__table caption{position:absolute;clip:rect(0 0 0 0);width:1px;height:1px;overflow:hidden}
.pham-fit__table thead th{text-align:left;padding:15px 13px;border-block:1px solid #3a3c40;color:#b5b4ae;background:#131417;font:600 11px/1.35 var(--font-body,Arial,sans-serif);letter-spacing:.025em}
.pham-fit__table tbody tr{border-bottom:1px solid #34363a}
.pham-fit__table tbody tr.is-highlighted{background:#232529;outline:1px solid #989a9c;outline-offset:-1px}
.pham-fit__table tbody th{text-align:left;padding:16px 13px;font:500 23px/1.1 var(--font-display,Arial,sans-serif)}
.pham-fit__table tbody td{padding:16px 13px;color:#efede7;font:500 14px/1.3 var(--font-mono,monospace);white-space:nowrap}
.pham-fit__compare-toggle{display:none}
.pham-fit__how-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;padding:0;margin:28px 0 0;list-style:none}
.pham-fit__how-grid li{border:1px solid #33353a;border-radius:3px;padding:20px;background:#101114}
.pham-fit__how-grid li>span{font:600 12px/1.2 var(--font-mono,monospace);color:#aaa9a5}
.pham-fit__how-grid li strong{display:block;margin-top:20px;font:600 16px/1.4 var(--font-body,Arial,sans-serif)}
.pham-fit__how-grid li p{margin:7px 0 0;color:#bcbab5;font:400 13px/1.6 var(--font-body,Arial,sans-serif)}
.pham-fit__assistant-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:27px}
.pham-fit__form,.pham-fit__result{padding:clamp(20px,3vw,30px);border:1px solid #35373a;border-radius:3px;background:#101114}
.pham-fit__form{display:grid;grid-template-columns:1fr 1fr;gap:19px}
.pham-fit__form>label span{display:block;color:#dedbd5;font:600 13px/1.45 var(--font-body,Arial,sans-serif)}
.pham-fit__form>label span strong,.pham-fit__form>label span small{display:inline-block;font-weight:400;color:#aaa9a5;font-size:11px;margin-left:4px}
.pham-fit__form>label>div{display:flex;align-items:center;gap:10px;border:1px solid #585a5d;border-radius:2px;padding:0 13px;margin-top:9px}
.pham-fit__form input[type=number]{width:100%;min-width:0;min-height:50px;background:transparent;border:0;outline:0;font:500 18px/1 var(--font-mono,monospace);color:#fff}
.pham-fit__form em{font:500 12px/1 var(--font-mono,monospace);color:#aaa9a5;font-style:normal}
.pham-fit__form fieldset{grid-column:1/-1;display:flex;gap:8px;flex-wrap:wrap;border:0;margin:0;padding:0}
.pham-fit__form legend{width:100%;margin-bottom:9px;color:#dedbd5;font:600 13px/1.4 var(--font-body,Arial,sans-serif)}
.pham-fit__radio{position:relative}
.pham-fit__radio input{position:absolute;opacity:0;inset:0}
.pham-fit__radio span{display:grid;place-items:center;padding:12px 16px;min-height:44px;border:1px solid #55585c;border-radius:2px;cursor:pointer;font:600 12px/1.2 var(--font-body,Arial,sans-serif);color:#d2d1cd}
.pham-fit__radio input:checked+span{color:#101114;border-color:#f2f0ec;background:#f2f0ec}
.pham-fit__radio input:focus-visible+span{outline:2px solid #fff;outline-offset:4px}
.pham-fit__form>button{grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;min-height:52px;border:1px solid #f2f0ec;border-radius:2px;padding:12px 18px;color:#090a0d;background:#f2f0ec;cursor:pointer;font:700 12px/1.2 var(--font-body,Arial,sans-serif);letter-spacing:.06em}
.pham-fit__form>button:hover{background:#d9d8d3}
.pham-fit__result{display:flex;flex-direction:column;justify-content:center}
.pham-fit__result-label{margin:0}
.pham-fit__result-size{font:400 clamp(70px,9vw,122px)/.95 var(--font-display,Arial,sans-serif);margin:18px 0}
.pham-fit__result h3{margin:0 0 10px;font:500 21px/1.3 var(--font-body,Arial,sans-serif)}
.pham-fit__result p{margin:0;color:#bcbab5;font:400 14px/1.6 var(--font-body,Arial,sans-serif)}
.pham-fit__result-meta{white-space:pre-line;margin-top:16px;color:#aaa9a5;font:500 11px/1.8 var(--font-mono,monospace)}
.pham-fit__footer{display:flex;justify-content:space-between;align-items:center;gap:22px;padding:36px 0 0}
.pham-fit__footer strong{font:600 19px/1.4 var(--font-body,Arial,sans-serif)}
.pham-fit__footer p{margin:6px 0 0;color:#aaa9a5;font:400 13px/1.55 var(--font-body,Arial,sans-serif)}
.pham-fit__footer a{display:flex;justify-content:space-between;align-items:center;gap:26px;min-height:52px;flex:0 0 auto;color:#08090c;background:#eeeae4;padding:14px 18px;text-decoration:none;font:700 12px/1.35 var(--font-body,Arial,sans-serif);letter-spacing:.05em}
.pham-fit__modal{width:min(98vw,1360px);max-width:none;max-height:95vh;padding:0;border:1px solid #56585b;background:#07080a;color:#faf9f6}
.pham-fit__modal::backdrop{background:rgba(0,0,0,.88)}
