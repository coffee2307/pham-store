{%- liquid
  assign edition_label = section.settings.edition_label | default: 'EDITION 01'
  assign product_code = section.settings.product_code | default: 'PHAM-001'
  assign recommendation_enabled = section.settings.enable_recommendation
-%}

<section class="pham-fit" data-pham-fit-guide
  data-recommendation-enabled="{% if recommendation_enabled %}true{% else %}false{% endif %}"
  data-intended-ease="{{ section.settings.intended_chest_ease | default: 30 }}"
  data-intended-shoulder-ease="{{ section.settings.intended_shoulder_ease | default: 9 }}">
  <div class="pham-fit__inner">

    <header class="pham-fit__hero">
      <div>
        <p class="pham-fit__kicker">PHAM FIT SYSTEM / 001</p>
        <h1>{{ product_code }}<br><span>SIZE GUIDE</span></h1>
        <p class="pham-fit__hero-copy">Cropped body. Dropped shoulder. Controlled oversized volume.</p>
      </div>
      <aside class="pham-fit__hero-card">
        <span>{{ edition_label }}</span>
        <strong>START WITH YOUR CHEST</strong>
        <p>Then refine by shoulder and compare with a jacket you already like.</p>
        <div><b>M</b><b>L</b><b>XL</b><b>XXL</b></div>
      </aside>
    </header>

    <section class="pham-fit__fit-overview">
      <div class="pham-fit__fit-card">
        <span>01</span>
        <div><strong>CROPPED BODY</strong><p>Shorter hem by design.</p></div>
      </div>
      <div class="pham-fit__fit-card">
        <span>02</span>
        <div><strong>DROPPED SHOULDER</strong><p>Relaxed shoulder line.</p></div>
      </div>
      <div class="pham-fit__fit-card">
        <span>03</span>
        <div><strong>ROOM THROUGH BODY</strong><p>Controlled oversized ease.</p></div>
      </div>
    </section>

    <section class="pham-fit__quick">
      <div class="pham-fit__section-title">
        <p>01 / QUICK SIZE</p>
        <h2>Start here.</h2>
        <span>Use body chest as the first reference.</span>
      </div>
      <div class="pham-fit__quick-grid">
        <button type="button" data-pham-quick-size="M"><span>M</span><strong>98–101 CM</strong><small>BODY CHEST</small></button>
        <button type="button" data-pham-quick-size="L"><span>L</span><strong>102–105 CM</strong><small>BODY CHEST</small></button>
        <button type="button" data-pham-quick-size="XL"><span>XL</span><strong>106–109 CM</strong><small>TECH-PACK ANCHOR</small></button>
        <button type="button" data-pham-quick-size="XXL"><span>XXL</span><strong>110–114 CM</strong><small>BODY CHEST</small></button>
      </div>
      <p class="pham-fit__quick-note">These are starting ranges, not hard limits. If you sit between sizes, compare the garment chart below with a jacket you already like.</p>
    </section>

    <section class="pham-fit__diagram-section">
      <div class="pham-fit__section-title">
        <p>02 / GARMENT MAP</p>
        <h2>Know what A–D mean.</h2>
      </div>
      <div class="pham-fit__diagram-grid">
        <div class="pham-fit__figure" aria-label="PHAM-001 technical flat showing garment measurements">
          <svg viewBox="0 0 520 420" role="img" aria-labelledby="PhamFitFigureTitle">
            <title id="PhamFitFigureTitle">PHAM-001 technical flat and garment measurement points</title>
            <defs>
              <marker id="phamFitArrow" markerWidth="7" markerHeight="7" refX="3.5" refY="3.5" orient="auto-start-reverse">
                <path d="M0,0 L7,3.5 L0,7 Z" fill="currentColor"/>
              </marker>
            </defs>
            <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <g stroke-width="1.5">
                <path d="M247 58 Q260 48 273 58 L303 72 L350 86 L389 119 L448 226 L415 244 L347 152 L339 311 Q260 330 181 311 L173 152 L105 244 L72 226 L131 119 L170 86 L217 72 Z"/>
                <path d="M217 72 Q231 98 260 100 Q289 98 303 72"/>
                <path d="M247 58 L238 91 M273 58 L282 91"/>
                <path d="M260 100 V318"/>
                <path d="M181 311 Q260 324 339 311"/>
                <path d="M78 224 L111 244 M409 244 L442 224"/>
                <path d="M188 218 L229 204 L236 232 L194 244 Z"/>
                <path d="M332 218 L291 204 L284 232 L326 244 Z"/>
                <path d="M173 152 Q181 126 203 110 M347 152 Q339 126 317 110"/>
              </g>
              <g stroke-width="1.2" marker-start="url(#phamFitArrow)" marker-end="url(#phamFitArrow)">
                <path d="M181 186 H339"/>
                <path d="M203 109 H317"/>
                <path d="M321 105 L420 237"/>
                <path d="M367 101 V311"/>
              </g>
            </g>
            <g fill="#050505" stroke="currentColor" stroke-width="1">
              <circle cx="260" cy="186" r="13"/><circle cx="260" cy="109" r="13"/><circle cx="372" cy="171" r="13"/><circle cx="367" cy="206" r="13"/>
            </g>
            <g fill="currentColor" font-size="11" font-family="ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" text-anchor="middle" dominant-baseline="middle">
              <text x="260" y="186">A</text><text x="260" y="109">B</text><text x="372" y="171">C</text><text x="367" y="206">D</text>
            </g>
          </svg>
        </div>
        <div class="pham-fit__legend">
          <div><span>A</span><strong>CHEST WIDTH</strong><p>Pit-to-pit, jacket laid flat.</p></div>
          <div><span>B</span><strong>SHOULDER</strong><p>Shoulder seam to shoulder seam.</p></div>
          <div><span>C</span><strong>SLEEVE</strong><p>Shoulder seam to cuff.</p></div>
          <div><span>D</span><strong>BODY LENGTH</strong><p>Back neck to hem.</p></div>
        </div>
      </div>
    </section>

    <section class="pham-fit__measurements">
      <div class="pham-fit__section-title">
        <p>03 / FINISHED GARMENT</p>
        <h2>PHAM-001 measurements.</h2>
        <span>Garment laid flat · centimeters</span>
      </div>
      <div class="pham-fit__table-wrap">
        <table class="pham-fit__table">
          <thead><tr><th>Size</th><th>A · Chest</th><th>B · Shoulder</th><th>C · Sleeve</th><th>D · Body</th></tr></thead>
          <tbody>
            <tr data-pham-fit-size="M" data-chest="{{ section.settings.m_chest }}" data-shoulder="{{ section.settings.m_shoulder }}" data-sleeve="{{ section.settings.m_sleeve }}" data-length="{{ section.settings.m_length }}">
              <th>M</th><td>{{ section.settings.m_chest }} cm</td><td>{{ section.settings.m_shoulder }} cm</td><td>{{ section.settings.m_sleeve }} cm</td><td>{{ section.settings.m_length }} cm</td>
            </tr>
            <tr data-pham-fit-size="L" data-chest="{{ section.settings.l_chest }}" data-shoulder="{{ section.settings.l_shoulder }}" data-sleeve="{{ section.settings.l_sleeve }}" data-length="{{ section.settings.l_length }}">
              <th>L</th><td>{{ section.settings.l_chest }} cm</td><td>{{ section.settings.l_shoulder }} cm</td><td>{{ section.settings.l_sleeve }} cm</td><td>{{ section.settings.l_length }} cm</td>
            </tr>
            <tr data-pham-fit-size="XL" data-chest="{{ section.settings.xl_chest }}" data-shoulder="{{ section.settings.xl_shoulder }}" data-sleeve="{{ section.settings.xl_sleeve }}" data-length="{{ section.settings.xl_length }}">
              <th>XL</th><td>{{ section.settings.xl_chest }} cm</td><td>{{ section.settings.xl_shoulder }} cm</td><td>{{ section.settings.xl_sleeve }} cm</td><td>{{ section.settings.xl_length }} cm</td>
            </tr>
            <tr data-pham-fit-size="XXL" data-chest="{{ section.settings.xxl_chest }}" data-shoulder="{{ section.settings.xxl_shoulder }}" data-sleeve="{{ section.settings.xxl_sleeve }}" data-length="{{ section.settings.xxl_length }}">
              <th>XXL</th><td>{{ section.settings.xxl_chest }} cm</td><td>{{ section.settings.xxl_shoulder }} cm</td><td>{{ section.settings.xxl_sleeve }} cm</td><td>{{ section.settings.xxl_length }} cm</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="pham-fit__tech-note">XL = current tech-pack anchor · M / L / XXL = Edition 01 grading proposal.</p>
    </section>

    <section class="pham-fit__how">
      <div class="pham-fit__section-title">
        <p>04 / HOW TO MEASURE</p>
        <h2>Four measurements. One minute.</h2>
      </div>
      <div class="pham-fit__how-grid">
        <article><span>01</span><strong>CHEST</strong><p>Around the fullest part of your chest, tape level and relaxed.</p></article>
        <article><span>02</span><strong>SHOULDER</strong><p>Straight across the back from shoulder point to shoulder point.</p></article>
        <article><span>03</span><strong>SLEEVE</strong><p>On a jacket you like, shoulder seam to cuff.</p></article>
        <article><span>04</span><strong>BODY LENGTH</strong><p>On a jacket you like, back neck to hem.</p></article>
      </div>
      <div class="pham-fit__best-method">
        <span>BEST METHOD</span>
        <div><strong>COMPARE A JACKET YOU ALREADY LIKE.</strong><p>Lay it flat, measure A–D, then match those numbers to the PHAM-001 table above.</p></div>
      </div>
    </section>

    <section class="pham-fit__assistant">
      <div class="pham-fit__section-title">
        <p>05 / FIT ASSISTANT</p>
        <h2>Get a starting size.</h2>
        <span>Chest drives the recommendation. Shoulder refines it.</span>
      </div>
      <div class="pham-fit__assistant-grid">
        <form class="pham-fit__form" data-pham-fit-form>
          <label class="is-primary"><span>Chest</span><div><input type="number" name="chest" min="70" max="160" inputmode="decimal" placeholder="106" required><em>CM</em></div></label>
          <label class="is-primary"><span>Shoulder</span><div><input type="number" name="shoulder" min="32" max="65" inputmode="decimal" placeholder="47"><em>CM</em></div></label>
          <label><span>Height <small>optional</small></span><div><input type="number" name="height" min="140" max="215" inputmode="decimal" placeholder="175"><em>CM</em></div></label>
          <label><span>Weight <small>optional</small></span><div><input type="number" name="weight" min="35" max="180" inputmode="decimal" placeholder="65"><em>KG</em></div></label>
          <fieldset>
            <legend>Fit preference</legend>
            <label class="pham-fit__radio"><input type="radio" name="preference" value="close"><span>CLEANER</span></label>
            <label class="pham-fit__radio"><input type="radio" name="preference" value="intended" checked><span>PHAM FIT</span></label>
            <label class="pham-fit__radio"><input type="radio" name="preference" value="relaxed"><span>MORE OVERSIZED</span></label>
          </fieldset>
          <button type="submit">FIND MY SIZE →</button>
        </form>
        <div class="pham-fit__result" data-pham-fit-result aria-live="polite">
          <span class="pham-fit__result-label">PHAM FIT / {{ product_code }}</span>
          <div class="pham-fit__result-size" data-pham-fit-result-size>—</div>
          <h3 data-pham-fit-result-title>{% if recommendation_enabled %}ENTER CHEST + SHOULDER{% else %}CALIBRATION PENDING{% endif %}</h3>
          <p data-pham-fit-result-copy>{% if recommendation_enabled %}We compare your measurements with the Edition 01 garment table and your preferred silhouette.{% else %}Automatic recommendation is currently disabled.{% endif %}</p>
          <div class="pham-fit__result-meta" data-pham-fit-result-meta></div>
        </div>
      </div>
    </section>

    <footer class="pham-fit__footer">
      <p>Fit recommendations are guidance. Layering, body shape and personal preference can change how a cropped bomber feels.</p>
      <a href="{{ section.settings.product_url | default: '/products/pham-001' }}">RETURN TO {{ product_code }} →</a>
    </footer>
  </div>
</section>

<style>
