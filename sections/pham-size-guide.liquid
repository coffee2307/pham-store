e{gap:8px}.pham-fit__intro-grid{gap:36px;padding:56px 0}.pham-fit__section{padding:52px 0}.pham-fit__section-head h2,.pham-fit__section-head>p:last-child{grid-column:1}.pham-fit__measure-grid,.pham-fit__selection{grid-template-columns:1fr 1fr}.pham-fit__measure-grid article{min-height:180px}.pham-fit__form{grid-template-columns:1fr}.pham-fit__form fieldset,.pham-fit__form button{grid-column:1}.pham-fit__result{min-height:360px}.pham-fit__footer{flex-direction:column}}@media(max-width:480px){.pham-fit__measure-grid,.pham-fit__selection{grid-template-columns:1fr}}
/* PHAM fit guide readability + technical-flat pass */
.pham-fit__inner{width:min(1280px,calc(100% - 56px))}
.pham-fit__hero-meta{font-size:12px;line-height:1.45}
.pham-fit__notice{grid-template-columns:minmax(260px,.8fr) 1.6fr;font-size:13px;line-height:1.5;padding:20px 0}
.pham-fit__intro-grid{grid-template-columns:minmax(0,1fr) minmax(420px,.92fr);gap:clamp(54px,6vw,92px);padding:72px 0 84px;align-items:center}
.pham-fit__copy h2{max-width:11ch;font-size:clamp(42px,5.2vw,72px);line-height:.94;margin-bottom:24px}
.pham-fit__copy .pham-fit__lead{max-width:52ch;color:#d1d0cb;font-size:17px;line-height:1.58;margin:0}
.pham-fit__fit-points{display:grid;margin-top:30px;border-top:1px solid #2d2d2d}
.pham-fit__fit-points>div{display:grid;grid-template-columns:44px 1fr;column-gap:16px;padding:16px 0;border-bottom:1px solid #252525}
.pham-fit__fit-points span{grid-row:1/3;color:#6f6f6b;font:600 10px/1.4 monospace;letter-spacing:.1em}
.pham-fit__fit-points strong{color:#f2f2ef;font:600 12px/1.35 monospace;letter-spacing:.09em}
.pham-fit__fit-points em{margin-top:4px;color:#979792;font:400 14px/1.45 var(--font-body,Arial,sans-serif);font-style:normal}
.pham-fit__copy .pham-fit__compare-note{max-width:54ch;margin:22px 0 0;color:#aaa9a5;font-size:14px;line-height:1.55}
.pham-fit__compare-note strong{color:#f0f0eb;font-weight:600}
.pham-fit__figure{padding:30px;background:linear-gradient(180deg,#0a0a0a,#070707)}
.pham-fit__figure svg{max-height:430px;color:#e2e2dd}
.pham-fit__figure-key{font-size:12px;gap:12px;padding-top:20px}
.pham-fit__section-head>p:not(.pham-fit__eyebrow){font-size:15.5px;line-height:1.62;max-width:62ch}
.pham-fit__table th,.pham-fit__table td{font-size:14px;padding:21px 18px}
.pham-fit__selection-note{font-size:13.5px;max-width:72ch}
.pham-fit__measure-grid p,.pham-fit__compare p{font-size:14px;line-height:1.6}
.pham-fit__result p{font-size:14px;line-height:1.6}
.pham-fit__footer p{font-size:13px}
@media(max-width:900px){
  .pham-fit__inner{width:min(100% - 32px,1280px)}
  .pham-fit__intro-grid{grid-template-columns:1fr;gap:42px;padding:56px 0 64px}
  .pham-fit__copy h2{max-width:12ch}
  .pham-fit__figure{padding:22px}
}
@media(max-width:560px){
  .pham-fit__inner{width:min(100% - 24px,1280px)}
  .pham-fit__notice{font-size:12.5px}
  .pham-fit__copy .pham-fit__lead{font-size:16px}
  .pham-fit__fit-points em{font-size:13px}
  .pham-fit__figure{padding:16px}
  .pham-fit__figure-key{font-size:11px}
}
</style>

<script>
(function(){
  var root=document.currentScript&&document.currentScript.previousElementSibling;while(root&&!root.matches('[data-pham-fit-guide]'))root=root.previousElementSibling;if(!root)root=document.querySelector('[data-pham-fit-guide]');if(!root)return;
  var form=root.querySelector('[data-pham-fit-form]'),sizeOut=root.querySelector('[data-pham-fit-result-size]'),titleOut=root.querySelector('[data-pham-fit-result-title]'),copyOut=root.querySelector('[data-pham-fit-result-copy]'),metaOut=root.querySelector('[data-pham-fit-result-meta]');
  var enabled=root.dataset.recommendationEnabled==='true',intendedEase=Number(root.dataset.intendedEase||30),intendedShoulderEase=Number(root.dataset.intendedShoulderEase||9);
  function num(v){var n=Number(v);return Number.isFinite(n)?n:0}
  var sizes=Array.prototype.map.call(root.querySelectorAll('[data-pham-fit-size]'),function(row){return{size:row.dataset.phamFitSize,chestFlat:num(row.dataset.chest),shoulder:num(row.dataset.shoulder),sleeve:num(row.dataset.sleeve),length:num(row.dataset.length)}})
  function calibrated(){return enabled&&sizes.length===4&&sizes.every(function(x){return x.chestFlat>0&&x.shoulder>0&&x.sleeve>0&&x.length>0})}
  form.addEventListener('submit',function(e){e.preventDefault();if(!calibrated()){sizeOut.textContent='—';titleOut.textContent='Calibration pending';copyOut.textContent='PHAM has not enabled automatic recommendations because the verified Edition 01 production measurements are incomplete. The system will not estimate a size from generic brand data.';metaOut.textContent='AVAILABLE SIZES · M / L / XL / XXL\nNEXT INPUT · VERIFIED PHAM-001 GARMENT SPEC';return}
    var data=new FormData(form),chest=num(data.get('chest')),shoulder=num(data.get('shoulder')),height=num(data.get('height')),weight=num(data.get('weight')),preference=String(data.get('preference')||'intended');if(chest<=0){sizeOut.textContent='—';titleOut.textContent='Chest measurement required';copyOut.textContent='Measure around the fullest part of your chest in centimeters, then run the fit analysis again.';metaOut.textContent='';return}
    var chestAdjust=preference==='close'?-6:(preference==='relaxed'?6:0),shoulderAdjust=preference==='close'?-2:(preference==='relaxed'?2:0),targetEase=Math.max(18,intendedEase+chestAdjust),targetShoulderEase=intendedShoulderEase+shoulderAdjust,targetChest=chest+targetEase;
    var ranked=sizes.map(function(x){var garmentChest=x.chestFlat*2,chestDelta=Math.abs(garmentChest-targetChest),shoulderDelta=shoulder>0?Math.abs(x.shoulder-(shoulder+targetShoulderEase)):0;return Object.assign({},x,{garmentChest:garmentChest,score:chestDelta+(shoulder>0?shoulderDelta*1.25:0)})}).sort(function(a,b){return a.score-b.score});
    var best=ranked[0],second=ranked[1],actualEase=best.garmentChest-chest;sizeOut.textContent=best.size;titleOut.textContent=preference==='close'?'Closer silhouette':(preference==='relaxed'?'More room through the body':'PHAM intended fit');copyOut.textContent='Recommended from the PHAM-001 Edition 01 grading table and your selected fit preference. Chest drives the result; shoulder refines it. Check body length and sleeve length before confirming your final size.';metaOut.textContent='BODY CHEST · '+chest.toFixed(0)+' CM\nGARMENT CHEST · '+best.garmentChest.toFixed(0)+' CM\nCHEST EASE · '+actualEase.toFixed(0)+' CM\n'+(height?'HEIGHT · '+height.toFixed(0)+' CM\n':'')+(weight?'WEIGHT · '+weight.toFixed(0)+' KG · CONTEXT ONLY\n':'')+(second?'ALTERNATIVE · '+second.size:'')
  })
})();
</script>

{% schema %}
{
  "name": "PHAM edition size guide",
  "settings": [
    {"type":"text","id":"edition_label","label":"Edition label","default":"EDITION 01"},
    {"type":"text","id":"product_code","label":"Product code","default":"PHAM-001"},
    {"type":"url","id":"product_url","label":"Product URL"},
    {"type":"checkbox","id":"enable_recommendation","label":"Enable automatic fit recommendation","default":true,"info":"PHAM-001 uses the XL tech-pack anchor and the Edition 01 grading proposal. Reconfirm after factory graded-pattern review."},
    {"type":"number","id":"intended_chest_ease","label":"Intended chest ease (cm)","default":30,"info":"Oversized PHAM-001 target. Close fit subtracts 6 cm; relaxed fit adds 6 cm."},
    {"type":"number","id":"intended_shoulder_ease","label":"Intended shoulder ease (cm)","default":9,"info":"Dropped-shoulder target used only when the customer supplies a shoulder measurement."},
    {"type":"header","content":"M · graded from XL anchor"},
    {"type":"number","id":"m_chest","label":"M chest width / flat (cm)","default":65},{"type":"number","id":"m_shoulder","label":"M shoulder (cm)","default":54},{"type":"number","id":"m_sleeve","label":"M sleeve (cm)","default":65},{"type":"number","id":"m_length","label":"M body length (cm)","default":63},
    {"type":"header","content":"L · graded from XL anchor"},
    {"type":"number","id":"l_chest","label":"L chest width / flat (cm)","default":67},{"type":"number","id":"l_shoulder","label":"L shoulder (cm)","default":55},{"type":"number","id":"l_sleeve","label":"L sleeve (cm)","default":66},{"type":"number","id":"l_length","label":"L body length (cm)","default":64},
    {"type":"header","content":"XL · tech pack anchor"},
    {"type":"number","id":"xl_chest","label":"XL chest width / flat (cm)","default":69},{"type":"number","id":"xl_shoulder","label":"XL shoulder (cm)","default":56},{"type":"number","id":"xl_sleeve","label":"XL sleeve (cm)","default":67},{"type":"number","id":"xl_length","label":"XL body length (cm)","default":65},
    {"type":"header","content":"XXL · graded from XL anchor"},
    {"type":"number","id":"xxl_chest","label":"XXL chest width / flat (cm)","default":71},{"type":"number","id":"xxl_shoulder","label":"XXL shoulder (cm)","default":57},{"type":"number","id":"xxl_sleeve","label":"XXL sleeve (cm)","default":68},{"type":"number","id":"xxl_length","label":"XXL body length (cm)","default":66}
  ],
  "presets": [{"name":"PHAM edition size guide"}]
}
{% endschema %}
