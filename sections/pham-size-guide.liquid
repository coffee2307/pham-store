<script>
(function(){
  var root=document.querySelector('[data-pham-fit-guide]');
  if(!root)return;
  var form=root.querySelector('[data-pham-fit-form]');
  var sizeOut=root.querySelector('[data-pham-fit-result-size]');
  var titleOut=root.querySelector('[data-pham-fit-result-title]');
  var copyOut=root.querySelector('[data-pham-fit-result-copy]');
  var metaOut=root.querySelector('[data-pham-fit-result-meta]');
  var selectedOut=root.querySelector('[data-pham-selected-size]');
  var enabled=root.dataset.recommendationEnabled==='true';
  var intendedEase=Number(root.dataset.intendedEase||30);
  var intendedShoulderEase=Number(root.dataset.intendedShoulderEase||9);
  var num=function(v){var n=Number(v);return Number.isFinite(n)?n:0};
  var sizes=Array.from(root.querySelectorAll('[data-pham-fit-size]')).map(function(row){
    return {size:row.dataset.phamFitSize,chestFlat:num(row.dataset.chest),shoulder:num(row.dataset.shoulder),sleeve:num(row.dataset.sleeve),length:num(row.dataset.length),row:row};
  });
  var buttons=Array.from(root.querySelectorAll('[data-pham-quick-size]'));
  function highlight(size,scroll){
    sizes.forEach(function(x){x.row.classList.toggle('is-highlighted',x.size===size)});
    buttons.forEach(function(btn){
      var active=btn.dataset.phamQuickSize===size;
      btn.classList.toggle('is-active',active);
      btn.setAttribute('aria-pressed',active?'true':'false');
    });
    if(selectedOut)selectedOut.textContent='Selected size: '+size;
    if(scroll){
      var target=root.querySelector('.pham-fit__measurements');
      if(target)target.scrollIntoView({behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'start'});
    }
  }
  var preview=root.querySelector('[data-pham-fit-preview]');
  buttons.forEach(function(btn){
    btn.addEventListener('click',function(){
      var size=btn.dataset.phamQuickSize;
      var row=sizes.find(function(x){return x.size===size});
      highlight(size,false);
      if(!row||!preview)return;
      preview.querySelector('[data-pham-preview-size]').textContent=size;
      [['shoulder',row.shoulder],['chest',row.chestFlat],['length',row.length],['sleeve',row.sleeve]].forEach(function(item){
        preview.querySelector('[data-pham-preview-'+item[0]+']').textContent=item[1]+' CM';
      });
      preview.classList.add('is-open');
      var box=preview.getBoundingClientRect();
      if(box.bottom>innerHeight-16 || box.top<75){
        preview.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'center'});
      }
    });
  });
  var compareBtn=root.querySelector('[data-pham-fit-compare]');
  var measurements=root.querySelector('.pham-fit__measurements');
  if(compareBtn&&measurements)compareBtn.addEventListener('click',function(){
    var expanded=measurements.classList.toggle('is-comparing');
    compareBtn.setAttribute('aria-expanded',expanded?'true':'false');
    compareBtn.innerHTML=(expanded?'SHOW SELECTED SIZE':'SHOW ALL FOUR SIZES')+' <span aria-hidden="true">+</span>';
  });
  function calibrated(){return enabled&&sizes.length===4&&sizes.every(function(x){return x.chestFlat>0&&x.shoulder>0&&x.sleeve>0&&x.length>0})}
  if(form)form.addEventListener('submit',function(e){
    e.preventDefault();
    if(!calibrated()){
      sizeOut.textContent='—';
      titleOut.textContent='Recommendation unavailable';
      copyOut.textContent='Please compare the garment chart above; size recommendations are not currently calibrated.';
      metaOut.textContent='';
      return;
    }
    var data=new FormData(form);
    var chest=num(data.get('chest'));
    var shoulder=num(data.get('shoulder'));
    var preference=String(data.get('preference')||'intended');
    if(chest<70||chest>160)return;
    var chestAdjust=preference==='close'?-6:(preference==='relaxed'?6:0);
    var shoulderAdjust=preference==='close'?-2:(preference==='relaxed'?2:0);
    var targetEase=Math.max(18,intendedEase+chestAdjust);
    var targetShoulderEase=intendedShoulderEase+shoulderAdjust;
    var ranked=sizes.map(function(x){
      var garmentChest=x.chestFlat*2;
      var chestDelta=Math.abs(garmentChest-(chest+targetEase));
      var shoulderDelta=shoulder>0?Math.abs(x.shoulder-(shoulder+targetShoulderEase)):0;
      return Object.assign({},x,{garmentChest:garmentChest,score:chestDelta+(shoulder>0?shoulderDelta*1.25:0)});
    }).sort(function(a,b){return a.score-b.score});
    var best=ranked[0],second=ranked[1];
    sizeOut.textContent=best.size;
    highlight(best.size,false);
    titleOut.textContent='Suggested starting size';
    copyOut.textContent='Start by comparing '+best.size+' with a jacket you own. This is an approximate fit suggestion, not a guaranteed match.';
    metaOut.textContent='BODY CHEST · '+chest.toFixed(0)+' CM\nGARMENT CHEST CIRCUMFERENCE · '+best.garmentChest.toFixed(0)+' CM\n'+(second?'ALTERNATIVE TO COMPARE · '+second.size:'');
  });
  var modal=root.querySelector('[data-pham-fit-modal]');
  var openBtn=root.querySelector('[data-pham-fit-expand]');
  var closeBtn=root.querySelector('[data-pham-fit-close]');
  if(modal&&openBtn&&closeBtn){
    openBtn.addEventListener('click',function(){modal.showModal()});
    closeBtn.addEventListener('click',function(){modal.close();openBtn.focus()});
    modal.addEventListener('click',function(e){if(e.target===modal)modal.close()});
  }
})();
</script>

