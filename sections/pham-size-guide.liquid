idth:720px}.pham-fit__table th,.pham-fit__table td{padding:20px 16px;border-bottom:1px solid #292929;text-align:left;font-size:13px}.pham-fit__table thead th{font:500 10px/1.4 monospace;letter-spacing:.1em;color:#858580;text-transform:uppercase}.pham-fit__table tbody th{font-size:22px;font-weight:500}.pham-fit__calibration{margin:22px 0 0;color:#a8a8a3}.pham-fit__selection{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#292929;border:1px solid #292929;margin-top:28px}.pham-fit__selection>div{background:#070707;padding:20px;display:grid;gap:12px}.pham-fit__selection span{font:500 9px/1.4 monospace;letter-spacing:.08em;color:#777}.pham-fit__selection strong{font-size:28px;font-weight:500}.pham-fit__selection em{font:500 11px monospace;font-style:normal;color:#aaa}.pham-fit__selection-note{font-size:12px;line-height:1.6;color:#858580;margin:14px 0 0}.pham-fit__measure-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#292929;margin-top:42px;border:1px solid #292929}.pham-fit__measure-grid article{background:#070707;padding:26px;min-height:210px}.pham-fit__measure-grid article>span{font:500 10px monospace;color:#777}.pham-fit__measure-grid h3{font-size:20px;margin:42px 0 12px}.pham-fit__measure-grid p,.pham-fit__compare p{font-size:13px;line-height:1.65;color:#9e9e99}.pham-fit__compare{display:grid;grid-template-columns:1fr 2fr;gap:30px;margin-top:28px;padding:24px;border:1px solid #292929}.pham-fit__compare strong{font:500 11px monospace;letter-spacing:.1em}.pham-fit__compare p{margin:0}.pham-fit__assistant-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#292929;border:1px solid #292929;margin-top:42px}.pham-fit__form,.pham-fit__result{background:#070707;padding:clamp(24px,4vw,48px)}.pham-fit__form{display:grid;grid-template-columns:1fr 1fr;gap:20px}.pham-fit__form>label>span,.pham-fit__form legend{display:block;margin-bottom:8px;font:500 10px monospace;letter-spacing:.1em;text-transform:uppercase;color:#8c