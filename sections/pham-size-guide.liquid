0;color:#8d8d88;font:400 .8rem/1.45 var(--font-body,Arial,sans-serif)}.pham-fit__quick,.pham-fit__diagram-section,.pham-fit__measurements,.pham-fit__how,.pham-fit__assistant{padding:68px 0;border-bottom:1px solid #292929}.pham-fit__section-title{display:grid;grid-template-columns:170px 1fr;column-gap:30px;align-items:end}.pham-fit__section-title h2{grid-column:2;margin:0;font:400 clamp(2.2rem,4.5vw,4.3rem)/.92 var(--font-display,Arial,sans-serif);letter-spacing:-.04em}.pham-fit__section-title>span{grid-column:2;margin-top:12px;color:#8f8f8a;font:400 .9rem/1.5 var(--font-body,Arial,sans-serif)}.pham-fit__quick-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:34px}.pham-fit__quick-grid button{display:grid;gap:9px;min-height:146px;padding:18px;text-align:left;border:1px solid #303030;background:#080808;color:#f2f2ef;cursor:pointer;transition:background 160ms ease,color 160ms ease,border-color 160ms ease}.pham-fit__quick-grid button:hover,.pham-fit__quick-grid button.is-active{background:#f2f2ef;color:#050505;border-color:#f2f2ef}.pham-fit__quick-grid span{font:400 2rem/1 var(--font-display,Arial,sans-serif)}.pham-fit__quick-grid strong{margin-top:auto;font:700 12px/1.2 var(--font-mono,monospace);letter-spacing:.06em}.pham-fit__quick-grid small{opacity:.58;font:600 8px/1 var(--font-mono,monospace);letter-spacing:.1em}.pham-fit__quick-note{max-width:72ch;margin:14px 0 0;color:#858580;font:400 .8rem/1.55 var(--font-body,Arial,sans-serif)}.pham-fit__diagram-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(260px,.75fr);gap:12px;margin-top:34px}.pham-fit__figure{display:flex;align-items:center;justify-content:center;min-height:480px;border:1px solid #303030;background:linear-gradient(180deg,#0b0b0b,#070707);padding:28px}.pham-fit__figure svg{display:block;width:100%;max-height:430px;color:#e1e1dc}.pham-fit__legend{display:grid;grid-template-rows:repeat(4,1fr);border:1px solid #303030}.pham-fit__legend>div{display:grid;grid-template-columns:42px 1fr;align-content:center;column-gap:14px;padding:18px;border-bottom:1px solid #303030}.pham-fit__legend>div:last-child{border-bottom:0}.pham-fit__legend span{grid-row:1/3;display:flex;width:30px;height:30px;align-items:center;justify-content:center;border:1px solid #555;font:700 10px/1 var(--font-mono,monospace)}.pham-fit__legend strong{font:600 10px/1.3 var(--font-mono,monospace);letter-spacing:.08em}.pham-fit__legend p{margin:6px 0 0;color:#868681;font:400 .78rem/1.4 var(--font-body,Arial,sans-serif)}.pham-fit__table-wrap{overflow:auto;margin-top:34px;border-top:1px solid #303030}.pham-fit__table{width:100%;border-collapse:collapse;min-width:720px}.pham-fit__table th,.pham-fit__table td{padding:20px 16px;border-bottom:1px solid #292929;text-align:left}.pham-fit__table thead th{color:#777;font:600 9px/1.3 var(--font-mono,monospace);letter-spacing:.1em;text-transform:uppercase}.pham-fit__table tbody th{font:500 1.4rem/1 var(--font-display,Arial,sans-serif)}.pham-fit__table tbody td{color:#c2c2bd;font:500 .9rem/1.2 var(--font-mono,monospace)}.pham-fit__table tr.is-highlighted{background:rgba(255,255,255,.055)}.pham-fit__tech-note{margin:13px 0 0;color:#777;font:500 9px/1.45 var(--font-mono,monospace);letter-spacing:.08em;text-transform:uppercase}.pham-fit__how-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:34px}.pham-fit__how-grid article{min-height:180px;padding:20px;border:1px solid #303030;background:#080808}.pham-fit__how-grid span{color:#666;font:600 9px/1 var(--font-mono,monospace)}.pham-fit__how-grid strong{display:block;margin-top:32px;font:600 11px/1.2 var(--font-mono,monospace);letter-spacing:.08em}.pham-fit__how-grid p{margin:9px 0 0;color:#93938e;font:400 .82rem/1.5 var(--font-body,Arial,sans-serif)}.pham-fit__best-method{display:grid;grid-template-columns:170px 1fr;gap:30px;margin-top:12px;padding:22px;border:1px solid #303030}.pham-fit__best-method>span{color:#777;font:600 9px/1.3 var(--font-mono,monospace);letter-spacing:.1em}.pham-fit__best-method strong{font:600 11px/1.3 var(--font-mono,monospace);letter-spacing:.08em}.pham-fit__best-method p{margin:7px 0 0;color:#93938e;font:400 .84rem/1.5 var(--font-body,Arial,sans-serif)}.pham-fit__assistant-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;margin-top:34px;border:1px solid #303030;background:#303030}.pham-fit__form,.pham-fit__result{background:#070707;padding:clamp(24px,4vw,44px)}.pham-fit__form{display:grid;grid-template-columns:1fr 1fr;gap:20px}.pham-fit__form>label>span,.pham-fit__form legend{display:block;margin-bottom:8px;color:#888883;font:600 9px/1 var(--font-mono,monospace);letter-spacing:.1em;text-transform:uppercase}.pham-fit__form>label>span small{opacity:.55;font-size:8px}.pham-fit__form>label>div{display:flex;align-items:center;border-bottom:1px solid #444}.pham-fit__form input[type=number]{width:100%;padding:11px 0;border:0;outline:0;background:transparent;color:#fff;font-size:20px}.pham-fit__form em{color:#777;font:600 9px/1 var(--font-mono,monospace);font-style:normal}.pham-fit__form fieldset{grid-column:1/-1;display:flex;gap:8px;flex-wrap:wrap;margin:2px 0 0;padding:14px 0 0;border:0}.pham-fit__radio input{position:absolute;opacity:0;pointer-events:none}.pham-fit__radio span{display:block;padding:11px 14px;border:1px solid #343434;font:600 9px/1 var(--font-mono,monospace);letter-spacing:.07em;cursor:pointer}.pham-fit__radio input:checked+span{background:#f0f0eb;color:#050505;border-color:#f0f0eb}.pham-fit__form button{grid-column:1/-1;margin-top:6px;padding:16px 20px;border:0;background:#f0f0eb;color:#050505;font:700 10px/1 var(--font-mono,monospace);letter-spacing:.1em;cursor:pointer}.pham-fit__result{display:flex;min-height:390px;flex-direction:column;justify-content:center}.pham-fit__result-label{color:#777}.pham-fit__result-size{margin:28px 0 20px;font:400 clamp(5rem,11vw,9rem)/.75 var(--font-display,Arial,sans-serif);letter-spacing:-.06em}.pham-fit__result h3{margin:0 0 10px;font:500 1.25rem/1.2 var(--font-display,Arial,sans-serif)}.pham-fit__result p{max-width:48ch;margin:0;color:#92928d;font:400 .84rem/1.55 var(--font-body,Arial,sans-serif)}.pham-fit__result-meta{margin-top:20px;color:#777;font:500 9px/1.65 var(--font-mono,monospace);letter-spacing:.06em;text-transform:uppercase;white-space:pre-line}.pham-fit__footer{display:flex;justify-content:space-between;gap:40px;padding-top:30px}.pham-fit__footer p{max-width:650px;margin:0;color:#858580;font:400 .78rem/1.55 var(--font-body,Arial,sans-serif)}.pham-fit__footer a{color:#fff;text-decoration:none;font:600 9px/1.4 var(--font-mono,monospace);letter-spacing:.08em;white-space:nowrap}
@media(max-width:900px){.pham-fit__inner{width:min(100% - 32px,1280px)}.pham-fit__hero{grid-template-columns:1fr}.pham-fit__hero-card{max-width:480px}.pham-fit__diagram-grid{grid-template-columns:1fr}.pham-fit__legend{grid-template-columns:1fr 1fr;grid-template-rows:none}.pham-fit__legend>div:nth-child(2){border-bottom:1px solid #303030}.pham-fit__legend>div:nth-child(odd){border-right:1px solid #303030}.pham-fit__quick-grid,.pham-fit__how-grid{grid-template-columns:1fr 1fr}.pham-fit__assistant-grid{grid-template-columns:1fr}}
