<!-- # DO NOT EDIT — managed by PHAM theme architecture -->
{%- liquid
  assign per_page = section.settings.products_per_page | default: 12
  assign terms    = search.terms | escape
-%}

<section class="pham-search" data-pham-search data-section-id="{{ section.id }}" role="region" aria-label="Search results">
  <div class="pham-container">
    <header class="pham-search__head reveal-up">
      <p class="pham-eyebrow">Atelier · Search</p>
      <h1 class="pham-search__title">
        {%- if search.performed -%}
          {%- if search.results_count > 0 -%}
            Results for &ldquo;{{ terms }}&rdquo;
          {%- else -%}
            No results for &ldquo;{{ terms }}&rdquo;
          {%- endif -%}
        {%- else -%}
          Search the atelier
        {%- endif -%}
      </h1>

      <form action="{{ routes.search_url }}" method="get" role="search" class="pham-search__form">
        <input type="hidden" name="type" value="product">
        <input type="hidden" name="options[prefix]" value="last">
        <label for="pham-search-input-{{ section.id }}" class="pham-visually-hidden">Search</label>
        <input id="pham-search-input-{{ section.id }}"
               type="search"
               name="q"
               value="{{ terms }}"
               placeholder="Search products, editorials, journal…"
               class="pham-search__input"
               autocomplete="off"
               spellcheck="false"
               required>
        <button type="submit" class="pham-search__submit" aria-label="Submit search">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
            <circle cx="8" cy="8" r="5.5" stroke="currentColor" stroke-width="1.2" fill="none"/>
            <line x1="12.5" y1="12.5" x2="16.5" y2="16.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          </svg>
        </button>
      </form>

      {%- if search.performed -%}
        <p class="pham-search__count">
          {{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %}
        </p>
      {%- endif -%}
    </header>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        {%- paginate search.results by per_page -%}
          <div class="pham-search__list stagger-children" data-pham-search-list role="list">
            {%- for result in search.results -%}
              {%- if result.object_type == 'product' -%}
                <div class="pham-search__cell" role="listitem">
                  {% render 'pham-product-card', product: result, eager: forloop.first %}
                </div>
              {%- elsif result.object_type == 'article' -%}
                <div class="pham-search__cell pham-search__cell--article" role="listitem">
                  <a href="{{ result.url }}" class="pham-search__article">
                    {%- if result.image -%}
                      {{ result.image
                          | image_url: width: 800
                          | image_tag:
                            loading: 'lazy',
                            widths: '320, 480, 640, 800',
                            sizes: '(max-width: 768px) 50vw, 25vw',
                            class: 'pham-search__article-img',
                            alt: result.image.alt | default: result.title
                      }}
                    {%- endif -%}
                    <div class="pham-search__article-meta">
                      <span class="pham-eyebrow">Journal</span>
                      <h3 class="pham-search__article-title">{{ result.title }}</h3>
                    </div>
                  </a>
                </div>
              {%- elsif result.object_type == 'page' -%}
                <div class="pham-search__cell pham-search__cell--page" role="listitem">
                  <a href="{{ result.url }}" class="pham-search__page">
                    <span class="pham-eyebrow">Page</span>
                    <h3 class="pham-search__page-title">{{ result.title }}</h3>
                  </a>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <nav class="pham-search__pagination" role="navigation" aria-label="Pagination">
              {%- if paginate.previous -%}
                <a href="{{ paginate.previous.url }}" class="pham-search__page-link" rel="prev">&larr; Previous</a>
              {%- endif -%}
              <span class="pham-search__page-info">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
              {%- if paginate.next -%}
                <a href="{{ paginate.next.url }}" class="pham-search__page-link" rel="next">Next &rarr;</a>
              {%- endif -%}
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      {%- else -%}
        <div class="pham-search__empty">
          <p class="pham-search__empty-text">No pieces match this search.</p>
          <a href="{{ routes.all_products_collection_url }}" class="pham-search__empty-cta">
            <span>Browse the collection</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

<style>
  .pham-search {
    background-color: var(--color-void);
    color: var(--color-bone);
    padding-block: var(--space-2xl);
    min-height: 60vh;
  }
  .pham-search__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
    max-width: 720px;
  }
  .pham-search__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    color: var(--color-bone);
    margin: 0;
  }
  .pham-search__form {
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--color-ash);
    transition: border-color var(--duration-base) var(--ease-luxury);
  }
  .pham-search__form:focus-within { border-color: var(--color-accent); }
  .pham-search__input {
    flex: 1;
    background: transparent;
    border: 0;
    padding: var(--space-sm) 0;
    color: var(--color-bone);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: var(--text-lg);
  }
  .pham-search__input:focus { outline: none; }
  .pham-search__input::placeholder { color: var(--color-smoke); }
  .pham-search__submit {
    background: transparent;
    border: 0;
    color: var(--color-bone);
    cursor: pointer;
    padding: var(--space-sm);
    display: inline-flex;
    align-items: center;
  }
  .pham-search__submit:hover { color: var(--color-accent); }
  .pham-search__count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-luxury);
    text-transform: uppercase;
    color: var(--color-smoke);
    margin: 0;
  }

  .pham-search__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background-color: var(--color-ash);
    border: 1px solid var(--color-ash);
  }
  .pham-search__cell {
    background-color: var(--color-void);
    padding: var(--space-sm);
    display: flex;
  }
  .pham-search__cell .pham-product-card { width: 100%; }

  .pham-search__article,
  .pham-search__page {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    text-decoration: none;
    color: inherit;
    width: 100%;
  }
  .pham-search__article-img {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    display: block;
  }
  .pham-search__article-title,
  .pham-search__page-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--text-lg);
    color: var(--color-bone);
    margin: 0;
  }
  .pham-search__article:hover .pham-search__article-title,
  .pham-search__page:hover .pham-search__page-title { color: var(--color-accent); }

  .pham-search__pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    margin-top: var(--space-xl);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-luxury);
    text-transform: uppercase;
  }
  .pham-search__page-link {
    color: var(--color-bone);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--color-ash);
  }
  .pham-search__page-link:hover { color: var(--color-accent); border-color: var(--color-accent); }
  .pham-search__page-info { color: var(--color-smoke); }

  .pham-search__empty {
    text-align: center;
    padding-block: var(--space-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: center;
  }
  .pham-search__empty-text {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-xl);
    color: var(--color-bone-80);
    margin: 0;
  }
  .pham-search__empty-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-bone);
    color: var(--color-bone);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-luxury);
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color var(--duration-base) var(--ease-luxury), color var(--duration-base) var(--ease-luxury);
  }
  .pham-search__empty-cta:hover { background-color: var(--color-accent); border-color: var(--color-accent); color: var(--color-void); }

  @media (max-width: 768px) {
    .pham-search__list { grid-template-columns: repeat(2, 1fr); }
  }
</style>

{% schema %}
{
  "name": "PHAM Search Results",
  "tag": "section",
  "class": "pham-search-section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Results per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "PHAM Search Results",
      "category": "PHAM"
    }
  ],
  "enabled_on": {
    "templates": ["search"]
  }
}
{% endschema %}
