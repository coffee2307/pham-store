<!-- # DO NOT EDIT — managed by PHAM theme architecture -->
{%- capture pham_feat_handle -%}{%- render 'pham-featured-product-handle', product_ref: section.settings.product -%}{%- endcapture -%}
{%- assign pham_feat_handle = pham_feat_handle | strip -%}
{%- if pham_feat_handle != blank -%}
  {%- assign product = all_products[pham_feat_handle] -%}
{%- endif -%}
{%- if product == blank or product == nil -%}
  {%- for pham_item in collections.all.products limit: 1 -%}
    {%- assign product = pham_item -%}
  {%- endfor -%}
{%- endif -%}

{%- capture pham_preorder_open_raw -%}{%- render 'pham-preorder-open', section: section -%}{%- endcapture -%}
{%- assign pham_preorder_open_raw = pham_preorder_open_raw | strip -%}
{%- assign pham_preorder_open = true -%}
{%- if pham_preorder_open_raw == 'false' -%}{%- assign pham_preorder_open = false -%}{%- endif -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign privacy_policy = shop.privacy_policy -%}
{%- assign terms_policy = shop.terms_of_service_policy -%}

{%- liquid
  assign pham_turnstile_on = false
  assign pham_turnstile_site_key = settings.pham_waitlist_turnstile_site_key | default: '0x4AAAAAADbDNIw-HnYSFAg2' | strip
  assign pham_turnstile_verify_url = settings.pham_waitlist_captcha_verify_url | default: 'https://script.google.com/macros/s/AKfycbx8Ug7u5hmd3XNPGB1h33xRwX3SjLgnEB6LsR4-lmlPu9m1r7yhf9bUgKaInbnCnvCj/exec' | strip

  if settings.pham_waitlist_turnstile_enabled and pham_turnstile_site_key != blank and pham_turnstile_verify_url contains 'https://'
    assign pham_turnstile_on = true
  endif

  assign pham_honeypot_on = settings.pham_waitlist_honeypot_enabled
  if pham_honeypot_on == nil
    assign pham_honeypot_on = true
  endif
-%}

<section class="pham-waitlist pham-container{% if pham_preorder_open %} pham-waitlist--signup{% endif %}"
         data-pham-waitlist-signup
         data-product-title="{{ product.title | escape }}"
         data-variant-id="{{ current_variant.id }}"
         data-pham-turnstile-enabled="{% if pham_turnstile_on %}true{% else %}false{% endif %}"
         data-pham-turnstile-site-key="{{ pham_turnstile_site_key | escape }}"
         data-pham-turnstile-verify-url="{{ pham_turnstile_verify_url | escape }}"
         data-pham-turnstile-action="waitlist_signup"
         role="region"
         aria-label="{{ section.settings.heading | default: 'Pre-order waitlist' | escape }}">

  {%- unless pham_preorder_open -%}
    <div class="pham-waitlist__closed reveal-up">
      <p class="pham-waitlist__closed-text">
        {%- if section.settings.closed_message != blank -%}
          {{ section.settings.closed_message }}
        {%- elsif settings.pham_waitlist_use_schedule -%}
          The waitlist opens {{ settings.pham_waitlist_opens | default: '2026-06-01' | date: '%B %d, %Y' }} and closes {{ settings.pham_waitlist_closes | default: '2026-07-01' | date: '%B %d, %Y' }}.
        {%- else -%}
          The pre-order waitlist is currently closed.
        {%- endif -%}
      </p>
      <a href="{{ routes.root_url }}" class="pham-back-link">Return to atelier</a>
    </div>
  {%- else -%}
    <form id="PhamWaitlistForm"
          class="pham-waitlist__form reveal-up"
          data-pham-waitlist-form
          novalidate>

      <div data-pham-waitlist-form-panel>
        <header class="pham-waitlist__head">
          {%- if section.settings.eyebrow != blank -%}
            <p class="pham-eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          <h1 class="pham-waitlist__title">
            {%- if section.settings.heading != blank -%}
              {{ section.settings.heading }}
            {%- else -%}
              Join the <span class="pham-waitlist__title-phrase">pre-order</span> waitlist
            {%- endif -%}
          </h1>
        {%- if section.settings.intro != blank -%}
          <p class="pham-waitlist__intro">{{ section.settings.intro }}</p>
        {%- endif -%}
        {%- if product != blank -%}
          <p class="pham-waitlist__product">
            <span class="pham-waitlist__product-label">Edition</span>
            <span class="pham-waitlist__product-name">{{ product.title }}</span>
            {%- if current_variant -%}
              <span class="pham-waitlist__product-price">{{ current_variant.price | money }}</span>
            {%- endif -%}
          </p>
        {%- endif -%}
        </header>

        <div class="pham-waitlist__status is-error" data-pham-waitlist-error hidden role="alert"></div>

        {%- if pham_honeypot_on -%}
          <div class="pham-waitlist__hp" aria-hidden="true">
            <label for="PhamWaitlistHp-{{ section.id }}">Company website</label>
            <input id="PhamWaitlistHp-{{ section.id }}"
                   type="text"
                   name="company"
                   tabindex="-1"
                   autocomplete="off"
                   data-pham-waitlist-honeypot>
          </div>
        {%- endif -%}

        <div class="pham-waitlist__grid">
          <div class="pham-waitlist__field pham-waitlist__field--full">
            <label for="PhamWaitlistName-{{ section.id }}">Full name</label>
            <input id="PhamWaitlistName-{{ section.id }}"
                   data-pham-waitlist-name
                   type="text"
                   autocomplete="name"
                   required
                   placeholder="Your name"
                   value="{% if customer %}{{ customer.name }}{% endif %}">
          </div>

          <div class="pham-waitlist__field pham-waitlist__field--full">
            <label for="PhamWaitlistEmail-{{ section.id }}">Email</label>
            <input id="PhamWaitlistEmail-{{ section.id }}"
                   data-pham-waitlist-email
                   type="email"
                   autocomplete="email"
                   spellcheck="false"
                   autocapitalize="off"
                   required
                   placeholder="you@example.com"
                   value="{% if customer %}{{ customer.email }}{% endif %}">
          </div>

          <div class="pham-waitlist__field pham-waitlist__field--full pham-waitlist__field--phone">
            <label for="PhamWaitlistPhone-{{ section.id }}">Phone</label>
            <input id="PhamWaitlistPhone-{{ section.id }}"
                   data-pham-waitlist-phone
                   type="tel"
                   autocomplete="tel"
                   required
                   placeholder="Phone number"
                   value="{% if customer and customer.phone != blank %}{{ customer.phone }}{% endif %}">
          </div>

          <div class="pham-waitlist__field pham-waitlist__field--full">
            <label for="PhamWaitlistAltContact-{{ section.id }}">Alternative contact <span class="pham-waitlist__optional">(optional)</span></label>
            <input id="PhamWaitlistAltContact-{{ section.id }}"
                   data-pham-waitlist-alt
                   type="text"
                   autocomplete="off"
                   placeholder="WhatsApp, Telegram, Line, WeChat, etc.">
          </div>

          <div class="pham-waitlist__field pham-waitlist__field--full">
            <label for="PhamWaitlistNotes-{{ section.id }}">Other requests <span class="pham-waitlist__optional">(optional)</span></label>
            <textarea id="PhamWaitlistNotes-{{ section.id }}"
                      data-pham-waitlist-notes
                      rows="4"
                      placeholder="Sizing, shipping country, special requests…"></textarea>
          </div>
        </div>

        <div class="pham-waitlist__footer">
          <p class="pham-waitlist__note">{{ section.settings.form_note | default: 'Your pass is reserved after payment is confirmed.' }}</p>

          <p class="pham-waitlist__marketing">
            {{ section.settings.marketing_label | default: 'Send me email updates about this edition and future PHAM releases.' }}
            <span class="pham-waitlist__yn" role="radiogroup" aria-label="Email updates">
              <label class="pham-waitlist__yn-option">
                <input type="radio"
                       name="pham-waitlist-marketing-{{ section.id }}"
                       value="yes"
                       data-pham-waitlist-marketing
                       {% if section.settings.marketing_checked %}checked{% endif %}>
                <span>YES</span>
              </label><span class="pham-waitlist__yn-sep" aria-hidden="true">/</span><label class="pham-waitlist__yn-option">
                <input type="radio"
                       name="pham-waitlist-marketing-{{ section.id }}"
                       value="no"
                       data-pham-waitlist-marketing
                       {% unless section.settings.marketing_checked %}checked{% endunless %}>
                <span>NO</span>
              </label>
            </span>
          </p>

          <label class="pham-waitlist__choice pham-waitlist__choice--legal">
            <input id="PhamWaitlistLegal-{{ section.id }}"
                   class="pham-waitlist__checkbox-input"
                   type="checkbox"
                   value="true"
                   data-pham-waitlist-legal
                   required
                   aria-required="true">
            <span class="pham-waitlist__checkbox-box" aria-hidden="true"></span>
            <span class="pham-waitlist__choice-copy">
              {%- if section.settings.legal_label != blank -%}
                {{ section.settings.legal_label }}
              {%- elsif privacy_policy.body != blank and terms_policy.body != blank -%}
                I agree to the <a href="{{ privacy_policy.url }}">Privacy policy</a> and <a href="{{ terms_policy.url }}">Terms of service</a>.
              {%- elsif privacy_policy.body != blank -%}
                I agree to the <a href="{{ privacy_policy.url }}">Privacy policy</a> and pre-order terms.
              {%- else -%}
                I agree to the pre-order terms and understand my details will be used to manage this waitlist.
              {%- endif -%}
            </span>
          </label>

          {%- render 'pham-turnstile-captcha',
              pham_turnstile_on: pham_turnstile_on,
              pham_turnstile_privacy_note: 'Your details are submitted to Shopify secure checkout. This HTTPS check verifies you are not a bot — no personal data is sent to the verification service.' -%}

          <button type="submit"
                  class="pham-waitlist__submit"
                  data-pham-waitlist-submit
                  disabled
                  aria-disabled="true">
            <span class="pham-waitlist__submit-label">{{ section.settings.submit_label | default: 'PROCEED TO CHECKOUT' }}</span>
            <span aria-hidden="true">&rarr;</span>
          </button>
        </div>
      </div>
    </form>
  {%- endunless -%}
</section>

<style>
  .pham-waitlist {
    max-width: 640px;
    min-height: 60vh;
  }
  .pham-waitlist__title {
    margin: 0 0 var(--space-sm);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-wrap: balance;
    line-height: 1.15;
  }
  .pham-waitlist__title-phrase {
    white-space: nowrap;
  }
  .pham-waitlist__intro,
  .pham-waitlist__closed-text {
    color: var(--color-smoke);
    line-height: 1.6;
  }
  .pham-waitlist__product {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    align-items: baseline;
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-ash);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-luxury);
    text-transform: uppercase;
  }
  .pham-waitlist__product-name { color: var(--color-bone); }
  .pham-waitlist__product-price {
    color: var(--color-accent);
    margin-left: auto;
    font-size: clamp(1.35rem, 3.5vw, 1.85rem);
    letter-spacing: 0.04em;
  }
  .pham-waitlist__grid {
    display: grid;
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }
  @media (min-width: 600px) {
    .pham-waitlist__grid { grid-template-columns: 1fr 1fr; }
    .pham-waitlist__field--full { grid-column: 1 / -1; }
  }
  .pham-waitlist__field label {
    display: block;
    margin-bottom: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: var(--tracking-luxury);
    text-transform: uppercase;
    color: var(--color-white);
  }
  .pham-waitlist__optional {
    text-transform: none;
    letter-spacing: normal;
    font-family: var(--font-body, inherit);
    opacity: 0.65;
  }
  .pham-waitlist__field textarea {
    resize: vertical;
    min-height: 6rem;
  }
  .pham-waitlist__field--phone .iti {
    width: 100%;
    display: block;
  }
  .pham-waitlist__field--phone .iti__tel-input {
    width: 100%;
    padding-left: 3.25rem;
  }
  .pham-waitlist__field--phone .iti__tel-input:focus {
    outline: none;
  }
  .pham-waitlist__field--phone .iti__country-container {
    border-right: 1px solid var(--color-ash);
  }
  .pham-waitlist__field--phone .iti__selected-country {
    background: transparent;
    padding: 0 0.5rem;
  }
  .pham-waitlist__field--phone .iti__selected-country-primary {
    padding: 0.85rem 0.35rem;
  }
  .pham-waitlist__field--phone .iti__selected-dial-code {
    color: var(--color-bone);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .pham-waitlist__field--phone .iti__arrow {
    border-top-color: var(--color-bone);
  }
  .pham-waitlist__field--phone .iti__dropdown-content {
    background: #0A0A0C;
    border: 1px solid var(--color-ash);
    color: var(--color-bone);
    box-sizing: border-box;
    overflow: hidden;
  }
  .pham-waitlist__field--phone .iti__search-input-wrapper {
    box-sizing: border-box;
    padding: 0.5rem;
  }
  .pham-waitlist__field--phone .iti__search-input {
    box-sizing: border-box;
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 0;
  }
  .pham-waitlist__field--phone .iti__search-input:focus {
    outline: none;
    border-color: var(--color-accent);
  }
  .pham-waitlist__field--phone .iti__country {
    padding: 0.5rem 0.75rem;
  }
  .pham-waitlist__field--phone .iti__country.iti__highlight {
    background: rgb(255 255 255 / 0.08);
  }
  .pham-waitlist__field--phone .iti__country-name,
  .pham-waitlist__field--phone .iti__dial-code {
    color: var(--color-bone);
  }
  .pham-waitlist__footer {
    width: 100%;
    margin-top: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .pham-waitlist__note {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-smoke);
    text-align: center;
  }
  .pham-waitlist__choice {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    width: 100%;
    margin: 0;
    cursor: pointer;
  }
  .pham-waitlist__choice-copy {
    flex: 1;
    min-width: 0;
    line-height: 1.55;
  }
  .pham-waitlist__marketing {
    margin: 0;
    text-align: center;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-smoke);
  }
  .pham-waitlist__yn {
    display: inline;
    white-space: nowrap;
    margin-left: 0.35em;
  }
  .pham-waitlist__yn-sep {
    text-decoration: none;
    color: var(--color-smoke);
  }
  .pham-waitlist__yn-option {
    display: inline;
    margin: 0;
    cursor: pointer;
  }
  .pham-waitlist__yn-option input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }
  .pham-waitlist__yn-option span {
    font-family: var(--font-mono);
    font-size: inherit;
    letter-spacing: var(--tracking-wide);
    text-decoration: underline;
    text-underline-offset: 2px;
    color: var(--color-smoke);
    cursor: pointer;
    user-select: none;
  }
  .pham-waitlist__yn-option input:checked + span {
    color: var(--color-white);
  }
  .pham-waitlist__yn-option input:focus-visible + span {
    outline: 2px solid var(--color-white);
    outline-offset: 2px;
  }
  .pham-waitlist__choice--legal {
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-ash);
    font-size: var(--text-base);
    color: var(--color-bone);
    align-items: flex-start;
  }
  .pham-waitlist__choice--legal .pham-waitlist__choice-copy a {
    color: var(--color-white);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .pham-waitlist__checkbox-input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .pham-waitlist__checkbox-box {
    flex: 0 0 1em;
    width: 1em;
    height: 1em;
    min-width: 1em;
    margin-top: 0.2em;
    border: 1.5px solid #FFFFFF;
    background: #0A0A0C;
    position: relative;
    box-sizing: border-box;
  }
  .pham-waitlist__checkbox-input:checked + .pham-waitlist__checkbox-box {
    background: #FFFFFF;
    border-color: #FFFFFF;
  }
  .pham-waitlist__checkbox-input:checked + .pham-waitlist__checkbox-box::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 45%;
    width: 0.25em;
    height: 0.45em;
    border: solid #0A0A0C;
    border-width: 0 1.5px 1.5px 0;
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .pham-waitlist__checkbox-input:focus-visible + .pham-waitlist__checkbox-box {
    outline: 2px solid #FFFFFF;
    outline-offset: 2px;
  }
  .pham-waitlist__submit {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-top: 0;
    padding: var(--space-sm) var(--space-md);
    background: transparent;
    border: 1px solid var(--color-white);
    color: var(--color-white);
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-luxury);
    text-transform: uppercase;
    cursor: pointer;
    transition: box-shadow var(--duration-base) var(--ease-tech);
  }
  .pham-waitlist__submit:hover:not(:disabled) {
    box-shadow: 0 0 32px rgba(255, 255, 255, 0.12);
  }
  .pham-waitlist__submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    box-shadow: none;
  }
  .pham-waitlist__status { margin-top: var(--space-md); min-height: 1.25rem; }
  .pham-waitlist__status.is-success { color: #8fd694; }
  .pham-waitlist__status.is-error { color: #ff8a8a; }
  .pham-waitlist__errors-heading { margin: 0 0 var(--space-xs); font-size: var(--text-sm); }
  .pham-waitlist__closed { margin-top: var(--space-xl); }
  [data-pham-waitlist-error][hidden] { display: none !important; }
  .pham-waitlist__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }
  .pham-waitlist__submit.is-verifying {
    opacity: 0.65;
    pointer-events: none;
  }
  .pham-waitlist-thank-you__title {
    margin: 0 0 var(--space-md);
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    line-height: 1.1;
  }
  .pham-waitlist-thank-you__message,
  .pham-waitlist-thank-you__followup {
    line-height: 1.65;
    margin: 0;
  }
  .pham-waitlist-thank-you__message {
    font-size: var(--text-md, 1.05rem);
    color: var(--color-bone);
  }
  .pham-waitlist-thank-you__followup {
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-smoke);
  }
  .pham-waitlist-thank-you__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    align-items: center;
    margin-top: var(--space-xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-ash);
  }
  .pham-waitlist-thank-you__link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-luxury);
    text-transform: uppercase;
    color: var(--color-white);
    text-decoration: none;
    border-bottom: 1px solid var(--color-white);
    padding-bottom: 2px;
  }
  .pham-waitlist-thank-you__link:hover { opacity: 0.75; }
</style>

{%- if pham_turnstile_on -%}
  {%- render 'pham-turnstile-scripts', form_script_asset: 'pham-waitlist-form.js' -%}
{%- else -%}
<script src="{{ 'pham-waitlist-form.js' | asset_url }}" defer></script>
{%- endif -%}

{% # theme-check-disable RemoteAsset %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@23/build/css/intlTelInput.css">
<script src="https://cdn.jsdelivr.net/npm/intl-tel-input@23/build/js/intlTelInput.min.js" defer></script>
{% # theme-check-enable RemoteAsset %}
<script src="{{ 'pham-waitlist-phone.js' | asset_url }}" defer></script>
<script src="{{ 'pham-waitlist-checkout.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "PHAM Waitlist Signup",
  "tag": "section",
  "class": "pham-waitlist-section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Defaults to theme featured product."
    },
    {
      "type": "header",
      "content": "Waitlist status"
    },
    {
      "type": "checkbox",
      "id": "preorder_open",
      "label": "Accept signups on this page",
      "default": true,
      "info": "Uncheck to show CLOSED on this page only."
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "PRE-ORDER · WAITLIST"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the pre-order waitlist",
      "info": "Leave blank to use the default title with proper line breaks."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Complete your details below. You will proceed to secure checkout for your Digital Access Pass."
    },
    {
      "type": "textarea",
      "id": "form_note",
      "label": "Note under fields",
      "default": "Your pass is reserved after payment is confirmed."
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button",
      "default": "PROCEED TO CHECKOUT"
    },
    {
      "type": "header",
      "content": "Legal & marketing"
    },
    {
      "type": "html",
      "id": "legal_label",
      "label": "Legal consent label (HTML allowed)",
      "info": "Leave blank to auto-link Privacy policy and Terms of service when configured in Admin."
