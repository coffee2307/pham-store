{{ 'pham-campaign.css' | asset_url | stylesheet_tag }}
{%- assign object_number = page.metafields.pham.object_number.value -%}
{%- assign object_product = page.metafields.pham.product_code.value | default: settings.pham_campaign_product_code | default: 'PHAM-001' -%}
{%- assign object_edition = page.metafields.pham.edition_label.value | default: settings.pham_campaign_edition_label | default: 'EDITION 01' -%}
{%- assign auth_status = page.metafields.pham.auth_status.value | default: 'PENDING RECORD' -%}
{%- assign public_identity = page.metafields.pham.public_identity.value -%}
{%- assign identity_label = page.metafields.pham.identity_label.value -%}
{%- assign token_type = page.metafields.pham.token_type.value | default: 'PENDING ALLOCATION' -%}
{%- assign design_origin = page.metafields.pham.design_origin.value | default: settings.pham_campaign_origin_label | default: 'DESIGNED IN VIETNAM / 2026' -%}
{%- assign production_origin = page.metafields.pham.production_origin.value | default: settings.pham_campaign_production_origin_label | default: 'PRODUCED IN DONGGUAN, CHINA' -%}

<section class="pham-campaign-shell" data-pham-provenance-record>
  <div class="pham-campaign-inner">
    <p class="pham-campaign-kicker">PHAM ARCHIVE · PROVENANCE RECORD</p>
    <h1 class="pham-campaign-title">{{ object_product }}<br>{% if object_number != blank %}OBJECT {{ object_number }} / {{ settings.pham_campaign_edition_size | default: 50 }}{% else %}OBJECT — / {{ settings.pham_campaign_edition_size | default: 50 }}{% endif %}</h1>
    <p class="pham-campaign-lede">{{ auth_status }} · {{ object_edition }} · {{ design_origin }}</p>

    <div class="pham-campaign-grid">
      <article class="pham-campaign-card pham-campaign-card--wide">
        <h2>Birth record</h2>
        <dl class="pham-provenance-timeline">
          <div><dt>Design origin</dt><dd>{{ design_origin }}</dd></div>
          <div><dt>Design record</dt><dd>{{ page.metafields.pham.design_record.value | default: 'Record will be attached after final design sign-off.' }}</dd></div>
          <div><dt>Production origin</dt><dd>{{ production_origin }}</dd></div>
          <div><dt>Production record</dt><dd>{{ page.metafields.pham.production_record.value | default: 'Production batch record pending.' }}</dd></div>
          <div><dt>QC</dt><dd>{{ page.metafields.pham.qc_record.value | default: 'Final quality-control record pending.' }}</dd></div>
          <div><dt>Assignment</dt><dd>{% if object_number != blank %}Assigned as Object {{ object_number }} / {{ settings.pham_campaign_edition_size | default: 50 }}.{% else %}Object number not yet assigned.{% endif %}</dd></div>
        </dl>
      </article>

      <article class="pham-campaign-card">
        <h2>Identity</h2>
        <p>{% if public_identity and identity_label != blank %}{{ identity_label }}{% else %}Collector identity is private unless the collector explicitly opts into public display.{% endif %}</p>
      </article>

      <article class="pham-campaign-card">
        <h2>Founder’s Token</h2>
        <div class="pham-campaign-stat"><strong>{{ token_type | upcase }}</strong><span>Collector token</span></div>
        <p style="margin-top:20px">Edition 01 plans 50 collector tokens: 49 silver-tone and one gold-tone. Allocation is recorded only after PHAM confirms the final token assignment.</p>
      </article>

      <article class="pham-campaign-card">
        <h2>Authentication</h2>
        <p>The production QR will resolve to a signed or tokenized authentication route. Sequential object URLs alone will not be treated as proof of authenticity.</p>
      </article>
    </div>
  </div>
</section>

{% schema %}
{"name":"PHAM Provenance","tag":"section","settings":[],"presets":[{"name":"PHAM Provenance"}]}
{% endschema %}
