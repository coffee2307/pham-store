<!-- # DO NOT EDIT — managed by PHAM theme architecture -->
<section class="pham-faq pham-container"
         data-pham-faq
         role="region"
         aria-labelledby="pham-faq-heading-{{ section.id }}">
  <header class="pham-faq__head reveal-up">
    {%- if section.settings.eyebrow != blank -%}
      <p class="pham-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 id="pham-faq-heading-{{ section.id }}" class="pham-faq__title">
      {{ section.settings.heading | default: 'FAQ' }}
    </h1>
    {%- if section.settings.intro != blank -%}
      <p class="pham-faq__intro">{{ section.settings.intro }}</p>
    {%- endif -%}
  </header>

  <div class="pham-faq__list reveal-up">
    {%- for block in section.blocks -%}
      {%- if block.type == 'faq_item' -%}
        {%- assign acc_id = section.id | append: '-faq-' | append: forloop.index -%}
        {% render 'pham-accordion',
          heading: block.settings.question,
          content: block.settings.answer,
          id: acc_id,
          open: block.settings.default_open
        %}
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.contact_note != blank -%}
    <p class="pham-faq__contact reveal-up">{{ section.settings.contact_note }}</p>
  {%- endif -%}
</section>

<style>
  .pham-faq { padding-block: var(--space-2xl) var(--space-3xl); max-width: 720px; }
  .pham-faq__title {
    margin: 0 0 var(--space-sm);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  .pham-faq__intro,
  .pham-faq__contact {
    color: var(--color-smoke);
    line-height: 1.65;
    margin: 0;
  }
  .pham-faq__intro { margin-top: var(--space-sm); }
  .pham-faq__list { display: flex; flex-direction: column; gap: var(--space-sm); margin-top: var(--space-xl); }
  .pham-faq__contact { margin-top: var(--space-xl); font-size: var(--text-sm); }
  .pham-faq__contact a { color: var(--color-white); }
</style>

{% schema %}
{
  "name": "PHAM FAQ",
  "tag": "section",
  "class": "pham-faq-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ATELIER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Answers about pre-order, sizing, shipping, and returns."
    },
    {
      "type": "richtext",
      "id": "contact_note",
      "label": "Contact note",
      "default": "<p>Still need help? <a href=\"/pages/contact\">Contact the atelier</a>.</p>"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How does pre-order work?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Join the waitlist with your contact details. PHAM is still in development — we will email you when the next edition is ready to proceed.</p>"
        },
        {
          "type": "checkbox",
          "id": "default_open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PHAM FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "How does pre-order work?",
            "answer": "<p>Join the waitlist with your contact details. PHAM is still in development — we will email you when the next edition is ready to proceed.</p>",
            "default_open": true
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "When will I be charged?",
            "answer": "<p>Billing happens only when a release is confirmed. We will email you with full details before anything is due.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "<p>Yes. Complimentary worldwide express shipping on all orders. Duties and taxes may apply depending on your country.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>Returns are accepted within 14 days of receipt for unworn items in original condition. See our Returns policy for full details.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
