{%- liquid
  assign hero_image = section.settings.hero_image
  assign hero_video = section.settings.hero_video
-%}

<section class="pham-immersive-hero" data-pham-immersive-hero data-section-id="{{ section.id }}">
  <div class="pham-immersive-hero__backdrop" aria-hidden="true">
    {%- if hero_video != blank -%}
      {{ hero_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, preload: 'metadata', class: 'pham-immersive-hero__video' }}
    {%- elsif hero_image != blank -%}
      {{ hero_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '768, 1200, 1600, 2000, 2400', sizes: '100vw', class: 'pham-immersive-hero__image', alt: '' }}
    {%- endif -%}
  </div>

  <div class="pham-immersive-hero__veil" aria-hidden="true"></div>
  <div class="pham-immersive-hero__grid" aria-hidden="true"></div>

  <div class="pham-immersive-hero__scene" aria-hidden="true">
    <div class="pham-immersive-hero__halo"></div>
    <div class="pham-immersive-hero__object">
      <span class="pham-immersive-hero__edge pham-immersive-hero__edge--top"></span>
      <span class="pham-immersive-hero__edge pham-immersive-hero__edge--right"></span>
      <span class="pham-immersive-hero__edge pham-immersive-hero__edge--bottom"></span>
      <span class="pham-immersive-hero__edge pham-immersive-hero__edge--left"></span>
      <div class="pham-immersive-hero__volume">
        <span></span><span></span><span></span>
      </div>
      <div class="pham-immersive-hero__spec">PHAM-001<br>FORM STUDY</div>
    </div>
  </div>

  <div class="pham-immersive-hero__content pham-container">
    <div class="pham-immersive-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pham-immersive-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="pham-immersive-hero__title">{{ section.settings.heading | default: 'Simply Being,<br>Fully Living.' }}</h1>
      {%- if section.settings.body != blank -%}
        <p class="pham-immersive-hero__body">{{ section.settings.body }}</p>
      {%- endif -%}
      <div class="pham-immersive-hero__actions">
        {%- capture product_url -%}{%- render 'pham-featured-product-url' -%}{%- endcapture -%}
        <a class="pham-immersive-hero__cta" href="{{ section.settings.cta_link | default: product_url | strip }}">
          <span>{{ section.settings.cta_label | default: 'DISCOVER EDITION 01' }}</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a class="pham-immersive-hero__scroll" href="#pham-immersive-hero-next-{{ section.id }}">
          <span>SCROLL TO EXPLORE</span><i aria-hidden="true"></i>
        </a>
      </div>
    </div>

    <div class="pham-immersive-hero__index" aria-label="Edition 01">
      <span>01</span>
      <span>EST. 2026</span>
      <span>VIETNAM</span>
    </div>
  </div>
  <span id="pham-immersive-hero-next-{{ section.id }}" class="pham-immersive-hero__anchor" aria-hidden="true"></span>
</section>

<style>
  .pham-immersive-hero{--ph-rx:-7deg;--ph-ry:8deg;--ph-x:0px;--ph-y:0px;position:relative;isolation:isolate;min-height:max(720px,100svh);overflow:hidden;background:#090a0d;color:#f0f0f1}
  .pham-immersive-hero__backdrop,.pham-immersive-hero__veil,.pham-immersive-hero__grid{position:absolute;inset:0;pointer-events:none}
  .pham-immersive-hero__image,.pham-immersive-hero__video{width:100%;height:100%;object-fit:cover;opacity:.42;filter:grayscale(1) contrast(1.12) brightness(.45);transform:scale(1.04)}
  .pham-immersive-hero__backdrop:empty{background:radial-gradient(circle at 75% 45%,#282a30 0,transparent 26%),radial-gradient(circle at 20% 98%,#17181d 0,transparent 43%),#090a0d}
  .pham-immersive-hero__veil{z-index:1;background:linear-gradient(90deg,rgba(9,10,13,.98) 0%,rgba(9,10,13,.82) 39%,rgba(9,10,13,.42) 70%,rgba(9,10,13,.67) 100%),linear-gradient(0deg,rgba(9,10,13,.72),transparent 48%)}
  .pham-immersive-hero__grid{z-index:2;opacity:.42;background-image:linear-gradient(rgba(255,255,255,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.07) 1px,transparent 1px);background-size:clamp(42px,5vw,92px) clamp(42px,5vw,92px);mask-image:linear-gradient(90deg,transparent 0,black 39%,black 100%);-webkit-mask-image:linear-gradient(90deg,transparent 0,black 39%,black 100%)}
  .pham-immersive-hero__scene{position:absolute;z-index:3;right:5vw;top:50%;width:min(48vw,670px);height:min(68vw,760px);min-width:470px;min-height:580px;transform:translateY(-50%);perspective:1300px;pointer-events:none}
  .pham-immersive-hero__halo{position:absolute;left:50%;top:50%;width:82%;aspect-ratio:1;border:1px solid rgba(255,255,255,.18);border-radius:50%;transform:translate(-50%,-50%) rotateX(65deg) rotateZ(-18deg);box-shadow:0 0 95px rgba(255,255,255,.08),inset 0 0 80px rgba(255,255,255,.025)}
  .pham-immersive-hero__object{position:absolute;left:50%;top:50%;width:52%;height:67%;transform-style:preserve-3d;transform:translate(-50%,-50%) translate3d(var(--ph-x),var(--ph-y),0) rotateX(var(--ph-rx)) rotateY(var(--ph-ry));transition:transform .12s linear;filter:drop-shadow(0 70px 45px rgba(0,0,0,.65))}
  .pham-immersive-hero__object:before,.pham-immersive-hero__object:after{content:"";position:absolute;inset:0;border:1px solid rgba(255,255,255,.7)}
  .pham-immersive-hero__object:before{transform:translateZ(72px);background:linear-gradient(130deg,rgba(255,255,255,.12),rgba(255,255,255,.015) 37%,rgba(0,0,0,.36) 73%),repeating-linear-gradient(90deg,transparent 0 28px,rgba(255,255,255,.08) 29px 30px)}
  .pham-immersive-hero__object:after{transform:translateZ(-72px);border-color:rgba(255,255,255,.16);background:rgba(0,0,0,.24)}
  .pham-immersive-hero__edge{position:absolute;display:block;background:rgba(255,255,255,.35);transform-style:preserve-3d}
  .pham-immersive-hero__edge--top,.pham-immersive-hero__edge--bottom{left:0;width:100%;height:144px;transform:rotateX(90deg) translateZ(72px);transform-origin:top}
  .pham-immersive-hero__edge--top{top:0}.pham-immersive-hero__edge--bottom{bottom:0;transform:rotateX(90deg) translateZ(72px)}
  .pham-immersive-hero__edge--left,.pham-immersive-hero__edge--right{top:0;width:144px;height:100%;transform:rotateY(90deg) translateZ(72px);transform-origin:left}
  .pham-immersive-hero__edge--left{left:0}.pham-immersive-hero__edge--right{right:0;transform:rotateY(90deg) translateZ(-72px)}
  .pham-immersive-hero__volume{position:absolute;inset:12% 18%;transform-style:preserve-3d;transform:translateZ(108px)}
  .pham-immersive-hero__volume span{position:absolute;inset:0;border:1px solid rgba(255,255,255,.28);background:linear-gradient(135deg,rgba(255,255,255,.13),transparent 58%)}
  .pham-immersive-hero__volume span:nth-child(1){transform:rotate(24deg) scale(.82)}.pham-immersive-hero__volume span:nth-child(2){transform:rotate(-36deg) scale(.64)}.pham-immersive-hero__volume span:nth-child(3){transform:rotate(76deg) scale(.42)}
  .pham-immersive-hero__spec{position:absolute;right:18px;bottom:15px;z-index:2;transform:translateZ(86px);font:400 9px/1.45 var(--font-mono);letter-spacing:.15em;color:rgba(255,255,255,.68)}
  .pham-immersive-hero__content{position:relative;z-index:5;min-height:max(720px,100svh);display:flex;align-items:center;justify-content:space-between;padding-top:92px;padding-bottom:64px}
  .pham-immersive-hero__copy{max-width:min(625px,50vw)}
  .pham-immersive-hero__eyebrow{margin:0 0 25px;color:rgba(255,255,255,.62);font:400 10px/1 var(--font-mono);letter-spacing:.23em}
  .pham-immersive-hero__title{margin:0;max-width:600px;font-family:var(--font-display);font-size:clamp(3.3rem,7.1vw,7.6rem);font-weight:400;line-height:.89;letter-spacing:-.055em;text-wrap:balance}
  .pham-immersive-hero__body{max-width:360px;margin:30px 0 0;color:rgba(255,255,255,.72);font:400 clamp(.9rem,1.2vw,1rem)/1.65 var(--font-body)}
  .pham-immersive-hero__actions{display:flex;align-items:center;gap:28px;margin-top:40px}
  .pham-immersive-hero__cta{min-width:230px;display:flex;align-items:center;justify-content:space-between;gap:18px;padding:16px 17px;border:1px solid rgba(255,255,255,.85);color:#0a0b0e;background:#f2f2f2;text-decoration:none;font:600 10px/1 var(--font-mono);letter-spacing:.12em;transition:color .25s var(--ease-tech),background .25s var(--ease-tech),transform .25s var(--ease-tech)}
  .pham-immersive-hero__cta:hover{color:#fff;background:transparent;transform:translateY(-3px)}
  .pham-immersive-hero__scroll{display:inline-flex;align-items:center;gap:11px;color:rgba(255,255,255,.58);text-decoration:none;font:400 9px/1 var(--font-mono);letter-spacing:.16em}
  .pham-immersive-hero__scroll i{width:38px;height:1px;background:currentColor;position:relative}.pham-immersive-hero__scroll i:after{content:"";position:absolute;right:0;top:-2px;width:5px;height:5px;border-top:1px solid currentColor;border-right:1px solid currentColor;transform:rotate(45deg)}
  .pham-immersive-hero__index{align-self:flex-end;display:flex;flex-direction:column;gap:10px;align-items:flex-end;font:400 9px/1 var(--font-mono);letter-spacing:.16em;color:rgba(255,255,255,.55)}
  .pham-immersive-hero__index span:first-child{font-family:var(--font-display);font-size:50px;letter-spacing:-.08em;color:rgba(255,255,255,.9)}
  .pham-immersive-hero__anchor{position:absolute;bottom:0;left:0;width:1px;height:1px}
  @media (max-width:900px){.pham-immersive-hero{min-height:max(700px,100svh)}.pham-immersive-hero__scene{right:-13vw;opacity:.74;transform:translateY(-43%) scale(.78)}.pham-immersive-hero__copy{max-width:70vw}.pham-immersive-hero__index{display:none}}
  @media (max-width:620px){.pham-immersive-hero,.pham-immersive-hero__content{min-height:720px}.pham-immersive-hero__content{align-items:flex-end;padding-top:100px;padding-bottom:48px}.pham-immersive-hero__copy{max-width:100%}.pham-immersive-hero__title{font-size:clamp(3.4rem,16vw,5.1rem);max-width:360px}.pham-immersive-hero__body{margin-top:22px;max-width:290px}.pham-immersive-hero__scene{top:33%;right:-28vw;transform:translateY(-50%) scale(.55);opacity:.64}.pham-immersive-hero__actions{align-items:flex-start;flex-direction:column;gap:20px;margin-top:28px}.pham-immersive-hero__grid{mask-image:none;-webkit-mask-image:none;opacity:.26}.pham-immersive-hero__cta{width:min(100%,300px)}}
  @media (prefers-reduced-motion:reduce){.pham-immersive-hero__object{transition:none}.pham-immersive-hero__cta{transition:none}}
</style>

{% schema %}
{
  "name": "PHAM Immersive hero",
  "tag": "section",
  "class": "pham-immersive-hero-section",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "video", "id": "hero_video", "label": "Hero video (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PHAM / EDITION 01 / FORM STUDY" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Simply Being,\nFully Living." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "The first piece. Cut with intent, held in restraint." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "DISCOVER EDITION 01" },
    { "type": "url", "id": "cta_link", "label": "CTA link", "info": "Leave blank to link to the featured product." }
  ],
  "presets": [{ "name": "PHAM Immersive hero", "category": "PHAM" }],
  "enabled_on": { "templates": ["index"] }
}
{% endschema %}