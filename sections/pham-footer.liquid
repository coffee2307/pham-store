<!-- # DO NOT EDIT — managed by PHAM theme architecture -->
{%- capture footer_product_url -%}{%- render 'pham-featured-product-url' -%}{%- endcapture -%}
{%- assign footer_product_url = footer_product_url | strip -%}
{%- liquid
  assign year = 'now' | date: '%Y'
-%}

<footer class="pham-footer"
        data-pham-footer
        role="contentinfo"
        data-section-id="{{ section.id }}"
        data-section-type="pham-footer">
  <div class="pham-container">
    <div class="pham-footer__grid">

      {%- comment -%} ============== COLUMN 1 — BRAND PHILOSOPHY ============== {%- endcomment -%}
      <div class="pham-footer__col pham-footer__col--brand">
        {% render 'pham-brand-lockup', class: 'pham-footer__logo', image_loading: 'lazy' %}
        <p class="pham-footer__tagline">{{ section.settings.tagline }}</p>
        {%- assign pham_facebook = settings.pham_social_facebook | default: 'https://www.facebook.com/profile.php?id=61590900803027' -%}
        {%- if settings.pham_social_instagram != blank or settings.pham_social_tiktok != blank or pham_facebook != blank -%}
          <ul class="pham-footer__socials" role="list">
            {%- if settings.pham_social_instagram != blank -%}
              <li>
                <a href="{{ settings.pham_social_instagram }}"
                   class="pham-footer__social"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="Instagram">Instagram</a>
              </li>
            {%- endif -%}
            {%- if settings.pham_social_tiktok != blank -%}
              <li>
                <a href="{{ settings.pham_social_tiktok }}"
                   class="pham-footer__social"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="TikTok">TikTok</a>
              </li>
            {%- endif -%}
            {%- if pham_facebook != blank -%}
              <li class="pham-footer__social-item pham-footer__social-item--facebook">
                <a href="{{ pham_facebook }}"
                   class="pham-footer__social pham-footer__social--facebook"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="PHAM on Facebook">
                  <svg class="pham-footer__social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M13.6 22v-9.1h3.1l.5-3.6h-3.6V7c0-1 .3-1.7 1.8-1.7h1.9V2.1c-.3 0-1.5-.1-2.8-.1-2.8 0-4.7 1.7-4.7 4.8v2.5H6.7v3.6h3.1V22h3.8Z"/>
                  </svg>
                  <span class="pham-footer__social-label">Facebook</span>
</a>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>

      {%- comment -%} ============== COLUMN 2 — EXPLORE ============== {%- endcomment -%}
      <nav class="pham-footer__col pham-footer__col--menu" aria-label="Explore PHAM">
        <h3 class="pham-footer__heading">{{ section.settings.menu_heading }}</h3>
        <ul class="pham-footer__menu" role="list">
          <li class="pham-footer__menu-item"><a href="{{ routes.root_url }}" class="pham-footer__link">HOME</a></li>
          <li class="pham-footer__menu-item"><a href="{{ footer_product_url }}" class="pham-footer__link">PRODUCT</a></li>
          <li class="pham-footer__menu-item"><a href="/pages/edition-01" class="pham-footer__link">EDITION 01</a></li>
          <li class="pham-footer__menu-item"><a href="/pages/pham-001-size-guide" class="pham-footer__link">SIZE GUIDE</a></li>
        </ul>
      </nav>

      {%- comment -%} ============== COLUMN 3 — THE LABEL ============== {%- endcomment -%}
      <nav class="pham-footer__col pham-footer__col--story" aria-label="The PHAM label">
        <h3 class="pham-footer__heading">THE LABEL</h3>
        <ul class="pham-footer__menu" role="list">
          <li class="pham-footer__menu-item"><a href="/pages/about" class="pham-footer__link">ABOUT</a></li>
          <li class="pham-footer__menu-item"><a href="/pages/founder-story" class="pham-footer__link">FOUNDER STORY</a></li>
          <li class="pham-footer__menu-item"><a href="/pages/contact" class="pham-footer__link">CONTACT</a></li>
        </ul>
      </nav>

      {%- comment -%} ============== COLUMN 4 — NEWSLETTER ============== {%- endcomment -%}
      <div class="pham-footer__col pham-footer__col--newsletter">
        <h3 class="pham-footer__heading">{{ section.settings.newsletter_heading }}</h3>
        <p class="pham-footer__newsletter-copy">{{ section.settings.newsletter_text }}</p>

        {%- form 'customer', class: 'pham-footer__form', id: 'pham-footer-newsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="pham-footer__form-row">
            <label for="pham-footer-email" class="pham-visually-hidden">Email address</label>
            <input id="pham-footer-email"
                   type="email"
                   name="contact[email]"
                   class="pham-footer__input"
                   placeholder="EMAIL ADDRESS"
                   value="{{ form.email }}"
                   required
                   autocomplete="email"
                   spellcheck="false"
                   autocapitalize="off">
            <button type="submit" class="pham-footer__submit" aria-label="Subscribe to the PHAM newsletter">
              <span class="pham-footer__submit-label">SUBSCRIBE</span>

            </button>
          </div>

          {% render 'pham-contact-email', variant: 'footer' %}

          {%- if form.errors -%}
            <p class="pham-footer__form-msg pham-footer__form-msg--error" role="alert">
              {{ form.errors | default_errors }}
            </p>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <p class="pham-footer__form-msg pham-footer__form-msg--success" role="status">
              Thank you. The atelier will be in touch.
            </p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

    {%- comment -%} ============== BOTTOM ROW ============== {%- endcomment -%}
    <hr class="pham-footer__divider pham-rule" aria-hidden="true">

    {%- if section.settings.show_policy_links -%}
      {% render 'pham-policy-links' %}
    {%- endif -%}

    <div class="pham-footer__bottom">
      <p class="pham-footer__copyright">
        &copy; {{ year }} {{ shop.name | escape }}. {{ section.settings.copyright_suffix }}
      </p>

      {%- if section.settings.show_payment_icons -%}
        {%- if shop.enabled_payment_types.size > 0 -%}
          <ul class="pham-footer__payments" role="list" aria-label="Accepted payment methods">
            {%- for type in shop.enabled_payment_types -%}
              <li class="pham-footer__payment-item">
                {{ type | payment_type_svg_tag: class: 'pham-footer__payment-icon' }}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</footer>

<style>
/* PHAM / FOOTER V2 — tidy information hierarchy, 2026-11 */
.pham-footer {
  padding-block: clamp(50px, 5vw, 72px) 27px;
}
.pham-footer__grid {
  display: grid;
  grid-template-columns: minmax(200px, 1.12fr) minmax(132px, .64fr) minmax(156px, .76fr) minmax(260px, 1.2fr);
  align-items: start;
  gap: clamp(22px, 3.2vw, 55px);
}
.pham-footer__col { gap: 13px; min-width: 0; }
.pham-footer__heading { margin: 0 0 3px; font-size: 12px; letter-spacing: .09em; }
.pham-footer .pham-footer__menu { display: flex; flex-direction: column; gap: 0; }
.pham-footer__link {
  display: inline-flex;
  align-items: center;
  min-height: 42px;
  padding: 8px 0;
  font-size: 13px;
  line-height: 1.45;
  white-space: normal;
  text-wrap: balance;
}
.pham-footer__tagline { max-width: 32ch; font-size: 14px; line-height: 1.55; }
.pham-footer__socials { margin-top: 3px; }
.pham-footer__newsletter-copy { max-width: 39ch; }
.pham-footer__divider { margin: clamp(35px, 4vw, 52px) 0 14px; }
.pham-footer__policies { margin-bottom: 14px; }
.pham-footer__policies-list { gap: 2px clamp(16px, 2vw, 32px); }
.pham-footer__bottom { align-items: center; gap: 14px; }
@media (min-width: 750px) and (max-width: 1100px) {
  .pham-footer__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 31px 38px; }
  .pham-footer__col--brand { grid-column: 1; grid-row: 1; }
  .pham-footer__col--newsletter { grid-column: 2; grid-row: 1; max-width: none; }
  .pham-footer__col--menu { grid-column: 1; grid-row: 2; }
  .pham-footer__col--story { grid-column: 2; grid-row: 2; }
}
@media (max-width: 749px) {
  .pham-footer { padding-block: 44px 25px; }
  .pham-footer__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(14px, 5vw, 24px);
    row-gap: 29px;
  }
  .pham-footer__col--brand { grid-column: 1 / -1; gap: 12px; }
  .pham-footer__col--menu { grid-column: 1; }
  .pham-footer__col--story { grid-column: 2; }
  .pham-footer__col--newsletter {
    grid-column: 1 / -1;
    padding-top: 25px;
    border-top: 1px solid rgba(255,255,255,.16);
    max-width: none;
  }
  .pham-footer__heading { font-size: 12px; }
  .pham-footer__link { min-height: 42px; font-size: 12px; letter-spacing: .025em; }
  .pham-footer__tagline { font-size: 14px; }
  .pham-footer__newsletter-copy { font-size: 13px; max-width: 49ch; }
  .pham-footer__form-row { flex-direction: row; }
  .pham-footer__submit { min-height: 48px; flex-basis: 114px; }
  .pham-footer__divider { margin: 28px 0 12px; }
  .pham-footer__policies-list { gap: 0 13px; }
}
</style>

{% schema %}
{
  "name": "PHAM Footer",
  "tag": "section",
  "class": "pham-footer-section",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Brand tagline",
      "default": "Simply Being, Fully Living."
    },
    {
      "type": "header",
      "content": "Menu column"
    },
    {
      "type": "text",
      "id": "menu_heading",
      "label": "Menu heading",
      "default": "Atelier"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "The Atelier List"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter description",
      "default": "Private releases. No noise. No frequency. Only when an edition is ready."
    },
    {
      "type": "header",
      "content": "Help pages"
    },
    {
      "type": "text",
      "id": "faq_handle",
      "label": "FAQ page handle",
      "default": "faq",
      "info": "Used in the fallback menu when no footer menu is assigned."
    },
    {
      "type": "text",
      "id": "size_guide_handle",
      "label": "Size guide page handle",
      "default": "size-guide"
    },
    {
      "type": "header",
      "content": "Bottom row"
    },
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "Show policy links",
      "default": true,
      "info": "Shipping, Return, Privacy, and Terms of Service."
    },
    {
      "type": "text",
      "id": "copyright_suffix",
      "label": "Copyright suffix",
      "default": "All rights reserved."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "PHAM Footer",
      "category": "Footer"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
