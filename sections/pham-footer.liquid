<!-- # DO NOT EDIT — managed by PHAM theme architecture -->
{%- capture footer_product_url -%}{%- render 'pham-featured-product-url' -%}{%- endcapture -%}
{%- assign footer_product_url = footer_product_url | strip -%}
{%- liquid
  assign year = 'now' | date: '%Y'
-%}

<footer class="pham-footer"
        data-pham-footer
        role="contentinfo"
        data-section-id="{{ section.id }}"
        data-section-type="pham-footer">
  <div class="pham-container">
    <div class="pham-footer__grid">

      {%- comment -%} ============== COLUMN 1 — BRAND PHILOSOPHY ============== {%- endcomment -%}
      <div class="pham-footer__col pham-footer__col--brand">
        {% render 'pham-brand-lockup', class: 'pham-footer__logo', image_loading: 'lazy' %}
        <p class="pham-footer__tagline">{{ section.settings.tagline }}</p>
        {%- assign pham_facebook = settings.pham_social_facebook | default: 'https://www.facebook.com/profile.php?id=61590900803027' -%}
        {%- if settings.pham_social_instagram != blank or settings.pham_social_tiktok != blank or pham_facebook != blank -%}
          <ul class="pham-footer__socials" role="list">
            {%- if settings.pham_social_instagram != blank -%}
              <li>
                <a href="{{ settings.pham_social_instagram }}"
                   class="pham-footer__social"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="Instagram">Instagram</a>
              </li>
            {%- endif -%}
            {%- if settings.pham_social_tiktok != blank -%}
              <li>
                <a href="{{ settings.pham_social_tiktok }}"
                   class="pham-footer__social"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="TikTok">TikTok</a>
              </li>
            {%- endif -%}
            {%- if pham_facebook != blank -%}
              <li class="pham-footer__social-item pham-footer__social-item--facebook">
                <a href="{{ pham_facebook }}"
                   class="pham-footer__social pham-footer__social--facebook"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="PHAM on Facebook">
                  <span class="pham-footer__social-mark" aria-hidden="true">
                  <svg class="pham-footer__social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M13.6 22v-9.1h3.1l.5-3.6h-3.6V7c0-1 .3-1.7 1.8-1.7h1.9V2.1c-.3 0-1.5-.1-2.8-.1-2.8 0-4.7 1.7-4.7 4.8v2.5H6.7v3.6h3.1V22h3.8Z"/>
                  </svg>
                  </span>
                  <span class="pham-footer__social-text">
                    <span class="pham-footer__social-kicker">FOLLOW PHAM</span>
                    <span class="pham-footer__social-label">FACEBOOK</span>
                  </span>
</a>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>

      {%- comment -%} ============== COLUMN 2 — EXPLORE ============== {%- endcomment -%}
      <nav class="pham-footer__col pham-footer__col--menu" aria-label="Explore PHAM">
        <h3 class="pham-footer__heading">{{ section.settings.menu_heading }}</h3>
        <ul class="pham-footer__menu" role="list">
          <li class="pham-footer__menu-item"><a href="{{ routes.root_url }}" class="pham-footer__link">HOME</a></li>
          <li class="pham-footer__menu-item"><a href="{{ footer_product_url }}" class="pham-footer__link">PRODUCT</a></li>
          <li class="pham-footer__menu-item"><a href="/pages/edition-01" class="pham-footer__link">EDITION 01</a></li>
          <li class="pham-footer__menu-item"><a href="/pages/pham-001-size-guide" class="pham-footer__link">SIZE GUIDE</a></li>
        </ul>
      </nav>

      {%- comment -%} ============== COLUMN 3 — THE LABEL ============== {%- endcomment -%}
      <nav class="pham-footer__col pham-footer__col--story" aria-label="The PHAM label">
        <h3 class="pham-footer__heading">THE LABEL</h3>
        <ul class="pham-footer__menu" role="list">
          <li class="pham-footer__menu-item"><a href="/pages/about" class="pham-footer__link">ABOUT</a></li>
          <li class="pham-footer__menu-item"><a href="/pages/founder-story" class="pham-footer__link">FOUNDER STORY</a></li>
          <li class="pham-footer__menu-item"><a href="/pages/contact" class="pham-footer__link">CONTACT</a></li>
        </ul>
      </nav>

      {%- comment -%} ============== COLUMN 4 — NEWSLETTER ============== {%- endcomment -%}
      <div class="pham-footer__col pham-footer__col--newsletter">
        <h3 class="pham-footer__heading">{{ section.settings.newsletter_heading }}</h3>
        <p class="pham-footer__newsletter-copy">{{ section.settings.newsletter_text }}</p>

        {%- form 'customer', class: 'pham-footer__form', id: 'pham-footer-newsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="pham-footer__form-row">
            <label for="pham-footer-email" class="pham-visually-hidden">Email address</label>
            <input id="pham-footer-email"
                   type="email"
                   name="contact[email]"
                   class="pham-footer__input"
                   placeholder="EMAIL ADDRESS"
                   value="{{ form.email }}"
                   required
                   autocomplete="email"
                   spellcheck="false"
                   autocapitalize="off">
            <button type="submit" class="pham-footer__submit" aria-label="Subscribe to the PHAM newsletter">
              <span class="pham-footer__submit-label">SUBSCRIBE</span>

            </button>
          </div>

          {% render 'pham-contact-email', variant: 'footer' %}

          {%- if form.errors -%}
            <p class="pham-footer__form-msg pham-footer__form-msg--error" role="alert">
              {{ form.errors | default_errors }}
            </p>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <p class="pham-footer__form-msg pham-footer__form-msg--success" role="status">
              Thank you. The atelier will be in touch.
            </p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

    {%- comment -%} ============== BOTTOM ROW ============== {%- endcomment -%}
    <hr class="pham-footer__divider pham-rule" aria-hidden="true">

    {%- if section.settings.show_policy_links -%}
      {% render 'pham-policy-links' %}
    {%- endif -%}

    <div class="pham-footer__bottom">
      <p class="pham-footer__copyright">
        &copy; {{ year }} {{ shop.name | escape }}. {{ section.settings.copyright_suffix }}
      </p>

      {%- if section.settings.show_payment_icons -%}
        {%- if shop.enabled_payment_types.size > 0 -%}
          <ul class="pham-footer__payments" role="list" aria-label="Accepted payment methods">
            {%- for type in shop.enabled_payment_types -%}
              <li class="pham-footer__payment-item">
                {{ type | payment_type_svg_tag: class: 'pham-footer__payment-icon' }}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</footer>

<style>
/* PHAM / FOOTER V3 — compact editorial layout (2026-11-12) */
.pham-footer {
  padding-block: clamp(36px, 4vw, 55px) 22px;
}
.pham-footer > .pham-container {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  column-gap: 26px;
  row-gap: 0;
  align-items: start;
}
.pham-footer .pham-footer__grid {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: minmax(190px, 1.08fr) minmax(115px, .6fr) minmax(145px, .75fr) minmax(275px, 1.27fr);
  gap: clamp(20px, 3.4vw, 54px);
  align-items: start;
}
.pham-footer .pham-footer__col { gap: 9px; min-width: 0; }
.pham-footer .pham-footer__heading {
  margin: 0 0 5px;
  color: #a3a3a1;
  font: 600 11px/1.5 var(--font-mono, monospace);
  letter-spacing: .105em;
}
.pham-footer .pham-footer__tagline {
  margin: 0;
  max-width: 31ch;
  color: #aaa9a6;
  font-size: 13px;
  line-height: 1.55;
}
.pham-footer .pham-footer__menu {
  display: flex;
  flex-direction: column;
  gap: 0;
  margin: 0;
}
.pham-footer .pham-footer__link {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  max-width: 100%;
  min-height: 36px;
  padding: 5px 0;
  font: 500 12px/1.4 var(--font-body, Arial, sans-serif);
  letter-spacing: .035em;
  color: #d2d1ce;
  text-wrap: pretty;
  transition: color .18s ease;
}
.pham-footer .pham-footer__link:hover { padding-left: 0; color: #fff; }
.pham-footer .pham-footer__socials { gap: 10px 18px; margin: 2px 0 0; }
.pham-footer .pham-footer__social-item--facebook { flex: 0 1 auto; margin: 0; }
.pham-footer .pham-footer__social,
.pham-footer .pham-footer__social--facebook {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 36px;
  width: fit-content;
  padding: 0;
  border: 0;
  background: transparent;
  color: #b9b8b4;
  font: 500 11px/1.4 var(--font-body, Arial, sans-serif);
  letter-spacing: .06em;
  text-decoration: none;
}
.pham-footer .pham-footer__social--facebook:hover { border: 0; background: transparent; color: #fff; }
.pham-footer .pham-footer__social--facebook .pham-footer__social-icon { width: 13px; height: 13px; flex-basis: 13px; }
.pham-footer .pham-footer__newsletter-copy {
  max-width: 39ch;
  margin: 0 0 6px;
  color: #aaa9a6;
  font: 400 13px/1.55 var(--font-body, Arial, sans-serif);
  letter-spacing: 0;
  text-transform: none;
}
.pham-footer .pham-footer__form-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  min-height: 44px;
  border-color: #555654;
}
.pham-footer .pham-footer__input {
  min-width: 0;
  width: 1%;
  flex: 1 1 auto;
  font-size: 13px;
  padding: 10px 12px !important;
}
.pham-footer .pham-footer__submit {
  flex: 0 0 auto;
  min-height: 44px;
  width: auto;
  padding: 9px 13px;
  border-top: 0;
  border-left: 1px solid #555654;
  font-size: 10px;
  letter-spacing: .055em;
}
.pham-footer .pham-footer__email-line { margin-top: 8px; }
.pham-footer .pham-footer__email-line a { color: #9e9e9b; font-size: 11px; letter-spacing: .015em; }
.pham-footer .pham-footer__divider {
  grid-column: 1 / -1;
  width: 100%;
  margin: 27px 0 12px;
  border-color: #323333;
}
.pham-footer .pham-footer__policies {
  grid-column: 1;
  grid-row: 3;
  align-self: center;
  margin: 0;
}
.pham-footer .pham-footer__policies-list {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0 19px;
}
.pham-footer .pham-footer__policy-link {
  display: inline-flex;
  align-items: center;
  min-height: 35px;
  border: 0;
  padding: 0;
  color: #999995;
  font: 500 11px/1.4 var(--font-body, Arial, sans-serif);
  letter-spacing: .025em;
  text-decoration: none;
}
.pham-footer .pham-footer__policy-link:hover { border: 0; color: #fff; }
.pham-footer .pham-footer__bottom {
  grid-column: 2;
  grid-row: 3;
  display: flex;
  flex-flow: row wrap;
  justify-content: flex-end;
  align-items: center;
  gap: 9px 16px;
  min-height: 35px;
}
.pham-footer .pham-footer__copyright {
  color: #858581;
  font-size: 10px;
  line-height: 1.5;
  letter-spacing: .035em;
  white-space: nowrap;
}
.pham-footer .pham-footer__payments { gap: 5px; }
.pham-footer .pham-footer__payment-item { width: 32px; height: 22px; border-color: #303232; background: #121314; }
.pham-footer .pham-footer__payment-icon { width: 25px; height: 16px; }
@media (min-width: 750px) and (max-width: 1100px) {
  .pham-footer .pham-footer__grid {
    grid-template-columns: repeat(2, minmax(0,1fr));
    gap: 27px 40px;
  }
  .pham-footer .pham-footer__col--brand { grid-column: 1; grid-row: 1; }
  .pham-footer .pham-footer__col--newsletter { grid-column: 2; grid-row: 1; max-width: none; }
  .pham-footer .pham-footer__col--menu { grid-column: 1; grid-row: 2; }
  .pham-footer .pham-footer__col--story { grid-column: 2; grid-row: 2; }
  .pham-footer > .pham-container { grid-template-columns: 1fr; }
  .pham-footer .pham-footer__policies { grid-column: 1; grid-row: 3; }
  .pham-footer .pham-footer__bottom { grid-column: 1; grid-row: 4; justify-content: space-between; }
}
@media (max-width: 749px) {
  .pham-footer { padding-block: 29px 18px; }
  .pham-footer > .pham-container {
    grid-template-columns: minmax(0, 1fr);
    padding-inline: max(16px, env(safe-area-inset-left, 0px)) max(16px, env(safe-area-inset-right, 0px));
  }
  .pham-footer .pham-footer__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 18px;
    row-gap: 22px;
  }
  .pham-footer .pham-footer__col--brand {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0,1fr) auto;
    grid-template-rows: auto auto;
    gap: 4px 12px;
    align-items: center;
  }
  .pham-footer .pham-footer__col--brand .pham-footer__logo { grid-column: 1; grid-row: 1; }
  .pham-footer .pham-footer__col--brand .pham-footer__tagline { grid-column: 1; grid-row: 2; }
  .pham-footer .pham-footer__col--brand .pham-footer__socials { grid-column: 2; grid-row: 1 / 3; margin: 0; }
  .pham-footer .pham-footer__col--menu { grid-column: 1; }
  .pham-footer .pham-footer__col--story { grid-column: 2; }
  .pham-footer .pham-footer__col--newsletter {
    grid-column: 1 / -1;
    max-width: none;
    border-top: 1px solid #303232;
    padding-top: 20px;
  }
  .pham-footer .pham-footer__heading { margin-bottom: 3px; font-size: 10px; }
  .pham-footer .pham-footer__link { min-height: 40px; font-size: 12px; letter-spacing: .015em; }
  .pham-footer .pham-footer__tagline { font-size: 12px; }
  .pham-footer .pham-footer__newsletter-copy { font-size: 12px; max-width: 48ch; }
  .pham-footer .pham-footer__submit { padding-inline: 10px; font-size: 10px; }
  .pham-footer .pham-footer__divider { margin: 22px 0 7px; }
  .pham-footer .pham-footer__policies { grid-column: 1; grid-row: 3; }
  .pham-footer .pham-footer__policies-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; column-gap: 14px; row-gap: 0; }
  .pham-footer .pham-footer__policy-link { min-height: 34px; font-size: 11px; }
  .pham-footer .pham-footer__bottom {
    grid-column: 1;
    grid-row: 4;
    justify-content: space-between;
    gap: 8px;
    padding-top: 6px;
  }
  .pham-footer .pham-footer__copyright { font-size: 9px; white-space: normal; }
}
@media (max-width: 360px) {
  .pham-footer .pham-footer__grid { column-gap: 12px; }
  .pham-footer .pham-footer__col--brand { grid-template-columns: 1fr auto; }
  .pham-footer .pham-footer__social--facebook { font-size: 10px; gap: 5px; }
  .pham-footer .pham-footer__policy-link { font-size: 10px; }
}


/* Facebook / stronger social CTA */
.pham-footer .pham-footer__social--facebook {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 9px;
  min-width: 126px;
  max-width: 100%;
  min-height: 44px;
  padding: 10px 13px;
  border: 1px solid #eceae5;
  background: #eceae5;
  color: #0a0b0d;
  font: 650 11px/1.2 var(--font-body,Arial,sans-serif);
  letter-spacing: .065em;
  text-decoration: none;
  transition: background-color .2s ease, color .2s ease, border-color .2s ease;
}
.pham-footer .pham-footer__social--facebook .pham-footer__social-icon {
  width: 14px;
  height: 14px;
  flex: 0 0 14px;
  color: inherit;
}
.pham-footer .pham-footer__social--facebook:hover,
.pham-footer .pham-footer__social--facebook:focus-visible {
  border-color: #f8f7f4;
  background: transparent;
  color: #f8f7f4;
}
@media (max-width: 749px) {
  .pham-footer .pham-footer__col--brand .pham-footer__socials {
    justify-self: end;
    align-self: center;
    margin: 0;
  }
  .pham-footer .pham-footer__social--facebook {
    min-width: 118px;
    padding-inline: 11px;
  }
}
/* PHAM social / refined editorial link: no oversized white button */
.pham-footer .pham-footer__col--brand .pham-footer__socials {
  margin-top: 12px;
}
.pham-footer .pham-footer__social--facebook {
  display: inline-flex;
  justify-content: flex-start;
  align-items: center;
  gap: 11px;
  width: fit-content;
  min-width: 0;
  min-height: 52px;
  padding: 4px 3px 8px 0;
  border: 0;
  border-bottom: 1px solid rgba(238,236,230,.48);
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  color: #eeeae2;
  text-decoration: none;
  transition: border-color .2s ease, color .2s ease;
}
.pham-footer .pham-footer__social--facebook:hover,
.pham-footer .pham-footer__social--facebook:focus-visible {
  border: 0;
  border-bottom: 1px solid #f7f6f2;
  background: transparent;
  color: #fff;
}
.pham-footer .pham-footer__social-mark {
  display: inline-grid;
  place-items: center;
  width: 34px;
  height: 34px;
  flex: 0 0 34px;
  border-radius: 50%;
  background: #e9e6df;
  color: #0b0d0f;
  transition: background-color .2s ease;
}
.pham-footer .pham-footer__social--facebook:hover .pham-footer__social-mark {
  background: #fff;
}
.pham-footer .pham-footer__social-mark .pham-footer__social-icon {
  display: block;
  width: 16px;
  height: 16px;
  fill: currentColor;
}
.pham-footer .pham-footer__social-text {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
}
.pham-footer .pham-footer__social-kicker {
  color: #999a9b;
  font: 500 9px/1.2 var(--font-mono, monospace);
  letter-spacing: .12em;
}
.pham-footer .pham-footer__social--facebook .pham-footer__social-label {
  font: 650 12px/1.2 var(--font-body, Arial, sans-serif);
  letter-spacing: .10em;
  color: #f3f0eb;
}
@media (max-width: 749px) {
  .pham-footer .pham-footer__col--brand {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto auto;
    align-items: start;
  }
  .pham-footer .pham-footer__col--brand .pham-footer__socials {
    grid-column: 1;
    grid-row: 3;
    justify-self: start;
    align-self: start;
    margin-top: 11px;
  }
  .pham-footer .pham-footer__social--facebook {
    width: fit-content;
    min-width: 0;
    min-height: 52px;
    padding: 4px 3px 8px 0;
    gap: 11px;
  }
}

</style>

{% schema %}
{
  "name": "PHAM Footer",
  "tag": "section",
  "class": "pham-footer-section",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Brand tagline",
      "default": "Simply Being, Fully Living."
    },
    {
      "type": "header",
      "content": "Menu column"
    },
    {
      "type": "text",
      "id": "menu_heading",
      "label": "Menu heading",
      "default": "Atelier"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "The Atelier List"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter description",
      "default": "Private releases. No noise. No frequency. Only when an edition is ready."
    },
    {
      "type": "header",
      "content": "Help pages"
    },
    {
      "type": "text",
      "id": "faq_handle",
      "label": "FAQ page handle",
      "default": "faq",
      "info": "Used in the fallback menu when no footer menu is assigned."
    },
    {
      "type": "text",
      "id": "size_guide_handle",
      "label": "Size guide page handle",
      "default": "size-guide"
    },
    {
      "type": "header",
      "content": "Bottom row"
    },
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "Show policy links",
      "default": true,
      "info": "Shipping, Return, Privacy, and Terms of Service."
    },
    {
      "type": "text",
      "id": "copyright_suffix",
      "label": "Copyright suffix",
      "default": "All rights reserved."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "PHAM Footer",
      "category": "Footer"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
