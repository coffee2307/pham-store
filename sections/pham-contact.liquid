<!-- # DO NOT EDIT — managed by PHAM theme architecture -->
{%- liquid
  assign pham_turnstile_on = false
  assign pham_contact_success = false
  assign pham_turnstile_site_key = settings.pham_waitlist_turnstile_site_key | default: '0x4AAAAAADbDNIw-HnYSFAg2' | strip
  assign pham_turnstile_verify_url = settings.pham_waitlist_captcha_verify_url | default: 'https://script.google.com/macros/s/AKfycbx8Ug7u5hmd3XNPGB1h33xRwX3SjLgnEB6LsR4-lmlPu9m1r7yhf9bUgKaInbnCnvCj/exec' | strip

  if settings.pham_waitlist_turnstile_enabled and pham_turnstile_site_key != blank and pham_turnstile_verify_url contains 'https://'
    assign pham_turnstile_on = true
  endif
-%}
<section class="pham-contact"
         data-pham-contact
         data-section-id="{{ section.id }}"
         data-pham-turnstile-enabled="{% if pham_turnstile_on %}true{% else %}false{% endif %}"
         data-pham-turnstile-site-key="{{ pham_turnstile_site_key | escape }}"
         data-pham-turnstile-verify-url="{{ pham_turnstile_verify_url | escape }}"
         data-pham-turnstile-action="contact_form"
         role="region"
         aria-label="Contact">
  <div class="pham-container pham-contact__inner">
    <header class="pham-contact__head reveal-up">
      <p class="pham-eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="pham-contact__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="pham-contact__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </header>

    {%- form 'contact', id: 'pham-contact-form', class: 'pham-contact__form reveal-up' -%}
      {%- if form.posted_successfully? -%}
        {%- assign pham_contact_success = true -%}
        <div class="pham-contact__success" data-pham-contact-success>
          <p class="pham-contact__msg pham-contact__msg--success" role="status">
            {{ section.settings.success_message }}
          </p>
          <p class="pham-contact__success-actions">
            <a href="{{ page.url | default: routes.root_url }}" class="pham-btn pham-contact__success-cta">
              Send another message
            </a>
          </p>
        </div>
      {%- else -%}

        {%- if form.errors -%}
          <div class="pham-contact__msg pham-contact__msg--error" role="alert">
            <p class="pham-contact__msg-heading">Please correct the following:</p>
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="pham-contact__fields">
          <div class="pham-contact__field">
            <label for="pham-contact-name-{{ section.id }}" class="pham-contact__label">Your Name</label>
          <input id="pham-contact-name-{{ section.id }}"
                 type="text"
                 name="contact[name]"
                 class="pham-contact__input"
                 placeholder="Your name"
                   value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                   autocomplete="name"
                   required>
          </div>

          <div class="pham-contact__field">
            <label for="pham-contact-email-{{ section.id }}" class="pham-contact__label">Email</label>
            <input id="pham-contact-email-{{ section.id }}"
                   type="email"
                   name="contact[email]"
                   class="pham-contact__input"
                   placeholder="Email address"
                   value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                   autocomplete="email"
                   spellcheck="false"
                   autocapitalize="off"
                   required>
          </div>

          <div class="pham-contact__field pham-contact__field--full">
            <label for="pham-contact-body-{{ section.id }}" class="pham-contact__label">Message</label>
            <textarea id="pham-contact-body-{{ section.id }}"
                      name="contact[body]"
                      class="pham-contact__textarea"
                      placeholder="Message"
                      rows="6"
                      required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
          </div>
        </div>

        {%- render 'pham-turnstile-captcha',
            pham_turnstile_on: pham_turnstile_on,
            pham_turnstile_privacy_note: 'Your message is sent via Shopify secure email. This HTTPS check verifies you are not a bot — message content is not shared with the verification service.' -%}

        <button type="submit" class="pham-btn pham-contact__submit">
          {{ section.settings.submit_label }}
        </button>
      {%- endif -%}
    {%- endform -%}

    {%- if section.settings.show_back_link -%}
      <p class="pham-contact__back">
        <a href="{{ routes.root_url }}" class="pham-back-link pham-contact__back-link">
          <span class="pham-back-link__arrow" aria-hidden="true">&larr;</span>
          <span class="pham-back-link__label">RETURN TO ATELIER</span>
        </a>
      </p>
    {%- endif -%}
  </div>
</section>

{%- if pham_turnstile_on and pham_contact_success == false -%}
  {%- render 'pham-turnstile-scripts', form_script_asset: 'pham-contact-form.js' -%}
{%- endif -%}

{% schema %}
{
  "name": "PHAM Contact",
  "tag": "section",
  "class": "pham-contact-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "PHAM · CONTACT HUB"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact Hub"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "Direct line to the atelier. All inquiries are reviewed manually."
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button label",
      "default": "Send Message"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Message received. The atelier will respond when ready."
    },
    {
      "type": "checkbox",
      "id": "show_back_link",
      "label": "Show return-to-home link",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "PHAM Contact",
      "category": "PHAM"
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}
