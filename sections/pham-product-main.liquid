</style>

<script>
  (function() {
    'use strict';
    var sectionId = {{ section.id | json }};
    var root = document.querySelector('[data-pham-product-main][data-section-id="' + sectionId + '"]');
    if (!root) return;

    (function redirectAfterWaitlistCaptcha() {
      try {
        if (sessionStorage.getItem('pham-waitlist-submitted') !== '1') return;
        var params = new URLSearchParams(window.location.search);
        if (params.get('view') === 'waitlist' || params.get('submitted') === '1') return;

        var formEl = root.querySelector('[data-pham-product-form]');
        var waitlistBase = formEl ? (formEl.getAttribute('data-pham-waitlist-base') || '') : '';
        if (!waitlistBase) return;

        sessionStorage.removeItem('pham-waitlist-submitted');

        var target;
        if (waitlistBase.indexOf('/products/') >= 0 && waitlistBase.indexOf('view=waitlist') < 0) {
          target = waitlistBase.split('?')[0] + '?view=waitlist&submitted=1';
        } else {
          var sep = waitlistBase.indexOf('?') >= 0 ? '&' : '?';
          target = waitlistBase + sep + 'submitted=1';
        }
        window.location.replace(target);
      } catch (e) { /* ignore */ }
    })();

    var dataScript = root.querySelector('[data-pham-product-variants]');
    var variants = [];
    if (dataScript) {
      try { variants = JSON.parse(dataScript.textContent) || []; } catch (e) { variants = []; }
    }

    var form           = root.querySelector('[data-pham-product-form]');
    var variantIdInputs = root.querySelectorAll('[data-pham-variant-id]');
    var waitlistCta    = form ? form.querySelector('[data-pham-waitlist-cta]') : null;
    var addToCartBtn   = form ? form.querySelector('[data-pham-add-to-cart]') : null;
    var cartQtyInput   = form ? form.querySelector('[data-pham-cart-quantity]') : null;
    var editionQtyInput = form ? form.querySelector('[data-pham-edition-qty-input]') : null;
    var waitlistBase   = form ? (form.getAttribute('data-pham-waitlist-base') || '') : '';
    var priceEl        = root.querySelector('[data-pham-product-price]');
    var scarcityEl     = root.querySelector('[data-pham-product-scarcity]');
    var submitBtn      = null;
    var ctaLabel       = waitlistCta ? waitlistCta.querySelector('[data-pham-product-cta-label]') : null;
    var ctaPrice       = null;
    var skuEl          = root.querySelector('[data-pham-product-sku]');
    var legendValueEls = root.querySelectorAll('[data-pham-option-value]');
    var currency       = (window.Shopify && window.Shopify.currency && window.Shopify.currency.active) || 'USD';

    function formatMoney(cents) {
      if (typeof cents !== 'number' || !isFinite(cents)) return '';
      try {
        return new Intl.NumberFormat(undefined, { style: 'currency', currency: currency }).format(cents / 100);
      } catch (e) {
        return '$' + (cents / 100).toFixed(2);
      }
    }

    function getSelectedOptions() {
      var opts = [];
      var radios = root.querySelectorAll('input[type="radio"][data-pham-option]');
      for (var i = 0; i < radios.length; i++) {
        var r = radios[i];
        if (r.checked) {
          var idx = parseInt(r.dataset.optionIndex, 10);
          if (!isNaN(idx)) opts[idx] = r.value;
        }
      }
      return opts;
    }

    function findVariant(opts) {
      var hasOptionRadios = root.querySelectorAll('input[type="radio"][data-pham-option]').length > 0;
      if (!hasOptionRadios && variants.length > 0) {
        return variants[0];
      }
      for (var i = 0; i < variants.length; i++) {
        var v = variants[i];
        if (!v || !v.options) continue;
        var match = true;
        for (var j = 0; j < v.options.length; j++) {
          if ((v.options[j] || '') !== (opts[j] || '')) { match = false; break; }
        }
        if (match) return v;
      }
      return null;
    }

    function updateLegends(opts) {
      for (var i = 0; i < legendValueEls.length; i++) {
        var el = legendValueEls[i];
        var idx = parseInt(el.getAttribute('data-pham-option-value'), 10);
        if (!isNaN(idx) && opts[idx] != null) el.textContent = opts[idx];
      }
    }

    function updateUrl(variant) {
      if (!variant || !window.history || !window.history.replaceState) return;
      try {
        var url = new URL(window.location.href);
        url.searchParams.set('variant', variant.id);
        window.history.replaceState({}, '', url.toString());
      } catch (e) { /* ignore */ }
    }

    function updateScarcity(variant) {
      if (!scarcityEl) return;
      if (variant
          && variant.inventory_management != null
          && variant.inventory_management !== ''
          && typeof variant.inventory_quantity === 'number'
          && variant.inventory_quantity > 0
          && variant.inventory_quantity <= 5) {
        scarcityEl.textContent = 'EDITION OF ' + variant.inventory_quantity + ' AVAILABLE';
        scarcityEl.removeAttribute('hidden');
      } else {
        scarcityEl.textContent = '';
        scarcityEl.setAttribute('hidden', '');
      }
    }

    function updatePrice(variant) {
      if (!priceEl || !variant) return;
      var formatted = formatMoney(variant.price);
      var currentEl = priceEl.querySelector('.pham-product-main__price-current');
      var compareEl = priceEl.querySelector('.pham-product-main__price-compare');
      if (currentEl) currentEl.textContent = formatted;

      if (variant.compare_at_price && variant.compare_at_price > variant.price) {
        if (currentEl) currentEl.classList.add('pham-product-main__price-current--sale');
        if (!compareEl) {
          compareEl = document.createElement('s');
          compareEl.className = 'pham-product-main__price-compare';
          priceEl.insertBefore(compareEl, priceEl.firstChild);
        }
        compareEl.textContent = formatMoney(variant.compare_at_price);
      } else {
        if (currentEl) currentEl.classList.remove('pham-product-main__price-current--sale');
        if (compareEl) compareEl.parentNode.removeChild(compareEl);
      }
    }

    function updateVariantIds(variant) {
      if (!variant) return;
      var idStr = String(variant.id);
      for (var vi = 0; vi < variantIdInputs.length; vi++) {
        variantIdInputs[vi].value = idStr;
      }
    }

    function updateAddToCartState(variant) {
      if (!addToCartBtn) return;
      var available = !!(variant && variant.available);
      addToCartBtn.disabled = !available;
      addToCartBtn.setAttribute('aria-disabled', available ? 'false' : 'true');
    }

    function syncCartQuantity() {
      if (!cartQtyInput) return;
      var qty = 1;
      if (editionQtyInput) {
        var parsed = parseInt(editionQtyInput.value, 10);
        if (!isNaN(parsed) && parsed > 0) qty = parsed;
      }
      cartQtyInput.value = String(qty);
    }
    function updateWaitlistLink(variant) {
      if (!waitlistCta || !waitlistBase || !variant) return;
      var sep = waitlistBase.indexOf('?') >= 0 ? '&' : '?';
      waitlistCta.href = waitlistBase + sep + 'variant=' + encodeURIComponent(String(variant.id));
    }

    function updateSku(variant) {
      if (!skuEl || !variant) return;
      if (variant.sku) skuEl.textContent = 'SKU · ' + variant.sku;
      else skuEl.textContent = '';
    }

    function update() {
      var opts = getSelectedOptions();
      updateLegends(opts);
      var variant = findVariant(opts);
      updateVariantIds(variant);
      updatePrice(variant);
      updateScarcity(variant);
      updateWaitlistLink(variant);
      updateAddToCartState(variant);
      syncCartQuantity();
      updateSku(variant);
      if (variant) updateUrl(variant);
    }

    /* ====== Product gallery (Shopee-style) ====== */
    var gallery = root.querySelector('[data-pham-product-gallery]');
    if (gallery) {
      var slides = gallery.querySelectorAll('[data-pham-gallery-slide]');
      var thumbs = gallery.querySelectorAll('[data-pham-gallery-thumb]');
      var prevBtn = gallery.querySelector('[data-pham-gallery-prev]');
      var nextBtn = gallery.querySelector('[data-pham-gallery-next]');
      var currentEl = gallery.querySelector('[data-pham-gallery-current]');
      var thumbStrip = gallery.querySelector('[data-pham-gallery-thumbs]');
      var thumbPrev = gallery.querySelector('[data-pham-thumb-prev]');
      var thumbNext = gallery.querySelector('[data-pham-thumb-next]');
      var activeIndex = 0;
      var total = slides.length;

      function pauseSlideMedia(slide) {
        if (!slide) return;
        var vids = slide.querySelectorAll('video');
        for (var vi = 0; vi < vids.length; vi++) {
          try { vids[vi].pause(); } catch (e) { /* */ }
        }
      }

      function goTo(index) {
        if (!total) return;
        if (index < 0) index = total - 1;
        if (index >= total) index = 0;
        activeIndex = index;

        for (var si = 0; si < slides.length; si++) {
          var on = si === activeIndex;
          slides[si].classList.toggle('is-active', on);
          if (!on) pauseSlideMedia(slides[si]);
        }
        for (var ti = 0; ti < thumbs.length; ti++) {
          var active = ti === activeIndex;
          thumbs[ti].classList.toggle('is-active', active);
          thumbs[ti].setAttribute('aria-selected', active ? 'true' : 'false');
          if (active && thumbStrip) {
            try {
              thumbs[ti].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            } catch (e) { /* */ }
          }
        }
        if (currentEl) currentEl.textContent = String(activeIndex + 1);
      }

      function updateThumbNav() {
        if (!thumbStrip || !thumbPrev || !thumbNext) return;
        var overflow = thumbStrip.scrollWidth > thumbStrip.clientWidth + 2;
        thumbPrev.hidden = !overflow;
        thumbNext.hidden = !overflow;
      }

      if (prevBtn) prevBtn.addEventListener('click', function () { goTo(activeIndex - 1); });
      if (nextBtn) nextBtn.addEventListener('click', function () { goTo(activeIndex + 1); });

      for (var t = 0; t < thumbs.length; t++) {
        (function (thumb) {
          thumb.addEventListener('click', function () {
            var idx = parseInt(thumb.getAttribute('data-slide-index'), 10);
            if (!isNaN(idx)) goTo(idx);
          });
        })(thumbs[t]);
      }

      if (thumbPrev && thumbStrip) {
        thumbPrev.addEventListener('click', function () {
          thumbStrip.scrollBy({ left: -160, behavior: 'smooth' });
        });
      }
      if (thumbNext && thumbStrip) {
        thumbNext.addEventListener('click', function () {
          thumbStrip.scrollBy({ left: 160, behavior: 'smooth' });
        });
      }

      gallery.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(activeIndex - 1); }
        if (e.key === 'ArrowRight') { e.preventDefault(); goTo(activeIndex + 1); }
      });

      if (thumbStrip) {
        updateThumbNav();
        window.addEventListener('resize', updateThumbNav);
      }
    }

    var radios = root.querySelectorAll('input[type="radio"][data-pham-option]');
    for (var i = 0; i < radios.length; i++) {
      radios[i].addEventListener('change', update);
    }

    if (form) {
      var cartForms = form.querySelectorAll('[data-pham-product-cart-form]');
      for (var cf = 0; cf < cartForms.length; cf++) {
        cartForms[cf].addEventListener('submit', syncCartQuantity);
      }
    }

    /* ====== Zoom modal ====== */
    var modal     = root.querySelector('[data-pham-zoom-modal]');
    var modalImg  = modal ? modal.querySelector('[data-pham-zoom-img]') : null;
    var triggers  = root.querySelectorAll('[data-pham-zoom-trigger]');
    var closers   = modal ? modal.querySelectorAll('[data-pham-zoom-close]') : [];
    var lastFocused = null;

    if (modal && modal.parentNode !== document.body) {
      document.body.appendChild(modal);
    }

    function openZoom(src, alt, srcset) {
      if (!modal || !modalImg) return;
      lastFocused = document.activeElement;
      modalImg.src = src;
      if (srcset) modalImg.setAttribute('srcset', srcset);
      modalImg.alt = alt || '';
      modal.removeAttribute('hidden');
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('pham-no-scroll');
      document.body.style.overflow = 'hidden';
      var closeEl = modal.querySelector('.pham-product-main__zoom-close');
      if (closeEl) { try { closeEl.focus(); } catch (e) {} }
    }

    function closeZoom() {
      if (!modal) return;
      modal.classList.remove('is-open');
      modal.setAttribute('hidden', '');
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('pham-no-scroll');
      document.body.style.overflow = '';
      if (modalImg) {
        modalImg.removeAttribute('srcset');
        modalImg.src = '';
      }
      if (lastFocused && typeof lastFocused.focus === 'function') {
        try { lastFocused.focus(); } catch (e) {}
      }
      lastFocused = null;
    }

    closeZoom();

    for (var t = 0; t < triggers.length; t++) {
      (function(trig) {
        trig.addEventListener('click', function(e) {
          e.preventDefault();
          openZoom(trig.dataset.phamZoomSrc, trig.dataset.phamZoomAlt, trig.dataset.phamZoomSrcset);
        });
      })(triggers[t]);
    }
    for (var c = 0; c < closers.length; c++) {
      closers[c].addEventListener('click', function(e) {
        e.preventDefault();
        closeZoom();
      });
    }
    document.addEventListener('keydown', function(e) {
      if ((e.key === 'Escape' || e.key === 'Esc') && modal && modal.classList.contains('is-open')) {
        closeZoom();
      }
    });

    update();
  })();
</script>

