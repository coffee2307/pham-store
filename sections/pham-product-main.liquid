<!-- # DO NOT EDIT — managed by PHAM theme architecture -->
{%- capture pham_preorder_open_raw -%}{%- render 'pham-preorder-open', section: section -%}{%- endcapture -%}
{%- assign pham_preorder_open_raw = pham_preorder_open_raw | strip -%}
{%- assign pham_preorder_open = true -%}
{%- if pham_preorder_open_raw == 'false' -%}{%- assign pham_preorder_open = false -%}{%- endif -%}
{%- capture pham_waitlist_page_url -%}{%- render 'pham-waitlist-page-url' -%}{%- endcapture -%}
{%- assign pham_waitlist_page_url = pham_waitlist_page_url | strip -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif

  assign show_vendor       = section.settings.show_vendor
  assign show_sku          = section.settings.show_sku
  assign details_heading   = section.settings.details_heading | default: 'Product details'
  assign shipping_heading  = section.settings.shipping_heading | default: 'Shipping & Returns'
  assign care_heading      = section.settings.care_heading | default: 'Composition & Care'
  assign shipping_content  = section.settings.shipping_content
  assign care_content      = section.settings.care_content
  assign size_handle       = section.settings.size_guide_handle | default: 'size-guide'
  assign faq_handle        = section.settings.faq_handle | default: 'faq'
  assign size_guide_page   = pages[size_handle]
  assign faq_page          = pages[faq_handle]
  assign short_tagline     = product.metafields.custom.short_tagline.value
  assign edition_number    = product.metafields.custom.edition_number.value
  assign shipping_window   = product.metafields.custom.shipping_window.value
-%}
{%- capture construction_content -%}
  {%- if product.metafields.custom.construction != blank -%}
    {{ product.metafields.custom.construction | metafield_tag }}
  {%- else -%}
    {{ product.description }}
  {%- endif -%}
{%- endcapture -%}
{%- capture materials_content -%}
  {%- if product.metafields.custom.materials != blank -%}
    {{ product.metafields.custom.materials | metafield_tag }}
  {%- endif -%}
{%- endcapture -%}
{%- if product.metafields.custom.care_instructions != blank -%}
  {%- capture care_content -%}{{ product.metafields.custom.care_instructions | metafield_tag }}{%- endcapture -%}
{%- endif -%}

<section class="pham-product-main"
         id="MainProduct-{{ product.id }}"
         data-pham-product-main
         data-section-id="{{ section.id }}"
         data-product-id="{{ product.id }}"
         data-pham-preorder-open="{% if pham_preorder_open %}true{% else %}false{% endif %}"
         role="region"
         aria-label="{{ product.title | escape }}">
  <div class="pham-product-main__grid pham-container">

    {%- comment -%} ============= LEFT: GALLERY (e-commerce layout) ============= {%- endcomment -%}
    <div class="pham-product-main__media reveal-up">
      {% render 'pham-product-gallery', product: product, section_id: section.id %}
    </div>

    {%- comment -%} ============= RIGHT: STICKY PANEL ============= {%- endcomment -%}
    <aside class="pham-product-main__panel">
      <div class="pham-product-main__panel-inner">

        <header class="pham-product-main__head reveal-up" data-pham-delay="80">
          {%- if show_vendor and product.vendor != blank -%}
            <p class="pham-eyebrow pham-product-main__vendor">{{ product.vendor }}</p>
          {%- endif -%}
          <h1 class="pham-product-main__title">{{ product.title }}</h1>
          {%- if short_tagline != blank -%}
            <p class="pham-product-main__tagline">{{ short_tagline }}</p>
          {%- endif -%}
          {%- if edition_number != blank -%}
            <p class="pham-product-main__edition">{{ edition_number }}</p>
          {%- endif -%}

          <div class="pham-product-main__price-block">
            <p class="pham-product-main__price" data-pham-product-price>
              {%- if on_sale -%}
                <s class="pham-product-main__price-compare">{{ product.compare_at_price | money }}</s>
                <span class="pham-product-main__price-current pham-product-main__price-current--sale">{{ current_variant.price | money }}</span>
              {%- else -%}
                <span class="pham-product-main__price-current">{{ current_variant.price | money }}</span>
              {%- endif -%}
            </p>
            {%- if product.has_only_default_variant == false -%}
              <p class="pham-product-main__price-note">Price varies by size</p>
            {%- endif -%}
          </div>

          {%- if show_sku -%}
            <p class="pham-product-main__sku" data-pham-product-sku>
              {%- if current_variant.sku != blank -%}SKU · {{ current_variant.sku }}{%- endif -%}
            </p>
          {%- endif -%}
        </header>

        <p class="pham-product-main__scarcity"
           data-pham-product-scarcity
           {% unless current_variant.inventory_management != blank and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 5 %}hidden{% endunless %}>
          {%- if current_variant.inventory_management != blank and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 5 -%}
            EDITION OF {{ current_variant.inventory_quantity }} AVAILABLE
          {%- endif -%}
        </p>

        <div class="pham-product-main__form reveal-up"
             data-pham-delay="120"
             data-pham-product-form
             data-pham-waitlist-base="{{ pham_waitlist_page_url | escape }}">

          {%- unless product.has_only_default_variant -%}
            <div class="pham-product-main__options">
              {%- for option in product.options_with_values -%}
                <fieldset class="pham-variant-group"
                          role="radiogroup"
                          aria-label="{{ option.name | escape }}"
                          data-option-index="{{ forloop.index0 }}">
                  <legend class="pham-variant-group__legend">
                    <span class="pham-variant-group__name">{{ option.name }}</span>
                    <span class="pham-variant-group__value" data-pham-option-value="{{ forloop.index0 }}">{{ option.selected_value }}</span>
                  </legend>
                  <div class="pham-variant-group__values">
                    {%- for value in option.values -%}
                      {%- assign value_handle = value | handleize -%}
                      {%- assign rid = 'pham-pm-' | append: section.id | append: '-' | append: forloop.parentloop.index0 | append: '-' | append: value_handle -%}
                      <input type="radio"
                             id="{{ rid }}"
                             name="options[{{ option.name | escape }}]"
                             value="{{ value | escape }}"
                             class="pham-visually-hidden pham-radio"
                             data-pham-option
                             data-option-index="{{ forloop.parentloop.index0 }}"
                             {% if option.selected_value == value %}checked{% endif %}>
                      <label for="{{ rid }}" class="pham-radio-label">
                        <span>{{ value }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <input type="hidden" name="id" value="{{ current_variant.id }}" data-pham-variant-id>

          {%- capture pham_show_limited_qty -%}{%- render 'pham-is-limited-edition', product: product -%}{%- endcapture -%}
          {%- assign pham_show_limited_qty = pham_show_limited_qty | strip -%}
          {%- if pham_show_limited_qty == 'true' -%}
            {%- render 'pham-edition-qty', section_id: section.id, style: 'main' -%}
          {%- endif -%}

          {%- render 'pham-product-purchase-cta',
              product: product,
              current_variant: current_variant,
              pham_preorder_open: pham_preorder_open,
              pham_waitlist_page_url: pham_waitlist_page_url,
              section: section,
              style: 'main'
          -%}

          {%- if section.settings.preorder_note != blank -%}
            <p class="pham-product-main__preorder-note">{{ section.settings.preorder_note }}</p>
          {%- endif -%}
          {%- if shipping_window != blank -%}
            <p class="pham-product-main__shipping-window">{{ shipping_window }}</p>
          {%- endif -%}

          {%- if section.settings.show_trust_strip -%}
            {% render 'pham-product-trust', section: section %}
          {%- endif -%}
        </div>

        <div class="pham-product-main__accordions reveal-up" data-pham-delay="180">
          {%- assign phase_blocks = section.blocks | where: 'type', 'phase' -%}
          {%- if phase_blocks.size > 0 or section.settings.show_phases_default -%}
            {%- capture phases_content -%}{%- render 'pham-product-phases-content', section: section -%}{%- endcapture -%}
            {%- assign phases_id = section.id | append: '-phases' -%}
            {%- assign phases_heading = section.settings.phases_eyebrow | default: 'PRODUCTION SCHEDULE' -%}
            {% render 'pham-accordion', heading: phases_heading, content: phases_content, id: phases_id %}
          {%- endif -%}

          {%- assign details_id = section.id | append: '-details' -%}
          {% render 'pham-accordion', heading: details_heading, content: construction_content, id: details_id, open: true %}

          {%- if materials_content != blank -%}
            {%- assign materials_id = section.id | append: '-materials' -%}
            {% render 'pham-accordion', heading: section.settings.materials_heading, content: materials_content, id: materials_id %}
          {%- endif -%}

          {%- if shipping_content != blank -%}
            {%- assign ship_id = section.id | append: '-ship' -%}
            {% render 'pham-accordion', heading: shipping_heading, content: shipping_content, id: ship_id %}
          {%- endif -%}

          {%- if care_content != blank -%}
            {%- assign care_id = section.id | append: '-care' -%}
            {% render 'pham-accordion', heading: care_heading, content: care_content, id: care_id %}
          {%- endif -%}

          {%- if section.settings.show_size_guide_link and size_guide_page != blank -%}
            {%- capture size_guide_content -%}
              <p><a href="{{ size_guide_page.url }}" class="pham-product-main__guide-link">View full size guide &rarr;</a></p>
            {%- endcapture -%}
            {%- assign size_id = section.id | append: '-size' -%}
            {% render 'pham-accordion', heading: section.settings.size_guide_heading, content: size_guide_content, id: size_id %}
          {%- endif -%}

          {%- if section.settings.show_faq_link and faq_page != blank -%}
            {%- capture faq_content -%}
              <p><a href="{{ faq_page.url }}" class="pham-product-main__guide-link">Read frequently asked questions &rarr;</a></p>
            {%- endcapture -%}
            {%- assign faq_id = section.id | append: '-faq' -%}
            {% render 'pham-accordion', heading: section.settings.faq_heading, content: faq_content, id: faq_id %}
          {%- endif -%}
        </div>
      </div>
    </aside>
  </div>

  {%- comment -%} ============= ZOOM MODAL ============= {%- endcomment -%}
  <div class="pham-product-main__zoom"
       data-pham-zoom-modal
       role="dialog"
       aria-modal="true"
       aria-hidden="true"
       aria-label="Image zoom"
       tabindex="-1"
       hidden>
    <button type="button"
            class="pham-product-main__zoom-backdrop"
            data-pham-zoom-close
            aria-label="Close zoom"></button>
    <button type="button"
            class="pham-product-main__zoom-close"
            data-pham-zoom-close
            aria-label="Close zoom">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <line x1="4" y1="4" x2="20" y2="20" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        <line x1="20" y1="4" x2="4" y2="20" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
    </button>
    <img class="pham-product-main__zoom-img"
         data-pham-zoom-img
         alt=""
         width="1600"
         height="2000"
         loading="lazy">
  </div>

  <script type="application/json" data-pham-product-variants>
    {{ product.variants | json }}
  </script>

  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
</section>

<style>
  .pham-product-main {
    background-color: var(--color-void);
    color: var(--color-bone);
    padding-block-end: var(--space-2xl);
  }
  .pham-product-main__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(var(--space-lg), 4vw, var(--space-2xl));
    align-items: start;
  }
  .pham-product-main__tagline { max-width: 42ch; margin: 14px 0 0; color: var(--color-bone-60); font: 400 .9rem/1.6 var(--font-body); }
  .pham-product-main__edition { margin: 12px 0 0; color: var(--color-smoke); font: 400 9px/1.4 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; }
  .pham-product-main__shipping-window { margin: 12px 0 0; padding: 12px 14px; border: 1px solid rgba(255,255,255,.14); color: var(--color-bone-80); font: 400 9px/1.5 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .pham-product-main__media {
    align-self: start;
  }

  /* E-commerce gallery (Shopee-style) */
  .pham-pdp-gallery {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    width: 100%;
  }
  .pham-pdp-gallery__viewer {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-obsidian);
    border: 1px solid var(--color-ash);
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .pham-pdp-gallery__stage {
    position: relative;
    flex: 1;
    width: 100%;
    min-height: 0;
  }
  .pham-pdp-gallery__slide {
    display: none;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
  }
  .pham-pdp-gallery__slide.is-active {
    display: flex;
    position: relative;
  }
  .pham-pdp-gallery__zoom-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: var(--space-md);
    box-sizing: border-box;
    background: transparent;
    border: 0;
    cursor: zoom-in;
  }
  .pham-pdp-gallery__img,
  .pham-pdp-gallery__video-frame,
  .pham-pdp-gallery__model-viewer {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .pham-pdp-gallery__video,
  .pham-pdp-gallery__model {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pham-pdp-gallery__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(5, 5, 5, 0.72);
    border: 1px solid var(--color-ash);
    color: var(--color-bone);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-luxury), border-color var(--duration-fast) var(--ease-luxury);
  }
  .pham-pdp-gallery__nav:hover {
    background: rgba(5, 5, 5, 0.92);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .pham-pdp-gallery__nav--prev { left: var(--space-sm); }
  .pham-pdp-gallery__nav--next { right: var(--space-sm); }
  .pham-pdp-gallery__counter {
    position: absolute;
    bottom: var(--space-sm);
    right: var(--space-sm);
    margin: 0;
    padding: 4px 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--color-bone);
    background: rgba(5, 5, 5, 0.72);
    border: 1px solid var(--color-ash);
    z-index: 2;
  }
  .pham-pdp-gallery__thumbs-wrap {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-xs);
  }
  .pham-pdp-gallery__thumb-nav {
    flex-shrink: 0;
    width: 28px;
    height: 72px;
    background: transparent;
    border: 1px solid var(--color-ash);
    color: var(--color-smoke);
    cursor: pointer;
    font-size: 1.1rem;
    transition: color var(--duration-fast) var(--ease-luxury), border-color var(--duration-fast) var(--ease-luxury);
  }
  .pham-pdp-gallery__thumb-nav:hover:not([hidden]) {
    color: var(--color-bone);
    border-color: var(--color-bone);
  }
  .pham-pdp-gallery__thumb-nav[hidden] { display: none; }
  .pham-pdp-gallery__thumbs {
    display: flex;
    gap: var(--space-xs);
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-block: 2px;
  }
  .pham-pdp-gallery__thumbs::-webkit-scrollbar { display: none; }
  .pham-pdp-gallery__thumb {
    flex: 0 0 72px;
    width: 72px;
    height: 72px;
    padding: 0;
    background: var(--color-obsidian);
    border: 1px solid var(--color-ash);
    cursor: pointer;
    overflow: hidden;
    transition: border-color var(--duration-fast) var(--ease-luxury);
  }
  .pham-pdp-gallery__thumb.is-active,
  .pham-pdp-gallery__thumb:hover {
    border-color: var(--color-accent);
  }
  .pham-pdp-gallery__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .pham-pdp-gallery__thumb-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--color-ash);
  }

  .pham-product-main__panel {
    position: sticky;
    top: calc(80px + var(--space-md));
    align-self: start;
    padding-block: var(--space-md);
  }
  .pham-product-main__panel-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: none;
  }
  .pham-product-main__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .pham-product-main__vendor { color: var(--color-accent); margin: 0; }
  .pham-product-main__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    color: var(--color-bone);
    margin: 0;
  }
  .pham-product-main__price-block {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: var(--space-xs);
  }
  .pham-product-main__price {
    font-family: var(--font-mono);
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-white);
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    line-height: 1.1;
  }
  .pham-product-main__price-current {
    color: var(--color-white);
  }
  .pham-product-main__price-compare {
    color: var(--color-smoke);
    font-size: 0.72em;
    font-weight: 400;
  }
  .pham-product-main__price-current--sale { color: var(--color-accent); }
  .pham-product-main__price-note {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-smoke);
  }
  .pham-product-main__sku {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-luxury);
    text-transform: uppercase;
    color: var(--color-smoke);
    margin: 0;
  }

  .pham-product-main__scarcity {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-luxury);
    text-transform: uppercase;
    color: var(--color-accent);
    padding: 8px 12px;
    border: 1px solid var(--color-accent);
    align-self: flex-start;
    margin: 0;
  }
  .pham-product-main__scarcity[hidden] { display: none; }

  /* Variant pickers */
  .pham-product-main__options {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .pham-variant-group {
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .pham-variant-group__legend {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    width: 100%;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-luxury);
    text-transform: uppercase;
    color: var(--color-smoke);
  }
  .pham-variant-group__value { color: var(--color-bone); }
  .pham-variant-group__values {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .pham-radio-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 40px;
    padding: 0 14px;
    border: 1px solid var(--color-ash);
    background-color: transparent;
    color: var(--color-bone);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-luxury),
                color var(--duration-fast) var(--ease-luxury),
                background-color var(--duration-fast) var(--ease-luxury);
  }
  .pham-radio-label:hover { border-color: var(--color-bone); }
  .pham-radio:checked + .pham-radio-label {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .pham-radio:focus-visible + .pham-radio-label {
    outline: 1px solid var(--color-accent);
    outline-offset: 2px;
  }
  .pham-radio[disabled] + .pham-radio-label {
    color: var(--color-smoke);
    border-color: var(--color-ash);
    background-image: linear-gradient(to top right, transparent calc(50% - 0.5px), var(--color-smoke) 50%, transparent calc(50% + 0.5px));
    cursor: not-allowed;
  }

  /* Quantity */
  .pham-product-main__qty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }
  .pham-product-main__qty-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-luxury);
    text-transform: uppercase;
    color: var(--color-smoke);
  }
  .pham-product-main__qty-stepper {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-ash);
  }
  .pham-product-main__qty-btn {
    width: 40px;
    height: 40px;
    background: transparent;
    border: 0;
    cursor: pointer;
    color: var(--color-bone);
    font-size: var(--text-md);
    display: inline-flex;
