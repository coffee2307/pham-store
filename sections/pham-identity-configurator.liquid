{{ 'pham-campaign.css' | asset_url | stylesheet_tag }}
{%- assign edition_size = settings.pham_campaign_edition_size | default: 50 -%}
{%- assign commerce_ready = settings.pham_campaign_commerce_ready | default: false -%}
{%- assign identity_status = 'locked' -%}
{%- assign reservation_id = blank -%}
{%- if customer -%}
  {%- assign identity_status = customer.metafields.pham.identity_status.value | default: 'locked' | downcase -%}
  {%- assign reservation_id = customer.metafields.pham.reservation_id.value -%}
{%- endif -%}
{%- assign can_configure = false -%}
{%- if customer and identity_status != 'locked' -%}{%- assign can_configure = true -%}{%- endif -%}
{%- assign submit_enabled = false -%}
{%- if can_configure and commerce_ready -%}{%- assign submit_enabled = true -%}{%- endif -%}
{%- assign identity_contact_email = settings.pham_contact_email | default: 'contact@phamofficial.com' -%}
{%- assign identity_whatsapp_number = settings.pham_identity_whatsapp_number | default: '' | strip | remove: '+' | remove: ' ' | remove: '-' -%}

<section class="pham-campaign-shell"
  data-pham-identity-configurator
  data-edition-size="{{ edition_size }}"
  data-submit-enabled="{% if submit_enabled %}true{% else %}false{% endif %}"
  data-identity-email="{{ identity_contact_email | escape }}"
  data-identity-whatsapp="{{ identity_whatsapp_number | escape }}"
  data-identity-reservation="{{ reservation_id | escape }}"
  data-identity-edition="{{ settings.pham_campaign_edition_label | default: 'EDITION 01' | escape }}"
  data-engine-enabled="{% if settings.pham_campaign_engine_enabled %}true{% else %}false{% endif %}"
  data-engine-proxy="{{ settings.pham_campaign_engine_proxy_path | default: '/apps/pham-edition' | escape }}">
  <div class="pham-campaign-inner pham-identity-page">
    <header class="pham-identity-page__intro">
      <h1 class="pham-campaign-title">Object <strong class="pham-funnel-emphasis">identity.</strong></h1>
      <p class="pham-campaign-lede">Preview your collector card, then message PHAM via email or WhatsApp to request personalisation. Nothing is submitted automatically.</p>
    </header>

    <div class="pham-identity-access" role="status">
      {%- unless commerce_ready -%}
        <p><strong>Preview mode.</strong> Explore card options now. Personalisation enquiries are enabled only for eligible collectors after launch. No number is reserved here.</p>
      {%- else -%}
        {%- if customer == nil -%}
          <p><strong>Sign in to continue.</strong> Identity configuration is available to eligible collectors.</p>
          <a href="{{ routes.account_login_url }}">Sign in</a>
        {%- elsif can_configure == false -%}
          <p><strong>Identity not unlocked.</strong> Available through the paid upgrade or a verified referral, subject to the {{ settings.pham_campaign_identity_limit | default: 15 }}-place limit.</p>
          {%- if settings.pham_campaign_referral_page_url != blank -%}
            <a href="{{ settings.pham_campaign_referral_page_url }}">Referral access</a>
          {%- endif -%}
        {%- else -%}
          <p><strong>Ready to personalise.</strong> Choose your details, then message PHAM directly. Your card is not confirmed until PHAM replies.</p>
        {%- endif -%}
      {%- endunless -%}
    </div>

    <div class="pham-identity-editor">
      <div class="pham-identity-form" data-pham-identity-form>
        <input type="hidden" data-pham-id-number-input value="">
            <div class="pham-identity-editor__grid">
              <div class="pham-identity-editor__controls">

                <fieldset class="pham-identity-number-field">
                  <legend><span class="pham-identity-step-index">01</span> Choose jacket number <span>01–{{ edition_size }}</span></legend>
                  <p class="pham-identity-number-field__hint">Choose one preferred number. This request is subject to PHAM confirmation.</p>
                  <div class="pham-number-grid" role="group" aria-label="Preferred jacket number">
                    {%- for i in (1..edition_size) -%}
                      {%- capture display_number -%}{%- if i < 10 -%}0{%- endif -%}{{ i }}{%- endcapture -%}
                      <button type="button"
                              data-pham-object-number="{{ i }}"
                              aria-label="Request jacket number {{ display_number }} of {{ edition_size }}"
                              aria-pressed="false"
                              {% unless can_configure or commerce_ready == false %}disabled{% endunless %}>{{ display_number }}</button>
                    {%- endfor -%}
                  </div>
                  <p class="pham-identity-number-status" data-pham-number-status aria-live="polite">No number selected yet.</p>
                </fieldset>

                <div class="pham-identity-step-title"><span class="pham-identity-step-index">02</span><div><h2>Personalize your card</h2><p>Your name and inscription appear on the preview. Special requests go privately to our production team.</p></div></div>
                <div class="pham-identity-editor__fields">
                  <div class="pham-config-field">
                    <label for="PhamIdentityName-{{ section.id }}">Name to print <span class="pham-identity-counter" data-pham-name-count>0/24</span></label>
                    <input id="PhamIdentityName-{{ section.id }}"
                           data-pham-id-name
                           
                           maxlength="24"
                           required
                           autocomplete="nickname"
                           placeholder="YOUR IDENTITY"
                           {% unless can_configure or commerce_ready == false %}disabled{% endunless %}>
                  </div>
                  <div class="pham-config-field">
                    <label for="PhamIdentityInscription-{{ section.id }}">Card inscription <span class="pham-identity-counter" data-pham-inscription-count>0/40</span></label>
                    <textarea id="PhamIdentityInscription-{{ section.id }}"
                              data-pham-id-inscription
                              
                              maxlength="40"
                              rows="2"
                              placeholder="A SHORT PERSONAL MESSAGE"
                              {% unless can_configure or commerce_ready == false %}disabled{% endunless %}></textarea>
                  </div>
                  <div class="pham-config-field pham-config-field--notes">
                    <label for="PhamIdentityNotes-{{ section.id }}">Special printing request <span class="pham-identity-counter" data-pham-notes-count>0/240</span></label>
                    <textarea id="PhamIdentityNotes-{{ section.id }}" data-pham-id-production-notes 
                              maxlength="240" rows="3"
                              placeholder="Letter case, spacing or layout details for PHAM to review"
                              {% unless can_configure or commerce_ready == false %}disabled{% endunless %}></textarea>
                    <p class="pham-identity-field-note">Optional and private. Not printed verbatim or shown publicly. Please avoid contact or sensitive information; all changes require production approval.</p>
                  </div>
                </div>

              </div>

              <aside class="pham-identity-editor__preview">
                <p class="pham-identity-editor__preview-label"><span class="pham-identity-step-index">03</span> Your card preview</p>
                <div class="pham-id-preview" aria-label="Collector card preview">
                  <div class="pham-id-preview__brand">PHAM</div>
                  <div class="pham-id-preview__main">
                    <div class="pham-id-preview__object">{{ settings.pham_campaign_product_code | default: 'PHAM-001' }}<span class="pham-id-preview__number">No. <span data-pham-preview-number>-- / {{ edition_size }}</span></span></div>
                    <div class="pham-id-preview__identity"><span data-pham-preview-name>YOUR IDENTITY</span>
<span data-pham-preview-inscription>YOUR INSCRIPTION</span></div>
                  </div>
                  <div class="pham-id-preview__foot"><span>{{ settings.pham_campaign_edition_label | default: 'EDITION 01' }}</span><span>QR RECORD</span></div>
                </div>
                <p class="pham-identity-editor__preview-note">Illustrative preview, not a manufacturing proof. Final layout and number are confirmed separately by PHAM.</p>
              </aside>
            </div>

            <div class="pham-identity-editor__actions">
              <div class="pham-identity-step-title pham-identity-step-title--contact">
                <span class="pham-identity-step-index">04</span>
                <div>
                  <h2>Message PHAM to confirm</h2>
                  <p>Choose a contact channel below. The message is prepared for you, but you must send it yourself and wait for our reply. Selecting a number does not reserve it.</p>
                </div>
              </div>
              <label class="pham-identity-public-choice">
                <input type="checkbox" data-pham-public-identity
                       value="yes"
                       {% unless can_configure or commerce_ready == false %}disabled{% endunless %}>
                <span>Show my alias on the public Object Record. Contact information remains private.</span>
              </label>
              <label class="pham-identity-public-choice pham-identity-review-choice">
                <input type="checkbox" data-pham-identity-review required
                       {% unless can_configure or commerce_ready == false %}disabled{% endunless %}>
                <span>I have checked the spelling. I understand this is a request, not a final production proof; numbers and special instructions are subject to approval. <a href="{{ settings.pham_campaign_terms_page_url | default: '/pages/edition-01-terms' }}">Edition terms</a>.</span>
              </label>
              {%- if submit_enabled -%}
                <div class="pham-identity-contact-methods" aria-label="Contact PHAM for personalisation">
                  <a href="#" class="pham-campaign-btn pham-identity-contact-method is-disabled" data-pham-identity-email-link aria-disabled="true">
                    <span>Email PHAM</span><small>{{ identity_contact_email | escape }}</small>
                  </a>
                  {%- if identity_whatsapp_number != blank -%}
                    <a href="#" class="pham-campaign-btn pham-identity-contact-method pham-identity-contact-method--secondary is-disabled" data-pham-identity-whatsapp-link aria-disabled="true" target="_blank" rel="noopener noreferrer">
                      <span>Message on WhatsApp</span><small>WhatsApp Business</small>
                    </a>
                  {%- else -%}
                    <div class="pham-identity-contact-method pham-identity-contact-method--unavailable" role="note">
                      <span>WhatsApp</span><small>Available once PHAM confirms its official contact number</small>
                    </div>
                  {%- endif -%}
                </div>
                <p class="pham-identity-field-note">You may also attach a reference picture in your email or WhatsApp conversation. PHAM will confirm feasibility before printing. Do not send card-payment information or sensitive documents.</p>
              {%- else -%}
                <div class="pham-identity-contact-methods" aria-label="PHAM personalisation contact channels">
                  <span class="pham-campaign-btn pham-identity-contact-method is-disabled" aria-disabled="true">Email PHAM</span>
                  <span class="pham-campaign-btn pham-identity-contact-method is-disabled" aria-disabled="true">WhatsApp</span>
                </div>
                <p class="pham-identity-editor__locked">Direct contact for personalisation opens to eligible collectors after launch. This preview does not reserve a number or send a message.</p>
              {%- endif -%}
            </div>
          <p class="pham-identity-result" data-pham-identity-result hidden role="status"></p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{"name":"PHAM Identity Card","tag":"section","settings":[],"presets":[{"name":"PHAM Identity Card"}]}
{% endschema %}
