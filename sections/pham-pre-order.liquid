<!-- # DO NOT EDIT — managed by PHAM theme architecture -->
{%- capture pham_feat_handle -%}{%- render 'pham-featured-product-handle', product_ref: section.settings.product -%}{%- endcapture -%}
{%- assign pham_feat_handle = pham_feat_handle | strip -%}
{%- if pham_feat_handle != blank -%}
  {%- assign product = all_products[pham_feat_handle] -%}
{%- endif -%}
{%- if product == blank or product == nil -%}
  {%- for pham_item in collections.all.products limit: 1 -%}
    {%- assign product = pham_item -%}
  {%- endfor -%}
{%- endif -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign on_sale = false
  if product != blank and product.compare_at_price > product.price
    assign on_sale = true
  endif

  assign show_vendor       = section.settings.show_vendor
  assign show_sku          = section.settings.show_sku
  assign details_heading   = section.settings.details_heading | default: 'Product details'
  assign shipping_heading  = section.settings.shipping_heading | default: 'Shipping & Returns'
  assign care_heading      = section.settings.care_heading | default: 'Composition & Care'
  assign shipping_content  = section.settings.shipping_content
  assign care_content      = section.settings.care_content
-%}

{%- if product == blank or product == nil -%}
<section class="pham-pre-order pham-pre-order--empty"
         data-pham-pre-order
         data-section-id="{{ section.id }}"
         role="region"
         aria-label="Pre-order">
  <div class="pham-container pham-pre-order__empty">
    <p class="pham-eyebrow">PRE-ORDER · EDITION 01</p>
    <h1 class="pham-pre-order__empty-title">No edition published.</h1>
    <p class="pham-pre-order__empty-text">Select a featured product in <strong>Theme settings → PHAM Brand → Featured product</strong>, then reload this page.</p>
    <a href="{{ routes.root_url }}" class="pham-back-link">Return to atelier</a>
  </div>
</section>
{%- else -%}

<section class="pham-product-main pham-pre-order"
         data-pham-product-main
         data-pham-pre-order
         data-section-id="{{ section.id }}"
         data-product-id="{{ product.id }}"
         role="region"
         aria-label="{{ product.title | escape }}">
  <div class="pham-container pham-pre-order__gateway reveal-up">
    <p class="pham-eyebrow">{{ section.settings.eyebrow | default: 'PRE-ORDER · EDITION 01' }}</p>
    <h2 class="pham-pre-order__title">{{ section.settings.heading | default: 'Secure your pre-order' }}</h2>
    {%- if section.settings.intro != blank -%}
      <p class="pham-pre-order__intro">{{ section.settings.intro }}</p>
    {%- endif -%}
  </div>
  <div class="pham-product-main__grid pham-container">

    {%- comment -%} ============= LEFT: MEDIA STACK ============= {%- endcomment -%}
    <div class="pham-product-main__media">
      {%- if product.media.size > 0 -%}
        <div class="pham-product-main__gallery" role="list">
          {%- for media in product.media -%}
            {%- if forloop.first -%}
              {%- assign pm_loading = 'eager' -%}
              {%- assign pm_fetchpriority = 'high' -%}
            {%- else -%}
              {%- assign pm_loading = 'lazy' -%}
              {%- assign pm_fetchpriority = 'auto' -%}
            {%- endif -%}
            <div class="pham-product-main__media-item" role="listitem">
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  <button type="button"
                          class="pham-product-main__media-trigger"
                          data-pham-zoom-trigger
                          data-pham-zoom-src="{{ media | image_url: width: 2400 }}"
                          data-pham-zoom-srcset="{{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 2000 }} 2000w, {{ media | image_url: width: 2400 }} 2400w"
                          data-pham-zoom-alt="{{ media.alt | default: product.title | escape }}"
                          aria-label="Zoom image {{ forloop.index }}">
                    {{ media
                        | image_url: width: 1600
                        | image_tag:
                          loading: pm_loading,
                          fetchpriority: pm_fetchpriority,
                          widths: '480, 768, 1080, 1440, 1600',
                          sizes: '(max-width: 900px) 100vw, 55vw',
                          class: 'pham-product-main__media-img',
                          alt: media.alt | default: product.title,
                          width: media.width,
                          height: media.height
                    }}
                  </button>
                {%- when 'external_video' -%}
                  <div class="pham-product-main__media-video">
                    {{ media | external_video_tag: class: 'pham-product-main__media-video-frame' }}
                  </div>
                {%- when 'video' -%}
                  <video class="pham-product-main__media-img" controls preload="metadata" playsinline {% if media.preview_image %}poster="{{ media.preview_image | image_url: width: 1600 }}"{% endif %} width="{{ media.width }}" height="{{ media.height }}">
                    {%- for source in media.sources -%}
                      <source src="{{ source.url }}" type="{{ source.mime_type }}">
                    {%- endfor -%}
                  </video>
                {%- when 'model' -%}
                  <div class="pham-product-main__media-model">
                    {{ media | model_viewer_tag: class: 'pham-product-main__media-model-viewer', reveal: 'interaction' }}
                  </div>
                {%- else -%}
                  {%- if media.preview_image -%}
                    {{ media.preview_image
                        | image_url: width: 1600
                        | image_tag:
                          loading: 'lazy',
                          widths: '480, 768, 1080, 1440, 1600',
                          sizes: '(max-width: 900px) 100vw, 55vw',
                          class: 'pham-product-main__media-img',
                          alt: media.alt | default: product.title
                    }}
                  {%- endif -%}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="pham-product-main__media-item">
          <div class="pham-product-main__media-img pham-skeleton" aria-hidden="true" style="aspect-ratio:3/4"></div>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ============= RIGHT: STICKY PANEL ============= {%- endcomment -%}
    <aside class="pham-product-main__panel">
      <div class="pham-product-main__panel-inner">

        <header class="pham-product-main__head">
          {%- if show_vendor and product.vendor != blank -%}
            <p class="pham-eyebrow pham-product-main__vendor">{{ product.vendor }}</p>
          {%- endif -%}
          <h1 class="pham-product-main__title">{{ product.title }}</h1>

          <p class="pham-eyebrow pham-product-main__price-label">Price</p>
          <p class="pham-product-main__price" data-pham-product-price>
            {%- if on_sale -%}
              <s class="pham-product-main__price-compare">{{ product.compare_at_price | money }}</s>
              <span class="pham-product-main__price-current pham-product-main__price-current--sale">{{ current_variant.price | money }}</span>
            {%- else -%}
              <span class="pham-product-main__price-current">{{ current_variant.price | money }}</span>
            {%- endif -%}
          </p>

          {%- if show_sku -%}
            <p class="pham-product-main__sku" data-pham-product-sku>
              {%- if current_variant.sku != blank -%}SKU · {{ current_variant.sku }}{%- endif -%}
            </p>
          {%- endif -%}
        </header>

        <p class="pham-product-main__scarcity"
           data-pham-product-scarcity
           {% unless current_variant.inventory_management != blank and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 5 %}hidden{% endunless %}>
          {%- if current_variant.inventory_management != blank and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 5 -%}
            EDITION OF {{ current_variant.inventory_quantity }} AVAILABLE
          {%- endif -%}
        </p>

        <form action="{{ routes.cart_add_url }}"
              method="post"
              enctype="multipart/form-data"
              class="pham-product-main__form"
              data-pham-product-form
              data-action="add-to-cart"
              novalidate>
          <input type="hidden" name="form_type" value="product">
          <input type="hidden" name="utf8" value="✓">

          {%- unless product.has_only_default_variant -%}
            <div class="pham-product-main__options">
              {%- for option in product.options_with_values -%}
                <fieldset class="pham-variant-group"
                          role="radiogroup"
                          aria-label="{{ option.name | escape }}"
                          data-option-index="{{ forloop.index0 }}">
                  <legend class="pham-variant-group__legend">
                    <span class="pham-variant-group__name">{{ option.name }}</span>
                    <span class="pham-variant-group__value" data-pham-option-value="{{ forloop.index0 }}">{{ option.selected_value }}</span>
                  </legend>
                  <div class="pham-variant-group__values">
                    {%- for value in option.values -%}
                      {%- assign value_handle = value | handleize -%}
                      {%- assign rid = 'pham-pm-' | append: section.id | append: '-' | append: forloop.parentloop.index0 | append: '-' | append: value_handle -%}
                      <input type="radio"
                             id="{{ rid }}"
                             name="options[{{ option.name | escape }}]"
                             value="{{ value | escape }}"
                             class="pham-visually-hidden pham-radio"
                             data-pham-option
                             data-option-index="{{ forloop.parentloop.index0 }}"
                             {% if option.selected_value == value %}checked{% endif %}>
                      <label for="{{ rid }}" class="pham-radio-label">
                        <span>{{ value }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <input type="hidden" name="id" value="{{ current_variant.id }}" data-pham-variant-id>

          <div class="pham-product-main__qty">
            <label for="pham-pm-qty-{{ section.id }}" class="pham-product-main__qty-label">Quantity</label>
            <input id="pham-pm-qty-{{ section.id }}"
                   type="number"
                   name="quantity"
                   value="1"
                   min="1"
                   inputmode="numeric"
                   pattern="[0-9]*"
                   class="pham-product-main__qty-input">
          </div>

          <button type="submit"
                  class="pham-product-main__cta pham-product-main__cta--preorder"
                  data-pham-product-submit
                  data-pham-preorder-cta
                  data-pham-preorder-label="{{ section.settings.preorder_label | default: 'SECURE PRE-ORDER · EDITION 01' | escape }}"
                  {% unless current_variant.available %}disabled aria-disabled="true"{% endunless %}>
            <span class="pham-product-main__cta-fill" aria-hidden="true"></span>
            <span class="pham-product-main__cta-rune" aria-hidden="true">◢</span>
            <span class="pham-product-main__cta-text">
              <span class="pham-product-main__cta-label" data-pham-product-cta-label>
                {%- if current_variant.available -%}
                  {{ section.settings.preorder_label | default: 'SECURE PRE-ORDER · EDITION 01' }}
                {%- else -%}
                  PRE-ORDER CLOSED
                {%- endif -%}
              </span>
              <span class="pham-product-main__cta-price" data-pham-product-cta-price>
                {{ current_variant.price | money }}
              </span>
            </span>
            <span class="pham-product-main__cta-arrow" aria-hidden="true">&rarr;</span>
          </button>

          {%- if section.settings.preorder_note != blank -%}
            <p class="pham-product-main__preorder-note">{{ section.settings.preorder_note }}</p>
          {%- endif -%}
        </form>

        {%- comment -%} ============= PRODUCTION PHASES METADATA ============= {%- endcomment -%}
        {%- assign phase_blocks = section.blocks | where: 'type', 'phase' -%}
        {%- if phase_blocks.size > 0 or section.settings.show_phases_default -%}
          <section class="pham-phases" data-pham-phases aria-label="Production phases">
            <header class="pham-phases__head">
              <span class="pham-eyebrow pham-phases__eyebrow">{{ section.settings.phases_eyebrow | default: 'PRODUCTION SCHEDULE' }}</span>
              <span class="pham-eyebrow pham-phases__system">SYS // ATELIER · 01</span>
            </header>

            <ol class="pham-phases__list" role="list">
              {%- if phase_blocks.size > 0 -%}
                {%- for block in phase_blocks -%}
                  {%- liquid
                    assign status_raw = block.settings.status | default: 'pending'
                    assign status_key = status_raw | downcase | replace: ' ', '-'
                  -%}
                  <li class="pham-phases__row pham-phases__row--{{ status_key }}" {{ block.shopify_attributes }}>
                    <span class="pham-phases__row-index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                    <span class="pham-phases__row-label">{{ block.settings.label }}</span>
                    <span class="pham-phases__row-meta">{{ block.settings.timeline }}</span>
                    <span class="pham-phases__row-status" data-status="{{ status_key }}">
                      <span class="pham-phases__row-dot" aria-hidden="true"></span>
                      <span>{{ block.settings.status }}</span>
                    </span>
                  </li>
                {%- endfor -%}
              {%- else -%}
                {%- comment -%} Default placeholder phases when no blocks have been configured {%- endcomment -%}
                <li class="pham-phases__row pham-phases__row--complete">
                  <span class="pham-phases__row-index">01</span>
                  <span class="pham-phases__row-label">PATTERN · CUT</span>
                  <span class="pham-phases__row-meta">Q1 · 2026</span>
                  <span class="pham-phases__row-status" data-status="complete">
                    <span class="pham-phases__row-dot" aria-hidden="true"></span>
                    <span>COMPLETE</span>
                  </span>
                </li>
                <li class="pham-phases__row pham-phases__row--in-progress">
                  <span class="pham-phases__row-index">02</span>
                  <span class="pham-phases__row-label">CONSTRUCTION</span>
                  <span class="pham-phases__row-meta">Q2 · 2026</span>
                  <span class="pham-phases__row-status" data-status="in-progress">
                    <span class="pham-phases__row-dot" aria-hidden="true"></span>
                    <span>IN PROGRESS</span>
                  </span>
                </li>
                <li class="pham-phases__row pham-phases__row--pending">
                  <span class="pham-phases__row-index">03</span>
                  <span class="pham-phases__row-label">FINISHING · QC</span>
                  <span class="pham-phases__row-meta">Q3 · 2026</span>
                  <span class="pham-phases__row-status" data-status="pending">
                    <span class="pham-phases__row-dot" aria-hidden="true"></span>
                    <span>PENDING</span>
                  </span>
                </li>
                <li class="pham-phases__row pham-phases__row--pending">
                  <span class="pham-phases__row-index">04</span>
                  <span class="pham-phases__row-label">SHIPPING</span>
                  <span class="pham-phases__row-meta">SEP · 2026</span>
                  <span class="pham-phases__row-status" data-status="pending">
                    <span class="pham-phases__row-dot" aria-hidden="true"></span>
                    <span>PENDING</span>
                  </span>
                </li>
              {%- endif -%}
            </ol>

            {%- if section.settings.shipping_terms != blank -%}
              <p class="pham-phases__terms">{{ section.settings.shipping_terms }}</p>
            {%- endif -%}
          </section>
        {%- endif -%}

        <div class="pham-product-main__accordions">
          {%- assign details_id = section.id | append: '-details' -%}
          {% render 'pham-accordion', heading: details_heading, content: product.description, id: details_id, open: true %}

          {%- if shipping_content != blank -%}
            {%- assign ship_id = section.id | append: '-ship' -%}
            {% render 'pham-accordion', heading: shipping_heading, content: shipping_content, id: ship_id %}
          {%- endif -%}

          {%- if care_content != blank -%}
            {%- assign care_id = section.id | append: '-care' -%}
            {% render 'pham-accordion', heading: care_heading, content: care_content, id: care_id %}
          {%- endif -%}
        </div>
      </div>
    </aside>
  </div>

  {%- comment -%} ============= ZOOM MODAL ============= {%- endcomment -%}
  <div class="pham-product-main__zoom"
       data-pham-zoom-modal
       role="dialog"
       aria-modal="true"
       aria-hidden="true"
       aria-label="Image zoom"
       tabindex="-1">
    <button type="button"
            class="pham-product-main__zoom-backdrop"
            data-pham-zoom-close
            aria-label="Close zoom"></button>
    <button type="button"
            class="pham-product-main__zoom-close"
            data-pham-zoom-close
            aria-label="Close zoom">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <line x1="4" y1="4" x2="20" y2="20" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        <line x1="20" y1="4" x2="4" y2="20" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
    </button>
    <img class="pham-product-main__zoom-img"
         data-pham-zoom-img
         alt=""
         width="1600"
         height="2000"
         loading="lazy">
  </div>

  <script type="application/json" data-pham-product-variants>
    {{ product.variants | json }}
  </script>
</section>
{%- endif -%}

<style>
  .pham-pre-order__gateway {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    max-width: 880px;
    padding-block: clamp(48px, 7vw, 96px) clamp(24px, 4vw, 48px);
  }
  .pham-pre-order__title {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-tech);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.05;
    color: var(--color-bone);
    margin: 0;
  }
  .pham-pre-order__intro {
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: 1.7;
    color: var(--color-bone-80);
    max-width: 60ch;
    margin: 0;
  }
  .pham-pre-order--empty {
    min-height: 60vh;
    display: flex;
    align-items: center;
    background: var(--color-void);
    color: var(--color-bone);
  }
  .pham-pre-order__empty {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding-block: clamp(64px, 10vw, 120px);
  }
  .pham-pre-order__empty-title {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: var(--tracking-tech);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    margin: 0;
  }
  .pham-pre-order__empty-text {
    font-family: var(--font-body);
    color: var(--color-bone-80);
    max-width: 50ch;
    margin: 0;
  }
</style>

<style>
  .pham-product-main {
    background-color: var(--color-void);
    color: var(--color-bone);
    padding-block-end: var(--space-2xl);
  }
  .pham-product-main__grid {
    display: grid;
    grid-template-columns: 55fr 45fr;
    gap: var(--gutter);
    align-items: flex-start;
  }
  .pham-product-main__media {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pham-product-main__gallery {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pham-product-main__media-item {
    position: relative;
    background-color: var(--color-obsidian);
    overflow: hidden;
  }
  .pham-product-main__media-trigger {
    display: block;
    width: 100%;
    background: transparent;
    border: 0;
    padding: 0;
    cursor: zoom-in;
    color: inherit;
  }
  .pham-product-main__media-img,
  .pham-product-main__media-video-frame,
  .pham-product-main__media-model-viewer {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  .pham-product-main__media-img { aspect-ratio: 3 / 4; }

  .pham-product-main__panel {
    position: sticky;
    top: calc(80px + var(--space-md));
    align-self: start;
    padding-block: var(--space-md);
  }
  .pham-product-main__panel-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 480px;
  }
  .pham-product-main__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .pham-product-main__vendor { color: var(--color-accent); margin: 0; }
  .pham-product-main__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    color: var(--color-bone);
    margin: 0;
  }
  .pham-product-main__price {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    letter-spacing: var(--tracking-luxury);
    color: var(--color-bone);
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
  }
  .pham-product-main__price-compare      { color: var(--color-smoke); }
  .pham-product-main__price-current--sale { color: var(--color-accent); }
  .pham-product-main__sku {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-luxury);
    text-transform: uppercase;
    color: var(--color-smoke);
    margin: 0;
  }

  .pham-product-main__scarcity {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-luxury);
    text-transform: uppercase;
    color: var(--color-accent);
    padding: 8px 12px;
    border: 1px solid var(--color-accent);
    align-self: flex-start;
    margin: 0;
  }
  .pham-product-main__scarcity[hidden] { display: none; }

  /* Variant pickers */
  .pham-product-main__options {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .pham-variant-group {
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .pham-variant-group__legend {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    width: 100%;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-luxury);
    text-transform: uppercase;
    color: var(--color-smoke);
  }
  .pham-variant-group__value { color: var(--color-bone); }
  .pham-variant-group__values {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .pham-radio-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 40px;
    padding: 0 14px;
    border: 1px solid var(--color-ash);
    background-color: transparent;
    color: var(--color-bone);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-luxury),
                color var(--duration-fast) var(--ease-luxury),
                background-color var(--duration-fast) var(--ease-luxury);
  }
  .pham-radio-label:hover { border-color: var(--color-bone); }
  .pham-radio:checked + .pham-radio-label {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .pham-radio:focus-visible + .pham-radio-label {
    outline: 1px solid var(--color-accent);
    outline-offset: 2px;
  }
  .pham-radio[disabled] + .pham-radio-label {
    color: var(--color-smoke);
    border-color: var(--color-ash);
    background-image: linear-gradient(to top right, transparent calc(50% - 0.5px), var(--color-smoke) 50%, transparent calc(50% + 0.5px));
    cursor: not-allowed;
  }

  /* Quantity */
  .pham-product-main__qty {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }
  .pham-product-main__qty-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-luxury);
    text-transform: uppercase;
    color: var(--color-smoke);
  }
  .pham-product-main__qty-input {
    width: 64px;
    height: 40px;
    background: transparent;
    color: var(--color-bone);
    border: 1px solid var(--color-ash);
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    -moz-appearance: textfield;
    appearance: textfield;
  }
  .pham-product-main__qty-input::-webkit-outer-spin-button,
  .pham-product-main__qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    appearance: none;
    margin: 0;
  }

  /* CTA — pre-order, white clip-path sweep with rune */
  .pham-product-main__cta {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    background: transparent;
    color: var(--color-white);
    border: 1px solid var(--color-white);
    overflow: hidden;
    isolation: isolate;
    cursor: pointer;
    font: inherit;
    transition: color var(--duration-base) var(--ease-tech), box-shadow var(--duration-base) var(--ease-tech);
  }
  .pham-product-main__cta--preorder {
    box-shadow:
      0 0 0 1px var(--color-white) inset,
      0 0 0 0 transparent;
  }
  .pham-product-main__cta--preorder:hover:not([disabled]):not([aria-disabled="true"]) {
    box-shadow:
      0 0 0 1px var(--color-white) inset,
      0 0 32px rgba(255, 255, 255, 0.16);
  }
  .pham-product-main__cta[disabled],
  .pham-product-main__cta[aria-disabled="true"] {
    color: var(--color-placeholder);
    border-color: var(--color-ash);
    cursor: not-allowed;
    box-shadow: none;
  }
  .pham-product-main__cta-fill {
    position: absolute;
    inset: 0;
    background-color: var(--color-white);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 500ms var(--ease-tech);
    z-index: 1;
  }
  .pham-product-main__cta-text {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: 18px var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: var(--tracking-tech);
    text-transform: uppercase;
  }
  .pham-product-main__cta-rune,
  .pham-product-main__cta-arrow {
    position: relative;
    z-index: 2;
    padding: 18px 18px;
    color: var(--color-white);
    transition: color var(--duration-base) var(--ease-tech), transform var(--duration-base) var(--ease-tech);
  }
  .pham-product-main__cta-rune { font-size: 12px; }
  .pham-product-main__cta:hover:not([disabled]):not([aria-disabled="true"]) { color: var(--color-void); }
  .pham-product-main__cta:hover:not([disabled]):not([aria-disabled="true"]) .pham-product-main__cta-fill { clip-path: inset(0 0 0 0); }
  .pham-product-main__cta:hover:not([disabled]):not([aria-disabled="true"]) .pham-product-main__cta-rune,
  .pham-product-main__cta:hover:not([disabled]):not([aria-disabled="true"]) .pham-product-main__cta-arrow { color: var(--color-void); }
  .pham-product-main__cta:hover:not([disabled]):not([aria-disabled="true"]) .pham-product-main__cta-rune { transform: rotate(180deg); }
  .pham-product-main__cta:hover:not([disabled]):not([aria-disabled="true"]) .pham-product-main__cta-arrow { transform: translateX(4px); }

  .pham-product-main__preorder-note {
    margin: 12px 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-base);
    line-height: 1.6;
    color: var(--color-placeholder);
    max-width: 52ch;
  }

  /* ===== PRODUCTION PHASES PANEL ===== */
  .pham-phases {
    margin-top: var(--space-md);
    border: 1px solid var(--color-ash);
    background-color: rgba(20, 20, 26, 0.55);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .pham-phases__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-bottom: 1px solid var(--color-ash);
    background-color: rgba(10, 10, 12, 0.6);
  }
  .pham-phases__eyebrow {
    color: var(--color-white);
    font-weight: 700;
  }
  .pham-phases__system {
    color: var(--color-placeholder);
    font-size: 10px;
  }
  .pham-phases__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pham-phases__row {
    display: grid;
    grid-template-columns: 48px 1fr auto auto;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--color-ash);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-bone);
    position: relative;
    isolation: isolate;
  }
  .pham-phases__row:last-child { border-bottom: 0; }
  .pham-phases__row::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 2px;
    background-color: transparent;
    transition: background-color var(--duration-base) var(--ease-tech);
  }
  .pham-phases__row--complete::before    { background-color: var(--color-white); }
  .pham-phases__row--in-progress::before { background-color: var(--color-warning); }
  .pham-phases__row--pending::before     { background-color: var(--color-ash); }
  .pham-phases__row--scheduled::before   { background-color: var(--color-cyan); }
  .pham-phases__row-index {
    color: var(--color-placeholder);
    font-weight: 700;
  }
  .pham-phases__row-label {
    color: var(--color-white);
    font-weight: 700;
  }
  .pham-phases__row-meta {
    color: var(--color-placeholder);
  }
  .pham-phases__row-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 8px;
    border: 1px solid var(--color-ash);
    font-size: 10px;
  }
  .pham-phases__row-dot {
    width: 6px;
    height: 6px;
    display: inline-block;
    background-color: var(--color-ash);
    border-radius: 0 !important;
  }
  .pham-phases__row-status[data-status="complete"]    { color: var(--color-white); border-color: var(--color-white); }
  .pham-phases__row-status[data-status="complete"] .pham-phases__row-dot { background-color: var(--color-white); }
  .pham-phases__row-status[data-status="in-progress"] { color: var(--color-warning); border-color: var(--color-warning); }
  .pham-phases__row-status[data-status="in-progress"] .pham-phases__row-dot {
    background-color: var(--color-warning);
    animation: pham-phase-pulse 1.8s var(--ease-tech) infinite;
  }
  .pham-phases__row-status[data-status="scheduled"]   { color: var(--color-cyan); border-color: var(--color-cyan); }
  .pham-phases__row-status[data-status="scheduled"] .pham-phases__row-dot   { background-color: var(--color-cyan); }
  .pham-phases__row-status[data-status="pending"]     { color: var(--color-placeholder); }

  @keyframes pham-phase-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.45; transform: scale(1.4); }
  }

  .pham-phases__terms {
    padding: 14px 18px;
    margin: 0;
    border-top: 1px solid var(--color-ash);
    background-color: rgba(10, 10, 12, 0.4);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.6;
    letter-spacing: var(--tracking-base);
    color: var(--color-placeholder);
  }

  @media (max-width: 600px) {
    .pham-phases__row {
      grid-template-columns: 32px 1fr;
      grid-template-rows: auto auto;
      row-gap: 6px;
    }
    .pham-phases__row-meta   { grid-column: 2; }
    .pham-phases__row-status { grid-column: 2; justify-self: start; }
  }

  .pham-product-main__accordions {
    margin-top: var(--space-sm);
  }

  /* Zoom modal */
  .pham-product-main__zoom {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--duration-base) var(--ease-luxury),
                visibility 0s linear var(--duration-base);
  }
  .pham-product-main__zoom.is-open {
    pointer-events: auto;
    opacity: 1;
    visibility: visible;
    transition: opacity var(--duration-base) var(--ease-luxury),
                visibility 0s linear 0s;
  }
  .pham-product-main__zoom-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(5, 5, 5, 0.96);
    border: 0;
    padding: 0;
    cursor: zoom-out;
  }
  .pham-product-main__zoom-close {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid var(--color-ash);
    color: var(--color-bone);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: color var(--duration-fast) var(--ease-luxury), border-color var(--duration-fast) var(--ease-luxury);
  }
  .pham-product-main__zoom-close:hover { color: var(--color-accent); border-color: var(--color-accent); }
  .pham-product-main__zoom-img {
    position: relative;
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    z-index: 1;
    cursor: zoom-out;
  }

  @media (max-width: 900px) {
    .pham-product-main__grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
    .pham-product-main__panel {
      position: static;
      top: auto;
    }
  }
</style>

<script>
  (function() {
    'use strict';
    var sectionId = {{ section.id | json }};
    var root = document.querySelector('[data-pham-product-main][data-section-id="' + sectionId + '"]');
    if (!root) return;

    var dataScript = root.querySelector('[data-pham-product-variants]');
    var variants = [];
    if (dataScript) {
      try { variants = JSON.parse(dataScript.textContent) || []; } catch (e) { variants = []; }
    }

    var form           = root.querySelector('[data-pham-product-form]');
    var variantIdInput = form ? form.querySelector('[data-pham-variant-id]') : null;
    var priceEl        = root.querySelector('[data-pham-product-price]');
    var scarcityEl     = root.querySelector('[data-pham-product-scarcity]');
    var submitBtn      = form ? form.querySelector('[data-pham-product-submit]') : null;
    var ctaLabel       = submitBtn ? submitBtn.querySelector('[data-pham-product-cta-label]') : null;
    var ctaPrice       = submitBtn ? submitBtn.querySelector('[data-pham-product-cta-price]') : null;
    var skuEl          = root.querySelector('[data-pham-product-sku]');
    var legendValueEls = root.querySelectorAll('[data-pham-option-value]');
    var currency       = (window.Shopify && window.Shopify.currency && window.Shopify.currency.active) || 'USD';

    function formatMoney(cents) {
      if (typeof cents !== 'number' || !isFinite(cents)) return '';
      try {
        return new Intl.NumberFormat(undefined, { style: 'currency', currency: currency }).format(cents / 100);
      } catch (e) {
        return '$' + (cents / 100).toFixed(2);
      }
    }

    function getSelectedOptions() {
      var opts = [];
      var radios = root.querySelectorAll('input[type="radio"][data-pham-option]');
      for (var i = 0; i < radios.length; i++) {
        var r = radios[i];
        if (r.checked) {
          var idx = parseInt(r.dataset.optionIndex, 10);
          if (!isNaN(idx)) opts[idx] = r.value;
        }
      }
      return opts;
    }

    function findVariant(opts) {
      for (var i = 0; i < variants.length; i++) {
        var v = variants[i];
        if (!v || !v.options) continue;
        var match = true;
        for (var j = 0; j < v.options.length; j++) {
          if ((v.options[j] || '') !== (opts[j] || '')) { match = false; break; }
        }
        if (match) return v;
      }
      return null;
    }

    function updateLegends(opts) {
      for (var i = 0; i < legendValueEls.length; i++) {
        var el = legendValueEls[i];
        var idx = parseInt(el.getAttribute('data-pham-option-value'), 10);
        if (!isNaN(idx) && opts[idx] != null) el.textContent = opts[idx];
      }
    }

    function updateUrl(variant) {
      if (!variant || !window.history || !window.history.replaceState) return;
      try {
        var url = new URL(window.location.href);
        url.searchParams.set('variant', variant.id);
        window.history.replaceState({}, '', url.toString());
      } catch (e) { /* ignore */ }
    }

    function updateScarcity(variant) {
      if (!scarcityEl) return;
      if (variant
          && variant.inventory_management != null
          && variant.inventory_management !== ''
          && typeof variant.inventory_quantity === 'number'
          && variant.inventory_quantity > 0
          && variant.inventory_quantity <= 5) {
        scarcityEl.textContent = 'EDITION OF ' + variant.inventory_quantity + ' AVAILABLE';
        scarcityEl.removeAttribute('hidden');
      } else {
        scarcityEl.textContent = '';
        scarcityEl.setAttribute('hidden', '');
      }
    }

    function updatePrice(variant) {
      if (!priceEl || !variant) return;
      var formatted = formatMoney(variant.price);
      var currentEl = priceEl.querySelector('.pham-product-main__price-current');
      var compareEl = priceEl.querySelector('.pham-product-main__price-compare');
      if (currentEl) currentEl.textContent = formatted;

      if (variant.compare_at_price && variant.compare_at_price > variant.price) {
        if (currentEl) currentEl.classList.add('pham-product-main__price-current--sale');
        if (!compareEl) {
          compareEl = document.createElement('s');
          compareEl.className = 'pham-product-main__price-compare';
          priceEl.insertBefore(compareEl, priceEl.firstChild);
        }
        compareEl.textContent = formatMoney(variant.compare_at_price);
      } else {
        if (currentEl) currentEl.classList.remove('pham-product-main__price-current--sale');
        if (compareEl) compareEl.parentNode.removeChild(compareEl);
      }
    }

    function updateSubmit(variant) {
      if (!submitBtn) return;
      if (!variant || !variant.available) {
        submitBtn.setAttribute('disabled', '');
        submitBtn.setAttribute('aria-disabled', 'true');
        if (ctaLabel) ctaLabel.textContent = variant ? 'PRE-ORDER CLOSED' : 'UNAVAILABLE';
      } else {
        submitBtn.removeAttribute('disabled');
        submitBtn.removeAttribute('aria-disabled');
        if (ctaLabel) {
          var preorderLabel = submitBtn.getAttribute('data-pham-preorder-label') || 'SECURE PRE-ORDER · EDITION 01';
          ctaLabel.textContent = preorderLabel;
        }
      }
    }

    function updateSku(variant) {
      if (!skuEl || !variant) return;
      if (variant.sku) skuEl.textContent = 'SKU · ' + variant.sku;
      else skuEl.textContent = '';
    }

    function update() {
      var opts = getSelectedOptions();
      updateLegends(opts);
      var variant = findVariant(opts);
      if (variantIdInput && variant) variantIdInput.value = String(variant.id);
      updatePrice(variant);
      updateScarcity(variant);
      updateSubmit(variant);
      updateSku(variant);
      if (ctaPrice && variant) ctaPrice.textContent = formatMoney(variant.price);
      if (variant) updateUrl(variant);
    }

    var radios = root.querySelectorAll('input[type="radio"][data-pham-option]');
    for (var i = 0; i < radios.length; i++) {
      radios[i].addEventListener('change', update);
    }

    /* ====== Zoom modal ====== */
    var modal     = root.querySelector('[data-pham-zoom-modal]');
    var modalImg  = modal ? modal.querySelector('[data-pham-zoom-img]') : null;
    var triggers  = root.querySelectorAll('[data-pham-zoom-trigger]');
    var closers   = modal ? modal.querySelectorAll('[data-pham-zoom-close]') : [];
    var lastFocused = null;

    function openZoom(src, alt, srcset) {
      if (!modal || !modalImg) return;
      lastFocused = document.activeElement;
      modalImg.src = src;
      if (srcset) modalImg.setAttribute('srcset', srcset);
      modalImg.alt = alt || '';
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('pham-no-scroll');
      document.body.style.overflow = 'hidden';
      var closeEl = modal.querySelector('.pham-product-main__zoom-close');
      if (closeEl) { try { closeEl.focus(); } catch (e) {} }
    }

    function closeZoom() {
      if (!modal) return;
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('pham-no-scroll');
      document.body.style.overflow = '';
      if (modalImg) {
        modalImg.removeAttribute('srcset');
        modalImg.src = '';
      }
      if (lastFocused && typeof lastFocused.focus === 'function') {
        try { lastFocused.focus(); } catch (e) {}
      }
      lastFocused = null;
    }

    for (var t = 0; t < triggers.length; t++) {
      (function(trig) {
        trig.addEventListener('click', function(e) {
          e.preventDefault();
          openZoom(trig.dataset.phamZoomSrc, trig.dataset.phamZoomAlt, trig.dataset.phamZoomSrcset);
        });
      })(triggers[t]);
    }
    for (var c = 0; c < closers.length; c++) {
      closers[c].addEventListener('click', function(e) {
        e.preventDefault();
        closeZoom();
      });
    }
    document.addEventListener('keydown', function(e) {
      if ((e.key === 'Escape' || e.key === 'Esc') && modal && modal.classList.contains('is-open')) {
        closeZoom();
      }
    });

    update();
  })();
</script>

