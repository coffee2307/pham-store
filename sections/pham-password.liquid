{%- liquid
  assign status_text = section.settings.status_text | default: 'SITE IN DEVELOPMENT'
  assign sub_text = section.settings.sub_text | default: 'PHAM is currently preparing its next release. Public access will open soon.'
-%}

<section class="pham-gate" data-pham-gate data-section-id="{{ section.id }}" aria-labelledby="pham-gate-status-{{ section.id }}">
  <div class="pham-gate__ambient" aria-hidden="true"></div>

  <div class="pham-gate__content">
    <div class="pham-gate__logo-wrap">
      <img
        class="pham-gate__logo"
        src="{{ 'Logo-PHAM.svg' | asset_url }}"
        alt="PHAM"
        width="1683"
        height="524"
        loading="eager"
        fetchpriority="high"
      >
    </div>

    <div class="pham-gate__status" id="pham-gate-status-{{ section.id }}">
      <span class="pham-gate__status-dot" aria-hidden="true"></span>
      <span>{{ status_text }}</span>
    </div>

    {%- if sub_text != blank -%}
      <p class="pham-gate__sub">{{ sub_text }}</p>
    {%- endif -%}

    <div class="pham-gate__access" data-pham-gate-operator>
      <button
        type="button"
        class="pham-gate__access-toggle"
        data-pham-gate-toggle
        aria-expanded="false"
        aria-controls="pham-gate-panel-{{ section.id }}"
      >
        PRIVATE ACCESS
      </button>

      <div
        class="pham-gate__panel"
        id="pham-gate-panel-{{ section.id }}"
        data-pham-gate-panel
        hidden
      >
        {%- form 'storefront_password', class: 'pham-gate__form' -%}
          <label for="pham-gate-password-{{ section.id }}" class="pham-visually-hidden">Store password</label>

          <div class="pham-gate__field">
            <input
              id="pham-gate-password-{{ section.id }}"
              type="password"
              name="password"
              class="pham-gate__input"
              placeholder="PASSWORD"
              autocomplete="current-password"
              autocapitalize="off"
              spellcheck="false"
              required
              {% if form.errors %}aria-invalid="true" aria-describedby="pham-gate-error-{{ section.id }}"{% endif %}
            >
            <button type="submit" class="pham-gate__submit">ENTER</button>
          </div>

          {%- if form.errors -%}
            <p id="pham-gate-error-{{ section.id }}" class="pham-gate__error" role="alert">
              {{ form.errors | default_errors }}
            </p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>

  <p class="pham-gate__meta">PHAM ATELIER · {{ 'now' | date: '%Y' }}</p>
</section>

<style>
  #password-form,
  body.template-password > footer,
  body.pham-password-layout > footer,
  .password-footer {
    display: none !important;
  }

  html,
  body.template-password,
  body.template-password .password-main-content {
    background: #080808 !important;
    background-image: none !important;
    overflow: hidden !important;
    overscroll-behavior: none;
  }

  body.template-password {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  body.template-password .password-main-content,
  .pham-gate-section {
    width: 100%;
    height: 100%;
    min-height: 100%;
  }

  .pham-visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  .pham-gate {
    --pham-gate-pointer-x: 50%;
    --pham-gate-pointer-y: 50%;
    --pham-gate-pointer-opacity: 0;
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    min-height: 100dvh;
    width: 100%;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    place-items: center;
    padding: clamp(28px, 5vw, 64px);
    background:
      radial-gradient(circle at 50% 42%, rgba(255, 255, 255, 0.045), transparent 34%),
      #080808;
    color: #f4f4f2;
  }

  .pham-gate::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
      circle 220px at var(--pham-gate-pointer-x) var(--pham-gate-pointer-y),
      rgba(255, 255, 255, 0.11) 0%,
      rgba(255, 255, 255, 0.055) 22%,
      rgba(255, 255, 255, 0.018) 48%,
      transparent 72%
    );
    opacity: var(--pham-gate-pointer-opacity);
    transition: opacity 260ms ease;
    mix-blend-mode: screen;
  }

  .pham-gate__ambient {
    position: absolute;
    inset: -20%;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.045), transparent 28%),
      radial-gradient(circle at 72% 68%, rgba(255, 255, 255, 0.025), transparent 26%);
    opacity: 0.7;
    animation: pham-gate-ambient 18s ease-in-out infinite alternate;
    will-change: transform, opacity;
  }

  .pham-gate__content {
    position: relative;
    z-index: 2;
    width: min(100%, 680px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .pham-gate__logo-wrap {
    width: clamp(220px, 36vw, 420px);
    max-width: 78vw;
    opacity: 0;
    transform: translateY(10px) scale(0.985);
    animation: pham-gate-logo-in 1100ms cubic-bezier(0.2, 0, 0, 1) 80ms forwards;
  }

  .pham-gate__logo {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 0 26px rgba(255, 255, 255, 0.035));
  }

  .pham-gate__status {
    margin-top: clamp(34px, 5vw, 56px);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 10px;
    line-height: 1.4;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: rgba(244, 244, 242, 0.82);
    opacity: 0;
    transform: translateY(8px);
    animation: pham-gate-copy-in 700ms cubic-bezier(0.2, 0, 0, 1) 520ms forwards;
  }

  .pham-gate__status-dot {
    width: 5px;
    height: 5px;
    flex: 0 0 auto;
    background: #f4f4f2;
    box-shadow: 0 0 10px rgba(244, 244, 242, 0.42);
    animation: pham-gate-pulse 2.4s ease-in-out infinite;
  }

  .pham-gate__sub {
    max-width: 44ch;
    margin: 15px 0 0;
    font-family: var(--font-body, system-ui, sans-serif);
    font-size: clamp(13px, 1.25vw, 15px);
    font-weight: 400;
    line-height: 1.7;
    letter-spacing: 0.01em;
    color: rgba(244, 244, 242, 0.5);
    opacity: 0;
    transform: translateY(8px);
    animation: pham-gate-copy-in 700ms cubic-bezier(0.2, 0, 0, 1) 660ms forwards;
  }

  .pham-gate__access {
    width: min(100%, 340px);
    margin-top: clamp(34px, 5vw, 52px);
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0;
    animation: pham-gate-fade-in 700ms ease 850ms forwards;
  }

  .pham-gate__access-toggle {
    appearance: none;
    border: 0;
    padding: 7px 2px;
    background: transparent;
    color: rgba(244, 244, 242, 0.34);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 9px;
    line-height: 1;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 220ms ease;
  }

  .pham-gate__access-toggle:hover,
  .pham-gate__access-toggle:focus-visible,
  .pham-gate__access-toggle[aria-expanded="true"] {
    color: rgba(244, 244, 242, 0.82);
  }

  .pham-gate__panel {
    width: 100%;
    margin-top: 14px;
    animation: pham-gate-panel-in 280ms cubic-bezier(0.2, 0, 0, 1) both;
  }

  .pham-gate__panel[hidden] {
    display: none;
  }

  .pham-gate__field {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: stretch;
    border-bottom: 1px solid rgba(244, 244, 242, 0.38);
  }

  .pham-gate__input {
    min-width: 0;
    border: 0 !important;
    outline: 0 !important;
    box-shadow: none !important;
    border-radius: 0 !important;
    background: transparent !important;
    padding: 12px 8px 12px 0 !important;
    color: #f4f4f2 !important;
    font-family: var(--font-mono, ui-monospace, monospace) !important;
    font-size: 11px !important;
    line-height: 1.4 !important;
    letter-spacing: 0.18em !important;
  }

  .pham-gate__input::placeholder {
    color: rgba(244, 244, 242, 0.28);
  }

  .pham-gate__submit {
    border: 0;
    background: transparent;
    padding: 12px 0 12px 18px;
    color: rgba(244, 244, 242, 0.72);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 9px;
    line-height: 1;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 220ms ease, transform 220ms ease;
  }

  .pham-gate__submit:hover,
  .pham-gate__submit:focus-visible {
    color: #ffffff;
    transform: translateX(2px);
  }

  .pham-gate__error {
    margin: 12px 0 0;
    color: rgba(255, 255, 255, 0.62);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pham-gate__meta {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: clamp(22px, 3vw, 34px);
    transform: translateX(-50%);
    margin: 0;
    white-space: nowrap;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 8px;
    line-height: 1;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(244, 244, 242, 0.2);
  }

  @keyframes pham-gate-logo-in {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes pham-gate-copy-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes pham-gate-fade-in {
    to { opacity: 1; }
  }

  @keyframes pham-gate-panel-in {
    from {
      opacity: 0;
      transform: translateY(-5px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes pham-gate-pulse {
    0%, 100% {
      opacity: 0.38;
      transform: scale(0.9);
    }
    50% {
      opacity: 1;
      transform: scale(1.15);
    }
  }

  @keyframes pham-gate-ambient {
    0% {
      transform: translate3d(-1.5%, -1%, 0) scale(1);
      opacity: 0.52;
    }
    100% {
      transform: translate3d(1.5%, 1%, 0) scale(1.04);
      opacity: 0.82;
    }
  }

  @media (max-width: 640px) {
    .pham-gate {
      padding: 26px 20px 72px;
    }

    .pham-gate__logo-wrap {
      width: min(72vw, 300px);
    }

    .pham-gate__status {
      margin-top: 34px;
      font-size: 9px;
      letter-spacing: 0.22em;
    }

    .pham-gate__sub {
      max-width: 31ch;
      font-size: 13px;
    }

    .pham-gate__access {
      margin-top: 32px;
      width: min(100%, 300px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pham-gate::after,
    .pham-gate__ambient,
    .pham-gate__logo-wrap,
    .pham-gate__status,
    .pham-gate__sub,
    .pham-gate__access,
    .pham-gate__status-dot,
    .pham-gate__panel {
      animation: none !important;
    }

    .pham-gate__logo-wrap,
    .pham-gate__status,
    .pham-gate__sub,
    .pham-gate__access {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script type="text/javascript">
  (function () {
    'use strict';

    var root = document.querySelector('[data-pham-gate]');
    if (!root || root.__phamGateBound) return;
    root.__phamGateBound = true;

    var toggle = root.querySelector('[data-pham-gate-toggle]');
    var panel = root.querySelector('[data-pham-gate-panel]');
    var input = panel ? panel.querySelector('input[type="password"]') : null;
    var finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    var glowFrame = null;
    var glowX = 0;
    var glowY = 0;

    function paintGlow() {
      root.style.setProperty('--pham-gate-pointer-x', glowX + 'px');
      root.style.setProperty('--pham-gate-pointer-y', glowY + 'px');
      glowFrame = null;
    }

    function handlePointerMove(event) {
      if (!finePointer.matches) return;
      var rect = root.getBoundingClientRect();
      glowX = event.clientX - rect.left;
      glowY = event.clientY - rect.top;
      root.style.setProperty('--pham-gate-pointer-opacity', '1');

      if (!glowFrame) {
        glowFrame = window.requestAnimationFrame(paintGlow);
      }
    }

    function handlePointerLeave() {
      root.style.setProperty('--pham-gate-pointer-opacity', '0');
    }

    root.addEventListener('pointermove', handlePointerMove, { passive: true });
    root.addEventListener('pointerleave', handlePointerLeave, { passive: true });

    if (toggle && panel) {
      toggle.addEventListener('click', function () {
        var expanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', expanded ? 'false' : 'true');
        panel.hidden = expanded;

        if (!expanded && input) {
          window.setTimeout(function () {
            input.focus();
          }, 60);
        }
      });
    }

    var error = root.querySelector('.pham-gate__error');
    if (error && toggle && panel) {
      toggle.setAttribute('aria-expanded', 'true');
      panel.hidden = false;
      if (input) input.focus();
    }
  })();
</script>

{% schema %}
{
  "name": "PHAM Password Gate",
  "tag": "section",
  "class": "pham-gate-section",
  "settings": [
    {
      "type": "text",
      "id": "status_text",
      "label": "Status",
      "default": "SITE IN DEVELOPMENT"
    },
    {
      "type": "textarea",
      "id": "sub_text",
      "label": "Supporting text",
      "default": "PHAM is currently preparing its next release. Public access will open soon."
    }
  ],
  "presets": [
    {
      "name": "PHAM Password Gate",
      "category": "PHAM"
    }
  ],
  "enabled_on": {
    "templates": ["password"]
  }
}
{% endschema %}
