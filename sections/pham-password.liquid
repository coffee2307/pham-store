<!-- # DO NOT EDIT — managed by PHAM theme architecture -->
{%- liquid
  assign brand_mark    = section.settings.brand_mark | default: 'ATELIER PHAM' | strip | upcase
  assign brand_mark    = brand_mark | replace: 'ATELIERPHAM', 'ATELIER PHAM'
  assign status_text   = section.settings.status_text | default: 'EDITION 01 // IN PRODUCTION'
  assign sub_text      = section.settings.sub_text
  assign release_date  = section.settings.release_date
  assign show_release  = section.settings.show_release
-%}

<section class="pham-gate" data-pham-gate data-section-id="{{ section.id }}" role="region" aria-label="Atelier gate">
  {%- comment -%} Atmospheric grid + radial gradient — pure CSS, no images required {%- endcomment -%}
  <div class="pham-gate__atmos" aria-hidden="true">
    <div class="pham-gate__grid"></div>
    <div class="pham-gate__glow"></div>
    <div class="pham-gate__scan" aria-hidden="true"></div>
  </div>

  {%- comment -%} CAD-style corner brackets {%- endcomment -%}
  <span class="pham-gate__bracket pham-gate__bracket--tl" aria-hidden="true"></span>
  <span class="pham-gate__bracket pham-gate__bracket--tr" aria-hidden="true"></span>
  <span class="pham-gate__bracket pham-gate__bracket--bl" aria-hidden="true"></span>
  <span class="pham-gate__bracket pham-gate__bracket--br" aria-hidden="true"></span>

  {%- comment -%} HUD readouts top + bottom {%- endcomment -%}
  <header class="pham-gate__hud pham-gate__hud--top">
    <span>SYS // ATELIER · 01</span>
    <span>SEALED · {{ 'now' | date: '%Y-%m-%d' | upcase }}</span>
  </header>

  <div class="pham-gate__core">
    <p class="pham-gate__pre">{{ section.settings.pre_text | default: 'PHAM // EXHIBITION GATEWAY' }}</p>

    <h1 class="pham-gate__mark" aria-label="{{ brand_mark | escape }}">
      {%- assign mark_words = brand_mark | split: ' ' -%}
      {%- assign pham_gate_char_i = 0 -%}
      {%- for word in mark_words -%}
        {%- if word != blank -%}
          <span class="pham-gate__mark-word">
            {%- assign mark_chars = word | split: '' -%}
            {%- for ch in mark_chars -%}
              <span class="pham-gate__mark-char" style="--pham-gate-i: {{ pham_gate_char_i }}">{{ ch }}</span>
              {%- assign pham_gate_char_i = pham_gate_char_i | plus: 1 -%}
            {%- endfor -%}
          </span>
        {%- endif -%}
      {%- endfor -%}
    </h1>

    <div class="pham-gate__status" data-pham-gate-status>
      <span class="pham-gate__status-dot" aria-hidden="true"></span>
      <span class="pham-gate__status-text">{{ status_text }}</span>
    </div>

    {%- if sub_text != blank -%}
      <p class="pham-gate__sub">{{ sub_text }}</p>
    {%- endif -%}

    {%- if show_release and release_date != blank -%}
      <p class="pham-gate__release">
        <span class="pham-gate__release-label">PUBLIC RELEASE</span>
        <span class="pham-gate__release-value">{{ release_date }}</span>
      </p>
    {%- endif -%}

    {%- comment -%} Operator gate — collapsed by default, slides open on click {%- endcomment -%}
    <div class="pham-gate__operator" data-pham-gate-operator>
      <button type="button"
              class="pham-gate__operator-toggle"
              data-pham-gate-toggle
              aria-expanded="false"
              aria-controls="pham-gate-input-{{ section.id }}">
        <span class="pham-gate__operator-bar" aria-hidden="true"></span>
        <span class="pham-gate__operator-label">ACCESS OPERATOR</span>
        <span class="pham-gate__operator-bar" aria-hidden="true"></span>
      </button>

      <div class="pham-gate__panel"
           id="pham-gate-input-{{ section.id }}"
           hidden
           data-pham-gate-panel>
        {%- form 'storefront_password', class: 'pham-gate__form' -%}
          <label for="pham-gate-pwd-{{ section.id }}" class="pham-visually-hidden">Operator key</label>
          <div class="pham-gate__row">
            <span class="pham-gate__row-prompt" aria-hidden="true">&rsaquo;</span>
            <input id="pham-gate-pwd-{{ section.id }}"
                   type="password"
                   name="password"
                   class="pham-gate__input"
                   placeholder="OPERATOR KEY"
                   autocomplete="current-password"
                   autocapitalize="off"
                   spellcheck="false"
                   required
                   {% if form.errors %}aria-invalid="true" aria-describedby="pham-gate-error-{{ section.id }}"{% endif %}>
            <button type="submit" class="pham-gate__submit" aria-label="Enter atelier">
              <span class="pham-gate__submit-label">ENTER</span>
              <span class="pham-gate__submit-arrow" aria-hidden="true">&rarr;</span>
            </button>
          </div>

          {%- if form.errors -%}
            <p id="pham-gate-error-{{ section.id }}" class="pham-gate__error" role="alert">
              <span aria-hidden="true">!! </span>{{ form.errors | default_errors }}
            </p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>

  <div class="pham-gate__foot">
  <nav class="pham-gate__utility" aria-label="Password page utilities">
    <button type="button"
            class="pham-gate__utility-link pham-gate__utility-link--action"
            data-pham-gate-access-trigger>
      ENTER USING PASSWORD
    </button>
    <span class="pham-gate__utility-sep" aria-hidden="true">/</span>
    <a href="/admin"
       class="pham-gate__utility-link">
      STORE OWNER · LOG IN
    </a>
    <span class="pham-gate__utility-sep" aria-hidden="true">/</span>
    <span class="pham-gate__utility-platform">
      PLATFORM ·
      <a href="https://www.shopify.com"
         class="pham-gate__utility-link pham-gate__utility-link--muted"
         rel="nofollow noopener"
         target="_blank">SHOPIFY</a>
    </span>
  </nav>

  <footer class="pham-gate__hud pham-gate__hud--bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | upcase }}</span>
    <span>ALL RIGHTS RESERVED</span>
  </footer>
  </div>
</section>

<style>
  /* Suppress Horizon's stock password dialog */
  #password-form { display: none !important; }
  body.template-password,
  body.template-password .password-main-content {
    background-color: #0A0A0C !important;
    background-image: none !important;
  }

  /* ===== GATE LAYOUT ===== */
  .pham-gate {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    min-height: 100dvh;
    width: 100%;
    background-color: #0A0A0C;
    background-image: radial-gradient(ellipse at 50% 40%, #14141A 0%, #0A0A0C 70%);
    color: var(--color-bone);
    overflow: hidden;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    padding: clamp(28px, 4vw, 56px);
  }

  /* Atmospheric grid pattern + scan-line + radial glow */
  .pham-gate__atmos {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .pham-gate__grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(to right,  rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at center, #000 0%, transparent 80%);
  }
  .pham-gate__glow {
    position: absolute;
    left: 50%; top: 45%;
    transform: translate(-50%, -50%);
    width: 700px; height: 700px;
    background: radial-gradient(circle, rgba(255,255,255,0.07) 0%, transparent 60%);
    filter: blur(20px);
  }
  .pham-gate__scan {
    position: absolute;
    left: 0; right: 0; top: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.4) 50%, transparent 100%);
    animation: pham-gate-scan 8s linear infinite;
    will-change: transform;
  }
  @keyframes pham-gate-scan {
    0%   { transform: translateY(-20vh); opacity: 0; }
    10%  { opacity: 1; }
    90%  { opacity: 1; }
    100% { transform: translateY(120vh); opacity: 0; }
  }

  /* Corner brackets */
  .pham-gate__bracket {
    position: absolute;
    width: 28px;
    height: 28px;
    z-index: 3;
    pointer-events: none;
  }
  .pham-gate__bracket--tl { top: clamp(16px, 3vw, 32px); left: clamp(16px, 3vw, 32px);   border-top: 1px solid var(--color-white); border-left: 1px solid var(--color-white); }
  .pham-gate__bracket--tr { top: clamp(16px, 3vw, 32px); right: clamp(16px, 3vw, 32px);  border-top: 1px solid var(--color-white); border-right: 1px solid var(--color-white); }
  .pham-gate__bracket--bl { bottom: clamp(16px, 3vw, 32px); left: clamp(16px, 3vw, 32px);  border-bottom: 1px solid var(--color-white); border-left: 1px solid var(--color-white); }
  .pham-gate__bracket--br { bottom: clamp(16px, 3vw, 32px); right: clamp(16px, 3vw, 32px); border-bottom: 1px solid var(--color-white); border-right: 1px solid var(--color-white); }

  /* HUD readouts */
  .pham-gate__hud {
    position: relative;
    z-index: 4;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-placeholder);
    padding-block: 8px;
  }
  .pham-gate__hud--bottom {
    padding-top: 14px;
  }

  .pham-gate__foot {
    position: relative;
    z-index: 4;
    margin-top: auto;
    width: 100%;
  }

  /* Utility strip — replaces Horizon password-footer */
  .pham-gate__utility {
    width: 100%;
    max-width: 920px;
    margin-inline: auto;
    padding-top: clamp(20px, 3vw, 36px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-placeholder);
  }
  .pham-gate__utility-sep {
    color: rgba(255, 255, 255, 0.18);
    user-select: none;
  }
  .pham-gate__utility-platform {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    color: var(--color-placeholder);
  }
  .pham-gate__utility-link {
    background: transparent;
    border: 0;
    padding: 0;
    margin: 0;
    cursor: pointer;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--color-bone-80);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-tech), letter-spacing var(--duration-base) var(--ease-tech);
  }
  .pham-gate__utility-link:hover,
  .pham-gate__utility-link:focus-visible {
    color: var(--color-white);
    letter-spacing: 0.32em;
    outline: none;
  }
  .pham-gate__utility-link--muted {
    color: var(--color-placeholder);
  }
  .pham-gate__utility-link--action {
    color: var(--color-white);
  }

  /* Kill Horizon stock password footer + dialog chrome on PHAM gate */
  #password-form,
  body.template-password > footer,
  body.pham-password-layout > footer,
  .password-footer {
    display: none !important;
  }

  /* Core stack */
  .pham-gate__core {
    position: relative;
    z-index: 4;
    margin: auto;
    width: 100%;
    max-width: 640px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(16px, 2.5vw, 28px);
  }
  .pham-gate__pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-placeholder);
  }

  /* Brand mark — per-char reveal, grouped by word */
  .pham-gate__mark {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.75rem, 7vw, 4.25rem);
    line-height: 1.08;
    color: var(--color-white);
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    column-gap: clamp(0.45em, 2vw, 0.75em);
    row-gap: 0.12em;
    max-width: min(100%, 920px);
  }
  .pham-gate__mark-word {
    display: inline-flex;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .pham-gate__mark-char {
    display: inline-block;
    opacity: 0;
    transform: translateY(40%);
    animation: pham-gate-mark 800ms var(--ease-tech) forwards;
    animation-delay: calc(var(--pham-gate-i, 0) * 60ms + 200ms);
    margin-right: 0.14em;
  }
  .pham-gate__mark-word .pham-gate__mark-char:last-child {
    margin-right: 0;
  }
  @keyframes pham-gate-mark {
    to { opacity: 1; transform: translateY(0); }
  }

  /* Status indicator */
  .pham-gate__status {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 18px;
    border: 1px solid var(--color-ash);
    background-color: rgba(20, 20, 26, 0.55);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-white);
  }
  .pham-gate__status-dot {
    width: 8px;
    height: 8px;
    background-color: var(--color-warning);
    box-shadow: 0 0 12px var(--color-warning);
    animation: pham-gate-pulse 1.8s var(--ease-tech) infinite;
  }
  @keyframes pham-gate-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.4; transform: scale(1.4); }
  }

  .pham-gate__sub {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(13px, 1.2vw, 15px);
    line-height: 1.7;
    color: var(--color-bone-80);
    max-width: 46ch;
  }

  .pham-gate__release {
    margin: 0;
    display: inline-flex;
    align-items: baseline;
    gap: 12px;
    padding: 8px 14px;
    border-top: 1px solid var(--color-ash);
    border-bottom: 1px solid var(--color-ash);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }
  .pham-gate__release-label { color: var(--color-placeholder); }
  .pham-gate__release-value { color: var(--color-white); font-weight: 700; }

  /* Operator gate — toggle + collapsible panel */
  .pham-gate__operator {
    margin-top: clamp(20px, 3vw, 40px);
    width: 100%;
    max-width: 460px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .pham-gate__operator-toggle {
    background: transparent;
    border: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-inline: auto;
    padding: 6px 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    color: var(--color-placeholder);
    transition: color var(--duration-base) var(--ease-tech), letter-spacing var(--duration-base) var(--ease-tech);
  }
  .pham-gate__operator-bar {
    display: inline-block;
    width: 28px;
    height: 1px;
    background-color: var(--color-placeholder);
    transition: width var(--duration-base) var(--ease-tech), background-color var(--duration-base) var(--ease-tech);
  }
  .pham-gate__operator-rune {
    display: inline-block;
    width: 12px;
    text-align: center;
    transition: transform var(--duration-base) var(--ease-tech), color var(--duration-base) var(--ease-tech);
  }
  .pham-gate__operator-toggle:hover,
  .pham-gate__operator-toggle:focus-visible {
    color: var(--color-white);
    letter-spacing: 0.42em;
  }
  .pham-gate__operator-toggle:hover .pham-gate__operator-bar,
  .pham-gate__operator-toggle:focus-visible .pham-gate__operator-bar {
    background-color: var(--color-white);
    width: 36px;
  }
  .pham-gate__operator-toggle[aria-expanded="true"] .pham-gate__operator-rune {
    transform: rotate(45deg);
    color: var(--color-white);
  }
  .pham-gate__operator-toggle[aria-expanded="true"] {
    color: var(--color-white);
  }

  /* Panel — single-pixel bordered minimal input block */
  .pham-gate__panel {
    width: 100%;
    border: 1px solid var(--color-white);
    background-color: rgba(10, 10, 12, 0.7);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    padding: 4px;
    animation: pham-gate-panel 280ms var(--ease-tech) both;
  }
  .pham-gate__panel[hidden] { display: none; }
  @keyframes pham-gate-panel {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .pham-gate__row {
    display: grid;
    grid-template-columns: 28px 1fr auto;
    align-items: center;
    gap: 0;
  }
  .pham-gate__row-prompt {
    text-align: center;
    color: var(--color-white);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 18px;
    user-select: none;
  }
  .pham-gate__input {
    border: 0 !important;
    box-shadow: none !important;
    background: transparent !important;
    color: var(--color-white) !important;
    padding: 14px 8px !important;
    font-family: var(--font-mono) !important;
    font-weight: 700 !important;
    font-size: 13px !important;
    letter-spacing: 0.32em !important;
    text-transform: uppercase !important;
    border-radius: 0 !important;
  }
  .pham-gate__input::placeholder {
    color: var(--color-placeholder);
    letter-spacing: 0.32em;
  }
  .pham-gate__input:focus {
    outline: none !important;
    box-shadow: none !important;
    border: 0 !important;
  }
  .pham-gate__submit {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--color-white);
    color: var(--color-void);
    border: 0;
    padding: 14px 18px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    transition: background-color var(--duration-base) var(--ease-tech), gap var(--duration-base) var(--ease-tech);
  }
  .pham-gate__submit:hover,
  .pham-gate__submit:focus-visible {
    background-color: var(--color-warning);
    color: var(--color-white);
    gap: 16px;
  }
  .pham-gate__error {
    margin: 12px 4px 4px;
    padding: 8px 12px;
    border: 1px solid var(--color-warning);
    color: var(--color-warning);
    background-color: rgba(255, 61, 0, 0.06);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  @media (max-width: 600px) {
    .pham-gate { padding: 24px 16px; }
    .pham-gate__hud { font-size: 9px; letter-spacing: 0.24em; }
    .pham-gate__mark { column-gap: 0.4em; }
    .pham-gate__mark-char { margin-right: 0.1em; }
    .pham-gate__utility {
      flex-direction: column;
      gap: 12px;
      letter-spacing: 0.22em;
      text-align: center;
    }
    .pham-gate__utility-sep { display: none; }
    .pham-gate__row { grid-template-columns: 24px 1fr; }
    .pham-gate__submit { grid-column: 1 / -1; justify-content: center; }
  }
</style>

<script type="text/javascript">
  (function () {
    'use strict';
    var toggles = document.querySelectorAll('[data-pham-gate-toggle]');
    toggles.forEach(function (btn) {
      if (btn.__phamGateBound) return;
      btn.__phamGateBound = true;
      btn.addEventListener('click', function () {
        var operator = btn.closest('[data-pham-gate-operator]');
        if (!operator) return;
        var panel = operator.querySelector('[data-pham-gate-panel]');
        if (!panel) return;
        var expanded = btn.getAttribute('aria-expanded') === 'true';
        var next = !expanded;
        btn.setAttribute('aria-expanded', next ? 'true' : 'false');
        if (next) {
          panel.hidden = false;
          var input = panel.querySelector('input[type="password"]');
          if (input) setTimeout(function () { input.focus(); }, 60);
        } else {
          panel.hidden = true;
        }
      });
    });

    // Utility — open operator panel from footer strip
    var accessTriggers = document.querySelectorAll('[data-pham-gate-access-trigger]');
    accessTriggers.forEach(function (btn) {
      if (btn.__phamGateAccessBound) return;
      btn.__phamGateAccessBound = true;
      btn.addEventListener('click', function () {
        var toggle = document.querySelector('[data-pham-gate-toggle]');
        if (!toggle) return;
        if (toggle.getAttribute('aria-expanded') !== 'true') toggle.click();
        var panel = document.querySelector('[data-pham-gate-panel]');
        var input = panel ? panel.querySelector('input[type="password"]') : null;
        if (input) setTimeout(function () { input.focus(); }, 80);
      });
    });

    // Auto-open the panel if the password form returned an error (Shopify reloads with form.errors set)
    var errorPanel = document.querySelector('.pham-gate__error');
    if (errorPanel) {
      var op = errorPanel.closest('[data-pham-gate-operator]');
      if (op) {
        var btn = op.querySelector('[data-pham-gate-toggle]');
        var panel = op.querySelector('[data-pham-gate-panel]');
        if (btn && panel) {
          btn.setAttribute('aria-expanded', 'true');
          panel.hidden = false;
        }
      }
    }
  })();
</script>

{% schema %}
{
  "name": "PHAM Gateway",
  "tag": "section",
  "class": "pham-gate-section",
  "settings": [
    {
      "type": "header",
      "content": "Brand mark"
    },
    {
      "type": "text",
      "id": "pre_text",
      "label": "Eyebrow",
      "default": "PHAM // EXHIBITION GATEWAY"
    },
    {
      "type": "text",
      "id": "brand_mark",
      "label": "Brand mark",
      "default": "ATELIER PHAM",
      "info": "Use a space between words (e.g. ATELIER PHAM). Each character animates in."
    },
    {
      "type": "header",
      "content": "Status"
    },
    {
      "type": "text",
      "id": "status_text",
      "label": "Status indicator",
      "default": "EDITION 01 // IN PRODUCTION"
    },
    {
