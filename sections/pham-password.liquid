<!-- # DO NOT EDIT — managed by PHAM theme architecture -->
<section class="pham-password" data-pham-password data-section-id="{{ section.id }}" role="region" aria-label="Password gate">
  <div class="pham-password__inner reveal-up">
    {%- if settings.pham_logo != blank -%}
      <div class="pham-password__logo">
        {{ settings.pham_logo
            | image_url: width: 480
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '120, 240, 360, 480',
              sizes: '180px',
              class: 'pham-password__logo-img',
              alt: shop.name,
              style: 'width:' | append: settings.pham_logo_width | default: 140 | append: 'px'
        }}
      </div>
    {%- else -%}
      <h1 class="pham-password__wordmark">{{ shop.name | default: 'PHAM' | upcase }}</h1>
    {%- endif -%}

    <p class="pham-eyebrow pham-password__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="pham-password__heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="pham-password__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- form 'storefront_password', class: 'pham-password__form' -%}
      <label for="pham-password-input" class="pham-visually-hidden">Password</label>
      <div class="pham-password__form-row">
        <input id="pham-password-input"
               type="password"
               name="password"
               class="pham-password__input"
               placeholder="ENTER PASSWORD"
               autocomplete="current-password"
               required
               {% if form.errors %}aria-invalid="true" aria-describedby="pham-password-error"{% endif %}>
        <button type="submit" class="pham-password__submit" aria-label="Enter">
          <span class="pham-password__submit-fill" aria-hidden="true"></span>
          <span class="pham-password__submit-label">ENTER</span>
        </button>
      </div>

      {%- if form.errors -%}
        <p id="pham-password-error" class="pham-password__error" role="alert">
          {{ form.errors | default_errors }}
        </p>
      {%- endif -%}
    {%- endform -%}

    {%- if section.settings.show_newsletter -%}
      <div class="pham-password__newsletter">
        <p class="pham-eyebrow pham-password__newsletter-eyebrow">{{ section.settings.newsletter_eyebrow }}</p>
        <p class="pham-password__newsletter-copy">{{ section.settings.newsletter_text }}</p>

        {%- form 'customer', class: 'pham-password__newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="prospect,password-page">
          <label for="pham-password-email" class="pham-visually-hidden">Email</label>
          <div class="pham-password__newsletter-row">
            <input id="pham-password-email"
                   type="email"
                   name="contact[email]"
                   class="pham-password__newsletter-input"
                   placeholder="EMAIL ADDRESS"
                   value="{{ form.email }}"
                   required
                   autocomplete="email">
            <button type="submit" class="pham-password__newsletter-submit" aria-label="Subscribe">
              <span>SUBSCRIBE</span>
              <span aria-hidden="true">&rarr;</span>
            </button>
          </div>
          {%- if form.errors -%}
            <p class="pham-footer__form-msg pham-footer__form-msg--error" role="alert">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <p class="pham-footer__form-msg pham-footer__form-msg--success" role="status">Thank you.</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}

    {%- if settings.pham_social_instagram != blank or settings.pham_social_tiktok != blank -%}
      <ul class="pham-password__socials" role="list">
        {%- if settings.pham_social_instagram != blank -%}
          <li><a href="{{ settings.pham_social_instagram }}" target="_blank" rel="noopener noreferrer">Instagram</a></li>
        {%- endif -%}
        {%- if settings.pham_social_tiktok != blank -%}
          <li><a href="{{ settings.pham_social_tiktok }}" target="_blank" rel="noopener noreferrer">TikTok</a></li>
        {%- endif -%}
      </ul>
    {%- endif -%}

    <p class="pham-password__powered">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}.</p>
  </div>
</section>

<style>
  /* Hide Horizon's hard-coded password dialog when our PHAM section is rendered */
  #password-form { display: none !important; }
  body.template-password,
  body.template-password .password-main-content { background-color: var(--color-void); }

  .pham-password {
    background-color: var(--color-void);
    color: var(--color-bone);
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2xl) var(--gutter);
  }
  .pham-password__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    max-width: 480px;
    width: 100%;
  }
  .pham-password__logo { margin-bottom: var(--space-sm); }
  .pham-password__logo-img {
    height: auto;
    max-height: 64px;
    object-fit: contain;
  }
  .pham-password__wordmark {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-luxury);
    color: var(--color-bone);
    margin: 0 0 var(--space-sm);
  }
  .pham-password__eyebrow { color: var(--color-accent); margin: 0; }
  .pham-password__heading {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
    color: var(--color-bone);
    margin: 0;
  }
  .pham-password__subheading {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-bone-80);
    margin: 0;
    max-width: 44ch;
  }

  .pham-password__form { width: 100%; margin-top: var(--space-sm); }
  .pham-password__form-row {
    display: flex;
    align-items: stretch;
    border-bottom: 1px solid var(--color-ash);
    transition: border-color var(--duration-base) var(--ease-luxury);
  }
  .pham-password__form-row:focus-within { border-bottom-color: var(--color-accent); }
  .pham-password__input {
    flex: 1;
    background: transparent;
    border: 0;
    padding: var(--space-sm) 0;
    color: var(--color-bone);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-luxury);
    text-transform: uppercase;
  }
  .pham-password__input::placeholder { color: var(--color-smoke); }
  .pham-password__input:focus { outline: none; }
  .pham-password__submit {
    position: relative;
    background: transparent;
    border: 0;
    cursor: pointer;
    color: var(--color-bone);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-luxury);
    text-transform: uppercase;
    padding: var(--space-sm) var(--space-md);
    overflow: hidden;
    isolation: isolate;
    transition: color var(--duration-base) var(--ease-luxury);
  }
  .pham-password__submit-fill {
    position: absolute;
    inset: 0;
    background-color: var(--color-accent);
    clip-path: inset(0 100% 0 0);
    transition: clip-path var(--duration-base) var(--ease-luxury);
    z-index: 1;
  }
  .pham-password__submit-label { position: relative; z-index: 2; }
  .pham-password__submit:hover { color: var(--color-void); }
  .pham-password__submit:hover .pham-password__submit-fill { clip-path: inset(0 0 0 0); }
  .pham-password__error {
    margin: var(--space-xs) 0 0;
    color: #d97a7a;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-base);
  }

  .pham-password__newsletter {
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-ash);
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    text-align: center;
  }
  .pham-password__newsletter-eyebrow { color: var(--color-accent); }
  .pham-password__newsletter-copy {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-bone-80);
    margin: 0;
  }
  .pham-password__newsletter-row {
    display: flex;
    align-items: stretch;
    border-bottom: 1px solid var(--color-ash);
    margin-top: var(--space-xs);
  }
  .pham-password__newsletter-row:focus-within { border-bottom-color: var(--color-accent); }
  .pham-password__newsletter-input {
    flex: 1;
    background: transparent;
    border: 0;
    padding: var(--space-sm) 0;
    color: var(--color-bone);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-luxury);
    text-transform: uppercase;
  }
  .pham-password__newsletter-input::placeholder { color: var(--color-smoke); }
  .pham-password__newsletter-input:focus { outline: none; }
  .pham-password__newsletter-submit {
    background: transparent;
    border: 0;
    color: var(--color-bone);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-luxury);
    text-transform: uppercase;
    cursor: pointer;
    padding: var(--space-sm);
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    transition: color var(--duration-fast) var(--ease-luxury), gap var(--duration-fast) var(--ease-luxury);
  }
  .pham-password__newsletter-submit:hover { color: var(--color-accent); gap: var(--space-sm); }

  .pham-password__socials {
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
    display: flex;
    gap: var(--space-md);
    justify-content: center;
  }
  .pham-password__socials a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-luxury);
    text-transform: uppercase;
    color: var(--color-smoke);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-luxury);
  }
  .pham-password__socials a:hover { color: var(--color-accent); }

  .pham-password__powered {
    margin-top: var(--space-md);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: var(--tracking-luxury);
    text-transform: uppercase;
    color: var(--color-smoke);
  }
</style>

{% schema %}
{
  "name": "PHAM Password",
  "tag": "section",
  "class": "pham-password-section",
  "settings": [
    {
      "type": "header",
      "content": "Gate copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "PHAM · COMING SOON"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "An edition in preparation."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "The atelier is sealed. Enter password to step inside, or join the list for the opening."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_eyebrow",
      "label": "Newsletter eyebrow",
      "default": "The Sealed List"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Newsletter description",
      "default": "Be the first to know."
    }
  ],
  "presets": [
    {
      "name": "PHAM Password",
      "category": "PHAM"
    }
  ],
  "enabled_on": {
    "templates": ["password"]
  }
}
{% endschema %}
