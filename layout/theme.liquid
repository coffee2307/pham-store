<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- render 'pham-favicon' -%}

    {% # theme-check-disable RemoteAsset %}
    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'pham-analytics' -%}
    {%- if request.design_mode -%}
      {%- render 'stylesheets' -%}
      {%- render 'fonts' -%}
      {%- render 'scripts' -%}
      {%- render 'theme-styles-variables' -%}
      {%- render 'color-schemes' -%}
    {%- else -%}
      {%- render 'pham-stylesheets' -%}
      {%- render 'pham-scripts' -%}
    {%- endif -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
    {% # theme-check-enable RemoteAsset %}

    {% comment %}CUSTOM_PHAM_THEME_START{% endcomment %}
    {% # theme-check-disable RemoteAsset, AssetPreload %}
    {%- comment -%} Pre-paint critical styles — keeps the first viewport stable while non-critical PHAM CSS streams in. {%- endcomment -%}
    <style>
      :root {
        --color-void:#0A0A0C; --color-ash:#222226; --color-bone:#E8E8EA; --color-white:#fff;
        --gutter:clamp(16px,4vw,48px); --max-width:1600px;
        --space-xs:8px; --space-sm:16px; --space-md:24px;
        --font-display:'Syncopate','Space Grotesk',system-ui,-apple-system,BlinkMacSystemFont,sans-serif;
        --font-body:'Space Grotesk',system-ui,-apple-system,BlinkMacSystemFont,sans-serif;
        --font-mono:'Space Mono',ui-monospace,'SFMono-Regular',Menlo,Consolas,monospace;
        --pham-header-offset:80px;
      }
      *,*::before,*::after { box-sizing:border-box; }
      html { background-color:#0A0A0C !important; overflow-x:clip; }
      body { margin:0; opacity:1 !important; visibility:visible !important; background:#0A0A0C; color:#E8E8EA; font-family:var(--font-body); transition:none !important; animation:none !important; overflow-x:clip; }
      html,body,#MainContent,.content-for-layout,main { background-color:#0A0A0C !important; color:#E8E8EA; }
      img,svg { display:block; max-width:100%; }
      .pham-container { width:100%; max-width:var(--max-width); margin-inline:auto; padding-inline:var(--gutter); }
      .pham-header { position:fixed; inset:0 0 auto; z-index:100; width:100%; background:rgba(10,10,12,.92); border-bottom:1px solid var(--color-ash); color:var(--color-bone); }
      .pham-header__spacer { height:80px; }
      .pham-header__inner { display:grid; grid-template-columns:1fr auto 1fr; align-items:center; width:100%; height:80px; gap:var(--space-md); overflow-x:clip; }
      .pham-header__zone { display:flex; align-items:center; gap:var(--space-sm); min-width:0; }
      .pham-header__zone--left { justify-content:flex-start; } .pham-header__zone--center { justify-content:center; overflow:hidden; } .pham-header__zone--right { justify-content:flex-end; }
      .pham-header__hamburger { display:none; }
      .pham-brand-lockup,.pham-header__logo { display:inline-flex; align-items:center; color:inherit; text-decoration:none; }
      .pham-brand-lockup--logo-only .pham-brand-lockup__mark { width:var(--pham-logo-width,140px); max-width:min(var(--pham-logo-width,140px),46vw); height:auto; aspect-ratio:1683.3006/523.8822; }
      .pham-brand-lockup__mark-img { width:100%; height:auto; object-fit:contain; }
      .pham-header__logo--mobile,.pham-brand-lockup.pham-header__logo--mobile { display:none; }
      .pham-header__nav--desktop,.pham-header__menu { display:flex; align-items:center; }
      .pham-header__menu { gap:var(--space-md); list-style:none; margin:0; padding:0; }
      .pham-header__menu-link { color:var(--color-bone); text-decoration:none; font:700 10px/1 var(--font-mono); letter-spacing:.25em; }
      .pham-header__action { display:inline-flex; align-items:center; justify-content:center; width:40px; height:40px; color:var(--color-bone); background:transparent; border:1px solid transparent; text-decoration:none; }
      .pham-vault__chapter:first-child.is-active { opacity:1; visibility:visible; transform:none; transition:none !important; }
      .pham-vault__display { color:#f5f5f1; font-family:var(--font-display); font-weight:400; }
      html.pham-js body,html.pham-js body.pham-page-ready,html.pham-js body.pham-page-exiting,body.pham-page-ready,body.pham-page-exiting { opacity:1 !important; visibility:visible !important; transition:none !important; animation:none !important; }
      @media (max-width:900px) {
        :root { --pham-header-offset:64px; }
        .pham-header__inner { position:relative; grid-template-columns:1fr 1fr; height:64px; gap:var(--space-xs); }
        .pham-header__spacer { height:64px; }
        .pham-header__hamburger { display:inline-flex; width:36px; height:36px; flex-direction:column; align-items:center; justify-content:center; gap:5px; padding:0; background:transparent; border:1px solid var(--color-ash); color:var(--color-bone); }
        .pham-header__hamburger-bar { width:18px; height:1px; background:currentColor; }
        .pham-header__nav--desktop,.pham-header__logo--desktop,.pham-brand-lockup.pham-header__logo--desktop { display:none; }
        .pham-header__logo--mobile,.pham-brand-lockup.pham-header__logo--mobile { display:inline-flex; }
        .pham-header__zone--center { position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); width:max-content; max-width:calc(100% - 112px); overflow:visible; }
        .pham-header__zone--right { justify-self:end; }
        .pham-brand-lockup--logo-only .pham-brand-lockup__mark { width:min(var(--pham-logo-width,140px),108px); max-width:42vw; }
      }
      @media (max-width:749px) {
        :root { --pham-header-offset:60px; }
        .pham-header { background:#0A0A0C; }
        .pham-header__inner { height:60px; padding-inline:max(16px,env(safe-area-inset-left,0px)) max(16px,env(safe-area-inset-right,0px)); }
        .pham-header__spacer { height:60px !important; }
        .pham-brand-lockup--logo-only .pham-brand-lockup__mark { width:min(var(--pham-logo-width,140px),96px); max-width:34vw; }
      }
      @view-transition { navigation:none; }
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {%- assign pham_text_fonts_url = 'https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&family=Space+Mono:wght@400&display=swap' -%}
    {%- assign pham_display_fonts_url = 'https://fonts.googleapis.com/css2?family=Syncopate:wght@400;700&display=optional' -%}
    <link rel="preload" as="style" href="{{ pham_text_fonts_url }}">
    <link href="{{ pham_text_fonts_url }}" rel="stylesheet" media="print" onload="this.media='all'">
    <link rel="preload" as="style" href="{{ pham_display_fonts_url }}">
    <link href="{{ pham_display_fonts_url }}" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript>
      <link href="{{ pham_text_fonts_url }}" rel="stylesheet">
      <link href="{{ pham_display_fonts_url }}" rel="stylesheet">
    </noscript>
    <link rel="preload" as="style" href="{{ 'pham-theme.css' | asset_url }}">
    {%- if request.page_type == 'index' and request.design_mode == false -%}
      <link rel="stylesheet" href="{{ 'pham-theme.css' | asset_url }}" media="print" onload="this.media='all'">
      <noscript>{{ 'pham-theme.css' | asset_url | stylesheet_tag }}</noscript>
    {%- else -%}
      {{ 'pham-theme.css' | asset_url | stylesheet_tag }}
    {%- endif -%}
    <script src="{{ 'pham-security.js' | asset_url }}" defer></script>
    {%- if request.path contains '/challenge' -%}
      <script src="{{ 'pham-challenge.js' | asset_url }}" defer></script>
    {%- endif -%}
    {% # theme-check-enable RemoteAsset, AssetPreload %}
    {% comment %}CUSTOM_PHAM_THEME_END{% endcomment %}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}{% if request.path contains '/challenge' %} pham-challenge-page{% endif %}{% if request.page_type == 'policy' or request.path contains '/policies/' %} pham-policy-page{% endif %}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'Skip to main content', literal: true %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    <footer>
      {% sections 'footer-group' %}
    </footer>

    {% comment %}CUSTOM_PHAM_SCRIPTS_START{% endcomment %}
    {%- render 'pham-post-login-redirect' -%}
    {% if request.page_type == 'policy' or request.path contains '/policies/' %}
      {% # theme-check-disable ParserBlockingScript %}
      <script src="{{ 'pham-policy.js' | asset_url }}" defer></script>
      {% # theme-check-enable ParserBlockingScript %}
    {% endif %}
    <script src="{{ 'pham-animations.js' | asset_url }}" defer></script>
    <script src="{{ 'pham-immersive.js' | asset_url }}" defer></script>
    <script src="{{ 'pham-header.js' | asset_url }}" defer></script>
    <script src="{{ 'pham-cart.js' | asset_url }}" defer></script>
    {%- if request.page_type == 'product' or template contains 'pre-order' -%}
      <script src="{{ 'pham-limited-qty.js' | asset_url }}" defer></script>
    {%- endif -%}
    {% comment %}CUSTOM_PHAM_SCRIPTS_END{% endcomment %}
  </body>
</html>
