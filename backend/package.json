{
  "name": "pham-campaign-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute PHAM_CAMPAIGN_DB --local --file=schema.sql",
    "db:migrate:local": "wrangler d1 migrations apply PHAM_CAMPAIGN_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply PHAM_CAMPAIGN_DB --remote",
    "webhooks:register": "node register-shopify-webhooks.mjs",
    "test": "node --test worker.test.mjs",
    "admin": "node admin.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
